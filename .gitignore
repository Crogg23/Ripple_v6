# transient run logs (tee'd output from connect/onboarding runs)
outputs/_*.log

# heartbeat runtime state + lock (scripts/heartbeat.py) — machine-local, never commit
outputs/_heartbeat_state.json
outputs/_heartbeat.lock
outputs/_heartbeat_selftest*.lock
outputs/_heartbeat_selftest*.pid

# per-query dossiers generated on demand by `connect dossier --html`
outputs/dossier_*.html

# local cache for multi-GB bulk-loader downloads (courtlistener_dockets_load.py,
# dea_arcos_full_load.py) — machine-local, never commit
outputs/_bulk_cache/

# loader run/error logs + resumable checkpoints — machine-local runtime state,
# same class of file as outputs/_*.log above (never committed); a stale
# checkpoint committed to git would actively mislead a resume on another
# machine, not just bloat the repo.
logs/

# python bytecode
__pycache__/
*.pyc

# OS cruft
.DS_Store

# dev/test caches
.pytest_cache/

# office lock/temp files (created while an .xlsx is open)
~$*

# DR exports of the control plane (scripts/export_control_plane.py) — backups, never commit
backups/

# Secrets — never commit (belt-and-suspenders; the live .env lives in library-onboarding/)
.env
*.env
!.env.example

# Wholesale-regenerated CONNECT artifacts — rebuilt by `python -m connect all`;
# don't churn 30MB+ through git (the reading room reads connect_graph.json off disk).
outputs/connect_graph.json
outputs/connect_fingerprints.json
outputs/connection_explorer.html

# Pour run logs — append-only console output, 50k+ lines per run; never track
library-onboarding/*.log
# Scheduled-task heartbeat state (runtime, machine-local)
outputs/_task_*_LAST.json
outputs/_task_*_out.txt
.dbt-venv/
.venv/
# ripple CLI runtime state (machine-local)
outputs/_ripple_state.json
outputs/_ripple_domain_approvals.json

# Wholesale-regenerated catalog/graph exports — large generated blobs, don't
# churn them through git (same reasoning as connect_graph.json above).
# NOTE: gitignore does NOT support inline "pattern # comment" -- a trailing
# # comment on the same line as a pattern becomes part of the (broken)
# pattern, not a comment. Keep notes on their own line, above the pattern.
#
# generated by portal_recon/export_portal_index.py
outputs/portal_index.json
# generated by scripts/export_graph.py
outputs/graph.gexf
outputs/graph_links.csv
outputs/graph_nodes.csv
# generated by scripts/thelibrary_build.py
outputs/thelibrary_content.json
outputs/thelibrary_content.json.bak_*
# generated by scripts/thelibrary_inventory.py
outputs/thelibrary_inventory.json

# Investigator Instrument: commit the .py chart cards, not the rendered HTML
investigations/**/*.html
investigations/**/plotly.min.js
outputs/_viz_cache.json

# Snowflake key-pair auth for dbt (added 2026-07-29). Private keys NEVER get committed.
.keys/
*.p8
*.pem

# generated by scripts/audit_blank_landing.py — a point-in-time report, regenerate
# it rather than tracking it (same reasoning as the other outputs/ blobs above)
outputs/_blank_landing_audit.json
importtime*.log

# Raw source downloads / scratch data (2026-08-06): re-downloadable multi-GB
# source files, some person-level (ICIJ, Companies House PSC). Never commit --
# GitHub rejects >100MB files and raw data doesn't belong in history.
# The small .py scratch loaders inside _dl/ are force-added (git add -f).
/ch_psc_snapshot.zip
/icij_offshore.zip
*.done
*.pid
library-onboarding/_dl/
library-onboarding/raw_downloads/
library-onboarding/ch_psc/
library-onboarding/icij_extract/
library-onboarding/scratch_*
scripts/hmda_historic_scratch/
outputs/_raw_downloads/
outputs/_fracfocus.zip
outputs/_eia860.zip
outputs/_eia861.zip
outputs/_dol_olms_cookies.txt
