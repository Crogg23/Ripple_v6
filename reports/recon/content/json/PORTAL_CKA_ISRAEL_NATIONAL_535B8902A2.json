\u05e5</a>": [[2026, 113, null]], "\u05d0\u05d9\u05df \u05d0\u05d6\u05d4\u05e8\u05d5\u05ea": [[2026, 87, null]], "\u05d0\u05d9\u05df \u05d4\u05de\u05dc\u05e6\u05d5\u05ea ": [[2026, 6, null]], "\u05d0\u05d9\u05df \u05d4\u05de\u05dc\u05e6\u05d5\u05ea.": [[2026, 2, null]], "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05de\u05e2\u05e1\u05e7\u05d0\u05d5\u05ea \u05e0\u05d3\u05dc\"\u05df \u05d1\u05d7\u05dc\u05e7 \u05d4\u05e6\u05e4\u05d5\u05e0\u05d9 \u05e9\u05dc \u05e7\u05e4\u05e8\u05d9\u05e1\u05d9\u05df.": [[2026, 1, null]], "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5 \u05de\u05e0\u05e1\u05d9\u05e2\u05d4 \u05d5\u05de\u05e9\u05d4\u05d9\u05d9\u05d4 \u05d1\u05d3\u05e8\u05d5\u05dd \u05e1\u05d5\u05d3\u05d0\u05df, \u05d1\u05d2\u05dc\u05dc \u05d0\u05d9 \u05d4\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea \u05d5\u05d7\u05e9\u05e9 \u05de\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05ea \u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05d1\u05de\u05d3\u05d9\u05e0\u05d4.\n\u05e9\u05d9\u05de\u05e8\u05d5 \u05e2\u05dc \u05e2\u05d9\u05e8\u05e0\u05d5\u05ea.": [[2026, 1, null]], "\u05e6\u05de\u05d7 \u05d4\u05d2\u05ea \u05d0\u05d9\u05e0\u05d5 \u05d7\u05d5\u05e7\u05d9 \u05d1\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4 \u05d5\u05de\u05d4\u05d5\u05d5\u05d4 \u05e2\u05d9\u05dc\u05d4 \u05dc\u05de\u05e2\u05e6\u05e8.": [[2026, 1, null]], "\u05e8\u05de\u05d4 2/ \u05d0\u05d9\u05d5\u05dd \u05de\u05d6\u05d3\u05de\u05df: \u05d4\u05de\u05dc\u05e6\u05d4 \u05dc\u05e0\u05e7\u05d5\u05d8 \u05d1\u05d0\u05de\u05e6\u05e2\u05d9 \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05d9\u05dd.": [[2026, 44, null]], "\u05e8\u05de\u05d4 3/ \u05d0\u05d9\u05d5\u05dd \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9: \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05e0\u05e1\u05d9\u05e2\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05df \u05d7\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea.": [[2026, 16, null]], "\u05e8\u05de\u05d4 4/ \u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4 \u05dc\u05de\u05d3\u05d9\u05e0\u05d4.": [[2026, 2, null]], "\u05e8\u05de\u05d4 4/ \u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4, \u05d0\u05d9\u05df \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05d3\u05d9\u05e0\u05d4 \u05d6\u05d5 \u05d5\u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05e9\u05d4\u05d9\u05d9\u05d4 \u05d9\u05e9 \u05dc\u05e2\u05d6\u05d5\u05d1 \u05d0\u05ea \u05d4\u05de\u05d3\u05d9\u05e0\u05d4": [[2026, 3, null]], "\u05e8\u05de\u05d4 4/ \u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4, \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4.": [[2026, 4, null]], "\u05e8\u05de\u05d4 4/ \u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4: \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4 \u05dc\u05de\u05d3\u05d9\u05e0\u05d4": [[2026, 4, null]], "\u05e8\u05de\u05d4 4/\u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4: \u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4 \u05dc\u05d0\u05dc\u05d2'\u05d9\u05e8\u05d9\u05d4. \u05db\u05de\u05d5 \u05db\u05df, \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05e9\u05d4\u05d9\u05d9\u05d4 \u05d1\u05d8\u05d9\u05e1\u05d4 \u05d0\u05e9\u05e8 \u05de\u05e1\u05dc\u05d5\u05dc\u05d4 \u05e2\u05d5\u05d1\u05e8 \u05de\u05e2\u05dc \u05e9\u05d8\u05d7\u05d4 \u05e9\u05dc \u05d0\u05dc\u05d2'\u05d9\u05e8\u05d9\u05d4.": [[2026, 1, null]], "\u05e8\u05de\u05ea \u05d0\u05d9\u05d5\u05dd \u05de\u05e9\u05d5\u05dc\u05d1\u05ea: \u05e8\u05de\u05ea \u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4\u05d4 (\u05e8\u05de\u05d4 4) \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4: \u05de\u05d6\u05e8\u05d7 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4, \u05e6\u05e4\u05d5\u05df \u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05d5\u05de\u05d7\u05d5\u05d6\u05d5\u05ea \u05e7\u05e1\u05d0\u05d9 \u05d1\u05d3\u05e8\u05d5\u05dd. \u05d0\u05d9\u05d5\u05dd \u05de\u05d6\u05d3\u05de\u05df (\u05e8\u05de\u05d4 2) \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e0\u05e7\u05d5\u05d8 \u05d1\u05d0\u05de\u05e6\u05e2\u05d9 \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05d9\u05dd: \u05e9\u05d0\u05e8 \u05e9\u05d8\u05d7\u05d9 \u05e7\u05d5\u05e0\u05d2\u05d5.": [[2026, 2, null]], "\u05e8\u05de\u05ea \u05d0\u05d9\u05d5\u05dd \u05de\u05e9\u05d5\u05dc\u05d1\u05ea: \u05e8\u05de\u05ea \u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4\u05d4 (\u05e8\u05de\u05d4 4) \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4: \u05e6\u05e4\u05d5\u05df \u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05dc\u05d0\u05d5\u05e8 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d8\u05e8\u05d5\u05e8 \u05de\u05e6\u05d3 \u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05d0\u05e1\u05dc\u05d0\u05de\u05d9\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea \u05d1\u05d0\u05d6\u05d5\u05e8 \u05e7\u05d0\u05d1\u05d5 \u05d3\u05dc\u05d2\u05d3\u05d5. \u05d0\u05d9\u05d5\u05dd \u05de\u05d6\u05d3\u05de\u05df (\u05e8\u05de\u05d4 2) \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e0\u05e7\u05d5\u05d8 \u05d1\u05d0\u05de\u05e6\u05e2\u05d9 \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05d9\u05dd: \u05e9\u05d0\u05e8 \u05e9\u05d8\u05d7\u05d9 \u05de\u05d5\u05d6\u05de\u05d1\u05d9\u05e7.": [[2026, 1, null]], "\u05e8\u05de\u05ea \u05d0\u05d9\u05d5\u05dd \u05de\u05e9\u05d5\u05dc\u05d1\u05ea: \u05e8\u05de\u05ea \u05d0\u05d9\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4\u05d4 (\u05e8\u05de\u05d4 4): \u05de\u05de\u05dc\u05d9\u05e6\u05d9\u05dd \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4 \u05e9\u05dc 30 \u05e7\u05d9\u05dc\u05d5\u05de\u05d8\u05e8 \u05de\u05d4\u05d2\u05d1\u05d5\u05dc \u05d4\u05de\u05e9\u05d5\u05ea\u05e3 \u05d1\u05d9\u05df \u05d8\u05d2'\u05d9\u05e7\u05d9\u05e1\u05d8\u05df \u05dc\u05d0\u05e4\u05d2\u05e0\u05d9\u05e1\u05d8\u05df \u05dc\u05d0\u05d5\u05e8 \u05d7\u05e9\u05e9 \u05de\u05de\u05e9\u05d9 \u05db\u05d9 \u05d2\u05d5\u05e8\u05de\u05d9 \u05d8\u05e8\u05d5\u05e8 \u05d4\u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05d1\u05d0\u05e4\u05d2\u05e0\u05d9\u05e1\u05d8\u05df \u05d9\u05e0\u05e1\u05d5 \u05dc\u05e4\u05d2\u05d5\u05e2/\u05dc\u05d7\u05d8\u05d5\u05e3 \u05ea\u05d9\u05d9\u05e8\u05d9\u05dd, \u05d1\u05d4\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd. \u05e8\u05de\u05ea \u05d0\u05d9\u05d5\u05dd \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea (\u05e8\u05de\u05d4 3) \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05e0\u05e1\u05d9\u05e2\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05df \u05d7\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea: \u05e9\u05d0\u05e8 \u05e9\u05d8\u05d7\u05d9 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4.": [[2026, 1, null]], "\u05e9\u05d9\u05de\u05e8\u05d5 \u05e2\u05dc \u05e2\u05d9\u05e8\u05e0\u05d5\u05ea, \u05d4\u05e7\u05e9\u05d9\u05d1\u05d5 \u05dc\u05d0\u05de\u05e6\u05e2\u05d9 \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea.": [[2026, 71, null]], "\u05e9\u05d9\u05de\u05e8\u05d5 \u05e2\u05dc \u05e2\u05d9\u05e8\u05e0\u05d5\u05ea, \u05d4\u05e7\u05e9\u05d9\u05d1\u05d5 \u05dc\u05d0\u05de\u05e6\u05e2\u05d9 \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea.\n\u05de\u05e2\u05d1\u05e8 \u05d2\u05d1\u05d5\u05dc \u05d0\u05d7\u05d3 \u05d1\u05d9\u05df \u05e7\u05d5\u05dc\u05d5\u05de\u05d1\u05d9\u05d4 \u05dc\u05d0\u05e7\u05d5\u05d5\u05d3\u05d5\u05e8 - \u05e8\u05d5\u05de\u05d9\u05e6'\u05d0\u05e7\u05d4.\n\u05d0\u05d6\u05e8\u05d7\u05d9\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d4\u05e0\u05e4\u05d9\u05e7 \u05d0\u05e9\u05e8\u05ea \u05d1\u05d9\u05e7\u05d5\u05e8 \u05d8\u05e8\u05dd \u05d4\u05d2\u05e2\u05d4 \u05dc\u05e7\u05d5\u05dc\u05d5\u05de\u05d1\u05d9\u05d4.\n\u05d4\u05dc\u05d9\u05db\u05d9 \u05e4\u05d5\u05e0\u05d3\u05e7\u05d0\u05d5\u05ea \u05d1\u05e7\u05d5\u05dc\u05d5\u05de\u05d1\u05d9\u05d4 \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e1\u05d3\u05e8\u05d9\u05dd \u05d1\u05d7\u05d5\u05e7 \u05d4\u05de\u05e7\u05d5\u05de\u05d9.\n\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05e4\u05e0\u05e7\u05e1 \u05d7\u05d9\u05e1\u05d5\u05e0\u05d9\u05dd \u05e9\u05de\u05d0\u05e9\u05e8 \u05d7\u05d9\u05e1\u05d5\u05df \u05e0\u05d2\u05d3 \u05e7\u05d3\u05d7\u05ea \u05e6\u05d4\u05d5\u05d1\u05d4, \u05d1\u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05de\u05d3\u05d9\u05e0\u05d4.": [[2026, 1, null]], "\u05e9\u05d9\u05de\u05e8\u05d5 \u05e2\u05dc \u05e2\u05d9\u05e8\u05e0\u05d5\u05ea, \u05d4\u05e7\u05e9\u05d9\u05d1\u05d5 \u05dc\u05d0\u05de\u05e6\u05e2\u05d9 \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea. ": [[2026, 2, null]]}}}, "what": {"CONTINENT": [["\u05d0\u05e4\u05e8\u05d9\u05e7\u05d4", 79], ["\u05d0\u05d9\u05e8\u05d5\u05e4\u05d4", 77], ["\u05d0\u05e1\u05d9\u05d4", 57], ["\u05d0\u05de\u05e8\u05d9\u05e7\u05d4", 52], ["\u05d0\u05e4\u05e8\u05d9\u05e7\u05d4                        ", 46], ["\u05d0\u05d9\u05e8\u05d5\u05e4\u05d4                        ", 45], ["\u05d0\u05de\u05e8\u05d9\u05e7\u05d4                        ", 43], ["\u05e4\u05d0\u05e1\u05d9\u05e4\u05d9\u05e7", 24], ["\u05d0\u05e1\u05d9\u05d4                          ", 20], ["\u05e4\u05d0\u05e1\u05d9\u05e4\u05d9\u05e7                       ", 11]], "LOGO": [["<img src=\"https://www.gov.il/BlobFolder/generalpage/logos-for-travel-warnings/he/Flags_malal.png\" alt=\"\u05d4\u05de\u05d8\u05d4 \u05dc\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05dc\u05d0\u05d5\u05de\u05d9\" /><P>\u05d4\u05de\u05d8\u05d4 \u05dc\u05d1\u05d8\u05d7\u05d5\u05df \u05dc\u05d0\u05d5\u05de\u05d9</p>", 196], ["<img src=\"https://www.gov.il/BlobFolder/generalpage/logos-for-travel-warnings/he/Flags_Artboard%201.png\" alt=\"\u05de\u05e9\u05e8\u05d3 \u05d4\u05d7\u05d5\u05e5\" /><P>\u05de\u05e9\u05e8\u05d3 \u05d4\u05d7\u05d5\u05e5</p>", 145], ["<img src=\"https://www.gov.il/BlobFolder/generalpage/logos-for-travel-warnings/he/Flags_health.png\" alt=\"\u05de\u05e9\u05e8\u05d3 \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea\" /><P>\u05de\u05e9\u05e8\u05d3 \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea</p>", 113]], "COL": [["\u05de\u05dc\"\u05dc", 196], ["\