{"table": "INTL_GR_DATAGOV", "rows": 5000, "ncols": 19, "profile": {"DATASET_ID": {"type": "TEXT", "distinct": 5016, "blank": 0, "top": [["8d9bfa72-dcd4-4960-be6d-9140cbea24d4", 25], ["2d5013a0-728c-44be-9a20-ed87e4da668e", 25], ["f9d6800f-d12d-47db-be0f-a3197893bfe3", 25], ["a609176b-c626-4418-927d-ad2f0d2b7ede", 25], ["770ebe8e-a77c-4f22-8cb0-e88162f3637a", 25], ["a88520b5-6eaf-41e9-a46f-fef6a5281450", 25], ["0363a8c5-cbb4-422a-a3ad-82e3c67b6a31", 25], ["7582742c-fb4e-419e-a559-808743d74b0e", 25], ["a2e4bde6-d06c-47d7-9333-b1773b321fa9", 25], ["1315f181-7b82-4067-b3b6-e300982c8349", 25], ["2fd58785-e117-432b-ba85-dd0ab88c3174", 25], ["5be0d599-ad94-419f-9ed2-e2d6b4c7fb0b", 25]], "date_fmt": null}, "TITLE": {"type": "TEXT", "distinct": 4498, "blank": 0, "top": [["\u03a4\u03a1\u039f\u03a0\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397 \u03a1\u03a5\u039c\u039f\u03a4\u039f\u039c\u0399\u039a\u039f\u03a5 \u03a6\u0395\u039a (248/\u0394/1989)", 63], ["\u03a3\u03a7\u0395\u0394\u0399\u0391 \u03a0\u039f\u039b\u0395\u039f\u0394\u039f\u039c\u0399\u039a\u0397\u03a3 \u039c\u0395\u039b\u0395\u03a4\u0397\u03a3 \u03a6\u0395\u039a(1019/\u0394/1986)", 41], ["\u03a4\u03a1\u039f\u03a0\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397 \u03a1\u03a5\u039c\u039f\u03a4\u039f\u039c\u0399\u039a\u039f\u03a5 \u03a6\u0395\u039a (531/\u0394/1986)", 34], ["\u03a3\u03a7\u0395\u0394\u0399\u0391 \u03a0\u039f\u039b\u0395\u039f\u0394\u039f\u039c\u0399\u039a\u0397\u03a3 \u039c\u0395\u039b\u0395\u03a4\u0397\u03a3 \u03a6\u0395\u039a(92/\u0394/1990)", 34], ["\u03a3\u03a7\u0395\u0394\u0399\u0391 \u03a0\u039f\u039b\u0395\u039f\u0394\u039f\u039c\u0399\u039a\u0397\u03a3 \u039c\u0395\u039b\u0395\u03a4\u0397\u03a3 \u03a6\u0395\u039a(1228/\u0394/2005)", 32], ["\u0394\u03b9\u03ac\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1 \u03a0\u03c1\u03ac\u03be\u03b5\u03c9\u03bd \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 - 2/92 \u03a0\u03c1\u03ac\u03be\u03b7 \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2", 31], ["\u03a4\u03a1\u039f\u03a0\u039f\u03a0\u039f\u0399\u0397\u03a3\u0397 \u03a1\u03a5\u039c\u039f\u03a4\u039f\u039c\u0399\u039a\u039f\u03a5 \u03a6\u0395\u039a (1099/\u0394/1996)", 27], ["\u0394\u03b9\u03ac\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1 \u03a0\u03c1\u03ac\u03be\u03b5\u03c9\u03bd \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 - 1/93 \u03a0\u03c1\u03ac\u03be\u03b7 \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2", 27], ["\u0394\u03b9\u03ac\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1 \u03a0\u03c1\u03ac\u03be\u03b5\u03c9\u03bd \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 - 1/97 \u03a0\u03c1\u03ac\u03be\u03b7 \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2", 27], ["\u0394\u03b9\u03ac\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1 \u03a0\u03c1\u03ac\u03be\u03b5\u03c9\u03bd \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 - 1/96 \u03a0\u03c1\u03ac\u03be\u03b7 \u0395\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2", 27], ["\u03a6\u03c9\u03c4\u03bf\u03b2\u03bf\u03bb\u03c4\u03b1\u03ca\u03ba\u03bf\u03af \u03a3\u03c4\u03b1\u03b8\u03bc\u03bf\u03af \u03bc\u03b5 \u0395\u03bd\u03c3\u03c9\u03bc\u03b1\u03c4\u03c9\u03bc\u03ad\u03bd\u03b7 \u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 (\u03c0\u03b5\u03c1. 11\u0391 \u03ac\u03c1\u03b8\u03c1\u03bf\u03c5 10 \u03bd. 4685/2020)", 26], ["\u03a0\u03b5\u03c1\u03b9\u03c6\u03ad\u03c1\u03b5\u03b9\u03b5\u03c2", 26]], "date_fmt": null}, "DESCRIPTION": {"type": "TEXT", "distinct": 4273, "blank": 0, "top": [["\u03a0\u03b5\u03c1\u03af \u03c4\u03c1\u03bf\u03c0\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03c9\u03c2 \u03c4\u03bf\u03c5 \u03c1\u03c5\u03bc\u03bf\u03c4\u03bf\u03bc\u03b9\u03ba\u03bf\u03cd \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u039d\u03ad\u03c9\u03bd \u039b\u03b9\u03bf\u03c3\u03af\u03c9\u03bd (\u0391\u03c4\u03c4\u03b9\u03ba\u03ae\u03c2)", 69], ["\u0388\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7: \u03b1) \u03a0\u03bf\u03bb\u03b5\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ae\u03c2 \u039c\u03b5\u03bb\u03ad\u03c4\u03b7\u03c2 \u0391\u03bd\u03b1\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03c1\u03c5\u03bc\u03bf\u03c4\u03bf\u03bc\u03b9\u03ba\u03bf\u03cd \u03a3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03c4\u03bf\u03c5 1905 \u039a\u03b1\u03bb\u03b1\u03bc\u03ac\u03c4\u03b1\u03c2 \u03c9\u03c2 \u03ba\u03b1\u03b9 \u03cc\u03c1\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c1\u03b9\u03c3\u03bc\u03ce\u03bd \u03b4\u03cc\u03bc\u03b7\u03c3\u03b7\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ad\u03c2 \u039a\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ae (VII) \u03ba\u03b1\u03b9 \u039d\u03cc\u03c4\u03b9\u03b1 (VIII) \u03c3\u03c5\u03bd\u03bf\u03b9\u03ba\u03af\u03b1. \u0391\u03bd\u03b1\u03c4\u03bf\u03bb\u03b9\u03ba\u03ae (V) \u03ba\u03b1\u03b9", 63], ["\u03a0\u03b5\u03c1\u03af \u03c4\u03c1\u03bf\u03c0\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b5\u03c9\u03c2 \u03c4\u03bf\u03c5 \u03c1\u03c5\u03bc\u03bf\u03c4\u03bf\u03bc\u03b9\u03ba\u03bf\u03cd \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u039d. \u039b\u03b9\u03bf\u03c3\u03af\u03c9\u03bd (\u0391\u03c4\u03c4\u03b9\u03ba\u03ae\u03c2)", 62], ["E\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c0\u03bf\u03bb\u03b5\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ae\u03c2 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b7\u03c2 \u03c4\u03b7\u03c2 \u0391\u03bd\u03b1\u03c4\u03bf\u03bb\u03b9\u03ba\u03ae\u03c2, \u0392\u03cc\u03c1\u03b5\u03b9\u03b1\u03c2 \u03ba\u03b1\u03b9 \u039a\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ae\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae\u03c2 \u03c4\u03bf\u03c5 \u0394\u03ae\u03bc\u03bf\u03c5 \u039a\u03b1\u03bb\u03b1\u03bc\u03ac\u03c4\u03b1\u03c2 (\u039d. \u039c\u03b5\u03c3\u03c3\u03b7\u03bd\u03af\u03b1\u03c2) \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03b5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03bf\u03c5 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03c3\u03b5 \u03c3\u03c5\u03bd\u03b5\u03c7\u03cc\u03bc\u03b5\u03bd\u03b5\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ad\u03c2 \u039a\u03bb\u03af\u03bc\u03b1\u03ba\u03b1\u03c2: - 1000", 41], ["\u0394\u03b5\u03bd \u03c0\u03b1\u03c1\u03ad\u03c7\u03b5\u03c4\u03b1\u03b9 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae", 38], ["\u03a0\u03b5\u03c1\u03af \u03b1\u03bd\u03b1\u03b8\u03b5\u03c9\u03c1\u03ae\u03c3\u03b5\u03c9\u03c2 \u03c4\u03bf\u03c5 \u03c1\u03c5\u03bc\u03bf\u03c4\u03bf\u03bc\u03b9\u03ba\u03bf\u03cd \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u039d\u03ad\u03c9\u03bd \u039b\u03b9\u03bf\u03c3\u03af\u03c9\u03bd (\u0391\u03c4\u03c4\u03b9\u03ba\u03ae\u03c2), \u03b5\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae\u03bd \u00ab\u039c\u03b9\u03c7\u03b5\u03bb\u03ae\u00bb", 34], ["\u0391\u03bd\u03b1\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03c1\u03c5\u03bc\u03bf\u03c4\u03bf\u03bc\u03b9\u03ba\u03ce\u03bd \u03c3\u03c7\u03b5\u03b4\u03af\u03c9\u03bd \u03c4\u03c9\u03bd \u03c0\u03c1\u03bf\u03c3\u03c6\u03c5\u03b3\u03b9\u03ba\u03ce\u03bd \u03bf\u03b9\u03ba\u03b9\u03c3\u03bc\u03ce\u03bd \u0391\u03b3. \u03a4\u03c1\u03b9\u03ac\u03b4\u03b1\u03c2, \u0391\u03b3. \u0399\u03c9\u03ac\u03bd\u03bd\u03b7 \u03ba\u03b1\u03b9 \u03a0\u03bb\u03b5\u03cd\u03bd\u03b1\u03c2 \u03c4\u03bf\u03c5 \u03b4\u03ae\u03bc\u03bf\u03c5 \u039a\u03b1\u03bb\u03b1\u03bc\u03ac\u03c4\u03b1\u03c2 (\u039d. \u039c\u03b5\u03c3\u03c3\u03b7\u03bd\u03af\u03b1\u03c2) \u03ba\u03b1\u03b9 \u03ad\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c0\u03bf\u03bb\u03b5\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ae\u03c2 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b7\u03c2 \u03c4\u03b7\u03c2 \u0394\u03c5\u03c4\u03b9\u03ba\u03ae\u03c2 \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03af\u03b4\u03b9\u03bf\u03c5 \u03b4\u03ae\u03bc\u03bf\u03c5", 34], ["\u0388\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c0\u03bf\u03bb\u03b5\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ae\u03c2 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b7\u03c2 \u03c4\u03bc\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03c4\u03c9\u03bd \u03c0\u03bf\u03bb\u03b5\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ce\u03bd \u03b5\u03bd\u03bf\u03c4\u03ae\u03c4\u03c9\u03bd \u0391\u03bd\u03b1\u03c4\u03bf\u03bb\u03b9\u03ba\u03ae\u03c2 \u03c0\u03b1\u03c1\u03b1\u03bb\u03af\u03b1\u03c2 (\u03a0\u0395 6), \u0393\u03b9\u03b1\u03bd\u03bd\u03b9\u03c4\u03c3\u03ac\u03bd\u03b9\u03ba\u03b1 (\u03a6\u03b1\u03c1\u03b1\u03af) (\u03a0\u0395 4) \u03ba\u03b1\u03b9 \u03a3\u03c4\u03c1\u03b1\u03c4\u03ce\u03bd\u03c9\u03bd (II\u0395 3) (\u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ae \u03a0\u03b1\u03bd\u03b1\u03b3\u03af\u03c4\u03c3\u03b1\u03c2) \u03c4\u03bf\u03c5 \u03b4\u03ae\u03bc\u03bf\u03c5 \u039a\u03b1\u03bb\u03b1\u03bc\u03ac\u03c4\u03b1\u03c2 (\u039d. \u039c\u03b5\u03c3\u03c3\u03b7\u03bd\u03af\u03b1\u03c2) \u03ba", 34], ["\u0388\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c0o\u03bb\u03b5o\u03b4o\u03bc\u03b9\u03ba\u03ae\u03c2 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03bf\u03b9\u03ba\u03b9\u03c3\u03bc\u03bf\u03cd \u03a0\u03b1\u03c1\u03b1\u03bb\u03af\u03b1\u03c2 \u0392\u03ad\u03c1\u03b3\u03b1\u03c2 \u03c4\u03bf\u03c5 \u0394\u03ae\u03bc\u03bf\u03c5 \u039a\u03b1\u03bb\u03b1\u03bc\u03ac\u03c4\u03b1\u03c2 \u039d. \u039c\u03b5\u03c3\u03c3\u03b7\u03bd\u03af\u03b1\u03c2 \u039a\u03bb\u03af\u03bc\u03b1\u03ba\u03b1\u03c2: - 1000", 32], ["\u2018E\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c0\u03bf\u03bb\u03b5\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ae\u03c2 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b7\u03c2 \u03c4\u03c9\u03bd \u03c0\u03bf\u03bb\u03b5\u03bf\u03b4\u03bf\u03bc\u03b9\u03ba\u03ce\u03bd \u03b5\u03bd\u03bf\u03c4\u03ae\u03c4\u03c9\u03bd \u00ab\u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac 3\u00bb \u03ba\u03b1\u03b9 \u00ab\u0393\u03b5\u03b9\u03c4\u03bf\u03bd\u03b9\u03ac 4\u00bb \u03c4\u03bf\u03c5 \u0394\u03ae\u03bc\u03bf\u03c5 \u039a\u03b1\u03bc\u03b1\u03c4\u03b5\u03c1\u03bf\u03cd (\u0391\u03c4\u03c4\u03b9\u03ba\u03ae\u03c2) \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03c3\u03c7\u03b5\u03b4\u03af\u03bf\u03c5 \u03c3\u03b5 \u03c3\u03c5\u03b