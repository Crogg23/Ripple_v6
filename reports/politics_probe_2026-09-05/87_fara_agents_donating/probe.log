{"label": "sf_shape", "rows": 1, "secs": 0.2, "sql": "select count(*) n, count(distinct registration_number) regs, count(distinct short_form_name) sfn, count(distinct short_form_last_name||'|'||short_form_first_name) lf, min(short_form_date) mn, max(short_form_date) mx, sum(iff(short_form_termination_date='',1,0)) open_ from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='Short-Form'"}
{"label": "sf_sample", "rows": 5, "secs": 0.2, "sql": "select short_form_name, short_form_last_name, short_form_first_name, short_form_date, short_form_termination_date, registrant_name, registration_number from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='Short-Form' limit 5"}
{"label": "fp_shape", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct registration_number) regs, count(distinct foreign_principal_country) countries from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='Exhibit AB'"}
{"label": "agent_keys", "rows": 1, "secs": 0.3, "sql": "with a as (\nselect regexp_replace(upper(trim(split_part(s.short_form_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(s.short_form_name,',',2))),'[^A-Z ]',''),' ',1) k,\n       s.registration_number, s.registrant_name, try_to_date(s.date_stamped,'MM/DD/YYYY') d0,\n       coalesce(r.term, current_date) d1\nfrom LIBRARY_RAW.LANDING.FED_FARA_BULK s\nleft join (select registration_number, max(try_to_date(termination_date,'MM/DD/YYYY')) term from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='' group by 1) r using (registration_number)\nwhere s.document_type='Short-Form' and s.short_form_name like '%,%'\n) select count(*) n, count(distinct k) keys, count(distinct registration_number) regs, sum(iff(d0 is null,1,0)) null_d0 from a"}
{"label": "hit_total", "rows": 1, "secs": 0.3, "sql": "with h as (\nwith a as (\nselect regexp_replace(upper(trim(split_part(s.short_form_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(s.short_form_name,',',2))),'[^A-Z ]',''),' ',1) k,\n       s.registration_number, s.registrant_name, try_to_date(s.date_stamped,'MM/DD/YYYY') d0,\n       coalesce(r.term, current_date) d1\nfrom LIBRARY_RAW.LANDING.FED_FARA_BULK s\nleft join (select registration_number, max(try_to_date(termination_date,'MM/DD/YYYY')) term from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='' group by 1) r using (registration_number)\nwhere s.document_type='Short-Form' and s.short_form_name like '%,%'\n),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k,\n             try_to_date(transaction_dt,'MMDDYYYY') dt, transaction_amt::number amt, cmte_id, employer, city, state\n      from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%'),\nj as (select f.k, f.cmte_id, f.amt, f.employer, f.city, f.state, f.dt, a.registration_number, a.registrant_name, a.d0, a.d1,\n             iff(f.dt between a.d0 and a.d1, 1, 0) in_window\n      from f join a on f.k = a.k)\nselect k, any_value(registrant_name) registrant, count(distinct registration_number) regs, count(*) fec_rows, sum(amt) dollars,\n       sum(in_window) rows_in_window, sum(iff(in_window=1,amt,0)) dollars_in_window,\n       count(distinct employer) employers, any_value(employer) a_employer, any_value(city) a_city, any_value(state) a_state\nfrom (select *, row_number() over (partition by k, cmte_id, amt, dt, registration_number order by in_window desc) rn from j) where rn=1\ngroup by 1\n) select count(*) keys_hit, sum(fec_rows) fec_rows, sum(dollars) dollars, sum(iff(rows_in_window>0,1,0)) keys_in_window, sum(rows_in_window) rows_in_window, sum(dollars_in_window) dollars_in_window, sum(iff(fec_rows<=50,1,0)) keys_le50 from h"}
{"label": "hit_top_noisy", "rows": 8, "secs": 0.4, "sql": "with h as (\nwith a as (\nselect regexp_replace(upper(trim(split_part(s.short_form_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(s.short_form_name,',',2))),'[^A-Z ]',''),' ',1) k,\n       s.registration_number, s.registrant_name, try_to_date(s.date_stamped,'MM/DD/YYYY') d0,\n       coalesce(r.term, current_date) d1\nfrom LIBRARY_RAW.LANDING.FED_FARA_BULK s\nleft join (select registration_number, max(try_to_date(termination_date,'MM/DD/YYYY')) term from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='' group by 1) r using (registration_number)\nwhere s.document_type='Short-Form' and s.short_form_name like '%,%'\n),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k,\n             try_to_date(transaction_dt,'MMDDYYYY') dt, transaction_amt::number amt, cmte_id, employer, city, state\n      from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%'),\nj as (select f.k, f.cmte_id, f.amt, f.employer, f.city, f.state, f.dt, a.registration_number, a.registrant_name, a.d0, a.d1,\n             iff(f.dt between a.d0 and a.d1, 1, 0) in_window\n      from f join a on f.k = a.k)\nselect k, any_value(registrant_name) registrant, count(distinct registration_number) regs, count(*) fec_rows, sum(amt) dollars,\n       sum(in_window) rows_in_window, sum(iff(in_window=1,amt,0)) dollars_in_window,\n       count(distinct employer) employers, any_value(employer) a_employer, any_value(city) a_city, any_value(state) a_state\nfrom (select *, row_number() over (partition by k, cmte_id, amt, dt, registration_number order by in_window desc) rn from j) where rn=1\ngroup by 1\n) select * from h order by fec_rows desc limit 8"}
{"label": "hit_in_window", "rows": 15, "secs": 0.4, "sql": "with h as (\nwith a as (\nselect regexp_replace(upper(trim(split_part(s.short_form_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(s.short_form_name,',',2))),'[^A-Z ]',''),' ',1) k,\n       s.registration_number, s.registrant_name, try_to_date(s.date_stamped,'MM/DD/YYYY') d0,\n       coalesce(r.term, current_date) d1\nfrom LIBRARY_RAW.LANDING.FED_FARA_BULK s\nleft join (select registration_number, max(try_to_date(termination_date,'MM/DD/YYYY')) term from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='' group by 1) r using (registration_number)\nwhere s.document_type='Short-Form' and s.short_form_name like '%,%'\n),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k,\n             try_to_date(transaction_dt,'MMDDYYYY') dt, transaction_amt::number amt, cmte_id, employer, city, state\n      from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%'),\nj as (select f.k, f.cmte_id, f.amt, f.employer, f.city, f.state, f.dt, a.registration_number, a.registrant_name, a.d0, a.d1,\n             iff(f.dt between a.d0 and a.d1, 1, 0) in_window\n      from f join a on f.k = a.k)\nselect k, any_value(registrant_name) registrant, count(distinct registration_number) regs, count(*) fec_rows, sum(amt) dollars,\n       sum(in_window) rows_in_window, sum(iff(in_window=1,amt,0)) dollars_in_window,\n       count(distinct employer) employers, any_value(employer) a_employer, any_value(city) a_city, any_value(state) a_state\nfrom (select *, row_number() over (partition by k, cmte_id, amt, dt, registration_number order by in_window desc) rn from j) where rn=1\ngroup by 1\n) select * from h where rows_in_window>0 and fec_rows<=50 order by dollars_in_window desc limit 15"}
{"label": "employer_leg", "rows": 1, "secs": 0.2, "sql": "with r as (select distinct regexp_replace(upper(trim(registrant_name)),'[^A-Z0-9 ]','') rn from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='Registration Statement' and registrant_name like '% %'),\nf as (select regexp_replace(upper(trim(employer)),'[^A-Z0-9 ]','') e, transaction_amt::number amt from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND')\nselect count(distinct rn) firms_hit, count(*) fec_rows, sum(amt) dollars from f join r on f.e = r.rn"}
{"label": "confirmed_total", "rows": 1, "secs": 0.3, "sql": "with c as (\nwith a as (\nselect regexp_replace(upper(trim(split_part(s.short_form_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(s.short_form_name,',',2))),'[^A-Z ]',''),' ',1) k,\n       s.registration_number, s.registrant_name, try_to_date(s.date_stamped,'MM/DD/YYYY') d0,\n       coalesce(r.term, current_date) d1\nfrom LIBRARY_RAW.LANDING.FED_FARA_BULK s\nleft join (select registration_number, max(try_to_date(termination_date,'MM/DD/YYYY')) term from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='' group by 1) r using (registration_number)\nwhere s.document_type='Short-Form' and s.short_form_name like '%,%'\n),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k,\n             try_to_date(transaction_dt,'MMDDYYYY') dt, transaction_amt::number amt, cmte_id, employer, city, state\n      from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%' and length(employer)>=8)\nselect f.k, a.registrant_name, a.registration_number, f.employer, f.city, f.state, f.amt, f.dt, f.cmte_id\nfrom f join a on f.k=a.k and left(regexp_replace(upper(f.employer),'[^A-Z]',''),8)=left(regexp_replace(upper(a.registrant_name),'[^A-Z]',''),8) and f.dt between a.d0 and a.d1\nqualify row_number() over (partition by f.k, f.cmte_id, f.amt, f.dt order by a.registration_number)=1\n) select count(distinct k) agents, count(distinct registration_number) firms, count(*) fec_rows, sum(amt) dollars, count(distinct cmte_id) cmtes from c"}
{"label": "confirmed_top", "rows": 10, "secs": 0.3, "sql": "with c as (\nwith a as (\nselect regexp_replace(upper(trim(split_part(s.short_form_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(s.short_form_name,',',2))),'[^A-Z ]',''),' ',1) k,\n       s.registration_number, s.registrant_name, try_to_date(s.date_stamped,'MM/DD/YYYY') d0,\n       coalesce(r.term, current_date) d1\nfrom LIBRARY_RAW.LANDING.FED_FARA_BULK s\nleft join (select registration_number, max(try_to_date(termination_date,'MM/DD/YYYY')) term from LIBRARY_RAW.LANDING.FED_FARA_BULK where document_type='' group by 1) r using (registration_number)\nwhere s.document_type='Short-Form' and s.short_form_name like '%,%'\n),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k,\n             try_to_date(transaction_dt,'MMDDYYYY') dt, transaction_amt::number amt, cmte_id, employer, city, state\n      from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%' and length(employer)>=8)\nselect f.k, a.registrant_name, a.registration_number, f.employer, f.city, f.state, f.amt, f.dt, f.cmte_id\nfrom f join a on f.k=a.k and left(regexp_replace(upper(f.employer),'[^A-Z]',''),8)=left(regexp_replace(upper(a.registrant_name),'[^A-Z]',''),8) and f.dt between a.d0 and a.d1\nqualify row_number() over (partition by f.k, f.cmte_id, f.amt, f.dt order by a.registration_number)=1\n) select k, any_value(registrant_name) firm, any_value(employer) employer, any_value(city) city, count(*) n, sum(amt) dollars from c group by 1 order by 6 desc limit 10"}
