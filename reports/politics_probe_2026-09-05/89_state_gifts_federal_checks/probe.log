{"label": "cols POLITICS__TX_LOBBY_FOOD_BEVERAGE", "rows": 35, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='POLITICS' and table_name='POLITICS__TX_LOBBY_FOOD_BEVERAGE' order by ordinal_position"}
{"label": "cols POLITICS__TX_LOBBY_GIFTS", "rows": 30, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='POLITICS' and table_name='POLITICS__TX_LOBBY_GIFTS' order by ordinal_position"}
{"label": "cols POLITICS__CA_LOBBY_COVER", "rows": 19, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='POLITICS' and table_name='POLITICS__CA_LOBBY_COVER' order by ordinal_position"}
{"label": "cols FINANCE__FED_FEC_INDIV_CONTRIBUTIONS", "rows": 15, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='FINANCE' and table_name='FINANCE__FED_FEC_INDIV_CONTRIBUTIONS' order by ordinal_position"}
{"label": "tx fill", "rows": 2, "secs": 1.0, "sql": "select 'FOOD' t, count(*) n, count(distinct filername) filers, min(activitydate) d0, max(activitydate) d1, count(activityexactamount) exact_n, count(distinct activityamountcd) cds from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_FOOD_BEVERAGE\n      union all select 'GIFTS', count(*), count(distinct filername), min(periodenddt), max(periodenddt), count(activityexactamount), count(distinct activityamountcd) from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_GIFTS"}
{"label": "tx amount codes", "rows": 10, "secs": 0.7, "sql": "select activityamountcd, activityamountrangelow lo, activityamountrangehigh hi, count(*) n from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_FOOD_BEVERAGE group by 1,2,3 order by 4 desc limit 10"}
{"label": "tx sample", "rows": 5, "secs": 0.5, "sql": "select filername, recipientnamefirst, recipientnamelast, recipientpersenttypecd, activityamountcd, activitydate from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_FOOD_BEVERAGE limit 5"}
{"label": "fec tx lobbyist sample", "rows": 5, "secs": 0.5, "sql": "select donor_name, city, state, employer, occupation, transaction_amt from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where state='TX' and occupation ilike '%LOBBY%' limit 5"}
{"label": "ca cover", "rows": 1, "secs": 0.7, "sql": "select count(distinct firm_name) firms, count(*) n, min(rpt_date) d0, max(rpt_date) d1 from LIBRARY_MARTS.POLITICS.POLITICS__CA_LOBBY_COVER"}
{"label": "tx filer -> fec lobbyist donor", "rows": 1, "secs": 15.1, "sql": "with tx as (\n      select distinct upper(trim(regexp_replace(filername, '\\\\s*\\\\(.*\\\\)\\\\s*$', ''))) nm from (\n        select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_FOOD_BEVERAGE union all select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_GIFTS)\n      where filername like '%,%'),\n    fec as (\n      select donor_name, city, count(*) n, sum(transaction_amt) amt from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS\n      where state='TX' and occupation ilike '%LOBBY%' and transaction_amt>0 group by 1,2)\n    select count(distinct tx.nm) tx_filers_matched, (select count(*) from tx) tx_filers, count(distinct fec.donor_name) fec_names, sum(fec.n) gifts, sum(fec.amt) dollars\n    from tx join fec on fec.donor_name like tx.nm || '%'"}
{"label": "eye check top 8", "rows": 8, "secs": 19.2, "sql": "with tx as (\n      select distinct upper(trim(regexp_replace(filername, '\\\\s*\\\\(.*\\\\)\\\\s*$', ''))) nm from (\n        select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_FOOD_BEVERAGE union all select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_GIFTS)\n      where filername like '%,%'),\n    fec as (\n      select donor_name, city, count(*) n, sum(transaction_amt) amt from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS\n      where state='TX' and occupation ilike '%LOBBY%' and transaction_amt>0 group by 1,2)\n    select tx.nm, fec.donor_name, fec.city, fec.n, fec.amt\n    from tx join fec on fec.donor_name like tx.nm || '%'\n     order by fec.amt desc limit 8"}
{"label": "exact LAST, FIRST match, any TX donor", "rows": 1, "secs": 2.8, "sql": "with tx as (\n      select distinct upper(trim(regexp_replace(filername, '\\\\s*\\\\(.*\\\\)\\\\s*$', ''))) nm from (\n        select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_FOOD_BEVERAGE union all select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_GIFTS)\n      where filername like '%,%'),\n    fec as (select donor_name, count(*) n, sum(transaction_amt) amt from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where state='TX' and transaction_amt>0 group by 1)\n    select count(distinct tx.nm) tx_filers_matched, count(distinct fec.donor_name) fec_names, sum(fec.n) gifts, sum(fec.amt) dollars\n    from tx join fec on fec.donor_name = tx.nm"}
{"label": "eye check exact match top 8", "rows": 8, "secs": 2.5, "sql": "with tx as (\n      select distinct upper(trim(regexp_replace(filername, '\\\\s*\\\\(.*\\\\)\\\\s*$', ''))) nm from (\n        select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_FOOD_BEVERAGE union all select filername from LIBRARY_MARTS.POLITICS.POLITICS__TX_LOBBY_GIFTS)\n      where filername like '%,%'),\n    fec as (select donor_name, city, employer, occupation, count(*) n, sum(transaction_amt) amt from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where state='TX' and transaction_amt>0 group by 1,2,3,4)\n    select tx.nm, fec.city, fec.employer, fec.occupation, fec.n, fec.amt from tx join fec on fec.donor_name = tx.nm order by fec.amt desc limit 8"}
