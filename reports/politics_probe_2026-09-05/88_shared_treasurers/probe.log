{"label": "cm_landing_sample", "rows": 3, "secs": 0.3, "sql": "select c1,c2,c3,c6,c7,c8 from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES limit 3"}
{"label": "cm_keys", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct c1) cmte_ids, count(distinct c1||'|'||c3||'|'||left(c8,5)) id_tres_zip, sum(iff(regexp_like(left(c8,5),'^[0-9]{5}$'),1,0)) zip5_ok from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES"}
{"label": "t527_titles", "rows": 5, "secs": 0.8, "sql": "select entity_title, count(*) n from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' group by 1 order by 2 desc limit 5"}
{"label": "t527_keys", "rows": 1, "secs": 0.5, "sql": "select count(*) n, count(distinct ein) eins, count(distinct entity_name||'|'||left(entity_zip,5)) name_zip, sum(iff(regexp_like(left(entity_zip,5),'^[0-9]{5}$'),1,0)) zip5_ok from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%'"}
{"label": "t527_norm", "rows": 1, "secs": 0.3, "sql": "with t as (select distinct ein, org_name, entity_name, array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',-1))),'|') k, left(entity_zip,5) z, entity_city, entity_state from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' and entity_name like '% %' and regexp_like(left(entity_zip,5),'^[0-9]{5}$')) select count(*) n, count(distinct k) keys from t"}
{"label": "fec_norm", "rows": 1, "secs": 0.3, "sql": "with f as (select distinct c1 cmte_id, c2 cmte_nm, c3 tres_nm, c10 cmte_tp, c7 st, c6 city,\n  iff(c3 like '%,%', array_to_string(array_sort(array_construct(regexp_replace(upper(trim(split_part(c3,',',1))),'[^A-Z ]',''), split_part(regexp_replace(upper(trim(split_part(c3,',',2))),'[^A-Z ]',''),' ',1))),'|'), array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',-1))),'|')) k,\n  left(c8,5) z from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES where c3 like '% %' and regexp_like(left(c8,5),'^[0-9]{5}$')) select count(*) n, count(distinct k) keys, count(distinct cmte_id) cmtes from f"}
{"label": "hit_total", "rows": 1, "secs": 0.2, "sql": "with j as (with t as (select distinct ein, org_name, entity_name, array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',-1))),'|') k, left(entity_zip,5) z, entity_city, entity_state from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' and entity_name like '% %' and regexp_like(left(entity_zip,5),'^[0-9]{5}$')), f as (select distinct c1 cmte_id, c2 cmte_nm, c3 tres_nm, c10 cmte_tp, c7 st, c6 city,\n  iff(c3 like '%,%', array_to_string(array_sort(array_construct(regexp_replace(upper(trim(split_part(c3,',',1))),'[^A-Z ]',''), split_part(regexp_replace(upper(trim(split_part(c3,',',2))),'[^A-Z ]',''),' ',1))),'|'), array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',-1))),'|')) k,\n  left(c8,5) z from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES where c3 like '% %' and regexp_like(left(c8,5),'^[0-9]{5}$')) select t.k, t.z, t.entity_name n527, t.org_name org527, t.entity_state st527, f.tres_nm, f.cmte_nm, f.cmte_id, f.cmte_tp, f.st stfec from t join f on t.k=f.k and t.z=f.z) select count(*) pairs, count(distinct k||z) people, count(distinct org527) orgs527, count(distinct cmte_id) fec_cmtes from j"}
{"label": "hit_fanout", "rows": 5, "secs": 0.3, "sql": "with j as (with t as (select distinct ein, org_name, entity_name, array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',-1))),'|') k, left(entity_zip,5) z, entity_city, entity_state from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' and entity_name like '% %' and regexp_like(left(entity_zip,5),'^[0-9]{5}$')), f as (select distinct c1 cmte_id, c2 cmte_nm, c3 tres_nm, c10 cmte_tp, c7 st, c6 city,\n  iff(c3 like '%,%', array_to_string(array_sort(array_construct(regexp_replace(upper(trim(split_part(c3,',',1))),'[^A-Z ]',''), split_part(regexp_replace(upper(trim(split_part(c3,',',2))),'[^A-Z ]',''),' ',1))),'|'), array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',-1))),'|')) k,\n  left(c8,5) z from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES where c3 like '% %' and regexp_like(left(c8,5),'^[0-9]{5}$')) select t.k, t.z, t.entity_name n527, t.org_name org527, t.entity_state st527, f.tres_nm, f.cmte_nm, f.cmte_id, f.cmte_tp, f.st stfec from t join f on t.k=f.k and t.z=f.z) select k, z, count(distinct org527) n527, count(distinct cmte_id) nfec from j group by 1,2 order by 3 desc, 4 desc limit 5"}
{"label": "hit_sample", "rows": 15, "secs": 1.2, "sql": "with j as (with t as (select distinct ein, org_name, entity_name, array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',-1))),'|') k, left(entity_zip,5) z, entity_city, entity_state from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' and entity_name like '% %' and regexp_like(left(entity_zip,5),'^[0-9]{5}$')), f as (select distinct c1 cmte_id, c2 cmte_nm, c3 tres_nm, c10 cmte_tp, c7 st, c6 city,\n  iff(c3 like '%,%', array_to_string(array_sort(array_construct(regexp_replace(upper(trim(split_part(c3,',',1))),'[^A-Z ]',''), split_part(regexp_replace(upper(trim(split_part(c3,',',2))),'[^A-Z ]',''),' ',1))),'|'), array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',-1))),'|')) k,\n  left(c8,5) z from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES where c3 like '% %' and regexp_like(left(c8,5),'^[0-9]{5}$')) select t.k, t.z, t.entity_name n527, t.org_name org527, t.entity_state st527, f.tres_nm, f.cmte_nm, f.cmte_id, f.cmte_tp, f.st stfec from t join f on t.k=f.k and t.z=f.z) select * from j qualify row_number() over (partition by k,z order by cmte_id) = 1 order by random() limit 15"}
{"label": "name_only_ctrl", "rows": 1, "secs": 0.3, "sql": "with t as (select distinct ein, org_name, entity_name, array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',-1))),'|') k, left(entity_zip,5) z, entity_city, entity_state from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' and entity_name like '% %' and regexp_like(left(entity_zip,5),'^[0-9]{5}$')), f as (select distinct c1 cmte_id, c2 cmte_nm, c3 tres_nm, c10 cmte_tp, c7 st, c6 city,\n  iff(c3 like '%,%', array_to_string(array_sort(array_construct(regexp_replace(upper(trim(split_part(c3,',',1))),'[^A-Z ]',''), split_part(regexp_replace(upper(trim(split_part(c3,',',2))),'[^A-Z ]',''),' ',1))),'|'), array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',-1))),'|')) k,\n  left(c8,5) z from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES where c3 like '% %' and regexp_like(left(c8,5),'^[0-9]{5}$')) select count(distinct t.k) people_name_only from t join f on t.k=f.k"}
{"label": "bridge_vs_mirror", "rows": 1, "secs": 0.3, "sql": "with j as (with t as (select distinct ein, org_name, entity_name, array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',-1))),'|') k, left(entity_zip,5) z, entity_city, entity_state from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' and entity_name like '% %' and regexp_like(left(entity_zip,5),'^[0-9]{5}$')), f as (select distinct c1 cmte_id, c2 cmte_nm, c3 tres_nm, c10 cmte_tp, c7 st, c6 city,\n  iff(c3 like '%,%', array_to_string(array_sort(array_construct(regexp_replace(upper(trim(split_part(c3,',',1))),'[^A-Z ]',''), split_part(regexp_replace(upper(trim(split_part(c3,',',2))),'[^A-Z ]',''),' ',1))),'|'), array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',-1))),'|')) k,\n  left(c8,5) z from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES where c3 like '% %' and regexp_like(left(c8,5),'^[0-9]{5}$')) select t.k, t.z, t.entity_name n527, t.org_name org527, t.entity_state st527, f.tres_nm, f.cmte_nm, f.cmte_id, f.cmte_tp, f.st stfec from t join f on t.k=f.k and t.z=f.z), p as (select k, z, count(*) pairs, sum(iff(regexp_replace(upper(org527),'[^A-Z]','')=regexp_replace(upper(cmte_nm),'[^A-Z]','') or regexp_replace(upper(cmte_nm),'[^A-Z]','') like '%'||left(regexp_replace(upper(org527),'[^A-Z]',''),12)||'%' or regexp_replace(upper(org527),'[^A-Z]','') like '%'||left(regexp_replace(upper(cmte_nm),'[^A-Z]',''),12)||'%',0,1)) diff_pairs, count(distinct org527) n527 from j group by 1,2)\nselect count(*) people, sum(iff(diff_pairs>0,1,0)) people_bridging, sum(iff(diff_pairs>0 and n527<=5,1,0)) bridging_not_pro, sum(iff(n527>20,1,0)) pro_treasurers from p"}
{"label": "bridge_sample", "rows": 8, "secs": 1.9, "sql": "with j as (with t as (select distinct ein, org_name, entity_name, array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(entity_name)),'[^A-Z ]',''),' ',-1))),'|') k, left(entity_zip,5) z, entity_city, entity_state from LIBRARY_MARTS.POLITICS.POLITICS__IRS527_DIRECTORS_OFFICERS where entity_title ilike '%treas%' and entity_name like '% %' and regexp_like(left(entity_zip,5),'^[0-9]{5}$')), f as (select distinct c1 cmte_id, c2 cmte_nm, c3 tres_nm, c10 cmte_tp, c7 st, c6 city,\n  iff(c3 like '%,%', array_to_string(array_sort(array_construct(regexp_replace(upper(trim(split_part(c3,',',1))),'[^A-Z ]',''), split_part(regexp_replace(upper(trim(split_part(c3,',',2))),'[^A-Z ]',''),' ',1))),'|'), array_to_string(array_sort(array_construct(split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',1), split_part(regexp_replace(upper(trim(c3)),'[^A-Z ]',''),' ',-1))),'|')) k,\n  left(c8,5) z from LIBRARY_RAW.LANDING.FED_FEC_COMMITTEES where c3 like '% %' and regexp_like(left(c8,5),'^[0-9]{5}$')) select t.k, t.z, t.entity_name n527, t.org_name org527, t.entity_state st527, f.tres_nm, f.cmte_nm, f.cmte_id, f.cmte_tp, f.st stfec from t join f on t.k=f.k and t.z=f.z) select k, z, n527, org527, tres_nm, cmte_nm, cmte_tp from j where regexp_replace(upper(org527),'[^A-Z]','')<>regexp_replace(upper(cmte_nm),'[^A-Z]','') and regexp_replace(upper(cmte_nm),'[^A-Z]','') not like '%'||left(regexp_replace(upper(org527),'[^A-Z]',''),12)||'%' and regexp_replace(upper(org527),'[^A-Z]','') not like '%'||left(regexp_replace(upper(cmte_nm),'[^A-Z]',''),12)||'%'\nqualify count(distinct org527) over (partition by k,z) <= 5 order by random() limit 8"}
