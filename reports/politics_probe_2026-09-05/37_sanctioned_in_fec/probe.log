{"label": "sanc_keys", "rows": 3, "secs": 0.3, "sql": "with s as (\nselect * from (\n  select 'OFAC' src, program list, regexp_replace(upper(trim(split_part(sdn_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(sdn_name,',',2))),'[^A-Z ]',''),' ',1) k from LIBRARY_RAW.LANDING.FED_OFAC_SDN where sdn_type='individual' and sdn_name like '%,%'\n  union all\n  select 'UK', regime_name, regexp_replace(upper(trim(name_6)),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(name_1)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UK_SANCTIONS_LIST where coalesce(type_of_entity,'')='' and coalesce(name_1,'')<>'' and coalesce(name_6,'')<>''\n  union all\n  select 'UN', un_list_type, regexp_replace(upper(trim(coalesce(nullif(fourth_name,''),nullif(third_name,''),second_name))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(first_name)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UN_CONSOLIDATED_SANCTIONS where record_type='INDIVIDUAL' and coalesce(second_name,'')<>''\n) s0 where split_part(k,'|',1)<>'' and split_part(k,'|',2)<>''\n) select src, count(*) rows_, count(distinct k) keys from s group by 1"}
{"label": "sanc_sample", "rows": 5, "secs": 0.3, "sql": "with s as (\nselect * from (\n  select 'OFAC' src, program list, regexp_replace(upper(trim(split_part(sdn_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(sdn_name,',',2))),'[^A-Z ]',''),' ',1) k from LIBRARY_RAW.LANDING.FED_OFAC_SDN where sdn_type='individual' and sdn_name like '%,%'\n  union all\n  select 'UK', regime_name, regexp_replace(upper(trim(name_6)),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(name_1)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UK_SANCTIONS_LIST where coalesce(type_of_entity,'')='' and coalesce(name_1,'')<>'' and coalesce(name_6,'')<>''\n  union all\n  select 'UN', un_list_type, regexp_replace(upper(trim(coalesce(nullif(fourth_name,''),nullif(third_name,''),second_name))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(first_name)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UN_CONSOLIDATED_SANCTIONS where record_type='INDIVIDUAL' and coalesce(second_name,'')<>''\n) s0 where split_part(k,'|',1)<>'' and split_part(k,'|',2)<>''\n) select * from s limit 5"}
{"label": "hit_total", "rows": 1, "secs": 8.7, "sql": "with h as (\nwith s as (\nselect * from (\n  select 'OFAC' src, program list, regexp_replace(upper(trim(split_part(sdn_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(sdn_name,',',2))),'[^A-Z ]',''),' ',1) k from LIBRARY_RAW.LANDING.FED_OFAC_SDN where sdn_type='individual' and sdn_name like '%,%'\n  union all\n  select 'UK', regime_name, regexp_replace(upper(trim(name_6)),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(name_1)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UK_SANCTIONS_LIST where coalesce(type_of_entity,'')='' and coalesce(name_1,'')<>'' and coalesce(name_6,'')<>''\n  union all\n  select 'UN', un_list_type, regexp_replace(upper(trim(coalesce(nullif(fourth_name,''),nullif(third_name,''),second_name))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(first_name)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UN_CONSOLIDATED_SANCTIONS where record_type='INDIVIDUAL' and coalesce(second_name,'')<>''\n) s0 where split_part(k,'|',1)<>'' and split_part(k,'|',2)<>''\n), sk as (select k, min(src) src, listagg(distinct src,'+') srcs, any_value(list) list from s group by 1),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k, transaction_amt::number amt, state, employer, city from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%')\nselect sk.k, sk.srcs, sk.list, count(*) fec_rows, sum(amt) dollars, count(distinct f.state) states, count(distinct f.employer) employers, any_value(f.city) a_city, any_value(f.state) a_state, any_value(f.employer) a_employer\nfrom f join sk on f.k = sk.k group by 1,2,3\n) select count(*) keys_hit, sum(fec_rows) fec_rows, sum(dollars) dollars, sum(iff(fec_rows<=20,1,0)) keys_le20_rows, sum(iff(fec_rows<=20,fec_rows,0)) rows_le20 from h"}
{"label": "hit_top_noisy", "rows": 10, "secs": 7.7, "sql": "with h as (\nwith s as (\nselect * from (\n  select 'OFAC' src, program list, regexp_replace(upper(trim(split_part(sdn_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(sdn_name,',',2))),'[^A-Z ]',''),' ',1) k from LIBRARY_RAW.LANDING.FED_OFAC_SDN where sdn_type='individual' and sdn_name like '%,%'\n  union all\n  select 'UK', regime_name, regexp_replace(upper(trim(name_6)),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(name_1)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UK_SANCTIONS_LIST where coalesce(type_of_entity,'')='' and coalesce(name_1,'')<>'' and coalesce(name_6,'')<>''\n  union all\n  select 'UN', un_list_type, regexp_replace(upper(trim(coalesce(nullif(fourth_name,''),nullif(third_name,''),second_name))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(first_name)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UN_CONSOLIDATED_SANCTIONS where record_type='INDIVIDUAL' and coalesce(second_name,'')<>''\n) s0 where split_part(k,'|',1)<>'' and split_part(k,'|',2)<>''\n), sk as (select k, min(src) src, listagg(distinct src,'+') srcs, any_value(list) list from s group by 1),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k, transaction_amt::number amt, state, employer, city from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%')\nselect sk.k, sk.srcs, sk.list, count(*) fec_rows, sum(amt) dollars, count(distinct f.state) states, count(distinct f.employer) employers, any_value(f.city) a_city, any_value(f.state) a_state, any_value(f.employer) a_employer\nfrom f join sk on f.k = sk.k group by 1,2,3\n) select * from h order by fec_rows desc limit 10"}
{"label": "hit_rare", "rows": 15, "secs": 12.1, "sql": "with h as (\nwith s as (\nselect * from (\n  select 'OFAC' src, program list, regexp_replace(upper(trim(split_part(sdn_name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(sdn_name,',',2))),'[^A-Z ]',''),' ',1) k from LIBRARY_RAW.LANDING.FED_OFAC_SDN where sdn_type='individual' and sdn_name like '%,%'\n  union all\n  select 'UK', regime_name, regexp_replace(upper(trim(name_6)),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(name_1)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UK_SANCTIONS_LIST where coalesce(type_of_entity,'')='' and coalesce(name_1,'')<>'' and coalesce(name_6,'')<>''\n  union all\n  select 'UN', un_list_type, regexp_replace(upper(trim(coalesce(nullif(fourth_name,''),nullif(third_name,''),second_name))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(first_name)),'[^A-Z ]',''),' ',1)\n    from LIBRARY_RAW.LANDING.INTL_UN_CONSOLIDATED_SANCTIONS where record_type='INDIVIDUAL' and coalesce(second_name,'')<>''\n) s0 where split_part(k,'|',1)<>'' and split_part(k,'|',2)<>''\n), sk as (select k, min(src) src, listagg(distinct src,'+') srcs, any_value(list) list from s group by 1),\nf as (select regexp_replace(upper(trim(split_part(name,',',1))),'[^A-Z ]','') || '|' || split_part(regexp_replace(upper(trim(split_part(name,',',2))),'[^A-Z ]',''),' ',1) k, transaction_amt::number amt, state, employer, city from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS where entity_tp='IND' and name like '%,%')\nselect sk.k, sk.srcs, sk.list, count(*) fec_rows, sum(amt) dollars, count(distinct f.state) states, count(distinct f.employer) employers, any_value(f.city) a_city, any_value(f.state) a_state, any_value(f.employer) a_employer\nfrom f join sk on f.k = sk.k group by 1,2,3\n) select * from h where fec_rows<=20 order by fec_rows desc, dollars desc limit 15"}
