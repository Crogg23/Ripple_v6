{"label": "cols FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE", "rows": 23, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='FINANCE' and table_name='FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE' order by ordinal_position"}
{"label": "olms fill", "rows": 1, "secs": 0.8, "sql": "select count(*) n, count(shortage_amount) sh_nonnull, sum(iff(shortage_amount>0,1,0)) sh_pos, sum(iff(shortage_amount>0,shortage_amount,0)) sh_dollars,\n      min(year_covered) y0, max(year_covered) y1, count(distinct file_number) files, count(distinct union_name) unions\n      from LIBRARY_MARTS.LABOR.LABOR__FED_DOL_OLMS"}
{"label": "pac_funds values", "rows": 4, "secs": 0.9, "sql": "select pac_funds, count(*) n from LIBRARY_MARTS.LABOR.LABOR__FED_DOL_OLMS group by 1 order by 2 desc"}
{"label": "shortage sample", "rows": 5, "secs": 0.5, "sql": "select union_name, affiliation_abbr, unit_name, designation_name, year_covered, shortage_amount, pac_funds, total_receipts from LIBRARY_MARTS.LABOR.LABOR__FED_DOL_OLMS where shortage_amount>0 order by shortage_amount desc limit 5"}
{"label": "fec labor connected orgs", "rows": 8, "secs": 1.2, "sql": "select connected_org_nm, count(*) n, count(distinct cmte_id) cmtes from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where org_tp='L' group by 1 order by 2 desc limit 8"}
{"label": "olms fill", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(shortage_amount) sh_nonnull, sum(iff(shortage_amount>0,1,0)) sh_pos, sum(iff(shortage_amount>0,shortage_amount,0)) sh_dollars,\n      min(year_covered) y0, max(year_covered) y1, count(distinct file_number) files, count(distinct union_name) unions\n      from LIBRARY_MARTS.LABOR.LABOR__FED_DOL_OLMS"}
{"label": "pac_funds values", "rows": 4, "secs": 0.6, "sql": "select pac_funds, count(*) n from LIBRARY_MARTS.LABOR.LABOR__FED_DOL_OLMS group by 1 order by 2 desc"}
{"label": "shortage sample", "rows": 5, "secs": 0.3, "sql": "select union_name, affiliation_abbr, unit_name, designation_name, year_covered, shortage_amount, pac_funds, total_receipts from LIBRARY_MARTS.LABOR.LABOR__FED_DOL_OLMS where shortage_amount>0 order by shortage_amount desc limit 5"}
{"label": "fec labor connected orgs", "rows": 8, "secs": 0.3, "sql": "select connected_org_nm, count(*) n, count(distinct cmte_id) cmtes from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where org_tp='L' group by 1 order by 2 desc limit 8"}
{"label": "shortage rows junk check", "rows": 1, "secs": 0.5, "sql": "select count(*) n, sum(iff(regexp_like(union_name,'^[0-9]+$'),1,0)) numeric_name, sum(iff(year_covered is null,1,0)) null_year,\n      sum(iff(shortage_amount between 1990 and 2030,1,0)) looks_like_year, sum(iff(total_receipts is null,1,0)) null_receipts\n      from LIBRARY_MARTS.LABOR.LABOR__FED_DOL_OLMS where shortage_amount>0"}
{"label": "landing shortage col", "rows": 1, "secs": 22.2, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_DOL_OLMS' and column_name ilike '%SHORT%'"}
{"label": "landing shortage fill", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(nullif(trim(SHORTAGE),'')) sh, sum(iff(try_to_number(SHORTAGE)>0,1,0)) pos from LIBRARY_RAW.LANDING.FED_DOL_OLMS"}
