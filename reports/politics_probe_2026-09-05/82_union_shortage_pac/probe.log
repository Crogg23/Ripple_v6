{"label": "cols LABOR__FED_DOL_OLMS", "rows": 61, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='LABOR' and table_name='LABOR__FED_DOL_OLMS' order by ordinal_position"}
