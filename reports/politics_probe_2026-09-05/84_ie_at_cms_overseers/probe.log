{"label": "84_ie_counts", "rows": 2, "secs": 1.2, "sql": "select 'landing' src, count(*) n, count(distinct file_num||'|'||tran_id) tran_keys, min(fec_election_yr) y0, max(fec_election_yr) y1, count(distinct cycle_file) cycle_files from LIBRARY_RAW.LANDING.FED_FEC_INDEPENDENT_EXPENDITURES\nunion all select 'mart', count(*), count(distinct file_num||'|'||tran_id), min(fec_election_yr), max(fec_election_yr), null from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES"}
{"label": "84_ie_by_year", "rows": 4, "secs": 0.5, "sql": "select fec_election_yr, count(*) n, sum(try_to_number(exp_amo,14,2)) usd from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES group by 1 order by 1"}
{"label": "84_ie_sample", "rows": 5, "secs": 0.3, "sql": "select cand_id, cand_name, spe_id, spe_nam, sup_opp, exp_amo, exp_date, amndt_ind, file_num, prev_file_num, tran_id from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES limit 5"}
{"label": "84_cmte_codes", "rows": 23, "secs": 0.3, "sql": "select committee_code, committee_name, is_subcommittee, count(*) members, count(distinct bioguide) d_bioguide\nfrom LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP where committee_name ilike '%energy and commerce%' or committee_name ilike '%ways and means%' or committee_name ilike '%finance%'\ngroup by 1,2,3 order by 1"}
{"label": "84_leg_sets", "rows": 1, "secs": 0.4, "sql": "select legislator_set, count(*) n, count(distinct bioguide) d, count_if(nullif(fec_ids,'') is not null) with_fec, any_value(fec_ids) sample_ids from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_LEGISLATORS group by 1"}
{"label": "84_roster", "rows": 3, "secs": 0.9, "sql": "with mem as (select distinct bioguide, committee_name from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP\n  where is_subcommittee in ('false','False','0','') and (committee_code in ('HSIF','HSWM','SSFI')\n     or committee_name in ('House Committee on Energy and Commerce','House Committee on Ways and Means','Senate Committee on Finance'))),\nleg as (select distinct bioguide, name_official_full, party, state, trim(f.value::string) fec_id\n  from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_LEGISLATORS, lateral split_to_table(regexp_replace(fec_ids,'[\\\\[\\\\]\"'' ]',''), ',') f where nullif(fec_ids,'') is not null),\nroster as (select m.committee_name, l.* from mem m join leg l using (bioguide) where l.fec_id <> '')\nselect committee_name, count(distinct bioguide) members, count(distinct fec_id) fec_ids from roster group by 1"}
{"label": "84_ie_by_cmte", "rows": 8, "secs": 1.5, "sql": "with mem as (select distinct bioguide, committee_name from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP\n  where is_subcommittee in ('false','False','0','') and (committee_code in ('HSIF','HSWM','SSFI')\n     or committee_name in ('House Committee on Energy and Commerce','House Committee on Ways and Means','Senate Committee on Finance'))),\nleg as (select distinct bioguide, name_official_full, party, state, trim(f.value::string) fec_id\n  from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_LEGISLATORS, lateral split_to_table(regexp_replace(fec_ids,'[\\\\[\\\\]\"'' ]',''), ',') f where nullif(fec_ids,'') is not null),\nroster as (select m.committee_name, l.* from mem m join leg l using (bioguide) where l.fec_id <> '')\n,\nie as (select * from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where file_num not in (select prev_file_num from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where prev_file_num is not null))\n\nselect r.committee_name, ie.sup_opp, count(*) n, count(distinct r.bioguide) members_hit, round(sum(try_to_number(ie.exp_amo,14,2))) usd\nfrom ie join roster r on ie.cand_id = r.fec_id group by 1,2 order by 1,2"}
{"label": "84_ie_roster_by_year", "rows": 11, "secs": 0.7, "sql": "with mem as (select distinct bioguide, committee_name from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP\n  where is_subcommittee in ('false','False','0','') and (committee_code in ('HSIF','HSWM','SSFI')\n     or committee_name in ('House Committee on Energy and Commerce','House Committee on Ways and Means','Senate Committee on Finance'))),\nleg as (select distinct bioguide, name_official_full, party, state, trim(f.value::string) fec_id\n  from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_LEGISLATORS, lateral split_to_table(regexp_replace(fec_ids,'[\\\\[\\\\]\"'' ]',''), ',') f where nullif(fec_ids,'') is not null),\nroster as (select m.committee_name, l.* from mem m join leg l using (bioguide) where l.fec_id <> '')\n,\nie as (select * from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where file_num not in (select prev_file_num from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where prev_file_num is not null))\n\nselect ie.fec_election_yr, ie.sup_opp, round(sum(try_to_number(ie.exp_amo,14,2))) usd, count(distinct r.bioguide) members\nfrom ie join roster r on ie.cand_id = r.fec_id group by 1,2 order by 1,2"}
{"label": "84_top_spenders", "rows": 10, "secs": 2.3, "sql": "with mem as (select distinct bioguide, committee_name from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP\n  where is_subcommittee in ('false','False','0','') and (committee_code in ('HSIF','HSWM','SSFI')\n     or committee_name in ('House Committee on Energy and Commerce','House Committee on Ways and Means','Senate Committee on Finance'))),\nleg as (select distinct bioguide, name_official_full, party, state, trim(f.value::string) fec_id\n  from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_LEGISLATORS, lateral split_to_table(regexp_replace(fec_ids,'[\\\\[\\\\]\"'' ]',''), ',') f where nullif(fec_ids,'') is not null),\nroster as (select m.committee_name, l.* from mem m join leg l using (bioguide) where l.fec_id <> '')\n,\nie as (select * from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where file_num not in (select prev_file_num from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where prev_file_num is not null))\n\nselect ie.spe_id, any_value(ie.spe_nam) spender, any_value(d.cmte_tp) tp, any_value(d.connected_org_nm) org, any_value(d.is_ambiguous) amb,\n  round(sum(iff(ie.sup_opp='S',try_to_number(ie.exp_amo,14,2),0))) usd_for, round(sum(iff(ie.sup_opp='O',try_to_number(ie.exp_amo,14,2),0))) usd_against,\n  count(distinct r.bioguide) members\nfrom ie join roster r on ie.cand_id = r.fec_id\nleft join (select cmte_id, any_value(cmte_tp) cmte_tp, any_value(connected_org_nm) connected_org_nm, max(is_ambiguous::int)::boolean is_ambiguous from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM group by 1) d on d.cmte_id = ie.spe_id\ngroup by 1 order by usd_for+usd_against desc limit 10"}
{"label": "84_top_targets", "rows": 10, "secs": 0.6, "sql": "with mem as (select distinct bioguide, committee_name from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP\n  where is_subcommittee in ('false','False','0','') and (committee_code in ('HSIF','HSWM','SSFI')\n     or committee_name in ('House Committee on Energy and Commerce','House Committee on Ways and Means','Senate Committee on Finance'))),\nleg as (select distinct bioguide, name_official_full, party, state, trim(f.value::string) fec_id\n  from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_LEGISLATORS, lateral split_to_table(regexp_replace(fec_ids,'[\\\\[\\\\]\"'' ]',''), ',') f where nullif(fec_ids,'') is not null),\nroster as (select m.committee_name, l.* from mem m join leg l using (bioguide) where l.fec_id <> '')\n,\nie as (select * from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where file_num not in (select prev_file_num from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDEPENDENT_EXPENDITURES where prev_file_num is not null))\n\nselect r.name_official_full, r.party, r.state, r.committee_name, round(sum(iff(ie.sup_opp='S',try_to_number(ie.exp_amo,14,2),0))) usd_for, round(sum(iff(ie.sup_opp='O',try_to_number(ie.exp_amo,14,2),0))) usd_against\nfrom ie join roster r on ie.cand_id = r.fec_id group by 1,2,3,4 order by usd_for+usd_against desc limit 10"}
