{"label": "tables", "rows": 37, "secs": 1.6, "sql": "select table_schema, table_name, row_count\nfrom LIBRARY_RAW.information_schema.tables\nwhere table_name like 'FED_COURTLISTENER%' or table_name like 'FED_FJC%'\n   or table_name = 'FED_SEC_EDGAR_COMPANY_TICKERS' or table_name like 'FED_FEC_INDIV%'\norder by 2,1"}
{"label": "tables", "rows": 37, "secs": 1.6, "sql": "select table_schema, table_name, row_count\nfrom LIBRARY_RAW.information_schema.tables\nwhere table_name like 'FED_COURTLISTENER%' or table_name like 'FED_FJC%'\n   or table_name = 'FED_SEC_EDGAR_COMPANY_TICKERS' or table_name like 'FED_FEC_INDIV%'\norder by 2,1"}
{"label": "tables", "rows": 37, "secs": 2.1, "sql": "select table_schema, table_name, row_count\nfrom LIBRARY_RAW.information_schema.tables\nwhere table_name like 'FED_COURTLISTENER%' or table_name like 'FED_FJC%'\n   or table_name = 'FED_SEC_EDGAR_COMPANY_TICKERS' or table_name like 'FED_FEC_INDIV%'\norder by 2,1"}
{"label": "linked_cols", "rows": 42, "secs": 1.0, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_COURTLISTENER_FJC_IDB_CL_LINKED' order by ordinal_position"}
{"label": "linked_sample", "rows": 3, "secs": 0.9, "sql": "select * from LIBRARY_RAW.LANDING.FED_COURTLISTENER_FJC_IDB_CL_LINKED limit 3"}
{"label": "inv_counts", "rows": 1, "secs": 0.8, "sql": "select count(*) n, count(distinct FINANCIAL_DISCLOSURE_ID) fds, count_if(REDACTED='True' or REDACTED='t' or REDACTED='true') redacted,\n  count_if(nullif(trim(DESCRIPTION),'') is not null) has_desc from LIBRARY_RAW.LANDING.FED_COURTLISTENER_INVESTMENTS"}
{"label": "inv_sample", "rows": 20, "secs": 0.5, "sql": "select DESCRIPTION, GROSS_VALUE_CODE, TRANSACTION_DURING_REPORTING_PERIOD, REDACTED from LIBRARY_RAW.LANDING.FED_COURTLISTENER_INVESTMENTS sample (20 rows)"}
{"label": "fd_counts", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(distinct ID) ids, count(distinct PERSON_ID) persons, min(YEAR) y0, max(YEAR) y1, count(distinct YEAR) yrs from LIBRARY_RAW.LANDING.FED_COURTLISTENER_FINANCIAL_DISCLOSURES"}
{"label": "fd_years", "rows": 2451, "secs": 0.3, "sql": "select YEAR, count(*) n from LIBRARY_RAW.LANDING.FED_COURTLISTENER_FINANCIAL_DISCLOSURES group by 1 order by 1"}
{"label": "dockets_counts", "rows": 1, "secs": 1.9, "sql": "select count(*) n, count_if(nullif(ASSIGNED_TO_ID,'') is not null) assigned, count(distinct nullif(ASSIGNED_TO_ID,'')) judges,\n  count_if(nullif(IDB_DATA_ID,'') is not null) has_idb, min(nullif(DATE_FILED,'')) d0, max(nullif(DATE_FILED,'')) d1 from LIBRARY_RAW.LANDING.FED_COURTLISTENER_DOCKETS"}
{"label": "tickers", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(distinct TITLE) titles, count(distinct CIK_STR) ciks from LIBRARY_RAW.LANDING.FED_SEC_EDGAR_COMPANY_TICKERS"}
{"label": "tickers_sample", "rows": 8, "secs": 0.4, "sql": "select TITLE, TICKER from LIBRARY_RAW.LANDING.FED_SEC_EDGAR_COMPANY_TICKERS sample (8 rows)"}
{"label": "idb_judge_codes", "rows": 5, "secs": 0.7, "sql": "select DISTRICT, FILEJUDG, count(*) n from LIBRARY_RAW.LANDING.FED_FJC_IDB_CIVIL group by 1,2 order by 3 desc limit 5"}
{"label": "fd_year_check", "rows": 1, "secs": 0.4, "sql": "select count(*) n, count_if(try_to_number(YEAR) between 1990 and 2030) good_year, count(distinct PERSON_ID) persons\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_FINANCIAL_DISCLOSURES"}
{"label": "edgar_keys", "rows": 1, "secs": 0.5, "sql": "with k as (select regexp_substr(regexp_replace(trim(regexp_replace(regexp_replace(upper(TITLE), '[^A-Z0-9 ]', ' '), '\\\\b(INC|INCORPORATED|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LLC|PLC|LP|HOLDINGS|HOLDING|GROUP|ADR|ADS|COM|COMMON|STOCK|STK|SHARES|SHS|NEW|CL|CLASS|A|B|C|THE|DE|NV|SA|AG|NA|N|TRUST|FUND|ETF|INDEX|MUTUAL|BOND|BONDS|NOTE|NOTES|PFD|PREFERRED|ORD|ORDINARY|USA|US)\\\\b', ' ')), ' +', ' '), '^[A-Z0-9]+ [A-Z0-9]+') k, TITLE from LIBRARY_RAW.LANDING.FED_SEC_EDGAR_COMPANY_TICKERS)\nselect count(*) n, count_if(k is not null) keyed, count(distinct k) keys,\n  (select count(*) from (select k from k where k is not null group by k having count(distinct TITLE) > 1)) ambiguous_keys\nfrom k"}
{"label": "inv_keys", "rows": 1, "secs": 0.7, "sql": "with inv as (select distinct upper(DESCRIPTION) d from LIBRARY_RAW.LANDING.FED_COURTLISTENER_INVESTMENTS where nullif(trim(DESCRIPTION),'') is not null)\nselect count(*) distinct_desc, count_if(regexp_substr(regexp_replace(trim(regexp_replace(regexp_replace(upper(d), '[^A-Z0-9 ]', ' '), '\\\\b(INC|INCORPORATED|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LLC|PLC|LP|HOLDINGS|HOLDING|GROUP|ADR|ADS|COM|COMMON|STOCK|STK|SHARES|SHS|NEW|CL|CLASS|A|B|C|THE|DE|NV|SA|AG|NA|N|TRUST|FUND|ETF|INDEX|MUTUAL|BOND|BONDS|NOTE|NOTES|PFD|PREFERRED|ORD|ORDINARY|USA|US)\\\\b', ' ')), ' +', ' '), '^[A-Z0-9]+ [A-Z0-9]+') is not null) keyed from inv"}
{"label": "pairs", "rows": 1, "secs": 3.4, "sql": "with \nedgar as (\n  select k, min(TITLE) title from (select regexp_substr(regexp_replace(trim(regexp_replace(regexp_replace(upper(TITLE), '[^A-Z0-9 ]', ' '), '\\\\b(INC|INCORPORATED|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LLC|PLC|LP|HOLDINGS|HOLDING|GROUP|ADR|ADS|COM|COMMON|STOCK|STK|SHARES|SHS|NEW|CL|CLASS|A|B|C|THE|DE|NV|SA|AG|NA|N|TRUST|FUND|ETF|INDEX|MUTUAL|BOND|BONDS|NOTE|NOTES|PFD|PREFERRED|ORD|ORDINARY|USA|US)\\\\b', ' ')), ' +', ' '), '^[A-Z0-9]+ [A-Z0-9]+') k, TITLE from LIBRARY_RAW.LANDING.FED_SEC_EDGAR_COMPANY_TICKERS) where k is not null\n  group by k having count(distinct TITLE) = 1 and split_part(k,' ',1) not in ('UNITED','FIRST','AMERICAN','NATIONAL','GENERAL','BANK','STATE','NORTH','SOUTH','EAST','WEST','NEW','GLOBAL','INTERNATIONAL','UNIVERSAL','CAPITAL','FEDERAL','ROYAL','PACIFIC','ATLANTIC','CENTRAL','SOUTHERN','NORTHERN','WESTERN','EASTERN','UNION','STANDARD','CONTINENTAL','CITY','HOME','LIFE','PUBLIC','SECURITY','MUTUAL','LIBERTY','FIDELITY','INDEPENDENCE','COMMUNITY','PEOPLES','CITIZENS','FARMERS','MERCHANTS','SUN','STAR','WORLD','GREAT','GOLDEN','BLUE','GREEN','RED','BLACK','WHITE','SILVER','ONE','TWO','TRI','MID','ALL','BIG','TRUE','BEST','SMART','SUPER','SIMPLY','ALPHA','OMEGA','DELTA','SIGMA','GAMMA','BETA','APEX','SUMMIT','PRIME','PREMIER','ADVANCED','APPLIED','INTEGRATED','ALLIED','ASSOCIATED','CONSOLIDATED','DIVERSIFIED','SELECT','SPECIALTY','STRATEGIC','ULTRA','MEGA','MICRO','NANO','META','NET','WEB','DIGITAL','DATA','TECH','MEDICAL','HEALTH','ENERGY','POWER','OIL','GAS','GOLD','SOLAR','WATER','AIR','LAND','SEA','REAL','ESTATE','INSURANCE','FINANCIAL','INVESTORS','INVESTMENT','EQUITY','INCOME','GROWTH','VALUE','TOTAL','CORE','MAIN','MAJOR','MODERN','NEXT','FUTURE','LEGACY','HERITAGE','PIONEER','FRONTIER','EMPIRE','KING','QUEEN','CROWN','EAGLE','LION','TIGER','BEAR','BULL','PHOENIX','TITAN','ATLAS','ORION','APOLLO','MERCURY','JUPITER','SATURN','NEPTUNE','PLUTO','MARS','VENUS','EARTH','T