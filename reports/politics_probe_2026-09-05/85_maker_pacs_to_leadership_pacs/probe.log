{"label": "85_dim_shape", "rows": 1, "secs": 0.5, "sql": "select count(*) n, count(distinct cmte_id) d_id, count_if(cycle is null) cycle_null, count_if(is_ambiguous) amb, count_if(nullif(connected_org_nm,'') is not null) with_org from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM"}
{"label": "85_lp_shape", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct fec_committee_id) d_cmte, count(distinct fec_candidate_id) d_cand, min(fec_election_yr) y0, max(fec_election_yr) y1, listagg(distinct cmte_dsgn,',') dsgn from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_LEADERSHIP_PAC"}
{"label": "85_c2c_tp", "rows": 12, "secs": 0.5, "sql": "select transaction_tp, memo_cd, count(*) n, round(sum(transaction_amt)) usd from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE group by 1,2 order by n desc limit 12"}
{"label": "85_top_payers", "rows": 15, "secs": 0.3, "sql": "select trim(regexp_replace(regexp_replace(regexp_replace(upper(applicable_manufacturer_or_applicable_gpo_making_payment_name),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) payer, count(distinct applicable_manufacturer_or_applicable_gpo_making_payment_name) spellings, round(sum(total_amount_of_payment_usdollars)) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 order by 3 desc limit 15"}
{"label": "85_match_count", "rows": 1, "secs": 19.6, "sql": "with payer as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(applicable_manufacturer_or_applicable_gpo_making_payment_name),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, round(sum(total_amount_of_payment_usdollars)) op_usd\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 having k like '% %'),\norg as (select distinct cmte_id, trim(regexp_replace(regexp_replace(regexp_replace(upper(connected_org_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, cmte_nm, cmte_tp, is_ambiguous from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where nullif(connected_org_nm,'') is not null),\nhit as (select p.k, p.op_usd, o.cmte_id, o.cmte_nm, o.cmte_tp, o.is_ambiguous from payer p join org o using (k))\nselect count(distinct k) makers, count(distinct cmte_id) pacs, count_if(is_ambiguous) amb_rows, count(*) n_rows from hit"}
{"label": "85_match_sample", "rows": 12, "secs": 20.5, "sql": "with payer as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(applicable_manufacturer_or_applicable_gpo_making_payment_name),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, round(sum(total_amount_of_payment_usdollars)) op_usd\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 having k like '% %'),\norg as (select distinct cmte_id, trim(regexp_replace(regexp_replace(regexp_replace(upper(connected_org_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, cmte_nm, cmte_tp, is_ambiguous from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where nullif(connected_org_nm,'') is not null),\nhit as (select p.k, p.op_usd, o.cmte_id, o.cmte_nm, o.cmte_tp, o.is_ambiguous from payer p join org o using (k))\nselect k, op_usd, cmte_id, cmte_nm, cmte_tp, is_ambiguous from hit qualify row_number() over (partition by k order by cmte_id)=1 order by op_usd desc limit 12"}
{"label": "85_flow_total", "rows": 1, "secs": 20.3, "sql": "with payer as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(applicable_manufacturer_or_applicable_gpo_making_payment_name),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, round(sum(total_amount_of_payment_usdollars)) op_usd\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 having k like '% %'),\norg as (select distinct cmte_id, trim(regexp_replace(regexp_replace(regexp_replace(upper(connected_org_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, cmte_nm, cmte_tp, is_ambiguous from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where nullif(connected_org_nm,'') is not null),\nhit as (select p.k, p.op_usd, o.cmte_id, o.cmte_nm, o.cmte_tp, o.is_ambiguous from payer p join org o using (k))\n,\nlp as (select distinct fec_committee_id, fec_candidate_id from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_LEADERSHIP_PAC),\nflow as (select h.k maker, h.op_usd, c.cmte_id giver, c.other_id lp_id, lp.fec_candidate_id cand, c.cycle, c.transaction_amt\n  from hit h join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE c on c.cmte_id = h.cmte_id join lp on lp.fec_committee_id = c.other_id\n  where coalesce(c.memo_cd,'') <> 'X' and c.transaction_tp in ('24K','24Z'))\nselect count(*) n, count(distinct maker) makers, count(distinct lp_id) lpacs, count(distinct cand) cands, round(sum(transaction_amt)) usd, min(cycle) c0, max(cycle) c1 from flow"}
{"label": "85_flow_cycle", "rows": 2, "secs": 22.8, "sql": "with payer as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(applicable_manufacturer_or_applicable_gpo_making_payment_name),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, round(sum(total_amount_of_payment_usdollars)) op_usd\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 having k like '% %'),\norg as (select distinct cmte_id, trim(regexp_replace(regexp_replace(regexp_replace(upper(connected_org_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, cmte_nm, cmte_tp, is_ambiguous from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where nullif(connected_org_nm,'') is not null),\nhit as (select p.k, p.op_usd, o.cmte_id, o.cmte_nm, o.cmte_tp, o.is_ambiguous from payer p join org o using (k))\n,\nlp as (select distinct fec_committee_id, fec_candidate_id from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_LEADERSHIP_PAC),\nflow as (select h.k maker, h.op_usd, c.cmte_id giver, c.other_id lp_id, lp.fec_candidate_id cand, c.cycle, c.transaction_amt\n  from hit h join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE c on c.cmte_id = h.cmte_id join lp on lp.fec_committee_id = c.other_id\n  where coalesce(c.memo_cd,'') <> 'X' and c.transaction_tp in ('24K','24Z'))\nselect cycle, count(*) n, round(sum(transaction_amt)) usd from flow group by 1 order by 1"}
{"label": "85_flow_makers", "rows": 10, "secs": 27.6, "sql": "with payer as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(applicable_manufacturer_or_applicable_gpo_making_payment_name),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, round(sum(total_amount_of_payment_usdollars)) op_usd\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 having k like '% %'),\norg as (select distinct cmte_id, trim(regexp_replace(regexp_replace(regexp_replace(upper(connected_org_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, cmte_nm, cmte_tp, is_ambiguous from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where nullif(connected_org_nm,'') is not null),\nhit as (select p.k, p.op_usd, o.cmte_id, o.cmte_nm, o.cmte_tp, o.is_ambiguous from payer p join org o using (k))\n,\nlp as (select distinct fec_committee_id, fec_candidate_id from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_LEADERSHIP_PAC),\nflow as (select h.k maker, h.op_usd, c.cmte_id giver, c.other_id lp_id, lp.fec_candidate_id cand, c.cycle, c.transaction_amt\n  from hit h join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE c on c.cmte_id = h.cmte_id join lp on lp.fec_committee_id = c.other_id\n  where coalesce(c.memo_cd,'') <> 'X' and c.transaction_tp in ('24K','24Z'))\nselect maker, op_usd, count(distinct lp_id) lpacs, round(sum(transaction_amt)) usd from flow group by 1,2 order by usd desc limit 10"}
{"label": "85_flow_cands", "rows": 10, "secs": 32.6, "sql": "with payer as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(applicable_manufacturer_or_applicable_gpo_making_payment_name),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, round(sum(total_amount_of_payment_usdollars)) op_usd\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 having k like '% %'),\norg as (select distinct cmte_id, trim(regexp_replace(regexp_replace(regexp_replace(upper(connected_org_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|INCORPORATED|LLC|L L C|CORP|CORPORATION|CO|COMPANY|LTD|LIMITED|LP|PLC|USA|US|THE)\\\\b',' '),' +',' ')) k, cmte_nm, cmte_tp, is_ambiguous from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM where nullif(connected_org_nm,'') is not null),\nhit as (select p.k, p.op_usd, o.cmte_id, o.cmte_nm, o.cmte_tp, o.is_ambiguous from payer p join org o using (k))\n,\nlp as (select distinct fec_committee_id, fec_candidate_id from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_LEADERSHIP_PAC),\nflow as (select h.k maker, h.op_usd, c.cmte_id giver, c.other_id lp_id, lp.fec_candidate_id cand, c.cycle, c.transaction_amt\n  from hit h join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE c on c.cmte_id = h.cmte_id join lp on lp.fec_committee_id = c.other_id\n  where coalesce(c.memo_cd,'') <> 'X' and c.transaction_tp in ('24K','24Z'))\nselect f.cand, any_value(l.name_official_full) who, any_value(l.party) p, any_value(l.state) st, count(distinct f.maker) makers, round(sum(f.transaction_amt)) usd\nfrom flow f left join (select distinct trim(v.value::string) fid, name_official_full, party, state from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_LEGISLATORS, lateral split_to_table(regexp_replace(fec_ids,'[\\\\[\\\\]\"'' ]',''),',') v) l on l.fid=f.cand\ngroup by 1 order by usd desc limit 10"}
