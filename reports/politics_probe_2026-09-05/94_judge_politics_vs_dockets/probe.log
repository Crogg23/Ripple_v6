{"label": "pa_party", "rows": 20, "secs": 0.7, "sql": "select POLITICAL_PARTY, SOURCE, count(*) n, count(distinct PERSON_ID) persons from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS group by 1,2 order by 3 desc"}
{"label": "pa_counts", "rows": 1, "secs": 0.5, "sql": "select count(*) n, count(distinct PERSON_ID) persons, count(distinct ID) ids from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS"}
{"label": "linked_counts", "rows": 1, "secs": 2.1, "sql": "select count(*) n, count(distinct ID) ids, count_if(nullif(DISPOSITION,'') is not null) has_disp, count(distinct DISPOSITION) disps, count(distinct NATURE_OF_SUIT) nos,\n  min(DATE_FILED) d0, max(DATE_FILED) d1 from LIBRARY_RAW.LANDING.FED_COURTLISTENER_FJC_IDB_CL_LINKED"}
{"label": "dockets_with_idb", "rows": 1, "secs": 1.0, "sql": "select count(*) n, count_if(nullif(ASSIGNED_TO_ID,'') is not null) assigned, count(distinct IDB_DATA_ID) idb_ids\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_DOCKETS where nullif(IDB_DATA_ID,'') is not null"}
{"label": "fec_cols", "rows": 24, "secs": 9.8, "sql": "select column_name, data_type from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_FEC_INDIV_CONTRIBUTIONS' order by ordinal_position"}
{"label": "party_x_judgment", "rows": 2, "secs": 2.0, "sql": "with \nparty as (\n  select PERSON_ID, POLITICAL_PARTY p from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS\n  where POLITICAL_PARTY in ('d','r') and nullif(PERSON_ID,'') is not null\n  qualify row_number() over (partition by PERSON_ID order by nullif(DATE_START,'') desc nulls last, ID desc) = 1\n),\ncases as (\n  select party.p, d.ASSIGNED_TO_ID judge, l.NATURE_OF_SUIT nos, l.JUDGMENT jd, l.DISPOSITION disp, l.PRO_SE, try_to_date(l.DATE_FILED) filed\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_DOCKETS d\n  join party on d.ASSIGNED_TO_ID = party.PERSON_ID\n  join LIBRARY_RAW.LANDING.FED_COURTLISTENER_FJC_IDB_CL_LINKED l on l.ID = d.IDB_DATA_ID\n)\n select p, count(*) cases, count(distinct judge) judges, count_if(jd in ('1','2')) decided_pl_or_def,\n  count_if(jd='1') for_plaintiff, count_if(jd='2') for_defendant, round(100.0*count_if(jd='1')/nullif(count_if(jd in ('1','2')),0),1) pct_plaintiff,\n  min(filed) d0, max(filed) d1 from cases group by 1"}
{"label": "nos_x_party", "rows": 30, "secs": 2.3, "sql": "with \nparty as (\n  select PERSON_ID, POLITICAL_PARTY p from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS\n  where POLITICAL_PARTY in ('d','r') and nullif(PERSON_ID,'') is not null\n  qualify row_number() over (partition by PERSON_ID order by nullif(DATE_START,'') desc nulls last, ID desc) = 1\n),\ncases as (\n  select party.p, d.ASSIGNED_TO_ID judge, l.NATURE_OF_SUIT nos, l.JUDGMENT jd, l.DISPOSITION disp, l.PRO_SE, try_to_date(l.DATE_FILED) filed\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_DOCKETS d\n  join party on d.ASSIGNED_TO_ID = party.PERSON_ID\n  join LIBRARY_RAW.LANDING.FED_COURTLISTENER_FJC_IDB_CL_LINKED l on l.ID = d.IDB_DATA_ID\n)\n select nos, p, count(*) cases, count_if(jd='1') for_pl, count_if(jd='2') for_def,\n  round(100.0*count_if(jd='1')/nullif(count_if(jd in ('1','2')),0),1) pct_plaintiff\n  from cases where nos in ('442','440','710','790','791','830','840','365','367','410','445','550','555','190','195') group by 1,2 order by 1,2"}
{"label": "nos442_prose", "rows": 4, "secs": 1.7, "sql": "with \nparty as (\n  select PERSON_ID, POLITICAL_PARTY p from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS\n  where POLITICAL_PARTY in ('d','r') and nullif(PERSON_ID,'') is not null\n  qualify row_number() over (partition by PERSON_ID order by nullif(DATE_START,'') desc nulls last, ID desc) = 1\n),\ncases as (\n  select party.p, d.ASSIGNED_TO_ID judge, l.NATURE_OF_SUIT nos, l.JUDGMENT jd, l.DISPOSITION disp, l.PRO_SE, try_to_date(l.DATE_FILED) filed\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_DOCKETS d\n  join party on d.ASSIGNED_TO_ID = party.PERSON_ID\n  join LIBRARY_RAW.LANDING.FED_COURTLISTENER_FJC_IDB_CL_LINKED l on l.ID = d.IDB_DATA_ID\n)\n select p, iff(PRO_SE in ('1','3'),'pro se plaintiff','represented') side, count(*) cases, count_if(jd='1') for_pl, count_if(jd='2') for_def,\n  round(100.0*count_if(jd='1')/nullif(count_if(jd in ('1','2')),0),1) pct_plaintiff from cases where nos='442' group by 1,2 order by 1,2"}
{"label": "fec_name_match", "rows": 1, "secs": 4.1, "sql": "with j as (\n  select j.ID person_id, upper(j.NAME_LAST) ln, upper(j.NAME_FIRST) fn, min(try_to_date(p.DATE_START)) first_bench, min(p.LOCATION_STATE) st\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGES j join LIBRARY_RAW.LANDING.FED_COURTLISTENER_POSITIONS p on p.PERSON_ID = j.ID and p.POSITION_TYPE like 'jud%'\n  join (select distinct PERSON_ID from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS where POLITICAL_PARTY in ('d','r')) pa on pa.PERSON_ID = j.ID\n  where length(j.NAME_LAST) >= 4 and length(j.NAME_FIRST) >= 3 group by 1,2,3\n  having first_bench is not null and st is not null\n),\nm as (\n  select j.person_id, f.NAME, f.CITY, f.STATE, f.EMPLOYER, f.OCCUPATION, try_to_date(f.TRANSACTION_DT,'MMDDYYYY') dt, try_to_number(f.TRANSACTION_AMT) amt, j.first_bench\n  from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS f join j on f.NAME = j.ln || ', ' || j.fn and f.STATE = j.st\n)\nselect count(*) rows_matched, count(distinct person_id) judges_matched, count_if(dt < first_bench) pre_bench_rows, count(distinct iff(dt < first_bench, person_id, null)) judges_pre_bench,\n  sum(iff(dt < first_bench, amt, 0)) pre_bench_dollars, count_if(upper(OCCUPATION) like '%ATTORNEY%' or upper(OCCUPATION) like '%LAWYER%') occ_lawyer,\n  count_if(upper(OCCUPATION) like '%JUDGE%') occ_judge from m"}
{"label": "fec_sample", "rows": 0, "secs": 3.4, "sql": "with j as (\n  select j.ID person_id, upper(j.NAME_LAST) ln, upper(j.NAME_FIRST) fn, min(try_to_date(p.DATE_START)) first_bench, min(p.LOCATION_STATE) st\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGES j join LIBRARY_RAW.LANDING.FED_COURTLISTENER_POSITIONS p on p.PERSON_ID = j.ID and p.POSITION_TYPE like 'jud%'\n  join (select distinct PERSON_ID from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS where POLITICAL_PARTY in ('d','r')) pa on pa.PERSON_ID = j.ID\n  where length(j.NAME_LAST) >= 4 and length(j.NAME_FIRST) >= 3 group by 1,2,3 having first_bench is not null and st is not null\n)\nselect j.person_id, f.NAME, f.CITY, f.STATE, f.EMPLOYER, f.OCCUPATION, f.TRANSACTION_DT, f.TRANSACTION_AMT, j.first_bench\nfrom LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS f join j on f.NAME = j.ln || ', ' || j.fn and f.STATE = j.st\nwhere try_to_date(f.TRANSACTION_DT,'MMDDYYYY') < j.first_bench order by random() limit 12"}
{"label": "fec_dates", "rows": 1, "secs": 2.4, "sql": "select count(*) n, min(try_to_date(TRANSACTION_DT,'MMDDYYYY')) d0, max(try_to_date(TRANSACTION_DT,'MMDDYYYY')) d1,\n  count_if(try_to_date(TRANSACTION_DT,'MMDDYYYY') is null) bad_dates, count(distinct substr(TRANSACTION_DT,5,4)) years from LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS"}
{"label": "fec_sample_any", "rows": 10, "secs": 3.0, "sql": "with j as (\n  select j.ID person_id, upper(j.NAME_LAST) ln, upper(j.NAME_FIRST) fn, min(try_to_date(p.DATE_START)) first_bench, min(p.LOCATION_STATE) st\n  from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGES j join LIBRARY_RAW.LANDING.FED_COURTLISTENER_POSITIONS p on p.PERSON_ID = j.ID and p.POSITION_TYPE like 'jud%'\n  join (select distinct PERSON_ID from LIBRARY_RAW.LANDING.FED_COURTLISTENER_JUDGE_POLITICAL_AFFILIATIONS where POLITICAL_PARTY in ('d','r')) pa on pa.PERSON_ID = j.ID\n  where length(j.NAME_LAST) >= 4 and length(j.NAME_FIRST) >= 3 group by 1,2,3 having first_bench is not null and st is not null\n)\nselect j.person_id, j.first_bench, f.NAME, f.CITY, f.STATE, f.EMPLOYER, f.OCCUPATION, f.TRANSACTION_DT, f.TRANSACTION_AMT\nfrom LIBRARY_RAW.LANDING.FED_FEC_INDIV_CONTRIBUTIONS f join j on f.NAME = j.ln || ', ' || j.fn and f.STATE = j.st order by random() limit 10"}
