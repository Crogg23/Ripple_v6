{"label": "LEIE org names: total vs multi-word", "rows": 1, "secs": 0.5, "sql": "select count(*) n, count(distinct nullif(trim(BUSINESS_NAME),'')) names,\n  count(distinct iff(length(trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')))>=10 and trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) like '% %', trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')), null)) multiword_names,\n  min(EXCLUSION_DATE) d0, max(EXCLUSION_DATE) d1\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where nullif(trim(BUSINESS_NAME),'') is not null"}
{"label": "indiv shape, SUB_ID as key, employer blanks", "rows": 1, "secs": 2.7, "sql": "select count(*) n, count(distinct SUB_ID) sub_ids, min(TRANSACTION_DATE) d0, max(TRANSACTION_DATE) d1,\n  sum(iff(nullif(trim(EMPLOYER),'') is null,1,0)) blank_employer,\n  sum(iff(ENTITY_TYPE='IND',1,0)) ind_rows, sum(iff(ENTITY_TYPE<>'IND',1,0)) non_ind_rows\n  from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS"}
{"label": "LEIE org = donor employer, per name", "rows": 40, "secs": 21.6, "sql": "with e as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) bn, min(EXCLUSION_DATE) excl, max(STATE) st, count(*) excl_rows\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where nullif(trim(BUSINESS_NAME),'') is not null group by 1\n           having length(bn)>=10 and bn like '% %'),\n     i as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) emp, STATE, CMTE_ID, DONOR_NAME, TRANSACTION_AMT, TRANSACTION_DATE, TRANSACTION_TYPE from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS\n           where nullif(trim(EMPLOYER),'') is not null)\nselect e.bn, e.st leie_st, e.excl, count(*) gifts, round(sum(i.TRANSACTION_AMT)) dollars,\n  count(distinct i.DONOR_NAME) donors, count(distinct i.CMTE_ID) committees,\n  sum(iff(i.STATE=e.st,1,0)) same_state_gifts, min(i.TRANSACTION_DATE) g0, max(i.TRANSACTION_DATE) g1\nfrom e join i on i.emp=e.bn group by 1,2,3 order by dollars desc limit 40"}
{"label": "LEIE org = org donor name", "rows": 0, "secs": 20.2, "sql": "with e as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) bn, min(EXCLUSION_DATE) excl, max(STATE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE\n           where nullif(trim(BUSINESS_NAME),'') is not null group by 1 having length(bn)>=10 and bn like '% %'),\n     i as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(DONOR_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) dn, STATE, CMTE_ID, TRANSACTION_AMT, ENTITY_TYPE from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where ENTITY_TYPE<>'IND')\nselect e.bn, e.st leie_st, e.excl, count(*) gifts, round(sum(i.TRANSACTION_AMT)) dollars, count(distinct i.CMTE_ID) committees,\n  sum(iff(i.STATE=e.st,1,0)) same_state_gifts, listagg(distinct i.ENTITY_TYPE, ',') etypes\nfrom e join i on i.dn=e.bn group by 1,2,3 order by dollars desc limit 20"}
{"label": "LEIE org = committee name / connected org", "rows": 0, "secs": 1.8, "sql": "with e as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) bn, min(EXCLUSION_DATE) excl, max(STATE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE\n           where nullif(trim(BUSINESS_NAME),'') is not null group by 1 having length(bn)>=10 and bn like '% %')\nselect e.bn, e.st leie_st, e.excl, d.CMTE_ID, d.CMTE_NM, d.CONNECTED_ORG_NM, d.CMTE_ST, d.CMTE_TP, d.IS_AMBIGUOUS\nfrom e join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on trim(regexp_replace(regexp_replace(regexp_replace(upper(d.CONNECTED_ORG_NM),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' '))=e.bn or trim(regexp_replace(regexp_replace(regexp_replace(upper(d.CMTE_NM),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' '))=e.bn\norder by 3 desc limit 20"}
{"label": "the nine DME names as employer / donor", "rows": 1, "secs": 44.9, "sql": "select nm, side, count(*) gifts, round(sum(TRANSACTION_AMT)) dollars, count(distinct DONOR_NAME) donors, count(distinct CMTE_ID) committees,\n  listagg(distinct STATE, ',') states, min(TRANSACTION_DATE) g0, max(TRANSACTION_DATE) g1\nfrom (\n  select trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) nm, 'employer' side, * from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) in ('SUNSHINE SENIOR SOLUTIONS','JL WEBB DME','ABSOLUTE MEDICAL SUPPLIES SERVICES','MAIN STREET DME','SOUTHEASTERN MEDEQUIP','EXPRESS HEALTHCARE','LIFELINE MEDICAL SUPPLY','TEMECULA MEDICAL SUPPLIES','ALMAZ MED SUPPLY')\n  union all\n  select trim(regexp_replace(regexp_replace(regexp_replace(upper(DONOR_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) nm, 'donor_name' side, * from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where trim(regexp_replace(regexp_replace(regexp_replace(upper(DONOR_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) in ('SUNSHINE SENIOR SOLUTIONS','JL WEBB DME','ABSOLUTE MEDICAL SUPPLIES SERVICES','MAIN STREET DME','SOUTHEASTERN MEDEQUIP','EXPRESS HEALTHCARE','LIFELINE MEDICAL SUPPLY','TEMECULA MEDICAL SUPPLIES','ALMAZ MED SUPPLY')\n) group by 1,2 order by dollars desc"}
{"label": "top 3 employer hits, donor by donor", "rows": 95, "secs": 21.0, "sql": "select trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) emp, DONOR_NAME, OCCUPATION, CITY, STATE, count(*) gifts, round(sum(TRANSACTION_AMT)) dollars,\n  count(distinct CMTE_ID) committees, min(TRANSACTION_DATE) g0, max(TRANSACTION_DATE) g1\nfrom LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) in ('UNITED MEDICAL','HEALTH PARTNERS','MAGNOLIA HEALTH') group by 1,2,3,4,5 order by 1, dollars desc"}
{"label": "the LEIE side of the top 3", "rows": 4, "secs": 0.5, "sql": "select trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) bn, BUSINESS_NAME, STATE, CITY, EXCLUSION_TYPE, EXCLUSION_DATE, NPI\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where trim(regexp_replace(regexp_replace(regexp_replace(upper(BUSINESS_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA)\\\\b',' '),' +',' ')) in ('UNITED MEDICAL','HEALTH PARTNERS','MAGNOLIA HEALTH') order by 1, EXCLUSION_DATE"}
