{"label": "86_wk_counts", "rows": 2, "secs": 0.9, "sql": "select 'landing' s, count(*) n, count(distinct advertiser_id) d_adv from LIBRARY_RAW.LANDING.FED_GOOGLE_POLADS_ADVERTISER_WEEKLY_SPEND union all select 'mart', count(*), count(distinct advertiser_id) from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_WEEKLY_SPEND"}
{"label": "86_wk_cycle", "rows": 1, "secs": 0.5, "sql": "select election_cycle, count(*) n, count(distinct advertiser_id) adv, round(sum(try_to_number(spend_usd,14,2))) usd, min(week_start_date) w0, max(week_start_date) w1 from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_WEEKLY_SPEND group by 1 order by 1"}
{"label": "86_stats_shape", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(distinct advertiser_id) d_adv, count_if(nullif(public_ids_list,'') is not null) with_public_ids, count_if(regions ilike '%US%') us_rows from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_STATS"}
{"label": "86_stats_sample", "rows": 5, "secs": 0.7, "sql": "select advertiser_id, advertiser_name, public_ids_list, regions, spend_usd from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_STATS where nullif(public_ids_list,'') is not null order by try_to_number(spend_usd) desc limit 5"}
{"label": "86_geo_sample", "rows": 5, "secs": 1.0, "sql": "select country, country_subdivision_primary, count(*) n from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_GEO_SPEND group by 1,2 order by n desc limit 5"}
{"label": "86_split", "rows": 4, "secs": 3.7, "sql": "with adv as (select advertiser_id, any_value(advertiser_name) nm, round(sum(try_to_number(spend_usd,14,2))) usd, min(election_cycle) c0, max(election_cycle) c1\n  from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_WEEKLY_SPEND group by 1 having usd >= 100000),\nst as (select advertiser_id, public_ids_list, regions from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_STATS qualify row_number() over (partition by advertiser_id order by try_to_number(spend_usd) desc)=1),\ndimn as (select distinct trim(regexp_replace(regexp_replace(regexp_replace(upper(cmte_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')) k from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM),\ngeo as (select advertiser_id, country_subdivision_primary st from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_GEO_SPEND where country='US' qualify row_number() over (partition by advertiser_id order by try_to_number(spend_usd,14,2) desc)=1),\ntagged as (select a.*, st.regions, st.public_ids_list, g.st top_state,\n   regexp_like(coalesce(st.public_ids_list,''),'.*C[0-9]{8}.*') has_fec_id,\n   d.k is not null name_in_dim, trim(regexp_replace(regexp_replace(regexp_replace(upper(a.nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')) nk\n  from adv a left join st using (advertiser_id) left join geo g using (advertiser_id) left join dimn d on d.k = trim(regexp_replace(regexp_replace(regexp_replace(upper(a.nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')))\nselect has_fec_id, name_in_dim, count(*) n, round(sum(usd)) usd from tagged where regions ilike '%US%' group by 1,2 order by 1,2"}
{"label": "86_top_nofec", "rows": 15, "secs": 3.7, "sql": "with adv as (select advertiser_id, any_value(advertiser_name) nm, round(sum(try_to_number(spend_usd,14,2))) usd, min(election_cycle) c0, max(election_cycle) c1\n  from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_WEEKLY_SPEND group by 1 having usd >= 100000),\nst as (select advertiser_id, public_ids_list, regions from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_STATS qualify row_number() over (partition by advertiser_id order by try_to_number(spend_usd) desc)=1),\ndimn as (select distinct trim(regexp_replace(regexp_replace(regexp_replace(upper(cmte_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')) k from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM),\ngeo as (select advertiser_id, country_subdivision_primary st from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_GEO_SPEND where country='US' qualify row_number() over (partition by advertiser_id order by try_to_number(spend_usd,14,2) desc)=1),\ntagged as (select a.*, st.regions, st.public_ids_list, g.st top_state,\n   regexp_like(coalesce(st.public_ids_list,''),'.*C[0-9]{8}.*') has_fec_id,\n   d.k is not null name_in_dim, trim(regexp_replace(regexp_replace(regexp_replace(upper(a.nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')) nk\n  from adv a left join st using (advertiser_id) left join geo g using (advertiser_id) left join dimn d on d.k = trim(regexp_replace(regexp_replace(regexp_replace(upper(a.nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')))\nselect nm, usd, c0, c1, top_state, public_ids_list from tagged where regions ilike '%US%' and not has_fec_id and not name_in_dim order by usd desc limit 15"}
{"label": "86_by_state", "rows": 12, "secs": 2.5, "sql": "with adv as (select advertiser_id, any_value(advertiser_name) nm, round(sum(try_to_number(spend_usd,14,2))) usd, min(election_cycle) c0, max(election_cycle) c1\n  from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_WEEKLY_SPEND group by 1 having usd >= 100000),\nst as (select advertiser_id, public_ids_list, regions from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_STATS qualify row_number() over (partition by advertiser_id order by try_to_number(spend_usd) desc)=1),\ndimn as (select distinct trim(regexp_replace(regexp_replace(regexp_replace(upper(cmte_nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')) k from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM),\ngeo as (select advertiser_id, country_subdivision_primary st from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_GOOGLE_POLADS_ADVERTISER_GEO_SPEND where country='US' qualify row_number() over (partition by advertiser_id order by try_to_number(spend_usd,14,2) desc)=1),\ntagged as (select a.*, st.regions, st.public_ids_list, g.st top_state,\n   regexp_like(coalesce(st.public_ids_list,''),'.*C[0-9]{8}.*') has_fec_id,\n   d.k is not null name_in_dim, trim(regexp_replace(regexp_replace(regexp_replace(upper(a.nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')) nk\n  from adv a left join st using (advertiser_id) left join geo g using (advertiser_id) left join dimn d on d.k = trim(regexp_replace(regexp_replace(regexp_replace(upper(a.nm),'[^A-Z0-9 ]',' '),'\\\\b(INC|LLC|CORP|CO|COMMITTEE|THE|FOR|OF|PAC)\\\\b',' '),' +',' ')))\nselect top_state, count(*) advertisers, round(sum(usd)) usd from tagged where regions ilike '%US%' and not has_fec_id and not name_in_dim group by 1 order by usd desc limit 12"}
{"label": "86_pac_ie", "rows": 1, "secs": 0.8, "sql": "select count(*) n, count(distinct cmte_id) d, count_if(independent_expenditures>0) with_ie, round(sum(independent_expenditures)) ie_usd from LIBRARY_MARTS.POLITICS.POLITICS__FED_FEC_PAC_SUMMARY"}
