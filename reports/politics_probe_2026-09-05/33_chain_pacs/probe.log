{"label": "chain shape: multi-word vs single-word names", "rows": 1, "secs": 0.6, "sql": "select count(*) chains, sum(homes) homes,\n  sum(iff(length(cn)>=10 and cn like '% %',1,0)) multiword, sum(iff(cn not like '% %',1,0)) single_word\n  from (select CHAIN_ID, max(CHAIN_NAME) chain_name, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CHAIN_NAME)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) cn, count(*) homes\n             from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where nullif(trim(CHAIN_ID),'') is not null group by 1)"}
{"label": "DIM shape, CMTE_ID as key, ambiguity", "rows": 1, "secs": 1.3, "sql": "select count(*) n, count(distinct CMTE_ID) cmte_ids, sum(iff(IS_AMBIGUOUS,1,0)) ambiguous,\n  sum(iff(nullif(trim(CONNECTED_ORG_NM),'') is not null,1,0)) with_connected_org,\n  sum(iff(CYCLE is null,1,0)) null_cycle from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM"}
{"label": "chain name in committee name / connected org", "rows": 15, "secs": 2.0, "sql": "with c as (select * from (select CHAIN_ID, max(CHAIN_NAME) chain_name, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CHAIN_NAME)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) cn, count(*) homes\n             from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where nullif(trim(CHAIN_ID),'') is not null group by 1) where length(cn)>=10 and cn like '% %'),\n     d as (select CMTE_ID, max(CMTE_NM) cmte_nm, max(CONNECTED_ORG_NM) conn, max(CMTE_TP) tp, max(CMTE_DSGN) dsgn, max(CMTE_ST) st,\n                  max(ORG_TP) org_tp, boolor_agg(IS_AMBIGUOUS) amb, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CMTE_NM)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) nm_n, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CONNECTED_ORG_NM)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) conn_n\n           from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM group by 1)\nselect c.CHAIN_ID, c.chain_name, c.homes, d.CMTE_ID, d.cmte_nm, d.conn, d.tp, d.dsgn, d.st, d.org_tp, d.amb,\n  iff(contains(d.conn_n, c.cn),'connected_org','cmte_name') how\nfrom c join d on contains(d.nm_n, c.cn) or contains(d.conn_n, c.cn)\norder by c.homes desc"}
{"label": "chain PAC -> candidates, memo rows out", "rows": 9, "secs": 1.2, "sql": "select CMTE_ID, count(*) gifts, round(sum(TRANSACTION_AMT)) dollars, count(distinct CAND_ID) candidates,\n  min(TRANSACTION_DT) g0, max(TRANSACTION_DT) g1, listagg(distinct CYCLE::int, ',') cycles\nfrom LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE where CMTE_ID in ('C00292094','C00513192','C00434233','C00421735','C00459008','C00421420','C00719914','C00758268','C00347955','C00414649','C00423871','C00897470','C00496919','C00242271','C00067231') and coalesce(MEMO_CD,'') <> 'X' group by 1 order by dollars desc"}
{"label": "individuals -> chain PAC", "rows": 9, "secs": 0.9, "sql": "select CMTE_ID, count(*) gifts, round(sum(TRANSACTION_AMT)) dollars, count(distinct DONOR_NAME) donors,\n  min(TRANSACTION_DATE) g0, max(TRANSACTION_DATE) g1\nfrom LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where CMTE_ID in ('C00292094','C00513192','C00434233','C00421735','C00459008','C00421420','C00719914','C00758268','C00347955','C00414649','C00423871','C00897470','C00496919','C00242271','C00067231') group by 1 order by dollars desc"}
{"label": "chain name = donor employer, with fines", "rows": 40, "secs": 8.6, "sql": "with c as (select * from (select CHAIN_ID, max(CHAIN_NAME) chain_name, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CHAIN_NAME)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) cn, count(*) homes\n             from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where nullif(trim(CHAIN_ID),'') is not null group by 1) where length(cn)>=10 and cn like '% %'),\n     f as (select p.CMS_CERTIFICATION_NUMBER_CCN ccn, sum(iff(PENALTY_TYPE='Fine', FINE_AMOUNT, 0)) fine_dollars, sum(iff(PENALTY_TYPE='Fine',1,0)) fines\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p group by 1),\n     cf as (select n.CHAIN_ID, sum(f.fine_dollars) fine_dollars, sum(f.fines) fines from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 n left join f on f.ccn=n.CMS_CERTIFICATION_NUMBER_CCN group by 1),\n     i as (select trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) emp, STATE, CMTE_ID, DONOR_NAME, TRANSACTION_AMT, TRANSACTION_DATE from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where nullif(trim(EMPLOYER),'') is not null)\nselect c.CHAIN_ID, c.chain_name, c.homes, cf.fines, round(cf.fine_dollars) fine_dollars,\n  count(*) gifts, round(sum(i.TRANSACTION_AMT)) dollars, count(distinct i.DONOR_NAME) donors, count(distinct i.CMTE_ID) committees,\n  listagg(distinct i.STATE, ',') donor_states, min(i.TRANSACTION_DATE) g0, max(i.TRANSACTION_DATE) g1\nfrom c join i on i.emp=c.cn left join cf on cf.CHAIN_ID=c.CHAIN_ID\ngroup by 1,2,3,4,5 order by dollars desc limit 40"}
{"label": "top 3 chains, donor by donor", "rows": 23, "secs": 9.7, "sql": "with c as (select * from (select CHAIN_ID, max(CHAIN_NAME) chain_name, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CHAIN_NAME)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) cn, count(*) homes\n             from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where nullif(trim(CHAIN_ID),'') is not null group by 1) where CHAIN_ID in ('225','461','372'))\nselect c.chain_name, DONOR_NAME, OCCUPATION, CITY, STATE, count(*) gifts, round(sum(TRANSACTION_AMT)) dollars, count(distinct CMTE_ID) committees\nfrom LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS i join c on trim(regexp_replace(regexp_replace(regexp_replace(upper(i.EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' '))=c.cn group by 1,2,3,4,5 qualify row_number() over (partition by c.chain_name order by dollars desc)<=8 order by 1, dollars desc"}
{"label": "where those 3 chains' homes are", "rows": 3, "secs": 0.4, "sql": "select CHAIN_ID, max(CHAIN_NAME) chain_name, listagg(distinct STATE, ',') home_states, count(*) homes\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_ID in ('225','461','372') group by 1"}
