{"label": "cols EDUCATION__FED_SENATE_LDA_FILINGS", "rows": 26, "secs": 0.9, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='EDUCATION' and table_name='EDUCATION__FED_SENATE_LDA_FILINGS' order by ordinal_position"}
{"label": "cols REGULATORY__FED_FEDERAL_REGISTER_DOCUMENTS", "rows": 38, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='REGULATORY' and table_name='REGULATORY__FED_FEDERAL_REGISTER_DOCUMENTS' order by ordinal_position"}
{"label": "lda range", "rows": 1, "secs": 0.7, "sql": "select min(filing_year) y0, max(filing_year) y1, count(*) n, count(distinct filing_uuid) uu, sum(iff(try_to_number(income)>0,1,0)) inc_pos, sum(iff(try_to_number(expenses)>0,1,0)) exp_pos from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_SENATE_LDA_FILINGS"}
{"label": "lda by year", "rows": 14, "secs": 0.4, "sql": "select filing_year, count(*) n from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_SENATE_LDA_FILINGS group by 1 order by 1"}
{"label": "lda trade groups", "rows": 15, "secs": 0.5, "sql": "select client_name, count(*) n, sum(try_to_number(income)) inc, sum(try_to_number(expenses)) exp from LIBRARY_MARTS.EDUCATION.EDUCATION__FED_SENATE_LDA_FILINGS\n      where client_name ilike '%HEALTH CARE ASSOCIATION%' or client_name ilike '%LEADINGAGE%' or client_name ilike '%HOSPICE%' or client_name ilike '%KIDNEY CARE%' or client_name ilike '%HOMECARE%' or client_name ilike 'DAVITA%' or client_name ilike 'FRESENIUS%'\n      group by 1 order by 2 desc limit 15"}
{"label": "fr cms by year", "rows": 4, "secs": 0.7, "sql": "select publication_year, count(*) n, sum(iff(comments_close_on is not null,1,0)) with_close from LIBRARY_MARTS.REGULATORY.REGULATORY__FED_FEDERAL_REGISTER_DOCUMENTS\n      where agencies ilike '%centers for medicare%' group by 1 order by 1"}
