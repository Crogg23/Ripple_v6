{"label": "the four oversight committees", "rows": 4, "secs": 0.4, "sql": "select COMMITTEE_CODE, COMMITTEE_NAME, count(*) members, count(distinct BIOGUIDE) bioguides\n  from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP where IS_SUBCOMMITTEE='False' and (COMMITTEE_NAME ilike '%Energy and Commerce%' or COMMITTEE_NAME ilike '%Ways and Means%'\n   or COMMITTEE_NAME ilike '%Committee on Finance%' or COMMITTEE_NAME ilike '%Health, Education, Labor%')\n  group by 1,2 order by 1"}
{"label": "overseers: members -> FEC id -> committees, key checks", "rows": 1, "secs": 4.0, "sql": "with c as (select distinct BIOGUIDE from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP where IS_SUBCOMMITTEE='False' and COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR')),\n     m as (select BIOGUIDE, count(*) n, count(distinct FEC_ID) fec_ids from LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID group by 1)\nselect count(*) members, sum(iff(m.BIOGUIDE is not null,1,0)) with_fec_id, max(m.n) max_rows_per_member,\n  (select count(*) from (select d.CMTE_ID, m.BIOGUIDE, m.FULL_NAME, listagg(distinct c.COMMITTEE_CODE, ',') within group (order by c.COMMITTEE_CODE) codes\n   from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CAND_ID=m.FEC_ID\n   where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR') group by 1,2,3)) cmtes_reached, (select count(distinct CMTE_ID) from (select d.CMTE_ID, m.BIOGUIDE, m.FULL_NAME, listagg(distinct c.COMMITTEE_CODE, ',') within group (order by c.COMMITTEE_CODE) codes\n   from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CAND_ID=m.FEC_ID\n   where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR') group by 1,2,3)) distinct_cmtes\nfrom c left join m on m.BIOGUIDE=c.BIOGUIDE"}
{"label": "chain employees' money by recipient bucket", "rows": 4, "secs": 22.5, "sql": "with c as (select * from (select CHAIN_ID, max(CHAIN_NAME) chain_name, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CHAIN_NAME)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) cn, count(*) homes\n             from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where nullif(trim(CHAIN_ID),'') is not null group by 1 having length(cn)>=10 and cn like '% %')),\n     i as (select CMTE_ID, trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) emp, TRANSACTION_AMT from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where nullif(trim(EMPLOYER),'') is not null),\n     g as (select i.CMTE_ID, count(*) gifts, sum(i.TRANSACTION_AMT) dollars, count(distinct c.CHAIN_ID) chains from i join c on c.cn=i.emp group by 1),\n     k as (select g.*, d.CAND_ID, d.CMTE_TP, o.BIOGUIDE from g left join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CMTE_ID=g.CMTE_ID left join (select d.CMTE_ID, m.BIOGUIDE, m.FULL_NAME, listagg(distinct c.COMMITTEE_CODE, ',') within group (order by c.COMMITTEE_CODE) codes\n   from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CAND_ID=m.FEC_ID\n   where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR') group by 1,2,3) o on o.CMTE_ID=g.CMTE_ID)\nselect case when BIOGUIDE is not null then 'overseer member' when nullif(CAND_ID,'') is not null then 'other candidate'\n            when CMTE_TP in ('Q','N','O','V','W') then 'PAC / super PAC' else 'party / other' end bucket,\n  count(*) committees, sum(gifts) gifts, round(sum(dollars)) dollars\nfrom k group by 1 order by dollars desc"}
{"label": "all individual money by the same buckets", "rows": 4, "secs": 2.4, "sql": "with g as (select CMTE_ID, count(*) gifts, sum(TRANSACTION_AMT) dollars from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS group by 1),\n     k as (select g.*, d.CAND_ID, d.CMTE_TP, o.BIOGUIDE from g left join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CMTE_ID=g.CMTE_ID left join (select d.CMTE_ID, m.BIOGUIDE, m.FULL_NAME, listagg(distinct c.COMMITTEE_CODE, ',') within group (order by c.COMMITTEE_CODE) codes\n   from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CAND_ID=m.FEC_ID\n   where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR') group by 1,2,3) o on o.CMTE_ID=g.CMTE_ID)\nselect case when BIOGUIDE is not null then 'overseer member' when nullif(CAND_ID,'') is not null then 'other candidate'\n            when CMTE_TP in ('Q','N','O','V','W') then 'PAC / super PAC' else 'party / other' end bucket,\n  count(*) committees, sum(gifts) gifts, round(sum(dollars)) dollars\nfrom k group by 1 order by dollars desc"}
{"label": "chain PACs -> overseer vs other candidates", "rows": 2, "secs": 0.8, "sql": "with x as (select CMTE_ID, CAND_ID, TRANSACTION_AMT from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE where CMTE_ID in ('C00292094','C00513192','C00434233','C00421735','C00459008','C00421420','C00347955','C00423871','C00242271','C00067231') and coalesce(MEMO_CD,'')<>'X' and nullif(CAND_ID,'') is not null),\n     o as (select distinct m.FEC_ID cand_id from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR'))\nselect iff(o.cand_id is not null,'overseer member','other candidate') bucket, count(*) gifts, round(sum(x.TRANSACTION_AMT)) dollars, count(distinct x.CAND_ID) candidates\nfrom x left join o on o.cand_id=x.CAND_ID group by 1 order by dollars desc"}
{"label": "all committee->candidate money, same split", "rows": 2, "secs": 0.5, "sql": "with x as (select CAND_ID, TRANSACTION_AMT from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE where coalesce(MEMO_CD,'')<>'X' and nullif(CAND_ID,'') is not null),\n     o as (select distinct m.FEC_ID cand_id from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR'))\nselect iff(o.cand_id is not null,'overseer member','other candidate') bucket, count(*) gifts, round(sum(x.TRANSACTION_AMT)) dollars, count(distinct x.CAND_ID) candidates\nfrom x left join o on o.cand_id=x.CAND_ID group by 1 order by dollars desc"}
{"label": "overseer members by chain-employee dollars", "rows": 15, "secs": 8.9, "sql": "with c as (select * from (select CHAIN_ID, max(CHAIN_NAME) chain_name, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CHAIN_NAME)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) cn, count(*) homes\n             from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where nullif(trim(CHAIN_ID),'') is not null group by 1 having length(cn)>=10 and cn like '% %')),\n     i as (select CMTE_ID, trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) emp, TRANSACTION_AMT from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where nullif(trim(EMPLOYER),'') is not null),\n     g as (select i.CMTE_ID, c.chain_name, count(*) gifts, sum(i.TRANSACTION_AMT) dollars from i join c on c.cn=i.emp group by 1,2),\n     p as (select x.CMTE_ID, d.CONNECTED_ORG_NM chain_name, count(*) gifts, sum(x.TRANSACTION_AMT) dollars\n           from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEE_TO_CANDIDATE x join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CMTE_ID=x.CMTE_ID join (select d.CMTE_ID, m.BIOGUIDE, m.FULL_NAME, listagg(distinct c.COMMITTEE_CODE, ',') within group (order by c.COMMITTEE_CODE) codes\n   from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CAND_ID=m.FEC_ID\n   where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR') group by 1,2,3) o on o.CMTE_ID=d.CMTE_ID  -- placeholder, replaced below\n           where 1=0 group by 1,2)\nselect o.FULL_NAME, o.codes, round(sum(g.dollars)) dollars, sum(g.gifts) gifts,\n  max_by(g.chain_name, g.dollars) top_chain, round(max(g.dollars)) top_chain_dollars\nfrom g join (select d.CMTE_ID, m.BIOGUIDE, m.FULL_NAME, listagg(distinct c.COMMITTEE_CODE, ',') within group (order by c.COMMITTEE_CODE) codes\n   from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CAND_ID=m.FEC_ID\n   where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR') group by 1,2,3) o on o.CMTE_ID=g.CMTE_ID group by 1,2 order by dollars desc limit 15"}
{"label": "top 3 members: the donors behind the money", "rows": 15, "secs": 1.8, "sql": "with c as (select * from (select CHAIN_ID, max(CHAIN_NAME) chain_name, trim(regexp_replace(regexp_replace(regexp_replace(upper(max(CHAIN_NAME)),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) cn, count(*) homes\n             from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where nullif(trim(CHAIN_ID),'') is not null group by 1 having length(cn)>=10 and cn like '% %')),\n     o as (select * from (select d.CMTE_ID, m.BIOGUIDE, m.FULL_NAME, listagg(distinct c.COMMITTEE_CODE, ',') within group (order by c.COMMITTEE_CODE) codes\n   from LIBRARY_MARTS.POLITICS.POLITICS__FED_CONGRESS_COMMITTEE_MEMBERSHIP c join LIBRARY_MARTS.POLITICS.POLITICS__MEMBER_FEC_ID m on m.BIOGUIDE=c.BIOGUIDE join LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_COMMITTEES_DIM d on d.CAND_ID=m.FEC_ID\n   where c.IS_SUBCOMMITTEE='False' and c.COMMITTEE_CODE in ('HSIF','HSWM','SSFI','SSHR') group by 1,2,3) where FULL_NAME in ('Jason Smith','Steve Daines','John Cornyn'))\nselect o.FULL_NAME, c.chain_name, i.DONOR_NAME, i.OCCUPATION, i.CITY, i.STATE, count(*) gifts, round(sum(i.TRANSACTION_AMT)) dollars,\n  min(i.TRANSACTION_DATE) g0, max(i.TRANSACTION_DATE) g1, listagg(distinct i.TRANSACTION_TYPE, ',') tx_types\nfrom LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS i join o on o.CMTE_ID=i.CMTE_ID join c on c.cn=trim(regexp_replace(regexp_replace(regexp_replace(upper(i.EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' '))\ngroup by 1,2,3,4,5,6 qualify row_number() over (partition by o.FULL_NAME order by dollars desc)<=5 order by 1, dollars desc"}
{"label": "the nine DME names, any side", "rows": 1, "secs": 16.4, "sql": "select count(*) gifts, round(sum(TRANSACTION_AMT)) dollars, count(distinct CMTE_ID) committees\n  from LIBRARY_MARTS.FINANCE.FINANCE__FED_FEC_INDIV_CONTRIBUTIONS where trim(regexp_replace(regexp_replace(regexp_replace(upper(EMPLOYER),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) in ('SUNSHINE SENIOR SOLUTIONS','JL WEBB DME','ABSOLUTE MEDICAL SUPPLIES SERVICES','MAIN STREET DME','SOUTHEASTERN MEDEQUIP','EXPRESS HEALTHCARE','LIFELINE MEDICAL SUPPLY','TEMECULA MEDICAL SUPPLIES','ALMAZ MED SUPPLY') or trim(regexp_replace(regexp_replace(regexp_replace(upper(DONOR_NAME),'[^A-Z0-9 ]',' '),'\\\\b(LLC|L L C|INC|INCORPORATED|CORP|CORPORATION|CO|LTD|PC|P C|PA|LP|LLP|PLLC|THE|DBA|GROUP|HOLDINGS)\\\\b',' '),' +',' ')) in ('SUNSHINE SENIOR SOLUTIONS','JL WEBB DME','ABSOLUTE MEDICAL SUPPLIES SERVICES','MAIN STREET DME','SOUTHEASTERN MEDEQUIP','EXPRESS HEALTHCARE','LIFELINE MEDICAL SUPPLY','TEMECULA MEDICAL SUPPLIES','ALMAZ MED SUPPLY')"}
