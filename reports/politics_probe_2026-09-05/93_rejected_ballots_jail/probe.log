{"label": "cols JUSTICE__XC_VERA_INCARCERATION_TRENDS", "rows": 167, "secs": 1.6, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='JUSTICE' and table_name='JUSTICE__XC_VERA_INCARCERATION_TRENDS' order by ordinal_position"}
{"label": "cols POLITICS__FED_MEDSL_HOUSE_RETURNS", "rows": 17, "secs": 1.4, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='POLITICS' and table_name='POLITICS__FED_MEDSL_HOUSE_RETURNS' order by ordinal_position"}
{"label": "eavs keys", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(distinct fipscode) fips, min(length(fipscode)) l0, max(length(fipscode)) l1, count(distinct state_abbr) states from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS"}
{"label": "eavs sample", "rows": 6, "secs": 0.6, "sql": "select fipscode, jurisdiction_name, state_abbr, a1a, c1a, c1b, c4a, c4b, c8a, c9a, e1a, e2a, f1a from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where state_abbr in ('GA','TX','AZ') limit 6"}
{"label": "eavs other text", "rows": 3, "secs": 0.5, "sql": "select c1g_other, c9r_other, e1e_other, c1comments from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where c9r_other is not null and c9r_other<>'' limit 3"}
{"label": "eavs vintage", "rows": 1, "secs": 0.5, "sql": "select min(_ingested_at) i0 from LIBRARY_RAW.LANDING.FED_EAC_EAVS"}
{"label": "vera range", "rows": 1, "secs": 0.6, "sql": "select max(year) y1, count(distinct county_fips) fips, count_if(year=2018) n18 from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS"}
{"label": "eavs keys", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct fipscode) fips, min(length(fipscode)) l0, max(length(fipscode)) l1, count(distinct state_abbr) states from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS"}
{"label": "eavs sample", "rows": 6, "secs": 0.2, "sql": "select fipscode, jurisdiction_name, state_abbr, a1a, c1a, c1b, c4a, c4b, c8a, c9a, e1a, e2a, f1a from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where state_abbr in ('GA','TX','AZ') limit 6"}
{"label": "eavs other text", "rows": 3, "secs": 0.3, "sql": "select c1g_other, c9r_other, e1e_other, c1comments from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where c9r_other is not null and c9r_other<>'' limit 3"}
{"label": "eavs vintage", "rows": 1, "secs": 0.3, "sql": "select min(_ingested_at) i0 from LIBRARY_RAW.LANDING.FED_EAC_EAVS"}
{"label": "vera range", "rows": 1, "secs": 0.3, "sql": "select max(year) y1, count(distinct county_fips) fips, count_if(year=2018) n18 from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS"}
{"label": "eavs c-block fill", "rows": 1, "secs": 0.9, "sql": "select count(*) n, sum(iff(try_to_number(c1b)>0 and try_to_number(c9a)>=0,1,0)) usable, sum(iff(c9a in ('-99','-88'),1,0)) sentinel, sum(iff(c9a='' or c9a is null,1,0)) blank,\n      sum(iff(try_to_number(c8a)+try_to_number(c9a)=try_to_number(c1b),1,0)) identity_holds, sum(iff(length(fipscode)<10,1,0)) short_fips\n      from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS"}
{"label": "vera last jail year", "rows": 1, "secs": 0.8, "sql": "select max(year) y from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS where total_jail_pop_rate is not null"}
{"label": "rejected share decile vs jail rate", "rows": 10, "secs": 1.2, "sql": "with e as (\n      select left(fipscode,5) cf, sum(try_to_number(c1b)) ret, sum(try_to_number(c9a)) rej\n      from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where length(fipscode)=10 and try_to_number(c1b)>0 and try_to_number(c9a)>=0 group by 1 having sum(try_to_number(c1b))>=500),\n    v as (select county_fips, total_jail_pop_rate jail, try_to_number(black_pop_15to64)/nullif(total_pop_15to64,0) black_sh\n          from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS where year=(select max(year) from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS where total_jail_pop_rate is not null) and total_jail_pop_rate is not null),\n    j as (select e.*, rej/ret rej_share, v.jail, v.black_sh, ntile(10) over (order by rej/ret) dec from e join v on v.county_fips=e.cf)\n    select dec, count(*) counties, round(median(rej_share)*100,2) rej_pct, round(median(jail),0) jail_rate_med, round(avg(jail),0) jail_rate_avg, round(median(black_sh)*100,1) black_pct\n    from j group by 1 order by 1"}
{"label": "coverage", "rows": 1, "secs": 0.9, "sql": "select (select count(distinct left(fipscode,5)) from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where length(fipscode)=10) eavs_counties,\n      (select count(*) from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS where year=2024 and total_jail_pop_rate is not null) vera_2024_with_jail,\n      (select count(*) from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS where year=2018 and total_jail_pop_rate is not null) vera_2018_with_jail"}
{"label": "short fips states", "rows": 2, "secs": 0.3, "sql": "select state_abbr, count(*) n, min(length(fipscode)) l from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where length(fipscode)<10 group by 1 order by 2 desc limit 6"}
{"label": "deciles on vera 2018", "rows": 10, "secs": 0.8, "sql": "with e as (\n      select left(fipscode,5) cf, sum(try_to_number(c1b)) ret, sum(try_to_number(c9a)) rej\n      from LIBRARY_MARTS.POLITICS.POLITICS__FED_EAC_EAVS where length(fipscode)=10 and try_to_number(c1b)>0 and try_to_number(c9a)>=0 group by 1 having sum(try_to_number(c1b))>=500),\n    v as (select county_fips, total_jail_pop_rate jail, try_to_number(black_pop_15to64)/nullif(total_pop_15to64,0) black_sh\n          from LIBRARY_MARTS.JUSTICE.JUSTICE__XC_VERA_INCARCERATION_TRENDS where year=2018 and total_jail_pop_rate is not null),\n    j as (select e.*, rej/ret rej_share, v.jail, v.black_sh, ntile(10) over (order by rej/ret) dec from e join v on v.county_fips=e.cf)\n    select dec, count(*) counties, round(median(rej_share)*100,2) rej_pct, round(median(jail),0) jail_rate_med, round(median(black_sh)*100,1) black_pct, round(corr(rej_share, jail),3) r_all\n    from j group by 1 order by 1"}
