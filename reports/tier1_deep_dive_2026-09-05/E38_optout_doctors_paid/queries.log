{"label": "cols HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS", "rows": 13, "secs": 1.2, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_OPEN_PAYMENTS", "rows": 22, "secs": 1.4, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_OPEN_PAYMENTS' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_OPEN_PAYMENTS_2023", "rows": 22, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_OPEN_PAYMENTS_2023' order by ordinal_position"}
{"label": "tables", "rows": 5, "secs": 1.0, "sql": "select table_name, row_count from LIBRARY_MARTS.information_schema.tables where table_schema='HEALTH' and (table_name like '%OPEN_PAYMENTS%' or table_name like '%OPT_OUT%')"}
{"label": "py HEALTH__FED_CMS_OPEN_PAYMENTS", "rows": 1, "secs": 1.4, "sql": "select PROGRAM_YEAR, count(*) n, count(distinct RECORD_ID) rid, count(distinct NPI) npis, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, min(DATE_OF_PAYMENT) d0, max(DATE_OF_PAYMENT) d1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 order by 1"}
{"label": "py HEALTH__FED_CMS_OPEN_PAYMENTS_2022", "rows": 1, "secs": 1.4, "sql": "select PROGRAM_YEAR, count(*) n, count(distinct RECORD_ID) rid, count(distinct NPI) npis, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, min(DATE_OF_PAYMENT) d0, max(DATE_OF_PAYMENT) d1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 group by 1 order by 1"}
{"label": "py HEALTH__FED_CMS_OPEN_PAYMENTS_2023", "rows": 1, "secs": 1.7, "sql": "select PROGRAM_YEAR, count(*) n, count(distinct RECORD_ID) rid, count(distinct NPI) npis, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, min(DATE_OF_PAYMENT) d0, max(DATE_OF_PAYMENT) d1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 group by 1 order by 1"}
{"label": "overlap main vs 2023", "rows": 1, "secs": 0.7, "sql": "select count(*) n from (select RECORD_ID from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS where PROGRAM_YEAR=2023) a join (select RECORD_ID from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023) b using(RECORD_ID)"}
{"label": "overlap main vs 2022", "rows": 1, "secs": 0.5, "sql": "select count(*) n from (select RECORD_ID from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS where PROGRAM_YEAR=2022) a join (select RECORD_ID from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022) b using(RECORD_ID)"}
{"label": "recipient types", "rows": 3, "secs": 0.9, "sql": "select COVERED_RECIPIENT_TYPE, count(*) n, count(distinct NPI) npis from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 order by 2 desc"}
{"label": "optout profile", "rows": 1, "secs": 0.7, "sql": "select count(*) n, count(distinct NPI) npis, min(OPTOUT_EFFECTIVE_DATE) e0, max(OPTOUT_EFFECTIVE_DATE) e1, min(OPTOUT_END_DATE) x0, max(OPTOUT_END_DATE) x1, min(length(NPI)) l0, max(length(NPI)) l1, count(distinct LAST_UPDATED) lu from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS"}
{"label": "optout by year", "rows": 29, "secs": 0.4, "sql": "select year(OPTOUT_EFFECTIVE_DATE) y, count(*) n, count(distinct NPI) npis from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS group by 1 order by 1"}
{"label": "optout dupes sample", "rows": 8, "secs": 0.6, "sql": "select * from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI in (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS group by 1 having count(*)>1) order by NPI limit 8"}
{"label": "optout specialties", "rows": 15, "secs": 1.0, "sql": "select SPECIALTY, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS group by 1 order by 2 desc limit 15"}
{"label": "op2023 npi hygiene", "rows": 1, "secs": 0.7, "sql": "select count(*) n, count(NPI) npi_nonnull, sum(iff(length(NPI)=10,1,0)) len10, count(distinct NPI) dist,\n    sum(iff(NPI in ('0000000000',''),1,0)) sentinel from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023"}
{"label": "cohort sizes", "rows": 1, "secs": 0.4, "sql": "select (select count(*) from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI)) all_optout, (select count(*) from (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01')) fixed_pre2023,\n    (select count(*) from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2022-01-01') fixed_pre2022"}
{"label": "first-pass rebuild: join", "rows": 1, "secs": 1.0, "sql": "select count(*) rows_, count(distinct p.NPI) npis, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) c on c.NPI = p.NPI"}
{"label": "first-pass rebuild: exists", "rows": 1, "secs": 1.1, "sql": "select count(*) rows_, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p\n    where exists (select 1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS o where o.NPI = p.NPI)"}
{"label": "first-pass naive raw-row join (dupes)", "rows": 1, "secs": 0.6, "sql": "select count(*) rows_, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS o on o.NPI = p.NPI"}
{"label": "fixed cohort PY2022", "rows": 1, "secs": 0.9, "sql": "select 2022 py, count(*) rows_, count(distinct p.NPI) paid_npis, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd,\n        median(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) med_pay, count(distinct p.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME) payers,\n        sum(iff(p.PHYSICIAN_OWNERSHIP_INDICATOR='Yes',p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS,0)) usd_ownership_flag\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI = p.NPI"}
{"label": "all recipients PY2022", "rows": 1, "secs": 0.6, "sql": "select 2022 py, count(distinct NPI) npis, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE <> 'Covered Recipient Teaching Hospital'"}
{"label": "loose cohort PY2022", "rows": 1, "secs": 0.7, "sql": "select 2022 py, count(distinct p.NPI) paid_npis, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) c on c.NPI = p.NPI"}
{"label": "fixed cohort PY2023", "rows": 1, "secs": 1.2, "sql": "select 2023 py, count(*) rows_, count(distinct p.NPI) paid_npis, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd,\n        median(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) med_pay, count(distinct p.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME) payers,\n        sum(iff(p.PHYSICIAN_OWNERSHIP_INDICATOR='Yes',p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS,0)) usd_ownership_flag\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI = p.NPI"}
{"label": "all recipients PY2023", "rows": 1, "secs": 0.9, "sql": "select 2023 py, count(distinct NPI) npis, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 where COVERED_RECIPIENT_TYPE <> 'Covered Recipient Teaching Hospital'"}
{"label": "loose cohort PY2023", "rows": 1, "secs": 0.9, "sql": "select 2023 py, count(distinct p.NPI) paid_npis, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) c on c.NPI = p.NPI"}
{"label": "fixed cohort PY2024", "rows": 1, "secs": 1.0, "sql": "select 2024 py, count(*) rows_, count(distinct p.NPI) paid_npis, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd,\n        median(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) med_pay, count(distinct p.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME) payers,\n        sum(iff(p.PHYSICIAN_OWNERSHIP_INDICATOR='Yes',p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS,0)) usd_ownership_flag\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI = p.NPI"}
{"label": "all recipients PY2024", "rows": 1, "secs": 1.6, "sql": "select 2024 py, count(distinct NPI) npis, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE <> 'Covered Recipient Teaching Hospital'"}
{"label": "loose cohort PY2024", "rows": 1, "secs": 0.7, "sql": "select 2024 py, count(distinct p.NPI) paid_npis, sum(p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) c on c.NPI = p.NPI"}
{"label": "nature by year", "rows": 45, "secs": 1.5, "sql": "select 2022 py, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature, count(*) n, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI group by 1,2 union all select 2023 py, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature, count(*) n, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI group by 1,2 union all select 2024 py, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature, count(*) n, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI group by 1,2 order by 1, 4 desc"}
{"label": "top payers pooled", "rows": 15, "secs": 1.3, "sql": "select payer, sum(usd) usd, sum(n) n, count(distinct npi) npis,\n    sum(iff(py=2022,usd,0)) usd22, sum(iff(py=2023,usd,0)) usd23, sum(iff(py=2024,usd,0)) usd24 from (select 2022 py, APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, 1 n\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select 2023 py, APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, 1 n\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select 2024 py, APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, 1 n\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI) group by 1 order by 2 desc limit 15"}
{"label": "specialty pooled", "rows": 20, "secs": 0.9, "sql": "with paid as (select 2022 py, c.NPI, c.specialty, p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select 2023 py, c.NPI, c.specialty, p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select 2024 py, c.NPI, c.specialty, p.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI)\n    select c.specialty, count(distinct c.NPI) cohort, count(distinct paid.NPI) paid_npis, sum(paid.usd) usd,\n      sum(iff(paid.py=2022,paid.usd,0)) usd22, sum(iff(paid.py=2023,paid.usd,0)) usd23, sum(iff(paid.py=2024,paid.usd,0)) usd24\n    from (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c left join paid on paid.NPI=c.NPI group by 1 order by 4 desc nulls last limit 20"}
{"label": "top recipients pooled", "rows": 25, "secs": 2.4, "sql": "select npi, min(specialty) specialty, min(st) st, sum(usd) usd, sum(n) n, count(distinct payer) payers,\n    sum(iff(nature like 'Compensation for services%',usd,0)) usd_consult, sum(iff(nature like 'Royalty%',usd,0)) usd_royalty from (select p.NPI npi, c.specialty, c.st, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, 1 n,\n    APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select p.NPI npi, c.specialty, c.st, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, 1 n,\n    APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select p.NPI npi, c.specialty, c.st, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, 1 n,\n    APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI) group by 1 order by 4 desc limit 25"}
{"label": "concentration pooled", "rows": 1, "secs": 1.5, "sql": "with x as (select npi, sum(usd) usd from (select p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI) group by 1), r as (select usd, row_number() over (order by usd desc) rk, sum(usd) over () tot from x)\n    select count(*) paid_npis, max(tot) tot, sum(iff(rk<=10,usd,0)) top10, sum(iff(rk<=100,usd,0)) top100,\n      sum(iff(usd<100,1,0)) under_100, median(usd) med_per_npi from r"}
{"label": "specialty cross-check PY2023", "rows": 12, "secs": 0.7, "sql": "select c.specialty roster, p.COVERED_RECIPIENT_SPECIALTY_1 op_spec, count(distinct p.NPI) npis, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI group by 1,2 order by 4 desc limit 12"}
{"label": "first-pass variants PY2023", "rows": 1, "secs": 0.7, "sql": "select\n  sum(iff(c.eff < '2024-01-01', usd, 0)) eff_before_2024,\n  sum(iff(c.eff <= try_to_date(p.DATE_OF_PAYMENT,'MM/DD/YYYY'), usd, 0)) eff_on_or_before_payment,\n  sum(iff(c.eff < '2023-07-01', usd, 0)) eff_before_mid2023,\n  sum(usd) any_roster\n  from (select NPI, DATE_OF_PAYMENT, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023) p join (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) c on c.NPI=p.NPI"}
{"label": "top payers normalized", "rows": 12, "secs": 1.7, "sql": "select payer, sum(usd) usd, count(*) n, count(distinct npi) npis, count(distinct raw) spellings,\n    sum(iff(py=2022,usd,0)) usd22, sum(iff(py=2023,usd,0)) usd23, sum(iff(py=2024,usd,0)) usd24,\n    sum(iff(nature like 'Royalty%',usd,0)) usd_royalty from (select 2022 py, upper(regexp_replace(APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME,'[^A-Za-z0-9 ]','')) payer,\n    APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME raw, p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select 2023 py, upper(regexp_replace(APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME,'[^A-Za-z0-9 ]','')) payer,\n    APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME raw, p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select 2024 py, upper(regexp_replace(APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME,'[^A-Za-z0-9 ]','')) payer,\n    APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME raw, p.NPI npi, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS usd, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature\n    from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI) group by 1 order by 2 desc limit 12"}
{"label": "top1 detail", "rows": 8, "secs": 0.9, "sql": "select 2022 py, APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n    count(*) n, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where NPI='1295737930' group by 1,2,3 union all select 2023 py, APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n    count(*) n, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 where NPI='1295737930' group by 1,2,3 union all select 2024 py, APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n    count(*) n, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS where NPI='1295737930' group by 1,2,3 order by 5 desc"}
{"label": "top1 roster", "rows": 1, "secs": 0.3, "sql": "select NPI, SPECIALTY, STATE_CODE, OPTOUT_EFFECTIVE_DATE, OPTOUT_END_DATE, ELIGIBLE_TO_ORDER_AND_REFER from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI='1295737930'"}
{"label": "paid persistence", "rows": 1, "secs": 1.6, "sql": "with y as (select distinct 2022 py, p.NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select distinct 2023 py, p.NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI union all select distinct 2024 py, p.NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS p join (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') c on c.NPI=p.NPI)\n    select count(distinct NPI) paid_any, sum(iff(k=3,1,0)) paid_all3, sum(iff(k=1,1,0)) paid_one from (select NPI, count(distinct py) k from y group by 1)"}
{"label": "cohort mix", "rows": 5, "secs": 0.3, "sql": "select case when specialty in ('Clinical Psychologist','Mental Health Counselor','Clinical Social Worker','Marriage And Family Therapist') then 'therapists'\n    when specialty in ('Dentist','Oral Surgery','Maxillofacial Surgery') then 'dental' when specialty='Psychiatry' then 'psychiatry'\n    when specialty in ('Orthopedic Surgery','Plastic And Reconstructive Surgery','Neurosurgery') then 'ortho/plastics/neurosurg' else 'other' end grp,\n    count(*) cohort from (select * from (select NPI, min(OPTOUT_EFFECTIVE_DATE) eff, max(OPTOUT_END_DATE) end_dt, min(SPECIALTY) specialty, min(STATE_CODE) st from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPT_OUT_AFFIDAVITS where NPI is not null and length(NPI)=10 group by NPI) where eff < '2023-01-01') group by 1 order by 2 desc"}
