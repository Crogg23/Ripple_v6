{"label": "fema_by_year_type", "rows": 14, "secs": 1.4, "sql": "select year(DECLARATION_DATE) y, INCIDENT_TYPE_CODE it, count(distinct DISASTER_NUMBER) dis, count(*) regs, count(distinct FIPS) fips\nfrom LIBRARY_MARTS.HOUSING.HOUSING__FED_FEMA_IA_HOUSING_REGISTRATIONS where DECLARATION_DATE between '2015-01-01' and '2017-12-31' group by 1,2 order by 1,2"}
{"label": "fema_firstpass_repro", "rows": 1, "secs": 0.6, "sql": "select count(distinct DISASTER_NUMBER) dis, count(*) regs, count(distinct FIPS) fips, count(distinct DAMAGED_STATE_ABBREVIATION) st,\nmin(length(FIPS)) minlen, max(length(FIPS)) maxlen, sum(iff(FIPS is null,1,0)) nullfips from LIBRARY_MARTS.HOUSING.HOUSING__FED_FEMA_IA_HOUSING_REGISTRATIONS where DECLARATION_DATE between '2015-01-01' and '2017-12-31'"}
{"label": "fema_disaster_list", "rows": 47, "secs": 1.0, "sql": "select DISASTER_NUMBER, min(DECLARATION_DATE) d, min(INCIDENT_TYPE_CODE) it, min(DAMAGED_STATE_ABBREVIATION) st, count(distinct DAMAGED_STATE_ABBREVIATION) nst, count(*) regs, count(distinct FIPS) fips\nfrom LIBRARY_MARTS.HOUSING.HOUSING__FED_FEMA_IA_HOUSING_REGISTRATIONS where DECLARATION_DATE between '2015-01-01' and '2017-12-31' group by 1 order by regs desc"}
{"label": "hmda_by_year", "rows": 3, "secs": 1.9, "sql": "select AS_OF_YEAR, count(*) n, count(distinct STATE_CODE) st, count(distinct STATE_CODE||'-'||COUNTY_CODE) cty,\nsum(iff(RATE_SPREAD is not null,1,0)) rs_nonnull, sum(iff(ACTION_TAKEN='1',1,0)) originated, sum(iff(ACTION_TAKEN='3',1,0)) denied,\nsum(iff(HOEPA_STATUS='1',1,0)) hoepa, min(length(STATE_CODE)) sl1, max(length(STATE_CODE)) sl2, min(length(COUNTY_CODE)) cl1, max(length(COUNTY_CODE)) cl2,\nsum(iff(COUNTY_CODE is null,1,0)) nullcty\nfrom LIBRARY_MARTS.HOUSING.HOUSING__FED_CFPB_HMDA_HISTORIC where AS_OF_YEAR in ('2015','2016','2017') group by 1 order by 1"}
{"label": "hmda_codes", "rows": 10, "secs": 0.7, "sql": "select HOEPA_STATUS, HOEPA_STATUS_NAME, ACTION_TAKEN, ACTION_TAKEN_NAME, count(*) n from LIBRARY_MARTS.HOUSING.HOUSING__FED_CFPB_HMDA_HISTORIC where AS_OF_YEAR='2016' group by 1,2,3,4 order by 3,1"}
{"label": "hmda_code_sample", "rows": 8, "secs": 0.6, "sql": "select STATE_CODE, STATE_ABBR, COUNTY_CODE, COUNTY_NAME, count(*) n from LIBRARY_MARTS.HOUSING.HOUSING__FED_CFPB_HMDA_HISTORIC where AS_OF_YEAR='2016' and STATE_ABBR in ('LA','TX') group by 1,2,3,4 order by n desc limit 8"}
{"label": "rate_spread_dist", "rows": 1, "secs": 0.6, "sql": "select min(RATE_SPREAD) mn, max(RATE_SPREAD) mx, approx_percentile(RATE_SPREAD,0.5) med, count(*) n, count(distinct LIEN_STATUS) ls from LIBRARY_MARTS.HOUSING.HOUSING__FED_CFPB_HMDA_HISTORIC where AS_OF_YEAR='2016' and RATE_SPREAD is not null"}
