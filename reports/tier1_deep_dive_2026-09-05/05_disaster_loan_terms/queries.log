{"label": "fema_firstpass_repro", "rows": 1, "secs": 1.4, "sql": "select count(distinct DISASTER_NUMBER) dis, count(*) regs, count(distinct FIPS) fips,\n min(length(FIPS)) minlen, max(length(FIPS)) maxlen, sum(iff(FIPS is null,1,0)) nullfips,\n count(distinct lpad(FIPS,5,'0')) fips5\n from LIBRARY_MARTS.HOUSING.HOUSING__FED_FEMA_IA_HOUSING_REGISTRATIONS where DECLARATION_DATE between '2015-01-01' and '2017-12-31'"}
{"label": "fema_county_disaster", "rows": 807, "secs": 0.8, "sql": "select lpad(FIPS,5,'0') fips5, DAMAGED_STATE_ABBREVIATION st, DISASTER_NUMBER dn,\n min(DECLARATION_DATE) decl, min(INCIDENT_TYPE_CODE) itype, count(*) regs\n from LIBRARY_MARTS.HOUSING.HOUSING__FED_FEMA_IA_HOUSING_REGISTRATIONS where DECLARATION_DATE between '2015-01-01' and '2017-12-31' and FIPS is not null\n group by 1,2,3"}
{"label": "hmda_county_year", "rows": 9656, "secs": 4.7, "sql": "select AS_OF_YEAR yr, STATE_ABBR st, lpad(STATE_CODE,2,'0')||lpad(COUNTY_CODE,3,'0') fips5,\n count(*) rows_all,\n sum(iff(ACTION_TAKEN in ('1','2','3'),1,0)) apps,\n sum(iff(ACTION_TAKEN='3',1,0)) denied,\n sum(iff(ACTION_TAKEN='1',1,0)) orig,\n sum(iff(ACTION_TAKEN='1' and RATE_SPREAD is not null,1,0)) orig_rs,\n sum(iff(ACTION_TAKEN='1' and HOEPA_STATUS='1',1,0)) orig_hoepa,\n sum(iff(ACTION_TAKEN='1' and LIEN_STATUS='1',1,0)) orig_lien1,\n sum(iff(ACTION_TAKEN='1' and LIEN_STATUS='1' and RATE_SPREAD is not null,1,0)) orig_lien1_rs,\n avg(iff(ACTION_TAKEN='1',RATE_SPREAD,null)) avg_rs\n from LIBRARY_MARTS.HOUSING.HOUSING__FED_CFPB_HMDA_HISTORIC where AS_OF_YEAR in ('2015','2016','2017') and COUNTY_CODE is not null\n group by 1,2,3"}
{"label": "hmda_year_counts", "rows": 3, "secs": 0.6, "sql": "select AS_OF_YEAR, count(*) n from LIBRARY_MARTS.HOUSING.HOUSING__FED_CFPB_HMDA_HISTORIC where AS_OF_YEAR in ('2015','2016','2017') group by 1 order by 1"}
{"label": "denial_reasons_county_year", "rows": 32574, "secs": 2.6, "sql": "select AS_OF_YEAR yr, STATE_ABBR st, lpad(STATE_CODE,2,'0')||lpad(COUNTY_CODE,3,'0') fips5,\n coalesce(DENIAL_REASON_1,'none') reason, count(*) n\n from LIBRARY_MARTS.HOUSING.HOUSING__FED_CFPB_HMDA_HISTORIC where AS_OF_YEAR in ('2015','2016','2017') and ACTION_TAKEN='3'\n and STATE_ABBR in ('AR','FL','GA','LA','MN','MO','MS','NC','SC','TN','TX','VA','WV')\n group by 1,2,3,4"}
