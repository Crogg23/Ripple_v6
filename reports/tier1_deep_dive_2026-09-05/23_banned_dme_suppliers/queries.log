{"label": "supplier file shape + money", "rows": 1, "secs": 0.5, "sql": "select count(*) n, count(distinct SUPLR_NPI) npis, sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT) paid, sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_ALOWD_AMT) allowed from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL"}
{"label": "supplier landing ingest date", "rows": 1, "secs": 0.9, "sql": "select to_varchar(min(_INGESTED_AT)) mi, to_varchar(max(_INGESTED_AT)) ma from LIBRARY_RAW.LANDING.FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL"}
{"label": "LEIE landing shape, sentinel, blanks", "rows": 1, "secs": 1.4, "sql": "select count(*) n, count(distinct NPI) npis, sum(iff(NPI='0000000000',1,0)) sentinel,\n  sum(iff(nullif(trim(NPI),'') is null,1,0)) blank_npi, sum(iff(nullif(trim(UPIN),'') is null,1,0)) blank_upin,\n  max(try_to_date(EXCLDATE, 'YYYYMMDD')) max_excl, min(INGESTED_AT) raw_ingest\n  from LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE"}
