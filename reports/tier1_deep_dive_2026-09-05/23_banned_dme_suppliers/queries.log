{"label": "name-only hit list", "rows": 30, "secs": 0.7, "sql": "with m as (select SUPLR_NPI, upper(max(SUPLR_PRVDR_LAST_NAME_ORG)) org, max(SUPLR_PRVDR_STATE_ABRVTN) st, sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT) paid from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL group by 1),\n e as (select distinct upper(regexp_replace(BUSINESS_NAME,'[^A-Z0-9 ]','')) bn, NPI, STATE, EXCLUSION_DATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where nullif(trim(BUSINESS_NAME),'') is not null)\nselect m.SUPLR_NPI, m.org, m.st, round(m.paid) paid, e.NPI leie_npi, e.STATE leie_st, e.EXCLUSION_DATE, iff(m.SUPLR_NPI=e.NPI,'npi','name only') how from m join e on regexp_replace(m.org,'[^A-Z0-9 ]','')=e.bn order by paid desc"}
{"label": "A4353 catheters per patient, excluded vs other", "rows": 2, "secs": 0.4, "sql": "select iff(SUPLR_NPI in ('1811518392','1063414571','1588302186','1689457772','1528004108','1225009665','1578139473','1063294221'),'excluded','other') grp, count(*) suppliers,\n round(median(try_to_number(TOT_SUPLR_SRVCS)/nullif(try_to_number(TOT_SUPLR_BENES),0)),1) med_per_bene,\n round(max(try_to_number(TOT_SUPLR_SRVCS)/nullif(try_to_number(TOT_SUPLR_BENES),0)),1) max_per_bene,\n round(percentile_cont(0.9) within group (order by try_to_number(TOT_SUPLR_SRVCS)/nullif(try_to_number(TOT_SUPLR_BENES),0)),1) p90_per_bene,\n round(sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT)) paid, sum(try_to_number(TOT_SUPLR_BENES)) benes\n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL where HCPCS_CD='A4353' group by 1"}
{"label": "file split excluded vs other", "rows": 2, "secs": 0.4, "sql": "with m as (select SUPLR_NPI, sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT) paid from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL group by 1)\nselect iff(SUPLR_NPI in ('1811518392','1063414571','1588302186','1689457772','1528004108','1225009665','1578139473','1063294221'),'excluded','other') grp, count(*) n, round(sum(paid)) paid, round(median(paid)) med from m group by 1"}
