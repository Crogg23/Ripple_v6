{"label": "excluded 8 by HCPCS", "rows": 26, "secs": 0.4, "sql": "select SUPLR_NPI, HCPCS_CD, HCPCS_DESC, try_to_number(TOT_SUPLR_BENES) benes, try_to_number(TOT_SUPLR_SRVCS) srvcs, round(AVG_SUPLR_MDCR_PYMT_AMT,2) avg_paid, round(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT) paid from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL where SUPLR_NPI in ('1811518392','1063414571','1588302186','1689457772','1528004108','1225009665','1578139473','1063294221') order by 1, paid desc"}
{"label": "top HCPCS nationally with excluded share", "rows": 12, "secs": 0.5, "sql": "select HCPCS_CD, max(HCPCS_DESC) d, count(distinct SUPLR_NPI) npis, round(sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT)) paid, round(sum(iff(SUPLR_NPI in ('1811518392','1063414571','1588302186','1689457772','1528004108','1225009665','1578139473','1063294221'), try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT,0))) paid_excl from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL group by 1 order by paid desc limit 12"}
{"label": "top 12 suppliers in file by paid", "rows": 12, "secs": 0.5, "sql": "with m as (select SUPLR_NPI, sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT) paid from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL group by 1)\nselect SUPLR_NPI, round(paid) paid, rank() over (order by paid desc) rk from m qualify rk<=12 order by rk"}
{"label": "name-only match as a cross-check", "rows": 1, "secs": 0.7, "sql": "with m as (select SUPLR_NPI, upper(max(SUPLR_PRVDR_LAST_NAME_ORG)) org, sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT) paid from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL group by 1),\n e as (select distinct upper(regexp_replace(BUSINESS_NAME,'[^A-Z0-9 ]','')) bn, NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where nullif(trim(BUSINESS_NAME),'') is not null)\nselect count(distinct m.SUPLR_NPI) name_hits, round(sum(m.paid)) paid, sum(iff(m.SUPLR_NPI=e.NPI,1,0)) npi_agrees from m join e on regexp_replace(m.org,'[^A-Z0-9 ]','')=e.bn"}
{"label": "LEIE exclusions by year", "rows": 9, "secs": 0.5, "sql": "select year(EXCLUSION_DATE) y, count(*) n, count(distinct nullif(NPI,'0000000000')) npis from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where EXCLUSION_DATE>='2018-01-01' group by 1 order by 1"}
