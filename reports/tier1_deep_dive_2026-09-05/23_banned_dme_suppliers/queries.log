{"label": "excluded suppliers, all", "rows": 8, "secs": 0.8, "sql": "with m as (select SUPLR_NPI, max(SUPLR_PRVDR_LAST_NAME_ORG) org, max(SUPLR_PRVDR_STATE_ABRVTN) st, max(SUPLR_PRVDR_ENT_CD) ent,\n   sum(try_to_number(TOT_SUPLR_SRVCS)*AVG_SUPLR_MDCR_PYMT_AMT) paid, sum(try_to_number(TOT_SUPLR_SRVCS)) srvcs, count(*) hcpcs_rows from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_SUPPL group by 1),\n e as (select NPI, min(EXCLUSION_DATE) first_excl, max(EXCLUSION_DATE) last_excl, count(*) excl_rows, max(EXCLUSION_TYPE) etype, max(BUSINESS_NAME) bname, max(LAST_NAME) lname, max(FIRST_NAME) fname, max(STATE) lstate\n      from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where nullif(trim(NPI),'') is not null and NPI<>'0000000000' group by 1)\nselect m.SUPLR_NPI, m.org, m.st, m.ent, round(m.paid) paid, m.srvcs, m.hcpcs_rows, e.first_excl, e.last_excl, e.excl_rows, e.etype, e.bname, e.lname, e.fname, e.lstate\nfrom m join e on m.SUPLR_NPI=e.NPI order by m.paid desc"}
