{"label": "cols HEALTH__FED_NURSINGHOME411", "rows": 71, "secs": 1.3, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_NURSINGHOME411' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES", "rows": 23, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_NURSING_HOME_PENALTIES", "rows": 14, "secs": 1.5, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NURSING_HOME_PENALTIES' order by ordinal_position"}
{"label": "bria chain rows", "rows": 2, "secs": 0.4, "sql": "select CHAIN_ID, CHAIN_NAME, count(*) homes, count(distinct CMS_CERTIFICATION_NUMBER_CCN) ccns,\n       min(length(CMS_CERTIFICATION_NUMBER_CCN)) minlen, max(length(CMS_CERTIFICATION_NUMBER_CCN)) maxlen,\n       max(PROCESSING_DATE) roster_date\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%' group by 1,2 order by 3 desc"}
{"label": "bria homes", "rows": 21, "secs": 0.3, "sql": "select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, NUMBER_OF_CERTIFIED_BEDS beds,\n       PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS chg_own, SPECIAL_FOCUS_STATUS sff, ABUSE_ICON\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%' order by 1"}
{"label": "ccn shape", "rows": 3, "secs": 0.4, "sql": "select 'nh411' t, count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) d, min(CMS_CERTIFICATION_NUMBER_CCN) lo, max(CMS_CERTIFICATION_NUMBER_CCN) hi from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411\nunion all select 'deficiencies', count(*), count(distinct CMS_CERTIFICATION_NUMBER_CCN), min(CMS_CERTIFICATION_NUMBER_CCN), max(CMS_CERTIFICATION_NUMBER_CCN) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES\nunion all select 'penalties', count(*), count(distinct CMS_CERTIFICATION_NUMBER_CCN), min(CMS_CERTIFICATION_NUMBER_CCN), max(CMS_CERTIFICATION_NUMBER_CCN) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES"}
{"label": "date ranges", "rows": 2, "secs": 0.2, "sql": "select 'deficiencies' t, min(SURVEY_DATE) lo, max(SURVEY_DATE) hi, count(*) n, count(SURVEY_DATE) dated from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES\nunion all select 'penalties', min(PENALTY_DATE), max(PENALTY_DATE), count(*), count(PENALTY_DATE) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES"}
{"label": "severity letters in file", "rows": 11, "secs": 0.4, "sql": "select SCOPE_SEVERITY_CODE, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES group by 1 order by 1"}
{"label": "penalty types", "rows": 2, "secs": 0.5, "sql": "select PENALTY_TYPE, count(*) n, count(FINE_AMOUNT) with_amt, sum(FINE_AMOUNT) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1 order by 2 desc"}
{"label": "earliest retained survey per home", "rows": 13, "secs": 0.8, "sql": "with h as (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(SURVEY_DATE) first_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES group by 1),\nb as (select CMS_CERTIFICATION_NUMBER_CCN ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%')\nselect case when b.ccn is not null then 'bria' else 'national' end grp,\n       year(first_dt) first_year, count(*) homes\nfrom h left join b using(ccn) group by 1,2 order by 1,2"}
{"label": "monthly defs by group", "rows": 72, "secs": 0.6, "sql": "with b as (select CMS_CERTIFICATION_NUMBER_CCN ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%'),\nh as (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(SURVEY_DATE) first_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES group by 1),\nm as (select dateadd(month, seq4(), '2023-01-01'::date) mo from table(generator(rowcount=>36))),\nden as (select m.mo, iff(b.ccn is not null,'bria','national') grp, count(*) homes\n        from m join h on h.first_dt < dateadd(month,1,m.mo) left join b on b.ccn=h.ccn group by 1,2),\nnum as (select date_trunc(month, SURVEY_DATE) mo, iff(b.ccn is not null,'bria','national') grp,\n               count(*) defs,\n               sum(iff(SCOPE_SEVERITY_CODE in ('G','H','I','J','K','L'),1,0)) gplus,\n               sum(iff(SCOPE_SEVERITY_CODE in ('J','K','L'),1,0)) ij,\n               sum(iff(COMPLAINT_DEFICIENCY='Y',1,0)) complaint,\n               count(distinct CMS_CERTIFICATION_NUMBER_CCN) homes_cited\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES d left join b on b.ccn=d.CMS_CERTIFICATION_NUMBER_CCN\n        where SURVEY_DATE >= '2023-01-01' and SURVEY_DATE < '2026-01-01' group by 1,2)\nselect den.mo, den.grp, den.homes, coalesce(defs,0) defs, coalesce(gplus,0) gplus, coalesce(ij,0) ij,\n       coalesce(complaint,0) complaint, coalesce(homes_cited,0) homes_cited\nfrom den left join num on num.mo=den.mo and num.grp=den.grp order by 2,1"}
{"label": "severity letters by year", "rows": 59, "secs": 0.7, "sql": "with b as (select CMS_CERTIFICATION_NUMBER_CCN ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%')\nselect year(SURVEY_DATE) yr, iff(b.ccn is not null,'bria','national') grp, SCOPE_SEVERITY_CODE sev, count(*) n\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES d left join b on b.ccn=d.CMS_CERTIFICATION_NUMBER_CCN\nwhere SURVEY_DATE >= '2023-01-01' and SURVEY_DATE < '2026-01-01' and SCOPE_SEVERITY_CODE is not null\ngroup by 1,2,3 order by 2,1,3"}
{"label": "per-home rebuild", "rows": 61, "secs": 0.5, "sql": "with b as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME nm from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%')\nselect year(SURVEY_DATE) yr, b.ccn, b.nm, count(*) defs,\n       sum(iff(SCOPE_SEVERITY_CODE >= 'G' and SCOPE_SEVERITY_CODE <= 'L',1,0)) gplus,\n       min(SURVEY_DATE) first_dt, count(distinct SURVEY_DATE) surveys\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES d join b on b.ccn=d.CMS_CERTIFICATION_NUMBER_CCN\nwhere SURVEY_DATE >= '2023-01-01' and SURVEY_DATE < '2026-01-01' group by 1,2,3 order by 2,1"}
{"label": "monthly fines by group", "rows": 72, "secs": 0.8, "sql": "with b as (select CMS_CERTIFICATION_NUMBER_CCN ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%'),\nh as (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(SURVEY_DATE) first_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES group by 1),\nm as (select dateadd(month, seq4(), '2023-01-01'::date) mo from table(generator(rowcount=>36))),\nden as (select m.mo, iff(b.ccn is not null,'bria','national') grp, count(*) homes\n        from m join h on h.first_dt < dateadd(month,1,m.mo) left join b on b.ccn=h.ccn group by 1,2),\nnum as (select date_trunc(month, PENALTY_DATE) mo, iff(b.ccn is not null,'bria','national') grp,\n               count(*) penalties, sum(iff(PENALTY_TYPE ilike 'fine%',1,0)) fines, sum(FINE_AMOUNT) usd,\n               count(distinct p.CMS_CERTIFICATION_NUMBER_CCN) homes_fined\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p left join b on b.ccn=p.CMS_CERTIFICATION_NUMBER_CCN\n        where PENALTY_DATE >= '2023-01-01' and PENALTY_DATE < '2026-01-01' group by 1,2)\nselect den.mo, den.grp, den.homes, coalesce(penalties,0) penalties, coalesce(fines,0) fines,\n       coalesce(usd,0) usd, coalesce(homes_fined,0) homes_fined\nfrom den left join num on num.mo=den.mo and num.grp=den.grp order by 2,1"}
{"label": "fines by period", "rows": 6, "secs": 0.4, "sql": "with b as (select CMS_CERTIFICATION_NUMBER_CCN ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%')\nselect iff(b.ccn is not null,'bria','national') grp,\n       case when PENALTY_DATE < '2024-01-01' then '2023 H2' else to_char(year(PENALTY_DATE)) end period,\n       count(*) penalties, sum(FINE_AMOUNT) usd, count(distinct p.CMS_CERTIFICATION_NUMBER_CCN) homes_hit\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p left join b on b.ccn=p.CMS_CERTIFICATION_NUMBER_CCN\nwhere PENALTY_DATE >= '2023-01-01' and PENALTY_DATE < '2026-01-01' group by 1,2 order by 1,2"}
{"label": "fines per Bria home per year", "rows": 44, "secs": 0.4, "sql": "with b as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME nm from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%')\nselect b.ccn, b.nm, year(PENALTY_DATE) yr, count(*) penalties, sum(FINE_AMOUNT) usd\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p join b on b.ccn=p.CMS_CERTIFICATION_NUMBER_CCN\nwhere PENALTY_DATE >= '2023-01-01' and PENALTY_DATE < '2026-01-01' group by 1,2,3 order by 1,3"}
{"label": "bria chain rows", "rows": 2, "secs": 0.2, "sql": "select CHAIN_ID, CHAIN_NAME, count(*) homes, count(distinct CMS_CERTIFICATION_NUMBER_CCN) ccns,\n       min(length(CMS_CERTIFICATION_NUMBER_CCN)) minlen, max(length(CMS_CERTIFICATION_NUMBER_CCN)) maxlen,\n       max(PROCESSING_DATE) roster_date\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME ilike '%bria%' group by 1,2 order by 3 desc"}
