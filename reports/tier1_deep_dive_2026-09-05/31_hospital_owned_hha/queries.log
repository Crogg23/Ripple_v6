{"label": "HH ccn is a key", "rows": 1, "secs": 0.4, "sql": "select count(*) n, count(distinct CCN) d, min(length(CCN)) mn, max(length(CCN)) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH"}
{"label": "HE keys", "rows": 1, "secs": 0.5, "sql": "select count(*) n, count(distinct CCN) d, count(distinct ASSOCIATE_ID) a, count(distinct NPI) npi, sum(iff(length(CCN)=7,1,0)) suffixed from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS"}
{"label": "HO keys", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct CCN) d, count(distinct ASSOCIATE_ID) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS"}
{"label": "star raw values", "rows": 10, "secs": 0.3, "sql": "select QUALITY_OF_PATIENT_CARE_STAR_RATING s, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH group by 1 order by 1"}
{"label": "why star is blank", "rows": 4, "secs": 0.8, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select grp, FOOTNOTE_FOR_QUALITY_OF_PATIENT_CARE_STAR_RATING f, count(*) n from g where star is null group by 1,2 order by 1,3 desc"}
{"label": "is a patient-survey star landed anywhere", "rows": 2, "secs": 1.5, "sql": "select table_schema, table_name from LIBRARY_RAW.information_schema.tables where table_name ilike '%HHCAHPS%' or table_name ilike '%PATIENT_SURVEY%' or table_name ilike '%HOME_HEALTH%' order by 1,2"}
{"label": "7-char CCNs are branches of a 6-char parent", "rows": 1, "secs": 0.7, "sql": "select count(*) n, sum(iff(p.CCN is not null,1,0)) parent_in_care_compare from (select CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS where length(CCN)=7) s left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH p on p.CCN = left(s.CCN,6)"}
{"label": "owned count, suffix stripped", "rows": 1, "secs": 0.3, "sql": "select count(distinct left(e.CCN,6)) hha from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID"}
{"label": "how many systems own how many HHAs", "rows": 1, "secs": 0.4, "sql": "select count(distinct h.ASSOCIATE_ID) systems, count(distinct h.CCN) hospital_ccn, count(distinct e.CCN) hha from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID"}
{"label": "biggest owners", "rows": 8, "secs": 0.8, "sql": "select e.ASSOCIATE_ID, min(h.ORGANIZATION_NAME) hosp, count(distinct e.CCN) hhas from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID group by 1 order by 3 desc limit 8"}
{"label": "second way: hospital-ish names by group", "rows": 3, "secs": 0.3, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select grp, sum(iff(regexp_like(upper(PROVIDER_NAME),'.*(HOSPITAL|MEDICAL CENTER|HEALTH SYSTEM|CLINIC|HEALTHCARE SYSTEM).*'),1,0)) namehit, count(*) n from g group by 1 order by 1"}
{"label": "care compare ownership type by group", "rows": 12, "secs": 0.7, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select grp, TYPE_OF_OWNERSHIP, count(*) n, round(avg(star),2) mean_star, round(avg(spend),3) mean_spend from g group by 1,2 order by 1,3 desc"}
{"label": "headline by group", "rows": 3, "secs": 0.5, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select grp, count(*) n,\n  sum(iff(star is null,1,0)) star_missing, round(100*avg(iff(star is null,1,0)),1) pct_star_missing,\n  round(avg(star),2) mean_star, median(star) med_star,\n  sum(iff(spend is null,1,0)) spend_missing, round(avg(spend),3) mean_spend, median(spend) med_spend,\n  sum(iff(eps is null,1,0)) eps_missing, median(eps) med_eps,\n  median(datediff('year', CERTIFICATION_DATE, '2026-07-01')) med_age_yrs\n  from g group by 1 order by 1"}
{"label": "star distribution", "rows": 27, "secs": 0.4, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select grp, star, count(*) n from g where star is not null group by 1,2 order by 1,2"}
{"label": "share 2 stars or under, 4 or over", "rows": 3, "secs": 0.5, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select grp, count(star) rated, round(100*sum(iff(star<=2,1,0))/count(star),1) pct_low, round(100*sum(iff(star>=4,1,0))/count(star),1) pct_high from g group by 1 order by 1"}
{"label": "by episode band", "rows": 10, "secs": 0.2, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select band, grp, count(*) n, round(100*avg(iff(star is null,1,0)),1) pct_star_missing,\n  round(avg(star),2) mean_star, round(avg(spend),3) mean_spend, round(100*avg(iff(spend is null,1,0)),1) pct_spend_missing\n  from g where grp <> 'not in PECOS' group by 1,2 order by 1,2"}
{"label": "missing star by band, everyone", "rows": 5, "secs": 0.3, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select band, count(*) n, round(100*avg(iff(star is null,1,0)),1) pct_star_missing from g group by 1 order by 1"}
{"label": "outcome rates by group", "rows": 3, "secs": 0.4, "sql": "with owned as (select distinct e.CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS h on h.ASSOCIATE_ID = e.ASSOCIATE_ID),\nenr as (select distinct CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH_AGENCY_ENROLLMENTS),\ng as (select c.*,\n  case when o.CCN is not null then 'hospital-owned' when n.CCN is not null then 'independent' else 'not in PECOS' end grp,\n  try_to_number(QUALITY_OF_PATIENT_CARE_STAR_RATING, 3, 1) star,\n  try_to_number(HOW_MUCH_MEDICARE_SPENDS_ON_AN_EPISODE_OF_CARE_AT_THIS_AGENCY_COMPARED_TO_MEDICARE_SPENDING_ACROSS_ALL_AGENCIES_NATIONALLY, 10, 2) spend,\n  try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) eps,\n  case when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) is null then '0 none' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 100 then '1 <100'\n       when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 250 then '2 100-249' when try_to_number(NO_OF_EPISODES_TO_CALC_HOW_MUCH_MEDICARE_SPENDS_PER_EPISODE_OF_CARE_AT_AGENCY_COMPARED_TO_SPENDING_AT_ALL_AGENCIES_NATIONAL) < 500 then '3 250-499' else '4 500+' end band\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOME_HEALTH c left join owned o on o.CCN = c.CCN left join enr n on n.CCN = c.CCN) select grp, count(*) n,\n  round(avg(DTC_RISK_STANDARDIZED_RATE),2) dtc, sum(iff(DTC_RISK_STANDARDIZED_RATE is null,1,0)) dtc_miss,\n  round(avg(PPH_RISK_STANDARDIZED_RATE),2) pph, sum(iff(PPH_RISK_STANDARDIZED_RATE is null,1,0)) pph_miss,\n  round(avg(PPR_RISK_STANDARDIZED_RATE),2) ppr, sum(iff(PPR_RISK_STANDARDIZED_RATE is null,1,0)) ppr_miss,\n  round(avg(try_to_number(HOW_OFTEN_PATIENTS_GOT_BETTER_AT_WALKING_OR_MOVING_AROUND,6,2)),2) walk,\n  round(avg(try_to_number(HOW_OFTEN_THE_HOME_HEALTH_TEAM_BEGAN_THEIR_PATIENTS_CARE_IN_A_TIMELY_MANNER,6,2)),2) timely,\n  round(avg(PERCENT_OF_RESIDENTS_EXPERIENCING_ONE_OR_MORE_FALLS_WITH_MAJOR_INJURY),2) falls\n  from g group by 1 order by 1"}
