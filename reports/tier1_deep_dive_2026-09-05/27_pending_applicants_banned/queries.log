{"label": "pending_shape", "rows": 2, "secs": 0.8, "sql": "with u as (\n  select NPI, 'physician' kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union all select NPI, 'non_physician' from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS)\nselect kind, count(*) n_rows, count(distinct NPI) n_npi,\n       count(*) - count(distinct NPI) n_dupe_rows,\n       sum(iff(NPI is null or trim(NPI)='' ,1,0)) n_blank,\n       sum(iff(length(trim(NPI))<>10 or not regexp_like(trim(NPI),'^[0-9]{10}$'),1,0)) n_malformed\nfrom u group by kind order by kind"}
{"label": "pending_total", "rows": 1, "secs": 0.5, "sql": "with u as (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union all select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS)\nselect count(*) n_rows, count(distinct NPI) n_npi, count(*)-count(distinct NPI) n_dupe_rows,\n       sum(iff(NPI='0000000000',1,0)) n_sentinel\nfrom u where NPI is not null and trim(NPI)<>''"}
{"label": "pending_dupes", "rows": 17, "secs": 0.4, "sql": "with u as (\n  select NPI, LAST_NAME, FIRST_NAME, 'physician' kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union all\n  select NPI, LAST_NAME, FIRST_NAME, 'non_physician' from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS)\nselect NPI, count(*) n_rows, count(distinct kind) n_files, count(distinct LAST_NAME||'|'||FIRST_NAME) n_names,\n       listagg(distinct kind, '+') within group (order by kind) kinds\nfrom u group by NPI having count(*)>1 order by n_rows desc, NPI"}
{"label": "leie_shape", "rows": 1, "secs": 0.3, "sql": "select count(*) n_rows,\n       sum(iff(NPI='0000000000',1,0)) n_sentinel,\n       sum(iff(NPI is null or trim(NPI)='',1,0)) n_blank,\n       sum(iff(NPI_IS_REAL,1,0)) n_flag_real,\n       count(distinct iff(NPI<>'0000000000' and trim(NPI)<>'', NPI, null)) n_real_distinct,\n       sum(iff(WAS_REINSTATED,1,0)) n_reinstated,\n       sum(iff(nullif(trim(REINSTATEMENT_DATE),'') is not null,1,0)) n_reinst_date\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE"}
{"label": "hits", "rows": 10, "secs": 1.0, "sql": "with p as (\nwith u as (\n  select NPI, LAST_NAME, FIRST_NAME, 'physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS\n  union all\n  select NPI, LAST_NAME, FIRST_NAME, 'non_physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS\n)\nselect NPI, min(LAST_NAME) LAST_NAME, min(FIRST_NAME) FIRST_NAME,\n       listagg(distinct kind, '+') within group (order by kind) kind,\n       count(*) n_rows\nfrom u where NPI is not null and length(trim(NPI)) = 10 and NPI <> '0000000000'\ngroup by NPI\n)\nselect p.NPI, p.LAST_NAME p_last, p.FIRST_NAME p_first, p.kind, p.n_rows pending_rows,\n       l.LAST_NAME l_last, l.FIRST_NAME l_first, l.BUSINESS_NAME, l.GENERAL_CATEGORY, l.SPECIALTY,\n       l.EXCLUSION_TYPE, l.EXCLUSION_DATE, nullif(trim(l.REINSTATEMENT_DATE),'') REINSTATEMENT_DATE,\n       l.WAS_REINSTATED, l.HAS_WAIVER, l.IS_ENTITY_NOT_INDIVIDUAL, l.STATE, l.CITY, l.EXCLUSION_SK\nfrom p join LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l on l.NPI = p.NPI\nwhere l.NPI <> '0000000000'\norder by l.EXCLUSION_DATE"}
{"label": "hits_rebuild", "rows": 3, "secs": 0.8, "sql": "select 'physician' kind, count(distinct p.NPI) n_npi from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS p\n where exists (select 1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l where l.NPI=p.NPI and l.NPI<>'0000000000')\nunion all\nselect 'non_physician', count(distinct p.NPI) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS p\n where exists (select 1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l where l.NPI=p.NPI and l.NPI<>'0000000000')\nunion all\nselect 'either', count(distinct NPI) from (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS) p\n where exists (select 1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l where l.NPI=p.NPI and l.NPI<>'0000000000')"}
{"label": "hits_rowlevel", "rows": 1, "secs": 0.4, "sql": "with u as (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union all select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS)\nselect count(*) n_join_rows, count(distinct u.NPI) n_npi, count(distinct l.EXCLUSION_SK) n_exclusions\nfrom u join LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l on l.NPI=u.NPI and l.NPI<>'0000000000'"}
{"label": "name_check", "rows": 10, "secs": 0.7, "sql": "with p as (\nwith u as (\n  select NPI, LAST_NAME, FIRST_NAME, 'physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS\n  union all\n  select NPI, LAST_NAME, FIRST_NAME, 'non_physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS\n)\nselect NPI, min(LAST_NAME) LAST_NAME, min(FIRST_NAME) FIRST_NAME,\n       listagg(distinct kind, '+') within group (order by kind) kind,\n       count(*) n_rows\nfrom u where NPI is not null and length(trim(NPI)) = 10 and NPI <> '0000000000'\ngroup by NPI\n)\nselect p.NPI,\n       upper(trim(p.LAST_NAME)) = upper(trim(l.LAST_NAME)) last_match,\n       upper(trim(p.FIRST_NAME)) = upper(trim(l.FIRST_NAME)) first_match,\n       left(upper(trim(p.FIRST_NAME)),3) = left(upper(trim(l.FIRST_NAME)),3) first3_match\nfrom p join LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l on l.NPI=p.NPI where l.NPI<>'0000000000'"}
{"label": "type_legend", "rows": 22, "secs": 0.4, "sql": "select EXCLUSION_TYPE, count(*) n, sum(iff(WAS_REINSTATED,1,0)) n_reinst\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE group by 1 order by n desc"}
{"label": "leie_type_share", "rows": 12, "secs": 0.3, "sql": "select EXCLUSION_TYPE, count(*) n\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where NPI<>'0000000000' and trim(NPI)<>'' group by 1 order by n desc limit 12"}
{"label": "affil", "rows": 9, "secs": 1.7, "sql": "with p as (\nwith u as (\n  select NPI, LAST_NAME, FIRST_NAME, 'physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS\n  union all\n  select NPI, LAST_NAME, FIRST_NAME, 'non_physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS\n)\nselect NPI, min(LAST_NAME) LAST_NAME, min(FIRST_NAME) FIRST_NAME,\n       listagg(distinct kind, '+') within group (order by kind) kind,\n       count(*) n_rows\nfrom u where NPI is not null and length(trim(NPI)) = 10 and NPI <> '0000000000'\ngroup by NPI\n),\nh as (select distinct p.NPI from p join LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l on l.NPI=p.NPI where l.NPI<>'0000000000')\nselect h.NPI, a.FACILITY_TYPE, a.CCN, a.PROVIDER_LAST_NAME, a.PROVIDER_FIRST_NAME, a.IND_PAC_ID\nfrom h left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_FACILITY_AFFILIATION a on a.NPI=h.NPI\norder by h.NPI, a.FACILITY_TYPE, a.CCN"}
{"label": "affil_base", "rows": 1, "secs": 0.8, "sql": "with p as (\nwith u as (\n  select NPI, LAST_NAME, FIRST_NAME, 'physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS\n  union all\n  select NPI, LAST_NAME, FIRST_NAME, 'non_physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS\n)\nselect NPI, min(LAST_NAME) LAST_NAME, min(FIRST_NAME) FIRST_NAME,\n       listagg(distinct kind, '+') within group (order by kind) kind,\n       count(*) n_rows\nfrom u where NPI is not null and length(trim(NPI)) = 10 and NPI <> '0000000000'\ngroup by NPI\n)\nselect count(*) n_pending, sum(iff(exists(select 1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_FACILITY_AFFILIATION a where a.NPI=p.NPI),1,0)) n_with_affil\nfrom p"}
{"label": "leie_year", "rows": 35, "secs": 0.3, "sql": "select year(EXCLUSION_DATE) yr, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE\nwhere NPI<>'0000000000' and trim(NPI)<>'' and EXCLUSION_DATE is not null group by 1 order by 1"}
{"label": "hits_multi", "rows": 1, "secs": 0.4, "sql": "with p as (\nwith u as (\n  select NPI, LAST_NAME, FIRST_NAME, 'physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS\n  union all\n  select NPI, LAST_NAME, FIRST_NAME, 'non_physician' as kind from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS\n)\nselect NPI, min(LAST_NAME) LAST_NAME, min(FIRST_NAME) FIRST_NAME,\n       listagg(distinct kind, '+') within group (order by kind) kind,\n       count(*) n_rows\nfrom u where NPI is not null and length(trim(NPI)) = 10 and NPI <> '0000000000'\ngroup by NPI\n)\nselect p.NPI, count(*) n_leie_rows from p join LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l on l.NPI=p.NPI and l.NPI<>'0000000000'\ngroup by 1 having count(*)>1"}
{"label": "aff_npi", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(distinct NPI) n_npi, sum(iff(NPI='0000000000',1,0)) n_sent from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_FACILITY_AFFILIATION"}
{"label": "landing_names", "rows": 3, "secs": 3.4, "sql": "select table_schema, table_name, row_count from LIBRARY_RAW.information_schema.tables\nwhere (table_name ilike '%LEIE%' or table_name ilike '%PENDING_INITIAL%' or table_name ilike '%REINSTAT%')\norder by 1,2"}
{"label": "landing_names", "rows": 3, "secs": 1.6, "sql": "select table_schema, table_name, row_count from LIBRARY_RAW.information_schema.tables\nwhere (table_name ilike '%LEIE%' or table_name ilike '%PENDING_INITIAL%' or table_name ilike '%REINSTAT%')\norder by 1,2"}
{"label": "cols_FED_HHS_OIG_LEIE", "rows": 21, "secs": 1.5, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_HHS_OIG_LEIE' order by ordinal_position"}
{"label": "cols_FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS", "rows": 5, "secs": 1.2, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS' order by ordinal_position"}
{"label": "cols_FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS", "rows": 5, "secs": 1.1, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS' order by ordinal_position"}
{"label": "leie_landing_shape", "rows": 1, "secs": 0.3, "sql": "select count(*) n_rows,\n       sum(iff(NPI='0000000000',1,0)) n_sentinel,\n       sum(iff(nullif(trim(NPI),'') is null,1,0)) n_blank,\n       count(distinct iff(NPI<>'0000000000' and nullif(trim(NPI),'') is not null, NPI, null)) n_real_distinct,\n       sum(iff(nullif(trim(REINDATE),'') is not null and REINDATE<>'00000000',1,0)) n_reindate,\n       min(REINDATE) min_reindate, max(REINDATE) max_reindate,\n       min(EXCLDATE) min_excl, max(EXCLDATE) max_excl,\n       max(INGESTED_AT) ingested_at\nfrom LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE"}
{"label": "leie_reindate_sample", "rows": 1, "secs": 0.5, "sql": "select REINDATE, count(*) n from LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE group by 1 order by n desc limit 5"}
{"label": "hits_landing", "rows": 10, "secs": 0.4, "sql": "select NPI, LASTNAME, FIRSTNAME, EXCLTYPE, EXCLDATE, REINDATE, WAIVERDATE, STATE, CITY\nfrom LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE\nwhere NPI in ('1861424954','1366450280','1225139496','1336103548','1083786099','1689740714','1386606325','1639294796','1164538013')\norder by EXCLDATE"}
{"label": "pending_landing_meta", "rows": 2, "secs": 0.6, "sql": "select 'phy' f, count(*) n, min(_INGESTED_AT) mn, max(_INGESTED_AT) mx from LIBRARY_RAW.LANDING.FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS\nunion all\nselect 'non', count(*), min(_INGESTED_AT), max(_INGESTED_AT) from LIBRARY_RAW.LANDING.FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS"}
{"label": "leie_mand_perm", "rows": 3, "secs": 0.3, "sql": "select iff(EXCLUSION_TYPE like '1128a%' or EXCLUSION_TYPE like '1128A%','mandatory (1128a)',\n       iff(EXCLUSION_TYPE like '1128b%','permissive (1128b)','other')) grp, count(*) n\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where NPI<>'0000000000' and trim(NPI)<>'' group by 1 order by n desc"}
{"label": "leie_state", "rows": 10, "secs": 0.5, "sql": "select STATE, count(*) n, round(100*count(*)/sum(count(*)) over (),1) pct\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where NPI<>'0000000000' and trim(NPI)<>'' group by 1 order by n desc limit 10"}
{"label": "nppes_cols", "rows": 68, "secs": 1.2, "sql": "select column_name from LIBRARY_MARTS.information_schema.columns\nwhere table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NPPES' and (column_name ilike '%STATE%' or column_name='NPI') order by ordinal_position"}
{"label": "nppes_cols2", "rows": 7, "secs": 1.2, "sql": "select column_name from LIBRARY_MARTS.information_schema.columns\nwhere table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NPPES' and (column_name ilike '%DEACTIV%' or column_name ilike '%ENTITY%' or column_name ilike '%TAXONOMY_CODE_1' or column_name ilike '%CREDENTIAL%') order by ordinal_position"}
{"label": "pending_state", "rows": 12, "secs": 8.6, "sql": "with p as (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS)\nselect n.PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME st, count(*) n,\n       round(100*count(*)/sum(count(*)) over (),1) pct\nfrom p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI=p.NPI group by 1 order by n desc limit 12"}
{"label": "nppes_cols2", "rows": 7, "secs": 1.2, "sql": "select column_name from LIBRARY_MARTS.information_schema.columns\nwhere table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NPPES' and (column_name ilike '%DEACTIV%' or column_name ilike '%ENTITY%' or column_name ilike '%TAXONOMY_CODE_1' or column_name ilike '%CREDENTIAL%') order by ordinal_position"}
{"label": "pending_state", "rows": 12, "secs": 0.2, "sql": "with p as (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS)\nselect n.PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME st, count(*) n,\n       round(100*count(*)/sum(count(*)) over (),1) pct\nfrom p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI=p.NPI group by 1 order by n desc limit 12"}
{"label": "pending_nppes_cov", "rows": 1, "secs": 0.6, "sql": "with p as (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS union select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS)\nselect count(*) n_pending, sum(iff(n.NPI is not null,1,0)) n_in_nppes from p left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI=p.NPI"}
{"label": "hits_nppes", "rows": 9, "secs": 0.8, "sql": "select NPI, PROVIDER_LAST_NAME_LEGAL_NAME, PROVIDER_FIRST_NAME, PROVIDER_CREDENTIAL_TEXT,\n       PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME st, HEALTHCARE_PROVIDER_TAXONOMY_CODE_1 tax,\n       NPI_DEACTIVATION_DATE, NPI_REACTIVATION_DATE\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI in ('1861424954','1366450280','1225139496','1336103548','1083786099','1689740714','1386606325','1639294796','1164538013') order by NPI"}
{"label": "leie_state7", "rows": 7, "secs": 0.3, "sql": "with b as (select STATE, count(*) n, round(100*count(*)/sum(count(*)) over (),2) pct\n           from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE where NPI<>'0000000000' and trim(NPI)<>'' group by 1)\nselect STATE, n, pct from b where STATE in ('FL','NC','NV','PA','CA','TX','NY') order by n desc"}
{"label": "pending_state7", "rows": 7, "secs": 1.1, "sql": "with p as (select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_PHYSICIANS\n           union select NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PENDING_INITIAL_LOGGING_AND_TRACKING_NON_PHYSICIANS),\nb as (select n.PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME st, count(*) n,\n             round(100*count(*)/sum(count(*)) over (),2) pct\n      from p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI=p.NPI group by 1)\nselect st, n, pct from b where st in ('FL','NC','NV','PA','CA','TX','NY') order by n desc"}
