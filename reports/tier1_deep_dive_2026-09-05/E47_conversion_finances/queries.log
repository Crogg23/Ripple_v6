{"label": "cols HEALTH__FED_CMS_HCRIS", "rows": 125, "secs": 1.5, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_HCRIS' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS", "rows": 39, "secs": 1.2, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_POS_OTHER", "rows": 473, "secs": 1.3, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_POS_OTHER' order by ordinal_position"}
{"label": "databases", "rows": 8, "secs": 0.3, "sql": "show databases"}
{"label": "hcris fy years", "rows": 3, "secs": 0.7, "sql": "select year(FISCAL_YEAR_END_DATE) fy, count(*) n, count(distinct PROVIDER_CCN) ccns, count(NET_INCOME) ni_filled, count(NET_PATIENT_REVENUE) npr_filled from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "reh flag", "rows": 2, "secs": 0.5, "sql": "select REH_CONVERSION_FLAG, count(*) n, count(REH_CONVERSION_DATE) dated, min(REH_CONVERSION_DATE) mn, max(REH_CONVERSION_DATE) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS group by 1"}
{"label": "raw hcris-like", "rows": 1, "secs": 1.7, "sql": "select table_schema, table_name, row_count from LIBRARY_RAW.information_schema.tables where table_name ilike '%HCRIS%' or table_name ilike '%COST%REPORT%' or table_name ilike '%HOSP%COST%' order by 1,2"}
{"label": "staging hcris-like", "rows": 2, "secs": 2.3, "sql": "select table_schema, table_name, row_count from LIBRARY_STAGING.information_schema.tables where table_name ilike '%HCRIS%' or table_name ilike '%COST%REPORT%' order by 1,2"}
{"label": "nan check", "rows": 1, "secs": 0.5, "sql": "select count(*) n, sum(iff(NET_PATIENT_REVENUE = 'NaN'::float,1,0)) npr_nan, sum(iff(NET_INCOME = 'NaN'::float,1,0)) ni_nan, sum(iff(TOTAL_COSTS='NaN'::float,1,0)) tc_nan, sum(iff(NET_INCOME = -TOTAL_OPERATING_EXPENSE,1,0)) ni_eq_neg_opex from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "rural/type spread", "rows": 20, "secs": 0.2, "sql": "select RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1,2 order by 3 desc"}
{"label": "reh cohort shape", "rows": 1, "secs": 1.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(*) n, count(distinct reh_ccn) reh_ccns, count(REH_CONVERSION_DATE) dated,\n  count(pred_ccn) with_pred, count(distinct pred_ccn) distinct_pred,\n  sum(iff(CAH_OR_HOSPITAL_CCN like '%/%',1,0)) piped from r"}
{"label": "reh cohort shape", "rows": 1, "secs": 0.2, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(*) n, count(distinct reh_ccn) reh_ccns, count(REH_CONVERSION_DATE) dated,\n  count(pred_ccn) with_pred, count(distinct pred_ccn) distinct_pred,\n  sum(iff(CAH_OR_HOSPITAL_CCN like '%/%',1,0)) piped from r"}
{"label": "pred ccn in hcris any report", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(distinct r.pred_ccn) matched_any_report, count(*) report_rows\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn"}
{"label": "reh last clean pre-conversion report", "rows": 11, "secs": 1.1, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n), c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n),\nj as (select r.*, c.*, row_number() over (partition by r.reh_ccn order by c.FISCAL_YEAR_END_DATE desc) k\n      from r join c on c.PROVIDER_CCN = r.pred_ccn\n      where r.REH_CONVERSION_DATE is null or c.FISCAL_YEAR_END_DATE <= r.REH_CONVERSION_DATE)\nselect reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, pred_ccn, HOSPITAL_NAME, CCN_FACILITY_TYPE, RURAL_VERSUS_URBAN,\n  NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE, datediff(day, FISCAL_YEAR_END_DATE, REH_CONVERSION_DATE) days_gap,\n  NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, m_cost, m_rev, NET_MARGIN_RATIO, TOTAL_FUND_BALANCES, CURRENT_RATIO, days_cash\nfrom j where k=1 order by m_cost"}
{"label": "reh loose (all reports) reproduce 28/35", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nj as (select r.reh_ccn, h.NET_INCOME, h.TOTAL_COSTS, h.NET_PATIENT_REVENUE,\n        row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n      from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn)\nselect count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, median(NET_INCOME/nullif(TOTAL_COSTS,0)) med_m_cost,\n  sum(iff(NET_PATIENT_REVENUE='NaN'::float,1,0)) blank_rev from j where k=1"}
{"label": "base rates by group", "rows": 8, "secs": 0.7, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg,\n  round(median(m_cost)*100,2) med_m_cost, round(median(m_rev)*100,2) med_m_rev,\n  sum(iff(TOTAL_FUND_BALANCES<0,1,0)) neg_equity, sum(iff(CURRENT_RATIO<1,1,0)) cr_under1, round(median(days_cash),1) med_days_cash,\n  count(CURRENT_RATIO) cr_filled, count(days_cash) dc_filled\nfrom (\n  select 'all hospitals' grp, * from b\n  union all select 'rural, all types', * from b where RURAL_VERSUS_URBAN='R'\n  union all select 'rural CAH+STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0\n  union all select 'rural CAH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='CAH' and is_reh_pred=0\n  union all select 'rural STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='STH' and is_reh_pred=0\n  union all select 'rural CAH+STH <=25 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=25 and is_reh_pred=0\n  union all select 'rural CAH+STH <=50 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=50 and is_reh_pred=0\n  union all select 'REH predecessors', * from b where is_reh_pred=1\n) group by 1 order by n desc"}
{"label": "margin buckets", "rows": 11, "secs": 0.5, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, bucket, count(*) n from (\n  select iff(is_reh_pred=1,'REH predecessors','rural CAH+STH (not REH)') grp,\n    case when m_cost < -0.20 then 'a. under -20%' when m_cost < -0.10 then 'b. -20% to -10%' when m_cost < 0 then 'c. -10% to 0'\n         when m_cost < 0.05 then 'd. 0 to +5%' when m_cost < 0.10 then 'e. +5% to +10%' else 'f. over +10%' end bucket\n  from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH')\n) group by 1,2 order by 1,2"}
{"label": "rural base by FY", "rows": 2, "secs": 0.9, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect year(FISCAL_YEAR_END_DATE) fy, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg, round(median(m_cost)*100,2) med\nfrom b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0 group by 1 order by 1"}
{"label": "reports per ccn", "rows": 1, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n) select reports_per_ccn, count(*) ccns from (select PROVIDER_CCN, count(*) reports_per_ccn from c group by 1) group by 1 order by 1"}
{"label": "reh cohort shape", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(*) n, count(distinct reh_ccn) reh_ccns, count(REH_CONVERSION_DATE) dated,\n  count(pred_ccn) with_pred, count(distinct pred_ccn) distinct_pred,\n  sum(iff(CAH_OR_HOSPITAL_CCN like '%/%',1,0)) piped from r"}
{"label": "pred ccn in hcris any report", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(distinct r.pred_ccn) matched_any_report, count(*) report_rows\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn"}
{"label": "reh filter walk", "rows": 1, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nj as (select r.reh_ccn, r.REH_CONVERSION_DATE, h.*, row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n      from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.pred_ccn)\nselect count(*) all_rows, count(distinct reh_ccn) reh_any,\n  sum(iff(k=1,1,0)) latest_rows,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) latest_fullyear,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380 and NET_PATIENT_REVENUE<>'NaN'::float,1,0)) latest_fy_rev,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380 and NET_PATIENT_REVENUE<>'NaN'::float and TOTAL_COSTS<>'NaN'::float and TOTAL_COSTS>0,1,0)) latest_fy_rev_cost,\n  sum(iff(k=1 and FISCAL_YEAR_END_DATE<=REH_CONVERSION_DATE,1,0)) latest_before_conv,\n  sum(iff(datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) any_fullyear_rows,\n  count(distinct iff(datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380, reh_ccn, null)) reh_with_fullyear,\n  sum(iff(TOTAL_COSTS='NaN'::float,1,0)) tc_nan, sum(iff(TOTAL_COSTS<=0,1,0)) tc_le0\nfrom j"}
{"label": "all predecessor reports listed", "rows": 21, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect r.reh_ccn, r.ORGANIZATION_NAME, r.REH_CONVERSION_DATE, h.FISCAL_YEAR_BEGIN_DATE, h.FISCAL_YEAR_END_DATE, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) len_days,\n  h.NET_INCOME, h.TOTAL_COSTS, h.NET_PATIENT_REVENUE\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.pred_ccn order by 1, h.FISCAL_YEAR_END_DATE"}
{"label": "reh last clean pre-conversion report", "rows": 11, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n), c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n),\nj as (select r.*, c.*, row_number() over (partition by r.reh_ccn order by c.FISCAL_YEAR_END_DATE desc) k\n      from r join c on c.PROVIDER_CCN = r.pred_ccn\n      where r.REH_CONVERSION_DATE is null or c.FISCAL_YEAR_END_DATE <= r.REH_CONVERSION_DATE)\nselect reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, pred_ccn, HOSPITAL_NAME, CCN_FACILITY_TYPE, RURAL_VERSUS_URBAN,\n  NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE, datediff(day, FISCAL_YEAR_END_DATE, REH_CONVERSION_DATE) days_gap,\n  NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, m_cost, m_rev, NET_MARGIN_RATIO, TOTAL_FUND_BALANCES, CURRENT_RATIO, days_cash\nfrom j where k=1 order by m_cost"}
{"label": "reh loose (all reports) reproduce 28/35", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nj as (select r.reh_ccn, h.NET_INCOME, h.TOTAL_COSTS, h.NET_PATIENT_REVENUE,\n        row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n      from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn)\nselect count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, median(NET_INCOME/nullif(TOTAL_COSTS,0)) med_m_cost,\n  sum(iff(NET_PATIENT_REVENUE='NaN'::float,1,0)) blank_rev from j where k=1"}
{"label": "base rates by group", "rows": 8, "secs": 0.5, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg,\n  round(median(m_cost)*100,2) med_m_cost, round(median(m_rev)*100,2) med_m_rev,\n  sum(iff(TOTAL_FUND_BALANCES<0,1,0)) neg_equity, sum(iff(CURRENT_RATIO<1,1,0)) cr_under1, round(median(days_cash),1) med_days_cash,\n  count(CURRENT_RATIO) cr_filled, count(days_cash) dc_filled\nfrom (\n  select 'all hospitals' grp, * from b\n  union all select 'rural, all types', * from b where RURAL_VERSUS_URBAN='R'\n  union all select 'rural CAH+STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0\n  union all select 'rural CAH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='CAH' and is_reh_pred=0\n  union all select 'rural STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='STH' and is_reh_pred=0\n  union all select 'rural CAH+STH <=25 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=25 and is_reh_pred=0\n  union all select 'rural CAH+STH <=50 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=50 and is_reh_pred=0\n  union all select 'REH predecessors', * from b where is_reh_pred=1\n) group by 1 order by n desc"}
{"label": "margin buckets", "rows": 11, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, bucket, count(*) n from (\n  select iff(is_reh_pred=1,'REH predecessors','rural CAH+STH (not REH)') grp,\n    case when m_cost < -0.20 then 'a. under -20%' when m_cost < -0.10 then 'b. -20% to -10%' when m_cost < 0 then 'c. -10% to 0'\n         when m_cost < 0.05 then 'd. 0 to +5%' when m_cost < 0.10 then 'e. +5% to +10%' else 'f. over +10%' end bucket\n  from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH')\n) group by 1,2 order by 1,2"}
{"label": "rural base by FY", "rows": 2, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect year(FISCAL_YEAR_END_DATE) fy, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg, round(median(m_cost)*100,2) med\nfrom b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0 group by 1 order by 1"}
{"label": "reports per ccn", "rows": 1, "secs": 0.2, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n) select reports_per_ccn, count(*) ccns from (select PROVIDER_CCN, count(*) reports_per_ccn from c group by 1) group by 1 order by 1"}
{"label": "post-conversion reports under REH ccn", "rows": 15, "secs": 0.7, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect r.reh_ccn, r.ORGANIZATION_NAME, r.STATE, r.REH_CONVERSION_DATE, h.FISCAL_YEAR_BEGIN_DATE, h.FISCAL_YEAR_END_DATE,\n  datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) len_days, h.NET_INCOME, h.TOTAL_COSTS,\n  iff(h.NET_PATIENT_REVENUE='NaN'::float, null, h.NET_INCOME/nullif(h.TOTAL_COSTS,0)) m_cost\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.reh_ccn order by 1, h.FISCAL_YEAR_END_DATE"}
{"label": "before/after pairs", "rows": 0, "secs": 0.8, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n), c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n),\npre as (select r.reh_ccn, c.m_cost pre_m, c.FISCAL_YEAR_END_DATE pre_fy, row_number() over (partition by r.reh_ccn order by c.FISCAL_YEAR_END_DATE desc) k\n        from r join c on c.PROVIDER_CCN=r.pred_ccn where r.REH_CONVERSION_DATE is null or c.FISCAL_YEAR_END_DATE <= r.REH_CONVERSION_DATE),\npost as (select r.reh_ccn, h.NET_INCOME/nullif(h.TOTAL_COSTS,0) post_m, h.FISCAL_YEAR_END_DATE post_fy, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) post_len,\n         row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n         from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.reh_ccn where h.NET_PATIENT_REVENUE<>'NaN'::float and h.TOTAL_COSTS>0)\nselect r.reh_ccn, r.ORGANIZATION_NAME, pre.pre_fy, round(pre.pre_m*100,1) pre_pct, post.post_fy, post.post_len, round(post.post_m*100,1) post_pct\nfrom r join pre on pre.reh_ccn=r.reh_ccn and pre.k=1 join post on post.reh_ccn=r.reh_ccn and post.k=1 order by pre_pct"}
{"label": "pos predecessor status", "rows": 1, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'/',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect count(*) n, sum(iff(p.CCN is not null,1,0)) in_pos, sum(iff(p.PGM_TRMNTN_CD not in ('00'),1,0)) terminated,\n  sum(iff(p.TRMNTN_EXPRTN_DT is not null,1,0)) term_dated\nfrom r left join (select * from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01') p on p.CCN=r.pred_ccn"}
{"label": "landing enroll tables", "rows": 1, "secs": 1.0, "sql": "select table_name, row_count from LIBRARY_RAW.information_schema.tables where table_schema='LANDING' and table_name ilike '%HOSPITAL_ENROLL%'"}
{"label": "landing enroll cols", "rows": 6, "secs": 1.3, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_CMS_HOSPITAL_ENROLLMENTS' and (column_name ilike '%REH%' or column_name ilike '%CAH%' or column_name ilike '%CCN%')"}
{"label": "landing vs mart pred ccn", "rows": 48, "secs": 0.7, "sql": "select l.CCN, l.CAH_OR_HOSPITAL_CCN landing_val, m.CAH_OR_HOSPITAL_CCN mart_val, l.REH_CONVERSION_DATE landing_date\nfrom LIBRARY_RAW.LANDING.FED_CMS_HOSPITAL_ENROLLMENTS l\njoin LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS m on m.CCN = l.CCN\nwhere l.REH_CONVERSION_FLAG='Y' order by 1"}
{"label": "reh cohort shape", "rows": 1, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(*) n, count(distinct reh_ccn) reh_ccns, count(REH_CONVERSION_DATE) dated,\n  count(pred_ccn) with_pred, count(distinct pred_ccn) distinct_pred,\n  sum(iff(CAH_OR_HOSPITAL_CCN like '%|%',1,0)) piped from r"}
{"label": "pred ccn in hcris any report", "rows": 1, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(distinct r.pred_ccn) matched_any_report, count(*) report_rows\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn"}
{"label": "reh filter walk", "rows": 1, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nj as (select r.reh_ccn, r.REH_CONVERSION_DATE, h.*, row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n      from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.pred_ccn)\nselect count(*) all_rows, count(distinct reh_ccn) reh_any,\n  sum(iff(k=1,1,0)) latest_rows,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) latest_fullyear,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380 and NET_PATIENT_REVENUE<>'NaN'::float,1,0)) latest_fy_rev,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380 and NET_PATIENT_REVENUE<>'NaN'::float and TOTAL_COSTS<>'NaN'::float and TOTAL_COSTS>0,1,0)) latest_fy_rev_cost,\n  sum(iff(k=1 and FISCAL_YEAR_END_DATE<=REH_CONVERSION_DATE,1,0)) latest_before_conv,\n  sum(iff(datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) any_fullyear_rows,\n  count(distinct iff(datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380, reh_ccn, null)) reh_with_fullyear,\n  sum(iff(TOTAL_COSTS='NaN'::float,1,0)) tc_nan, sum(iff(TOTAL_COSTS<=0,1,0)) tc_le0\nfrom j"}
{"label": "all predecessor reports listed", "rows": 35, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect r.reh_ccn, r.ORGANIZATION_NAME, r.REH_CONVERSION_DATE, h.FISCAL_YEAR_BEGIN_DATE, h.FISCAL_YEAR_END_DATE, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) len_days,\n  h.NET_INCOME, h.TOTAL_COSTS, h.NET_PATIENT_REVENUE\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.pred_ccn order by 1, h.FISCAL_YEAR_END_DATE"}
{"label": "reh last clean pre-conversion report", "rows": 23, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n), c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n),\nj as (select r.*, c.*, row_number() over (partition by r.reh_ccn order by c.FISCAL_YEAR_END_DATE desc) k\n      from r join c on c.PROVIDER_CCN = r.pred_ccn\n      where r.REH_CONVERSION_DATE is null or c.FISCAL_YEAR_END_DATE <= r.REH_CONVERSION_DATE)\nselect reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, pred_ccn, HOSPITAL_NAME, CCN_FACILITY_TYPE, RURAL_VERSUS_URBAN,\n  NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE, datediff(day, FISCAL_YEAR_END_DATE, REH_CONVERSION_DATE) days_gap,\n  NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, m_cost, m_rev, NET_MARGIN_RATIO, TOTAL_FUND_BALANCES, CURRENT_RATIO, days_cash\nfrom j where k=1 order by m_cost"}
{"label": "reh loose (all reports) reproduce 28/35", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nj as (select r.reh_ccn, h.NET_INCOME, h.TOTAL_COSTS, h.NET_PATIENT_REVENUE,\n        row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n      from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn)\nselect count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, median(NET_INCOME/nullif(TOTAL_COSTS,0)) med_m_cost,\n  sum(iff(NET_PATIENT_REVENUE='NaN'::float,1,0)) blank_rev from j where k=1"}
{"label": "base rates by group", "rows": 8, "secs": 0.8, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg,\n  round(median(m_cost)*100,2) med_m_cost, round(median(m_rev)*100,2) med_m_rev,\n  sum(iff(TOTAL_FUND_BALANCES<0,1,0)) neg_equity, sum(iff(CURRENT_RATIO<1,1,0)) cr_under1, round(median(days_cash),1) med_days_cash,\n  count(CURRENT_RATIO) cr_filled, count(days_cash) dc_filled\nfrom (\n  select 'all hospitals' grp, * from b\n  union all select 'rural, all types', * from b where RURAL_VERSUS_URBAN='R'\n  union all select 'rural CAH+STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0\n  union all select 'rural CAH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='CAH' and is_reh_pred=0\n  union all select 'rural STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='STH' and is_reh_pred=0\n  union all select 'rural CAH+STH <=25 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=25 and is_reh_pred=0\n  union all select 'rural CAH+STH <=50 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=50 and is_reh_pred=0\n  union all select 'REH predecessors', * from b where is_reh_pred=1\n) group by 1 order by n desc"}
{"label": "margin buckets", "rows": 11, "secs": 0.4, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, bucket, count(*) n from (\n  select iff(is_reh_pred=1,'REH predecessors','rural CAH+STH (not REH)') grp,\n    case when m_cost < -0.20 then 'a. under -20%' when m_cost < -0.10 then 'b. -20% to -10%' when m_cost < 0 then 'c. -10% to 0'\n         when m_cost < 0.05 then 'd. 0 to +5%' when m_cost < 0.10 then 'e. +5% to +10%' else 'f. over +10%' end bucket\n  from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH')\n) group by 1,2 order by 1,2"}
{"label": "rural base by FY", "rows": 2, "secs": 0.4, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect year(FISCAL_YEAR_END_DATE) fy, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg, round(median(m_cost)*100,2) med\nfrom b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0 group by 1 order by 1"}
{"label": "reports per ccn", "rows": 1, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n) select reports_per_ccn, count(*) ccns from (select PROVIDER_CCN, count(*) reports_per_ccn from c group by 1) group by 1 order by 1"}
{"label": "post-conversion reports under REH ccn", "rows": 15, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect r.reh_ccn, r.ORGANIZATION_NAME, r.STATE, r.REH_CONVERSION_DATE, h.FISCAL_YEAR_BEGIN_DATE, h.FISCAL_YEAR_END_DATE,\n  datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) len_days, h.NET_INCOME, h.TOTAL_COSTS,\n  iff(h.NET_PATIENT_REVENUE='NaN'::float, null, h.NET_INCOME/nullif(h.TOTAL_COSTS,0)) m_cost\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.reh_ccn order by 1, h.FISCAL_YEAR_END_DATE"}
{"label": "before/after pairs", "rows": 0, "secs": 0.5, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n), c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n),\npre as (select r.reh_ccn, c.m_cost pre_m, c.FISCAL_YEAR_END_DATE pre_fy, row_number() over (partition by r.reh_ccn order by c.FISCAL_YEAR_END_DATE desc) k\n        from r join c on c.PROVIDER_CCN=r.pred_ccn where r.REH_CONVERSION_DATE is null or c.FISCAL_YEAR_END_DATE <= r.REH_CONVERSION_DATE),\npost as (select r.reh_ccn, h.NET_INCOME/nullif(h.TOTAL_COSTS,0) post_m, h.FISCAL_YEAR_END_DATE post_fy, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) post_len,\n         row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n         from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.reh_ccn where h.NET_PATIENT_REVENUE<>'NaN'::float and h.TOTAL_COSTS>0)\nselect r.reh_ccn, r.ORGANIZATION_NAME, pre.pre_fy, round(pre.pre_m*100,1) pre_pct, post.post_fy, post.post_len, round(post.post_m*100,1) post_pct\nfrom r join pre on pre.reh_ccn=r.reh_ccn and pre.k=1 join post on post.reh_ccn=r.reh_ccn and post.k=1 order by pre_pct"}
{"label": "pos predecessor status", "rows": 1, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect count(*) n, sum(iff(p.CCN is not null,1,0)) in_pos, sum(iff(p.PGM_TRMNTN_CD not in ('00'),1,0)) terminated,\n  sum(iff(p.TRMNTN_EXPRTN_DT is not null,1,0)) term_dated\nfrom r left join (select * from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01') p on p.CCN=r.pred_ccn"}
{"label": "reh cohort shape", "rows": 1, "secs": 0.2, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(*) n, count(distinct reh_ccn) reh_ccns, count(REH_CONVERSION_DATE) dated,\n  count(pred_ccn) with_pred, count(distinct pred_ccn) distinct_pred,\n  sum(iff(CAH_OR_HOSPITAL_CCN like '%|%',1,0)) piped from r"}
{"label": "pred ccn in hcris any report", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n) select count(distinct r.pred_ccn) matched_any_report, count(*) report_rows\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn"}
{"label": "reh filter walk", "rows": 1, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nj as (select r.reh_ccn, r.REH_CONVERSION_DATE, h.*, row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n      from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.pred_ccn)\nselect count(*) all_rows, count(distinct reh_ccn) reh_any,\n  sum(iff(k=1,1,0)) latest_rows,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) latest_fullyear,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380 and NET_PATIENT_REVENUE<>'NaN'::float,1,0)) latest_fy_rev,\n  sum(iff(k=1 and datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380 and NET_PATIENT_REVENUE<>'NaN'::float and TOTAL_COSTS<>'NaN'::float and TOTAL_COSTS>0,1,0)) latest_fy_rev_cost,\n  sum(iff(k=1 and FISCAL_YEAR_END_DATE<=REH_CONVERSION_DATE,1,0)) latest_before_conv,\n  sum(iff(datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) any_fullyear_rows,\n  count(distinct iff(datediff(day,FISCAL_YEAR_BEGIN_DATE,FISCAL_YEAR_END_DATE) between 350 and 380, reh_ccn, null)) reh_with_fullyear,\n  sum(iff(TOTAL_COSTS='NaN'::float,1,0)) tc_nan, sum(iff(TOTAL_COSTS<=0,1,0)) tc_le0\nfrom j"}
{"label": "all predecessor reports listed", "rows": 35, "secs": 0.2, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect r.reh_ccn, r.ORGANIZATION_NAME, r.REH_CONVERSION_DATE, h.FISCAL_YEAR_BEGIN_DATE, h.FISCAL_YEAR_END_DATE, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) len_days,\n  h.NET_INCOME, h.TOTAL_COSTS, h.NET_PATIENT_REVENUE\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.pred_ccn order by 1, h.FISCAL_YEAR_END_DATE"}
{"label": "reh last clean pre-conversion report", "rows": 23, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n), c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n),\nj as (select r.*, c.*, row_number() over (partition by r.reh_ccn order by c.FISCAL_YEAR_END_DATE desc) k\n      from r join c on c.PROVIDER_CCN = r.pred_ccn\n      where r.REH_CONVERSION_DATE is null or c.FISCAL_YEAR_END_DATE <= r.REH_CONVERSION_DATE)\nselect reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, pred_ccn, HOSPITAL_NAME, CCN_FACILITY_TYPE, RURAL_VERSUS_URBAN,\n  NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE, datediff(day, FISCAL_YEAR_END_DATE, REH_CONVERSION_DATE) days_gap,\n  NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, m_cost, m_rev, NET_MARGIN_RATIO, TOTAL_FUND_BALANCES, CURRENT_RATIO, days_cash\nfrom j where k=1 order by m_cost"}
{"label": "reh loose (all reports) reproduce 28/35", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nj as (select r.reh_ccn, h.NET_INCOME, h.TOTAL_COSTS, h.NET_PATIENT_REVENUE,\n        row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n      from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.pred_ccn)\nselect count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, median(NET_INCOME/nullif(TOTAL_COSTS,0)) med_m_cost,\n  sum(iff(NET_PATIENT_REVENUE='NaN'::float,1,0)) blank_rev from j where k=1"}
{"label": "base rates by group", "rows": 8, "secs": 0.9, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg,\n  round(median(m_cost)*100,2) med_m_cost, round(median(m_rev)*100,2) med_m_rev,\n  sum(iff(TOTAL_FUND_BALANCES<0,1,0)) neg_equity, sum(iff(CURRENT_RATIO<1,1,0)) cr_under1, round(median(days_cash),1) med_days_cash,\n  count(CURRENT_RATIO) cr_filled, count(days_cash) dc_filled\nfrom (\n  select 'all hospitals' grp, * from b\n  union all select 'rural, all types', * from b where RURAL_VERSUS_URBAN='R'\n  union all select 'rural CAH+STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0\n  union all select 'rural CAH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='CAH' and is_reh_pred=0\n  union all select 'rural STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE='STH' and is_reh_pred=0\n  union all select 'rural CAH+STH <=25 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=25 and is_reh_pred=0\n  union all select 'rural CAH+STH <=50 beds (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and NUMBER_OF_BEDS<=50 and is_reh_pred=0\n  union all select 'REH predecessors', * from b where is_reh_pred=1\n) group by 1 order by n desc"}
{"label": "margin buckets", "rows": 11, "secs": 1.0, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, bucket, count(*) n from (\n  select iff(is_reh_pred=1,'REH predecessors','rural CAH+STH (not REH)') grp,\n    case when m_cost < -0.20 then 'a. under -20%' when m_cost < -0.10 then 'b. -20% to -10%' when m_cost < 0 then 'c. -10% to 0'\n         when m_cost < 0.05 then 'd. 0 to +5%' when m_cost < 0.10 then 'e. +5% to +10%' else 'f. over +10%' end bucket\n  from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH')\n) group by 1,2 order by 1,2"}
{"label": "rural base by FY", "rows": 2, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect year(FISCAL_YEAR_END_DATE) fy, count(*) n, sum(iff(NET_INCOME<0,1,0)) neg, round(100.0*sum(iff(NET_INCOME<0,1,0))/count(*),1) pct_neg, round(median(m_cost)*100,2) med\nfrom b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0 group by 1 order by 1"}
{"label": "reports per ccn", "rows": 1, "secs": 0.2, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n) select reports_per_ccn, count(*) ccns from (select PROVIDER_CCN, count(*) reports_per_ccn from c group by 1) group by 1 order by 1"}
{"label": "post-conversion reports under REH ccn", "rows": 15, "secs": 0.2, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect r.reh_ccn, r.ORGANIZATION_NAME, r.STATE, r.REH_CONVERSION_DATE, h.FISCAL_YEAR_BEGIN_DATE, h.FISCAL_YEAR_END_DATE,\n  datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) len_days, h.NET_INCOME, h.TOTAL_COSTS,\n  iff(h.NET_PATIENT_REVENUE='NaN'::float, null, h.NET_INCOME/nullif(h.TOTAL_COSTS,0)) m_cost\nfrom r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN = r.reh_ccn order by 1, h.FISCAL_YEAR_END_DATE"}
{"label": "before/after pairs", "rows": 0, "secs": 0.2, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n), c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n),\npre as (select r.reh_ccn, c.m_cost pre_m, c.FISCAL_YEAR_END_DATE pre_fy, row_number() over (partition by r.reh_ccn order by c.FISCAL_YEAR_END_DATE desc) k\n        from r join c on c.PROVIDER_CCN=r.pred_ccn where r.REH_CONVERSION_DATE is null or c.FISCAL_YEAR_END_DATE <= r.REH_CONVERSION_DATE),\npost as (select r.reh_ccn, h.NET_INCOME/nullif(h.TOTAL_COSTS,0) post_m, h.FISCAL_YEAR_END_DATE post_fy, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) post_len,\n         row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n         from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.reh_ccn where h.NET_PATIENT_REVENUE<>'NaN'::float and h.TOTAL_COSTS>0)\nselect r.reh_ccn, r.ORGANIZATION_NAME, pre.pre_fy, round(pre.pre_m*100,1) pre_pct, post.post_fy, post.post_len, round(post.post_m*100,1) post_pct\nfrom r join pre on pre.reh_ccn=r.reh_ccn and pre.k=1 join post on post.reh_ccn=r.reh_ccn and post.k=1 order by pre_pct"}
{"label": "pos predecessor status", "rows": 1, "secs": 0.3, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect count(*) n, sum(iff(p.CCN is not null,1,0)) in_pos, sum(iff(p.PGM_TRMNTN_CD not in ('00'),1,0)) terminated,\n  sum(iff(p.TRMNTN_EXPRTN_DT is not null,1,0)) term_dated\nfrom r left join (select * from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01') p on p.CCN=r.pred_ccn"}
{"label": "before/after pairs, loose pre", "rows": 7, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\npre as (select r.reh_ccn, h.NET_INCOME/nullif(h.TOTAL_COSTS,0) pre_m, h.FISCAL_YEAR_END_DATE pre_fy, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) pre_len,\n        row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n        from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.pred_ccn where h.NET_PATIENT_REVENUE<>'NaN'::float and h.TOTAL_COSTS>0),\npost as (select r.reh_ccn, h.NET_INCOME/nullif(h.TOTAL_COSTS,0) post_m, h.FISCAL_YEAR_END_DATE post_fy, datediff(day,h.FISCAL_YEAR_BEGIN_DATE,h.FISCAL_YEAR_END_DATE) post_len,\n         row_number() over (partition by r.reh_ccn order by h.FISCAL_YEAR_END_DATE desc) k\n         from r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.PROVIDER_CCN=r.reh_ccn where h.NET_PATIENT_REVENUE<>'NaN'::float and h.TOTAL_COSTS>0)\nselect r.reh_ccn, r.ORGANIZATION_NAME, r.STATE, r.REH_CONVERSION_DATE, pre.pre_fy, pre.pre_len, round(pre.pre_m*100,1) pre_pct, post.post_fy, post.post_len, round(post.post_m*100,1) post_pct\nfrom r join pre on pre.reh_ccn=r.reh_ccn and pre.k=1 join post on post.reh_ccn=r.reh_ccn and post.k=1 order by pre_pct"}
{"label": "net_margin_ratio sign rebuild", "rows": 2, "secs": 0.5, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, RURAL_VERSUS_URBAN, CCN_FACILITY_TYPE, NUMBER_OF_BEDS,\n       FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE, FISCAL_YEAR_LENGTH_DAYS,\n       NET_INCOME, TOTAL_COSTS, NET_PATIENT_REVENUE, TOTAL_FUND_BALANCES, CURRENT_RATIO,\n       CASH_ON_HAND_AND_IN_BANKS, TOTAL_OPERATING_EXPENSE, NET_MARGIN_RATIO,\n       NET_INCOME / nullif(TOTAL_COSTS,0) as m_cost,\n       NET_INCOME / nullif(NET_PATIENT_REVENUE,0) as m_rev,\n       (CASH_ON_HAND_AND_IN_BANKS) / nullif(TOTAL_OPERATING_EXPENSE/365.0,0) as days_cash,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n  and NET_PATIENT_REVENUE <> 'NaN'::float and NET_INCOME <> 'NaN'::float\n  and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS > 0\n), r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n),\nb as (select c.*, iff(c.PROVIDER_CCN in (select pred_ccn from r where pred_ccn is not null),1,0) is_reh_pred from c where rn=1)\n\nselect grp, count(NET_MARGIN_RATIO) n, sum(iff(NET_MARGIN_RATIO<0,1,0)) neg_nmr, sum(iff(NET_INCOME<0,1,0)) neg_ni,\n  sum(iff(sign(NET_MARGIN_RATIO)<>sign(NET_INCOME),1,0)) sign_disagree, round(median(NET_MARGIN_RATIO)*100,2) med_nmr,\n  round(median(NUMBER_OF_BEDS),0) med_beds\nfrom (select 'REH predecessors' grp, * from b where is_reh_pred=1\n      union all select 'rural CAH+STH (not REH)', * from b where RURAL_VERSUS_URBAN='R' and CCN_FACILITY_TYPE in ('CAH','STH') and is_reh_pred=0)\nwhere NET_MARGIN_RATIO <> 'NaN'::float group by 1"}
{"label": "pos termination vs conversion", "rows": 43, "secs": 0.4, "sql": "with r as (\nselect CCN as reh_ccn, ORGANIZATION_NAME, STATE, REH_CONVERSION_DATE, CAH_OR_HOSPITAL_CCN,\n       split_part(CAH_OR_HOSPITAL_CCN,'|',1) as pred_ccn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HOSPITAL_ENROLLMENTS where REH_CONVERSION_FLAG='Y'\n)\nselect r.reh_ccn, r.pred_ccn, r.REH_CONVERSION_DATE, p.FAC_NAME, p.PGM_TRMNTN_CD, p.TRMNTN_EXPRTN_DT,\n  datediff(day, r.REH_CONVERSION_DATE, p.TRMNTN_EXPRTN_DT) term_minus_conv\nfrom r join (select * from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01') p on p.CCN=r.pred_ccn order by 7"}
