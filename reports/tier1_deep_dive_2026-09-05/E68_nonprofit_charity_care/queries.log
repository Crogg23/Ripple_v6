{"label": "hcris columns", "rows": 125, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns\nwhere table_schema='HEALTH' and table_name='HEALTH__FED_CMS_HCRIS' order by ordinal_position"}
{"label": "bmf tables", "rows": 8, "secs": 2.1, "sql": "select table_catalog, table_schema, table_name, row_count from LIBRARY_MARTS.information_schema.tables where table_name ilike '%IRS%BMF%'\nunion all select table_catalog, table_schema, table_name, row_count from LIBRARY_RAW.information_schema.tables where table_name ilike '%IRS%BMF%'"}
{"label": "control codes", "rows": 13, "secs": 0.3, "sql": "select TYPE_OF_CONTROL, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "bmf columns", "rows": 32, "secs": 1.5, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns\n        where table_schema='CORPORATE_REGISTRY' and table_name='CORPORATE_REGISTRY__FED_IRS_EO_BMF' order by ordinal_position"}
{"label": "hcris shape and nan counts", "rows": 1, "secs": 0.6, "sql": "select count(*) rows_, count(distinct PROVIDER_CCN) ccns,\n          sum(iff(NET_INCOME = 'NaN'::float,1,0)) ni_nan,\n          sum(iff(TOTAL_COSTS = 'NaN'::float,1,0)) tc_nan,\n          sum(iff(COST_OF_CHARITY_CARE = 'NaN'::float,1,0)) cc_nan,\n          sum(iff(NET_INCOME > TOTAL_COSTS,1,0)) ni_gt_tc,\n          sum(iff(datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) not between 350 and 380,1,0)) short_or_long,\n          min(FISCAL_YEAR_END_DATE) min_fye, max(FISCAL_YEAR_END_DATE) max_fye,\n          sum(iff(year(FISCAL_YEAR_END_DATE)=2023,1,0)) fye_2023, sum(iff(year(FISCAL_YEAR_END_DATE)=2024,1,0)) fye_2024,\n          sum(iff(year(FISCAL_YEAR_BEGIN_DATE)=2023,1,0)) fyb_2023\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "ccns with 2+ reports", "rows": 10, "secs": 0.2, "sql": "select PROVIDER_CCN, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 having count(*)>1 order by 2 desc limit 10"}
{"label": "filter walk by owner", "rows": 3, "secs": 0.3, "sql": "select case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner, count(*) all_rows, count(distinct PROVIDER_CCN) ccns,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float,1,0)) charity_parses,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0,1,0)) money_parses,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0 and NET_INCOME<=TOTAL_COSTS,1,0)) ni_guard,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0 and NET_INCOME<=TOTAL_COSTS\n                  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) full_year\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "clean rows by owner", "rows": 3, "secs": 0.4, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n) select owner, count(*) n, count(distinct PROVIDER_CCN) ccns, sum(iff(rn=1,1,0)) latest_rows from c group by 1 order by 1"}
{"label": "bmf columns", "rows": 32, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns\n        where table_schema='CORPORATE_REGISTRY' and table_name='CORPORATE_REGISTRY__FED_IRS_EO_BMF' order by ordinal_position"}
{"label": "hcris shape and nan counts", "rows": 1, "secs": 0.3, "sql": "select count(*) rows_, count(distinct PROVIDER_CCN) ccns,\n          sum(iff(NET_INCOME = 'NaN'::float,1,0)) ni_nan,\n          sum(iff(TOTAL_COSTS = 'NaN'::float,1,0)) tc_nan,\n          sum(iff(COST_OF_CHARITY_CARE = 'NaN'::float,1,0)) cc_nan,\n          sum(iff(NET_INCOME > TOTAL_COSTS,1,0)) ni_gt_tc,\n          sum(iff(datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) not between 350 and 380,1,0)) short_or_long,\n          min(FISCAL_YEAR_END_DATE) min_fye, max(FISCAL_YEAR_END_DATE) max_fye,\n          sum(iff(year(FISCAL_YEAR_END_DATE)=2023,1,0)) fye_2023, sum(iff(year(FISCAL_YEAR_END_DATE)=2024,1,0)) fye_2024,\n          sum(iff(year(FISCAL_YEAR_BEGIN_DATE)=2023,1,0)) fyb_2023\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "ccns with 2+ reports", "rows": 10, "secs": 0.3, "sql": "select PROVIDER_CCN, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 having count(*)>1 order by 2 desc limit 10"}
{"label": "filter walk by owner", "rows": 3, "secs": 0.3, "sql": "select case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner, count(*) all_rows, count(distinct PROVIDER_CCN) ccns,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float,1,0)) charity_parses,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0,1,0)) money_parses,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0 and NET_INCOME<=TOTAL_COSTS,1,0)) ni_guard,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0 and NET_INCOME<=TOTAL_COSTS\n                  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) full_year\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "clean rows by owner", "rows": 3, "secs": 0.2, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n) select owner, count(*) n, count(distinct PROVIDER_CCN) ccns, sum(iff(rn=1,1,0)) latest_rows from c group by 1 order by 1"}
{"label": "normalizer sanity", "rows": 1, "secs": 0.2, "sql": "select trim(regexp_replace(regexp_replace(regexp_replace(upper('THE COMMUNITY MEMORIAL HOSPITAL OF ST. LUKES, INC'), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as s,\n        trim(regexp_replace(regexp_replace(regexp_replace(upper('STANFORD HEALTH CARE'), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as s2, trim(regexp_replace(regexp_replace(regexp_replace(upper('CEDARS-SINAI MEDICAL CENTER'), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as s3"}
{"label": "bmf ntee E2x spellings", "rows": 12, "secs": 0.6, "sql": "select NTEE_CODE, count(*) n from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE like 'E2%' group by 1 order by 2 desc limit 12"}
{"label": "tail counts by owner, control code only", "rows": 3, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, count(*) n_clean,\n          sum(iff(NET_INCOME > 50e6,1,0)) n_over_50m,\n          sum(iff(charity_share < 0.01,1,0)) n_under_1pct,\n          sum(iff(NET_INCOME > 50e6 and charity_share < 0.01,1,0)) n_tail,\n          sum(iff(NET_INCOME > 50e6 and COST_OF_CHARITY_CARE <= 0,1,0)) n_over_50m_zero_charity\n        from c where rn=1 group by 1 order by 1"}
{"label": "nonprofit-control tail list", "rows": 89, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE,\n               NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n               charity_share, margin_on_cost\n        from c where rn=1 and owner='nonprofit' and NET_INCOME > 50e6 and charity_share < 0.01 order by NET_INCOME desc"}
{"label": "irs pairs shape", "rows": 1, "secs": 1.1, "sql": "with p as (with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n), b as (select EIN, ORG_NAME, CITY, STATE, NTEE_CODE, SUBSECTION_CODE, trim(regexp_replace(regexp_replace(regexp_replace(upper(ORG_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as bn\n              from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE rlike '^E2[0-2].*'\n              and ORG_NAME not rlike '.*(AUXILIARY|VOLUNTEER|FOUNDATION|GUILD|LEAGUE|FRIENDS|ALUMNI).*'),\n        h as (select c.*, trim(regexp_replace(regexp_replace(regexp_replace(upper(HOSPITAL_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as hn from c where rn=1)\n        select h.*, b.EIN, b.ORG_NAME, b.NTEE_CODE, b.SUBSECTION_CODE, iff(h.hn=b.bn,1,0) exact_name\n        from h join b on upper(h.CITY)=upper(b.CITY) and h.STATE_CODE=b.STATE\n          and length(h.hn)>=6 and length(b.bn)>=6\n          and (h.hn like b.bn||'%' or b.bn like h.hn||'%'))\n        select count(*) pairs, count(distinct EIN) eins, count(distinct PROVIDER_CCN) ccns,\n          count(distinct iff(owner='nonprofit',PROVIDER_CCN,null)) ccn_nonprofit,\n          count(distinct iff(owner='for-profit',PROVIDER_CCN,null)) ccn_forprofit,\n          count(distinct iff(owner='government',PROVIDER_CCN,null)) ccn_gov,\n          sum(exact_name) exact_pairs from p"}
{"label": "irs-matched nonprofit tail list", "rows": 37, "secs": 0.8, "sql": "with p as (with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n), b as (select EIN, ORG_NAME, CITY, STATE, NTEE_CODE, SUBSECTION_CODE, trim(regexp_replace(regexp_replace(regexp_replace(upper(ORG_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as bn\n              from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE rlike '^E2[0-2].*'\n              and ORG_NAME not rlike '.*(AUXILIARY|VOLUNTEER|FOUNDATION|GUILD|LEAGUE|FRIENDS|ALUMNI).*'),\n        h as (select c.*, trim(regexp_replace(regexp_replace(regexp_replace(upper(HOSPITAL_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as hn from c where rn=1)\n        select h.*, b.EIN, b.ORG_NAME, b.NTEE_CODE, b.SUBSECTION_CODE, iff(h.hn=b.bn,1,0) exact_name\n        from h join b on upper(h.CITY)=upper(b.CITY) and h.STATE_CODE=b.STATE\n          and length(h.hn)>=6 and length(b.bn)>=6\n          and (h.hn like b.bn||'%' or b.bn like h.hn||'%')),\n        one as (select PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, owner, NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE,\n                 NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE, charity_share, margin_on_cost,\n                 count(distinct EIN) n_eins, min_by(EIN, iff(exact_name=1,0,1)) ein, min_by(ORG_NAME, iff(exact_name=1,0,1)) bmf_name, max(exact_name) any_exact\n                from p group by all)\n        select * from one where owner='nonprofit' and NET_INCOME > 50e6 and charity_share < 0.01 order by NET_INCOME desc"}
{"label": "irs-matched tail by owner", "rows": 3, "secs": 0.7, "sql": "with p as (with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n), b as (select EIN, ORG_NAME, CITY, STATE, NTEE_CODE, SUBSECTION_CODE, trim(regexp_replace(regexp_replace(regexp_replace(upper(ORG_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as bn\n              from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE rlike '^E2[0-2].*'\n              and ORG_NAME not rlike '.*(AUXILIARY|VOLUNTEER|FOUNDATION|GUILD|LEAGUE|FRIENDS|ALUMNI).*'),\n        h as (select c.*, trim(regexp_replace(regexp_replace(regexp_replace(upper(HOSPITAL_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as hn from c where rn=1)\n        select h.*, b.EIN, b.ORG_NAME, b.NTEE_CODE, b.SUBSECTION_CODE, iff(h.hn=b.bn,1,0) exact_name\n        from h join b on upper(h.CITY)=upper(b.CITY) and h.STATE_CODE=b.STATE\n          and length(h.hn)>=6 and length(b.bn)>=6\n          and (h.hn like b.bn||'%' or b.bn like h.hn||'%'))\n        select owner, count(distinct PROVIDER_CCN) n from p where NET_INCOME > 50e6 and charity_share < 0.01 group by 1"}
{"label": "charity share percentiles by owner", "rows": 3, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, count(*) n,\n          percentile_cont(0.10) within group (order by charity_share) p10,\n          percentile_cont(0.25) within group (order by charity_share) p25,\n          percentile_cont(0.50) within group (order by charity_share) p50,\n          percentile_cont(0.75) within group (order by charity_share) p75,\n          percentile_cont(0.90) within group (order by charity_share) p90,\n          sum(COST_OF_CHARITY_CARE)/sum(TOTAL_COSTS) dollar_weighted_share,\n          sum(iff(COST_OF_CHARITY_CARE<=0,1,0)) n_zero_charity,\n          sum(iff(charity_share<0.01,1,0)) n_under_1pct,\n          sum(NET_INCOME) total_ni, sum(COST_OF_CHARITY_CARE) total_charity, sum(TOTAL_COSTS) total_costs,\n          percentile_cont(0.5) within group (order by COST_OF_UNCOMPENSATED_CARE/TOTAL_COSTS) p50_uncomp_share\n        from c where rn=1 group by 1 order by 1"}
{"label": "charity share by owner x profit bucket", "rows": 15, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, case when NET_INCOME < 0 then '1 loss' when NET_INCOME < 10e6 then '2 $0-10M'\n                     when NET_INCOME < 50e6 then '3 $10-50M' when NET_INCOME < 100e6 then '4 $50-100M' else '5 $100M+' end as profit_bucket, count(*) n,\n          percentile_cont(0.5) within group (order by charity_share) p50_share,\n          sum(COST_OF_CHARITY_CARE)/sum(TOTAL_COSTS) dollar_weighted_share,\n          sum(iff(charity_share<0.01,1,0)) n_under_1pct,\n          sum(NET_INCOME) total_ni, sum(COST_OF_CHARITY_CARE) total_charity\n        from c where rn=1 group by 1,2 order by 1,2"}
{"label": "charity share histogram by owner", "rows": 21, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, case when charity_share <= 0 then '0 zero' when charity_share < 0.005 then '1 0-0.5%' when charity_share < 0.01 then '2 0.5-1%'\n                   when charity_share < 0.02 then '3 1-2%' when charity_share < 0.03 then '4 2-3%' when charity_share < 0.05 then '5 3-5%'\n                   when charity_share < 0.10 then '6 5-10%' else '7 10%+' end as bin, count(*) n from c where rn=1 group by 1,2 order by 1,2"}
{"label": "scatter points, profitable hospitals, top 1200 by NI", "rows": 1200, "secs": 0.4, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, owner, NET_INCOME, charity_share, TOTAL_COSTS\n        from c where rn=1 and NET_INCOME > 0 order by NET_INCOME desc limit 1200"}
{"label": "nonprofits over $50M: how many thin", "rows": 1, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select count(*) n, sum(iff(charity_share<0.01,1,0)) n_under_1pct, sum(iff(charity_share<0.02,1,0)) n_under_2pct,\n          percentile_cont(0.5) within group (order by charity_share) p50\n        from c where rn=1 and owner='nonprofit' and NET_INCOME > 50e6"}
{"label": "bmf columns", "rows": 32, "secs": 1.7, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns\n        where table_schema='CORPORATE_REGISTRY' and table_name='CORPORATE_REGISTRY__FED_IRS_EO_BMF' order by ordinal_position"}
{"label": "hcris shape and nan counts", "rows": 1, "secs": 0.3, "sql": "select count(*) rows_, count(distinct PROVIDER_CCN) ccns,\n          sum(iff(NET_INCOME = 'NaN'::float,1,0)) ni_nan,\n          sum(iff(TOTAL_COSTS = 'NaN'::float,1,0)) tc_nan,\n          sum(iff(COST_OF_CHARITY_CARE = 'NaN'::float,1,0)) cc_nan,\n          sum(iff(NET_INCOME > TOTAL_COSTS,1,0)) ni_gt_tc,\n          sum(iff(datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) not between 350 and 380,1,0)) short_or_long,\n          min(FISCAL_YEAR_END_DATE) min_fye, max(FISCAL_YEAR_END_DATE) max_fye,\n          sum(iff(year(FISCAL_YEAR_END_DATE)=2023,1,0)) fye_2023, sum(iff(year(FISCAL_YEAR_END_DATE)=2024,1,0)) fye_2024,\n          sum(iff(year(FISCAL_YEAR_BEGIN_DATE)=2023,1,0)) fyb_2023\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "ccns with 2+ reports", "rows": 10, "secs": 0.2, "sql": "select PROVIDER_CCN, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 having count(*)>1 order by 2 desc limit 10"}
{"label": "filter walk by owner", "rows": 3, "secs": 0.3, "sql": "select case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner, count(*) all_rows, count(distinct PROVIDER_CCN) ccns,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float,1,0)) charity_parses,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0,1,0)) money_parses,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0 and NET_INCOME<=TOTAL_COSTS,1,0)) ni_guard,\n          sum(iff(COST_OF_CHARITY_CARE <> 'NaN'::float and NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and TOTAL_COSTS>0 and NET_INCOME<=TOTAL_COSTS\n                  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380,1,0)) full_year\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "clean rows by owner", "rows": 3, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n) select owner, count(*) n, count(distinct PROVIDER_CCN) ccns, sum(iff(rn=1,1,0)) latest_rows from c group by 1 order by 1"}
{"label": "normalizer sanity", "rows": 1, "secs": 0.2, "sql": "select trim(regexp_replace(regexp_replace(regexp_replace(upper('THE COMMUNITY MEMORIAL HOSPITAL OF ST. LUKES, INC'), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as s,\n        trim(regexp_replace(regexp_replace(regexp_replace(upper('STANFORD HEALTH CARE'), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as s2, trim(regexp_replace(regexp_replace(regexp_replace(upper('CEDARS-SINAI MEDICAL CENTER'), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as s3"}
{"label": "bmf ntee E2x spellings", "rows": 12, "secs": 0.3, "sql": "select NTEE_CODE, count(*) n from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE like 'E2%' group by 1 order by 2 desc limit 12"}
{"label": "tail counts by owner, control code only", "rows": 3, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, count(*) n_clean,\n          sum(iff(NET_INCOME > 50e6,1,0)) n_over_50m,\n          sum(iff(charity_share < 0.01,1,0)) n_under_1pct,\n          sum(iff(NET_INCOME > 50e6 and charity_share < 0.01,1,0)) n_tail,\n          sum(iff(NET_INCOME > 50e6 and COST_OF_CHARITY_CARE <= 0,1,0)) n_over_50m_zero_charity\n        from c where rn=1 group by 1 order by 1"}
{"label": "nonprofit-control tail list", "rows": 89, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE,\n               NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n               charity_share, margin_on_cost\n        from c where rn=1 and owner='nonprofit' and NET_INCOME > 50e6 and charity_share < 0.01 order by NET_INCOME desc"}
{"label": "irs pairs shape", "rows": 1, "secs": 0.4, "sql": "with p as (with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n), b as (select EIN, ORG_NAME, CITY, STATE, NTEE_CODE, SUBSECTION_CODE, trim(regexp_replace(regexp_replace(regexp_replace(upper(ORG_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as bn\n              from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE rlike '^E2[0-2].*'\n              and ORG_NAME not rlike '.*(AUXILIARY|VOLUNTEER|FOUNDATION|GUILD|LEAGUE|FRIENDS|ALUMNI).*'),\n        h as (select c.*, trim(regexp_replace(regexp_replace(regexp_replace(upper(HOSPITAL_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as hn from c where rn=1)\n        select h.*, b.EIN, b.ORG_NAME, b.NTEE_CODE, b.SUBSECTION_CODE, iff(h.hn=b.bn,1,0) exact_name\n        from h join b on upper(h.CITY)=upper(b.CITY) and h.STATE_CODE=b.STATE\n          and length(h.hn)>=6 and length(b.bn)>=6\n          and (h.hn like b.bn||'%' or b.bn like h.hn||'%'))\n        select count(*) pairs, count(distinct EIN) eins, count(distinct PROVIDER_CCN) ccns,\n          count(distinct iff(owner='nonprofit',PROVIDER_CCN,null)) ccn_nonprofit,\n          count(distinct iff(owner='for-profit',PROVIDER_CCN,null)) ccn_forprofit,\n          count(distinct iff(owner='government',PROVIDER_CCN,null)) ccn_gov,\n          sum(exact_name) exact_pairs from p"}
{"label": "irs-matched nonprofit tail list", "rows": 37, "secs": 0.4, "sql": "with p as (with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n), b as (select EIN, ORG_NAME, CITY, STATE, NTEE_CODE, SUBSECTION_CODE, trim(regexp_replace(regexp_replace(regexp_replace(upper(ORG_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as bn\n              from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE rlike '^E2[0-2].*'\n              and ORG_NAME not rlike '.*(AUXILIARY|VOLUNTEER|FOUNDATION|GUILD|LEAGUE|FRIENDS|ALUMNI).*'),\n        h as (select c.*, trim(regexp_replace(regexp_replace(regexp_replace(upper(HOSPITAL_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as hn from c where rn=1)\n        select h.*, b.EIN, b.ORG_NAME, b.NTEE_CODE, b.SUBSECTION_CODE, iff(h.hn=b.bn,1,0) exact_name\n        from h join b on upper(h.CITY)=upper(b.CITY) and h.STATE_CODE=b.STATE\n          and length(h.hn)>=6 and length(b.bn)>=6\n          and (h.hn like b.bn||'%' or b.bn like h.hn||'%')),\n        one as (select PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, owner, NUMBER_OF_BEDS, FISCAL_YEAR_END_DATE,\n                 NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE, charity_share, margin_on_cost,\n                 count(distinct EIN) n_eins, min_by(EIN, iff(exact_name=1,0,1)) ein, min_by(ORG_NAME, iff(exact_name=1,0,1)) bmf_name, max(exact_name) any_exact\n                from p group by all)\n        select * from one where owner='nonprofit' and NET_INCOME > 50e6 and charity_share < 0.01 order by NET_INCOME desc"}
{"label": "irs-matched tail by owner", "rows": 3, "secs": 0.3, "sql": "with p as (with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n), b as (select EIN, ORG_NAME, CITY, STATE, NTEE_CODE, SUBSECTION_CODE, trim(regexp_replace(regexp_replace(regexp_replace(upper(ORG_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as bn\n              from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE rlike '^E2[0-2].*'\n              and ORG_NAME not rlike '.*(AUXILIARY|VOLUNTEER|FOUNDATION|GUILD|LEAGUE|FRIENDS|ALUMNI).*'),\n        h as (select c.*, trim(regexp_replace(regexp_replace(regexp_replace(upper(HOSPITAL_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as hn from c where rn=1)\n        select h.*, b.EIN, b.ORG_NAME, b.NTEE_CODE, b.SUBSECTION_CODE, iff(h.hn=b.bn,1,0) exact_name\n        from h join b on upper(h.CITY)=upper(b.CITY) and h.STATE_CODE=b.STATE\n          and length(h.hn)>=6 and length(b.bn)>=6\n          and (h.hn like b.bn||'%' or b.bn like h.hn||'%'))\n        select owner, count(distinct PROVIDER_CCN) n from p where NET_INCOME > 50e6 and charity_share < 0.01 group by 1"}
{"label": "charity share percentiles by owner", "rows": 3, "secs": 0.2, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, count(*) n,\n          percentile_cont(0.10) within group (order by charity_share) p10,\n          percentile_cont(0.25) within group (order by charity_share) p25,\n          percentile_cont(0.50) within group (order by charity_share) p50,\n          percentile_cont(0.75) within group (order by charity_share) p75,\n          percentile_cont(0.90) within group (order by charity_share) p90,\n          sum(COST_OF_CHARITY_CARE)/sum(TOTAL_COSTS) dollar_weighted_share,\n          sum(iff(COST_OF_CHARITY_CARE<=0,1,0)) n_zero_charity,\n          sum(iff(charity_share<0.01,1,0)) n_under_1pct,\n          sum(NET_INCOME) total_ni, sum(COST_OF_CHARITY_CARE) total_charity, sum(TOTAL_COSTS) total_costs,\n          percentile_cont(0.5) within group (order by COST_OF_UNCOMPENSATED_CARE/TOTAL_COSTS) p50_uncomp_share\n        from c where rn=1 group by 1 order by 1"}
{"label": "charity share by owner x profit bucket", "rows": 15, "secs": 0.4, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, case when NET_INCOME < 0 then '1 loss' when NET_INCOME < 10e6 then '2 $0-10M'\n                     when NET_INCOME < 50e6 then '3 $10-50M' when NET_INCOME < 100e6 then '4 $50-100M' else '5 $100M+' end as profit_bucket, count(*) n,\n          percentile_cont(0.5) within group (order by charity_share) p50_share,\n          sum(COST_OF_CHARITY_CARE)/sum(TOTAL_COSTS) dollar_weighted_share,\n          sum(iff(charity_share<0.01,1,0)) n_under_1pct,\n          sum(NET_INCOME) total_ni, sum(COST_OF_CHARITY_CARE) total_charity\n        from c where rn=1 group by 1,2 order by 1,2"}
{"label": "charity share histogram by owner", "rows": 21, "secs": 0.2, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select owner, case when charity_share <= 0 then '0 zero' when charity_share < 0.005 then '1 0-0.5%' when charity_share < 0.01 then '2 0.5-1%'\n                   when charity_share < 0.02 then '3 1-2%' when charity_share < 0.03 then '4 2-3%' when charity_share < 0.05 then '5 3-5%'\n                   when charity_share < 0.10 then '6 5-10%' else '7 10%+' end as bin, count(*) n from c where rn=1 group by 1,2 order by 1,2"}
{"label": "scatter points, profitable hospitals, top 1200 by NI", "rows": 1200, "secs": 0.5, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select PROVIDER_CCN, HOSPITAL_NAME, STATE_CODE, owner, NET_INCOME, charity_share, TOTAL_COSTS\n        from c where rn=1 and NET_INCOME > 0 order by NET_INCOME desc limit 1200"}
{"label": "nonprofits over $50M: how many thin", "rows": 1, "secs": 0.2, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select count(*) n, sum(iff(charity_share<0.01,1,0)) n_under_1pct, sum(iff(charity_share<0.02,1,0)) n_under_2pct,\n          percentile_cont(0.5) within group (order by charity_share) p50\n        from c where rn=1 and owner='nonprofit' and NET_INCOME > 50e6"}
{"label": "who fills S-10 charity, by owner", "rows": 6, "secs": 0.3, "sql": "select case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner, iff(COST_OF_CHARITY_CARE <> 'NaN'::float,'charity parses','charity NaN') fill,\n          count(*) n, median(TOTAL_COSTS) med_costs, median(NUMBER_OF_BEDS) med_beds,\n          sum(iff(NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and NET_INCOME>50e6,1,0)) n_over_50m\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS where TOTAL_COSTS <> 'NaN'::float group by 1,2 order by 1,2"}
{"label": "tail vs rest of nonprofits, wider measures", "rows": 2, "secs": 0.3, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n)\n        select iff(NET_INCOME > 50e6 and charity_share < 0.01,'tail','rest') grp, count(*) n,\n          percentile_cont(0.5) within group (order by charity_share) p50_charity,\n          percentile_cont(0.5) within group (order by COST_OF_UNCOMPENSATED_CARE/TOTAL_COSTS) p50_uncomp,\n          percentile_cont(0.5) within group (order by TOTAL_BAD_DEBT_EXPENSE/TOTAL_COSTS) p50_baddebt,\n          sum(NET_INCOME) total_ni, sum(COST_OF_CHARITY_CARE) total_charity, sum(TOTAL_COSTS) total_costs\n        from c where rn=1 and owner='nonprofit' group by 1"}
{"label": "nonprofit-control tail not matched to IRS", "rows": 52, "secs": 0.7, "sql": "with c as (\nselect PROVIDER_CCN, HOSPITAL_NAME, CITY, STATE_CODE, TYPE_OF_CONTROL, case when TYPE_OF_CONTROL in ('1','2') then 'nonprofit'\n                when TYPE_OF_CONTROL in ('3','4','5','6') then 'for-profit'\n                when TYPE_OF_CONTROL in ('7','8','9','10','11','12','13') then 'government' else 'unknown' end as owner,\n       NUMBER_OF_BEDS, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE,\n       NET_INCOME, TOTAL_COSTS, COST_OF_CHARITY_CARE, TOTAL_BAD_DEBT_EXPENSE, COST_OF_UNCOMPENSATED_CARE,\n       COST_OF_CHARITY_CARE / TOTAL_COSTS as charity_share,\n       NET_INCOME / TOTAL_COSTS as margin_on_cost,\n       row_number() over (partition by PROVIDER_CCN order by FISCAL_YEAR_END_DATE desc) rn\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS\nwhere NET_INCOME <> 'NaN'::float and TOTAL_COSTS <> 'NaN'::float and COST_OF_CHARITY_CARE <> 'NaN'::float\n  and TOTAL_COSTS > 0 and NET_INCOME <= TOTAL_COSTS\n  and datediff(day, FISCAL_YEAR_BEGIN_DATE, FISCAL_YEAR_END_DATE) between 350 and 380\n), b as (select EIN, ORG_NAME, CITY, STATE, NTEE_CODE, SUBSECTION_CODE, trim(regexp_replace(regexp_replace(regexp_replace(upper(ORG_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as bn\n              from LIBRARY_MARTS.CORPORATE_REGISTRY.CORPORATE_REGISTRY__FED_IRS_EO_BMF where NTEE_CODE rlike '^E2[0-2].*'\n              and ORG_NAME not rlike '.*(AUXILIARY|VOLUNTEER|FOUNDATION|GUILD|LEAGUE|FRIENDS|ALUMNI).*'),\n        h as (select c.*, trim(regexp_replace(regexp_replace(regexp_replace(upper(HOSPITAL_NAME), '[^A-Z0-9 ]', ' '), '\\\\b(THE|OF|AND|INC|LLC|CORP|CORPORATION|HOSPITAL|HOSPITALS|MEDICAL|CENTER|CENTRE|HEALTH|HEALTHCARE|SYSTEM|SERVICES|REGIONAL|COMMUNITY|MEMORIAL|GENERAL|ASSOCIATION|FOUNDATION|DBA)\\\\b', ' '), ' +', ' ')) as hn from c where rn=1 and owner='nonprofit' and NET_INCOME > 50e6 and charity_share < 0.01),\n        m as (select distinct h.PROVIDER_CCN from h join b on upper(h.CITY)=upper(b.CITY) and h.STATE_CODE=b.STATE\n                and length(h.hn)>=6 and length(b.bn)>=6 and (h.hn like b.bn||'%' or b.bn like h.hn||'%'))\n        select h.PROVIDER_CCN, h.HOSPITAL_NAME, h.CITY, h.STATE_CODE, h.NET_INCOME, h.charity_share\n        from h left join m using (PROVIDER_CCN) where m.PROVIDER_CCN is null order by NET_INCOME desc"}
