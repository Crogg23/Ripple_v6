ient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate, p.OPIOID_LA_PRSCRBR_RATE la_rate,\n   coalesce(y.usd,0) usd, y.NPI is not null paid,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n , s as (select PRSCRBR_TYPE, sum(case when paid then 1 end) n_paid, sum(case when not paid then 1 end) n_unpaid,\n   avg(case when paid then rate end) r_paid, avg(case when not paid then rate end) r_unpaid from j group by 1)\n select sum(n_paid*r_paid)/sum(case when r_paid is not null then n_paid end) paid_actual,\n        sum(n_paid*r_unpaid)/sum(case when r_unpaid is not null then n_paid end) unpaid_at_paid_mix,\n        sum(n_unpaid*r_unpaid)/sum(case when r_unpaid is not null then n_unpaid end) unpaid_actual from s"}
{"label": "PY2024 targeting by specialty", "rows": 21, "secs": 2.7, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, count(*) n_pay,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate, p.OPIOID_LA_PRSCRBR_RATE la_rate,\n   coalesce(y.usd,0) usd, y.NPI is not null paid,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select case when PRSCRBR_TYPE in ('Nurse Practitioner','Physician Assistant','Dentist','Internal Medicine','Family Practice') then PRSCRBR_TYPE else 'other specialties' end spec, grp, count(*) n,\n   avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(la_rate) mean_la,\n   avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot, median(usd_op) med_usd_op,\n   sum(opc) opioid_clms, sum(tot) all_clms\n from j group by grouping sets ((spec, grp),(grp)) order by 1,2"}
{"label": "PY2024 top5 specialty x all-money band", "rows": 15, "secs": 1.0, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, count(*) n_pay,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate, p.OPIOID_LA_PRSCRBR_RATE la_rate,\n   coalesce(y.usd,0) usd, y.NPI is not null paid,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select PRSCRBR_TYPE, case when not paid then 'unpaid' when usd<2000 then 'paid under $2k' else 'paid $2k+' end band, count(*) n,\n  avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot\n from j where PRSCRBR_TYPE in ('Nurse Practitioner','Physician Assistant','Dentist','Internal Medicine','Family Practice') group by 1,2 order by 1,2"}
{"label": "PY2024 dose response within opioid-paid", "rows": 5, "secs": 1.6, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, count(*) n_pay,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate, p.OPIOID_LA_PRSCRBR_RATE la_rate,\n   coalesce(y.usd,0) usd, y.NPI is not null paid,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n , d as (select *, ntile(5) over (order by usd_op) q from j where grp like '2%')\n select q, count(*) n, min(usd_op) lo, max(usd_op) hi, median(usd_op) med_usd, median(n_op) med_npay, avg(rate) mean_rate, median(rate) med_rate,\n   sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot from d group by 1 order by 1"}
{"label": "PY2024 who pays on opioid brands", "rows": 9, "secs": 0.9, "sql": "select APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, count(*) n_pay, count(distinct NPI) npi_d,\n   sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, median(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) med_usd,\n   sum(case when NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE='Food and Beverage' then 1 else 0 end)/count(*) food_share\n from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' and regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*')\n group by 1 order by 2 desc limit 12"}
{"label": "PY2024 opioid brand names matched", "rows": 13, "secs": 0.7, "sql": "select upper(trim(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1)) name, count(*) n_pay, count(distinct NPI) npi_d\n from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where regexp_like(upper(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') group by 1 order by 2 desc limit 25"}
{"label": "PY2024 suppression-bounded group rates", "rows": 3, "secs": 1.4, "sql": "with pay as (select NPI, sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select grp, count(*) n, avg(case when rate is null then 1.0 else 0 end) share_null, avg(case when opc=0 then 1.0 else 0 end) share_zero,\n  sum(coalesce(opc,1))/sum(tot)*100 agg_lo, sum(coalesce(opc,10))/sum(tot)*100 agg_hi, sum(opc)/sum(case when opc is not null then tot end)*100 agg_nonnull\n from j group by 1 order by 1"}
{"label": "PY2024 opioid-paid group by specialty", "rows": 12, "secs": 1.4, "sql": "with pay as (select NPI, sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select PRSCRBR_TYPE, count(*) n, avg(rate) mean_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate from j where grp like '2%' group by 1 order by 2 desc limit 12"}
{"label": "PY2024 groups standardised to opioid-maker specialty mix (claim-weighted), brand-only regex", "rows": 3, "secs": 3.5, "sql": "with pay as (select NPI, sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n , s as (select PRSCRBR_TYPE, grp, sum(opc) opc, sum(tot) tot, count(*) n from j group by 1,2),\n w as (select PRSCRBR_TYPE, tot w from s where grp like '2%')\n select s.grp, sum(w.w * s.opc/nullif(s.tot,0))/sum(case when s.tot>0 then w.w end)*100 agg_at_opioid_mix, count(*) n_spec\n from s join w using (PRSCRBR_TYPE) group by 1 order by 1"}
{"label": "PY2024 matched specialties, brand-only regex", "rows": 24, "secs": 1.3, "sql": "with pay as (select NPI, sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select PRSCRBR_TYPE, grp, count(*) n, sum(opc)/nullif(sum(tot),0)*100 agg_rate from j\n where PRSCRBR_TYPE in ('Nurse Practitioner','Physician Assistant','Pain Management','Interventional Pain Management','Anesthesiology','Physical Medicine and Rehabilitation','Family Practice','Internal Medicine')\n group by 1,2 order by 1,2"}
{"label": "PY2024 opioid-claims share bounds", "rows": 1, "secs": 1.6, "sql": "with pay as (select NPI, sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select sum(case when grp like '2%' then opc end) op_clms, sum(opc) op_all_nonnull, sum(coalesce(opc,10)) op_all_hi, sum(case when grp like '2%' then 1 end) n,\n  sum(case when grp like '2%' then opc end)/sum(opc)*100 share_hi, sum(case when grp like '2%' then coalesce(opc,1) end)/sum(coalesce(opc,10))*100 share_lo from j"}
