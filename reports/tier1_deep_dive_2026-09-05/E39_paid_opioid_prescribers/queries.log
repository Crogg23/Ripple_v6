{"label": "mart tables", "rows": 12, "secs": 2.0, "sql": "select table_schema, table_name, row_count from LIBRARY_MARTS.information_schema.tables\n where table_name ilike '%OPEN_PAYMENTS%' or table_name ilike '%PART_D%' or table_name ilike '%PARTD%' order by 1,2"}
{"label": "landing tables", "rows": 6, "secs": 1.6, "sql": "select table_name, row_count from LIBRARY_RAW.information_schema.tables\n where table_schema='LANDING' and (table_name ilike '%OPEN_PAYMENTS%' or table_name ilike '%PARTD%' or table_name ilike '%PART_D%') order by 1"}
{"label": "cols HEALTH__FED_CMS_OPEN_PAYMENTS", "rows": 22, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_OPEN_PAYMENTS' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_PART_D_PRESCRIBERS", "rows": 84, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_PART_D_PRESCRIBERS' order by ordinal_position"}
{"label": "pd sanity", "rows": 1, "secs": 0.8, "sql": "select count(*) n, count(distinct NPI) npi_d, count(OPIOID_PRSCRBR_RATE) rate_nn,\n count(try_to_number(OPIOID_TOT_CLMS)) op_clm_nn, count(try_to_number(TOT_CLMS)) tot_nn,\n sum(case when OPIOID_TOT_CLMS='' then 1 end) op_blank, min(length(NPI)) l1, max(length(NPI)) l2 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS"}
{"label": "pd ent cd", "rows": 2, "secs": 0.5, "sql": "select PRSCRBR_ENT_CD, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS group by 1"}
{"label": "pd top types", "rows": 15, "secs": 0.6, "sql": "select PRSCRBR_TYPE, count(*) n, avg(OPIOID_PRSCRBR_RATE) r from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS group by 1 order by 2 desc limit 15"}
{"label": "pd sample", "rows": 5, "secs": 0.7, "sql": "select NPI, PRSCRBR_TYPE, TOT_CLMS, OPIOID_TOT_CLMS, OPIOID_PRSCRBR_RATE, OPIOID_TOT_BENES from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS limit 5"}
{"label": "op undated years", "rows": 1, "secs": 0.7, "sql": "select PROGRAM_YEAR, count(*) n, count(NPI) npi_nn, count(distinct NPI) npi_d, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 order by 1"}
{"label": "op 2022 years", "rows": 1, "secs": 0.5, "sql": "select PROGRAM_YEAR, count(*) n, count(distinct NPI) npi_d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 group by 1"}
{"label": "op 2023 years", "rows": 1, "secs": 0.7, "sql": "select PROGRAM_YEAR, count(*) n, count(distinct NPI) npi_d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 group by 1"}
{"label": "op recipient type", "rows": 3, "secs": 0.3, "sql": "select COVERED_RECIPIENT_TYPE, count(*) n, count(NPI) npi_nn from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 order by 2 desc"}
{"label": "op nature", "rows": 12, "secs": 0.5, "sql": "select NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE, count(*) n, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS group by 1 order by 2 desc limit 12"}
{"label": "pd null meaning", "rows": 3, "secs": 0.6, "sql": "select case when OPIOID_TOT_CLMS='0' then 'zero' when OPIOID_TOT_CLMS='' then 'blank' else 'positive' end k,\n count(*) n, min(try_to_number(TOT_CLMS)) min_tot, median(try_to_number(TOT_CLMS)) med_tot, min(try_to_number(OPIOID_TOT_CLMS)) min_op\n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS group by 1"}
{"label": "paid vs unpaid 2022", "rows": 2, "secs": 2.2, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        p.OPIOID_LA_PRSCRBR_RATE la_rate, coalesce(y.usd,0) usd, coalesce(y.n_pay,0) n_pay, y.NPI is not null paid\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select paid, count(*) n, count(rate) n_rate, avg(rate) mean_rate, median(rate) med_rate,\n  sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(la_rate) mean_la,\n  avg(case when rate>=10 then 1.0 else 0 end) share_ge10, avg(case when opc=0 then 1.0 else 0 end) share_zero,\n  avg(case when rate is null then 1.0 else 0 end) share_null, median(tot) med_tot\n from j group by 1 order by 1"}
{"label": "pd null meaning", "rows": 3, "secs": 0.2, "sql": "select case when OPIOID_TOT_CLMS='0' then 'zero' when OPIOID_TOT_CLMS='' then 'blank' else 'positive' end k,\n count(*) n, min(try_to_number(TOT_CLMS)) min_tot, median(try_to_number(TOT_CLMS)) med_tot, min(try_to_number(OPIOID_TOT_CLMS)) min_op\n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS group by 1"}
{"label": "paid vs unpaid 2022", "rows": 2, "secs": 0.3, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        p.OPIOID_LA_PRSCRBR_RATE la_rate, coalesce(y.usd,0) usd, coalesce(y.n_pay,0) n_pay, y.NPI is not null paid\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select paid, count(*) n, count(rate) n_rate, avg(rate) mean_rate, median(rate) med_rate,\n  sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(la_rate) mean_la,\n  avg(case when rate>=10 then 1.0 else 0 end) share_ge10, avg(case when opc=0 then 1.0 else 0 end) share_zero,\n  avg(case when rate is null then 1.0 else 0 end) share_null, median(tot) med_tot\n from j group by 1 order by 1"}
{"label": "deciles 2022", "rows": 11, "secs": 1.4, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        p.OPIOID_LA_PRSCRBR_RATE la_rate, coalesce(y.usd,0) usd, coalesce(y.n_pay,0) n_pay, y.NPI is not null paid\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n , d as (select *, case when not paid then 0 else ntile(10) over (partition by paid order by usd) end dec from j)\n select dec, count(*) n, min(usd) usd_lo, max(usd) usd_hi, median(usd) usd_med,\n  avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate,\n  avg(case when rate>=10 then 1.0 else 0 end) share_ge10, avg(case when rate is null then 1.0 else 0 end) share_null, median(tot) med_tot\n from d group by 1 order by 1"}
{"label": "specialty x paid 2022", "rows": 24, "secs": 2.8, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        p.OPIOID_LA_PRSCRBR_RATE la_rate, coalesce(y.usd,0) usd, coalesce(y.n_pay,0) n_pay, y.NPI is not null paid\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select PRSCRBR_TYPE, paid, count(*) n, avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate,\n  avg(case when rate>=10 then 1.0 else 0 end) share_ge10, avg(case when rate is null then 1.0 else 0 end) share_null, median(tot) med_tot\n from j where PRSCRBR_TYPE in (select PRSCRBR_TYPE from j group by 1 order by count(*) desc limit 12)\n group by 1,2 order by 1,2"}
{"label": "direct standardisation 2022", "rows": 1, "secs": 1.1, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        p.OPIOID_LA_PRSCRBR_RATE la_rate, coalesce(y.usd,0) usd, coalesce(y.n_pay,0) n_pay, y.NPI is not null paid\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n , s as (select PRSCRBR_TYPE, sum(case when paid then 1 end) n_paid, sum(case when not paid then 1 end) n_unpaid,\n   avg(case when paid then rate end) r_paid, avg(case when not paid then rate end) r_unpaid from j group by 1)\n select sum(n_paid*r_paid)/sum(case when r_paid is not null then n_paid end) paid_actual,\n        sum(n_paid*r_unpaid)/sum(case when r_unpaid is not null then n_paid end) unpaid_at_paid_mix,\n        sum(n_unpaid*r_unpaid)/sum(case when r_unpaid is not null then n_unpaid end) unpaid_actual\n from s"}
{"label": "top decile specialty mix 2022", "rows": 24, "secs": 9.5, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        coalesce(y.usd,0) usd, y.NPI is not null paid, case when y.NPI is null then 'unpaid' when y.usd<2032.73 then 'paid_under_2k' else 'paid_top_decile' end band\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select band, PRSCRBR_TYPE, count(*) n, avg(rate) mean_rate from j group by 1,2 qualify row_number() over (partition by band order by count(*) desc)<=8 order by 1,3 desc"}
{"label": "top decile specialty mix 2022", "rows": 24, "secs": 0.3, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        coalesce(y.usd,0) usd, y.NPI is not null paid, case when y.NPI is null then 'unpaid' when y.usd<2032.73 then 'paid_under_2k' else 'paid_top_decile' end band\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select band, PRSCRBR_TYPE, count(*) n, avg(rate) mean_rate from j group by 1,2 qualify row_number() over (partition by band order by count(*) desc)<=8 order by 1,3 desc"}
{"label": "top5 specialty x band 2022", "rows": 15, "secs": 2.4, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        coalesce(y.usd,0) usd, y.NPI is not null paid, case when y.NPI is null then 'unpaid' when y.usd<2032.73 then 'paid_under_2k' else 'paid_top_decile' end band\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select PRSCRBR_TYPE, band, count(*) n, avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate,\n  avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot\n from j where PRSCRBR_TYPE in ('Nurse Practitioner','Physician Assistant','Dentist','Internal Medicine','Family Practice')\n group by 1,2 order by 1,2"}
{"label": "paid vs unpaid 2023", "rows": 2, "secs": 1.0, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        coalesce(y.usd,0) usd, y.NPI is not null paid, case when y.NPI is null then 'unpaid' when y.usd<2032.73 then 'paid_under_2k' else 'paid_top_decile' end band\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select paid, count(*) n, avg(rate) mean_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(case when rate>=10 then 1.0 else 0 end) share_ge10 from j group by 1 order by 1"}
{"label": "suppression-bounded aggregate 2022", "rows": 2, "secs": 1.3, "sql": "with pay as (select NPI, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) usd, count(*) n_pay from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n        coalesce(y.usd,0) usd, y.NPI is not null paid, case when y.NPI is null then 'unpaid' when y.usd<2032.73 then 'paid_under_2k' else 'paid_top_decile' end band\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select paid, count(*) n,\n  sum(coalesce(opc, 1))/sum(tot)*100 agg_lo, sum(coalesce(opc,10))/sum(tot)*100 agg_hi, sum(opc)/sum(case when opc is not null then tot end)*100 agg_nonnull\n from j group by 1 order by 1"}
{"label": "landing drug cols", "rows": 22, "secs": 1.1, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_CMS_OPEN_PAYMENTS_2022' and (column_name ilike '%DRUG%' or column_name ilike '%PRODUCT%' or column_name ilike 'NPI%' or column_name ilike '%_NPI%') order by 1"}
{"label": "registry tables", "rows": 20, "secs": 1.6, "sql": "select table_catalog, table_schema, table_name from LIBRARY_MARTS.information_schema.tables where table_name ilike '%REGISTRY%' or table_name ilike '%FRESHNESS%' limit 20"}
{"label": "opioid brand names in OP 2022", "rows": 20, "secs": 1.2, "sql": "select upper(trim(n)) name, count(*) n_pay, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, count(distinct NPI) npi_d\n from (select NPI, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS, NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1 n from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS_2022\n       union all select NPI, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS, NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2 from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS_2022)\n where regexp_like(upper(n), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') group by 1 order by 2 desc limit 40"}
{"label": "targeting: opioid-maker paid vs other paid vs unpaid 2022", "rows": 21, "secs": 2.5, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate, p.OPIOID_LA_PRSCRBR_RATE la_rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select case when PRSCRBR_TYPE in ('Nurse Practitioner','Physician Assistant','Dentist','Internal Medicine','Family Practice') then PRSCRBR_TYPE else 'ALL' end spec,\n   grp, count(*) n, avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(la_rate) mean_la,\n   avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot, median(usd_op) med_usd_op\n from j group by grouping sets ((spec, grp),(grp)) order by 1,2"}
{"label": "targeting replicated on OP 2023", "rows": 3, "secs": 2.3, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS_2023 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op, y.usd\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select grp, count(*) n, avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate,\n   avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot from j group by 1 order by 1"}
{"label": "share of all opioid claims by group 2022", "rows": 3, "secs": 1.3, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op, y.usd\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select grp, count(*) n, sum(opc) opioid_clms, sum(tot) all_clms, sum(opc)/sum(sum(opc)) over () share_of_opioid_clms, count(*)/sum(count(*)) over () share_of_prescribers\n from j group by 1 order by 1"}
{"label": "dose response within opioid-paid 2022", "rows": 5, "secs": 1.8, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op, y.usd\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n , d as (select *, ntile(5) over (order by usd_op) q from j where grp like '2%')\n select q, count(*) n, min(usd_op) lo, max(usd_op) hi, median(usd_op) med_usd, median(n_op) med_npay, avg(rate) mean_rate, median(rate) med_rate,\n   sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot from d group by 1 order by 1"}
{"label": "who pays on opioid brands 2022", "rows": 9, "secs": 0.9, "sql": "select APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer, count(*) n_pay, count(distinct NPI) npi_d,\n   sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, median(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) med_usd,\n   sum(case when NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE='Food and Beverage' then 1 else 0 end)/count(*) food_share\n from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS_2022 where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' and regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*')\n group by 1 order by 2 desc limit 12"}
{"label": "raw registry tables", "rows": 2, "secs": 1.5, "sql": "select table_catalog, table_schema, table_name from LIBRARY_RAW.information_schema.tables where table_name ilike '%SOURCE%' or table_name ilike '%WATERMARK%' limit 20"}
{"label": "pd landing audit cols", "rows": 3, "secs": 2.0, "sql": "select column_name from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_CMS_PART_D_PRESCRIBERS' and column_name like '\\\\_%' escape '\\\\' or (table_schema='LANDING' and table_name='FED_CMS_PART_D_PRESCRIBERS' and column_name ilike '%INGEST%')"}
{"label": "FED_CMS_PART_D_PRESCRIBERS run ids", "rows": 8, "secs": 0.5, "sql": "select 'FED_CMS_PART_D_PRESCRIBERS' t, _SOURCE_RUN_ID, _SRC_SHA256, min(_INGESTED_AT) mn, max(_INGESTED_AT) mx, count(*) n from LIBRARY_RAW.LANDING.FED_CMS_PART_D_PRESCRIBERS group by 1,2,3"}
{"label": "FED_CMS_PARTD_PRESCRIBER_DRUG run ids", "rows": 1, "secs": 0.5, "sql": "select 'FED_CMS_PARTD_PRESCRIBER_DRUG' t, _SOURCE_RUN_ID, _SRC_SHA256, min(_INGESTED_AT) mn, max(_INGESTED_AT) mx, count(*) n from LIBRARY_RAW.LANDING.FED_CMS_PARTD_PRESCRIBER_DRUG group by 1,2,3"}
{"label": "ingest runs for both Part D tables", "rows": 2, "secs": 0.7, "sql": "select * from LIBRARY_META.INGEST_LOGS.INGEST_RUNS where RUN_ID='3c2495ce-6c28-437d-9c8c-5eae5dd9ebeb' or RUN_ID='431c13fc-5535-493a-9536-fe7c55070255'"}
{"label": "PY2024 paid vs unpaid", "rows": 2, "secs": 1.5, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, count(*) n_pay,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate, p.OPIOID_LA_PRSCRBR_RATE la_rate,\n   coalesce(y.usd,0) usd, y.NPI is not null paid,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n select paid, count(*) n, count(rate) n_rate, avg(rate) mean_rate, median(rate) med_rate, sum(opc)/nullif(sum(tot),0)*100 agg_rate,\n  avg(case when rate>=10 then 1.0 else 0 end) share_ge10, avg(case when rate is null then 1.0 else 0 end) share_null, median(tot) med_tot\n from j group by 1 order by 1"}
{"label": "PY2024 deciles of all-industry money", "rows": 11, "secs": 1.5, "sql": "with pay as (select NPI, sum(try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS)) usd, count(*) n_pay,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then try_to_number(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) else 0 end) usd_op,\n   sum(case when regexp_like(upper(coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_1,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_2,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_3,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_4,'') || '|' || coalesce(NAME_OF_DRUG_OR_BIOLOGICAL_OR_DEVICE_OR_MEDICAL_SUPPLY_5,'')), '.*(OXYCONTIN|XTAMPZA|NUCYNTA|BELBUCA|HYSINGLA|BUTRANS|SUBSYS|ROXYBOND|APADAZ|OXAYDO|ZOHYDRO|ARYMO|MORPHABOND|CONZIP|DSUVIA|PERCOCET|EMBEDA|EXALGO|DURAGESIC|ABSTRAL|FENTORA|LAZANDA|ACTIQ|OLINVYK|SEGLENTIS|ULTRAM|ROXICODONE|OXAYDO|KADIAN|MS CONTIN|DILAUDID|OPANA|VICODIN|NORCO|LORTAB|TRAMADOL|OXYCODONE|HYDROCODONE|MORPHINE|FENTANYL|HYDROMORPHONE|TAPENTADOL|OXYMORPHONE|BUPRENORPHINE).*') then 1 else 0 end) n_op\n   from LIBRARY_RAW.LANDING.FED_CMS_OPEN_PAYMENTS where COVERED_RECIPIENT_TYPE<>'Covered Recipient Teaching Hospital' group by 1),\n j as (select p.NPI, p.PRSCRBR_TYPE, try_to_number(p.TOT_CLMS) tot, try_to_number(p.OPIOID_TOT_CLMS) opc, p.OPIOID_PRSCRBR_RATE rate, p.OPIOID_LA_PRSCRBR_RATE la_rate,\n   coalesce(y.usd,0) usd, y.NPI is not null paid,\n   case when y.NPI is null then '0 unpaid' when y.n_op=0 then '1 paid, no opioid brand' else '2 paid by opioid maker' end grp, y.usd_op, y.n_op\n   from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_PART_D_PRESCRIBERS p left join pay y on y.NPI=p.NPI)\n , d as (select *, case when not paid then 0 else ntile(10) over (partition by paid order by usd) end dec from j)\n select dec, count(*) n, min(usd) usd_lo, max(usd) usd_hi, median(usd) usd_med, avg(rate) mean_rate, median(rate) med_rate,\n  sum(opc)/nullif(sum(tot),0)*100 agg_rate, avg(case when rate>=10 then 1.0 else 0 end) share_ge10, median(tot) med_tot\n from d group by 1 order by 1"}
