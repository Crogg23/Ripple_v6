{"label": "Part B individual billers by enumeration year", "rows": 20, "secs": 0.2, "sql": "select year(n.PROVIDER_ENUMERATION_DATE) enum_year, count(*) partb_billers\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' group by 1 order by 1"}
{"label": "skin dollars by state, new vs veteran", "rows": 69, "secs": 0.3, "sql": "select s.RNDRNG_PRVDR_STATE_ABRVTN st,\n       iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n       count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = s.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1,2"}
{"label": "top 10 new NPIs by skin dollars", "rows": 10, "secs": 1.6, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed, sum(try_to_number(s.TOT_SRVCS,18,6)) units,\n         count(distinct s.HCPCS_CD) codes\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect k.RNDRNG_NPI npi, p.RNDRNG_PRVDR_LAST_ORG_NAME last_name, p.RNDRNG_PRVDR_FIRST_NAME first_name,\n       p.RNDRNG_PRVDR_TYPE ptype, p.RNDRNG_PRVDR_STATE_ABRVTN st, p.RNDRNG_PRVDR_CITY city,\n       n.enum_dt, k.skin_allowed, p.TOT_MDCR_ALOWD_AMT total_allowed, p.TOT_MDCR_PYMT_AMT total_paid,\n       try_to_number(p.TOT_BENES,18,0) benes, k.units, k.codes\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI join newnpi n on n.NPI = k.RNDRNG_NPI\norder by k.skin_allowed desc limit 10"}
{"label": "concentration among new skin billers", "rows": 1, "secs": 1.3, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), r as (select a, row_number() over (order by a desc) rn from skin)\nselect sum(iff(rn<=10,a,0)) top10, sum(iff(rn<=50,a,0)) top50, sum(a) total, count(*) npis,\n       sum(iff(a>=1000000,1,0)) over_1m\nfrom r"}
{"label": "dollars per beneficiary new vs veteran skin billers", "rows": 2, "secs": 2.5, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed,\n         sum(try_to_number(TOT_BENES,18,0)) skin_bene_lines\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), j as (\n  select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n         p.TOT_MDCR_ALOWD_AMT allowed, try_to_number(p.TOT_BENES,18,0) benes,\n         k.skin_allowed, k.skin_bene_lines\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\n  join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\n)\nselect grp, count(*) npis,\n       median(allowed/nullif(benes,0)) med_allowed_per_bene,\n       sum(allowed)/sum(benes) pooled_allowed_per_bene,\n       median(skin_allowed/nullif(skin_bene_lines,0)) med_skin_per_skin_bene,\n       sum(skin_allowed)/sum(skin_bene_lines) pooled_skin_per_skin_bene,\n       median(skin_allowed/allowed) med_skin_share,\n       sum(iff(skin_allowed/allowed > 0.5,1,0)) majority_skin,\n       sum(iff(allowed/nullif(benes,0) > 100000,1,0)) over_100k_per_bene\nfrom j group by 1 order by 1"}
{"label": "per-bene, NP/PA only", "rows": 2, "secs": 1.3, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), j as (\n  select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp, p.RNDRNG_PRVDR_TYPE ptype,\n         p.TOT_MDCR_ALOWD_AMT allowed, try_to_number(p.TOT_BENES,18,0) benes, k.skin_allowed\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\n  join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\n  where p.RNDRNG_PRVDR_TYPE in ('Nurse Practitioner','Physician Assistant')\n)\nselect grp, count(*) npis, median(allowed/nullif(benes,0)) med_allowed_per_bene,\n       sum(allowed)/sum(benes) pooled_allowed_per_bene, sum(skin_allowed) skin_allowed\nfrom j group by 1 order by 1"}
{"label": "provider type of new skin billers", "rows": 4, "secs": 1.0, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect p.RNDRNG_PRVDR_TYPE ptype, count(*) npis, sum(k.a) skin_allowed\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI group by 1 order by 3 desc limit 8"}
{"label": "key checks", "rows": 3, "secs": 0.3, "sql": "select 'prov' as t, count(*) n, count(distinct RNDRNG_NPI) d, min(length(RNDRNG_NPI)) mn, max(length(RNDRNG_NPI)) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER\nunion all\nselect 'nppes', count(*), count(distinct NPI), min(length(NPI)), max(length(NPI)) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES\nunion all\nselect 'svc', count(*), count(distinct RNDRNG_NPI), min(length(RNDRNG_NPI)), max(length(RNDRNG_NPI)) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI"}
{"label": "nppes entity type + enumeration range", "rows": 3, "secs": 0.2, "sql": "select ENTITY_TYPE_CODE, count(*) n, min(PROVIDER_ENUMERATION_DATE) mn, max(PROVIDER_ENUMERATION_DATE) mx,\n       sum(iff(PROVIDER_ENUMERATION_DATE is null,1,0)) null_dt\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES group by 1 order by 1"}
{"label": "carbon date both files", "rows": 6, "secs": 0.3, "sql": "select 'prov' f, year(n.PROVIDER_ENUMERATION_DATE) y, count(distinct p.RNDRNG_NPI) npis\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI\nwhere year(n.PROVIDER_ENUMERATION_DATE) >= 2022 group by 1,2\nunion all\nselect 'svc', year(n.PROVIDER_ENUMERATION_DATE), count(distinct s.RNDRNG_NPI)\nfrom (select distinct RNDRNG_NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI) s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = s.RNDRNG_NPI\nwhere year(n.PROVIDER_ENUMERATION_DATE) >= 2022 group by 1,2\norder by 1,2"}
{"label": "top1% split new vs veteran (loose number)", "rows": 2, "secs": 0.3, "sql": "with ind as (\n  select RNDRNG_NPI, TOT_MDCR_ALOWD_AMT, try_to_number(TOT_BENES,18,0) benes, RNDRNG_PRVDR_TYPE, RNDRNG_PRVDR_STATE_ABRVTN st\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER where RNDRNG_PRVDR_ENT_CD = 'I'\n), ranked as (\n  select *, percent_rank() over (order by TOT_MDCR_ALOWD_AMT desc) pr from ind\n), top1 as (\n  select r.*, n.PROVIDER_ENUMERATION_DATE enum_dt,\n         iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp\n  from ranked r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = r.RNDRNG_NPI and n.ENTITY_TYPE_CODE = '1'\n  where r.pr < 0.01\n)\n\nselect grp, count(*) npis, sum(TOT_MDCR_ALOWD_AMT) allowed, min(TOT_MDCR_ALOWD_AMT) cut\nfrom top1 group by 1 order by 1"}
{"label": "top1% skin-substitute dollars (strict number, first-pass cohort)", "rows": 2, "secs": 0.3, "sql": "with ind as (\n  select RNDRNG_NPI, TOT_MDCR_ALOWD_AMT, try_to_number(TOT_BENES,18,0) benes, RNDRNG_PRVDR_TYPE, RNDRNG_PRVDR_STATE_ABRVTN st\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER where RNDRNG_PRVDR_ENT_CD = 'I'\n), ranked as (\n  select *, percent_rank() over (order by TOT_MDCR_ALOWD_AMT desc) pr from ind\n), top1 as (\n  select r.*, n.PROVIDER_ENUMERATION_DATE enum_dt,\n         iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp\n  from ranked r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = r.RNDRNG_NPI and n.ENTITY_TYPE_CODE = '1'\n  where r.pr < 0.01\n)\n\nselect t.grp, count(distinct s.RNDRNG_NPI) npis_with_skin, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed\nfrom top1 t join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s on s.RNDRNG_NPI = t.RNDRNG_NPI\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1 order by 1"}
{"label": "ALL 2022+ NPIs: skin-substitute dollars", "rows": 1, "secs": 0.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\nselect count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed, sum(try_to_number(s.TOT_SRVCS,18,6)) sq_cm_units,\n       count(distinct s.HCPCS_CD) codes\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100)"}
{"label": "skin dollars new vs veteran, all individual billers", "rows": 2, "secs": 0.2, "sql": "select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n       count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = s.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1 order by 1"}
{"label": "Q4 below 4100 among new NPIs", "rows": 1, "secs": 0.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\nselect sum(iff((left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100),1,0)) hi_lines, sum(iff(left(s.HCPCS_CD,2)='Q4' and not (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100),1,0)) lo_lines,\n       sum(iff(left(s.HCPCS_CD,2)='Q4' and not (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100), try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT, 0)) lo_dollars\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI"}
{"label": "top skin codes among new NPIs", "rows": 15, "secs": 0.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\nselect s.HCPCS_CD, max(s.HCPCS_DESC) descr, count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1 order by 4 desc limit 15"}
{"label": "skin billing by enumeration year", "rows": 20, "secs": 0.3, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect year(n.PROVIDER_ENUMERATION_DATE) enum_year,\n       count(*) skin_billers, sum(k.skin_allowed) skin_allowed,\n       sum(p.TOT_MDCR_ALOWD_AMT) total_allowed\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\njoin LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\ngroup by 1 order by 1"}
{"label": "Part B individual billers by enumeration year", "rows": 20, "secs": 0.2, "sql": "select year(n.PROVIDER_ENUMERATION_DATE) enum_year, count(*) partb_billers\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' group by 1 order by 1"}
{"label": "skin dollars by state, new vs veteran", "rows": 69, "secs": 0.3, "sql": "select s.RNDRNG_PRVDR_STATE_ABRVTN st,\n       iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n       count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = s.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1,2"}
{"label": "top 10 new NPIs by skin dollars", "rows": 10, "secs": 1.0, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed, sum(try_to_number(s.TOT_SRVCS,18,6)) units,\n         count(distinct s.HCPCS_CD) codes\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect k.RNDRNG_NPI npi, p.RNDRNG_PRVDR_LAST_ORG_NAME last_name, p.RNDRNG_PRVDR_FIRST_NAME first_name,\n       p.RNDRNG_PRVDR_TYPE ptype, p.RNDRNG_PRVDR_STATE_ABRVTN st, p.RNDRNG_PRVDR_CITY city,\n       n.enum_dt, k.skin_allowed, p.TOT_MDCR_ALOWD_AMT total_allowed, p.TOT_MDCR_PYMT_AMT total_paid,\n       try_to_number(p.TOT_BENES,18,0) benes, k.units, k.codes\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI join newnpi n on n.NPI = k.RNDRNG_NPI\norder by k.skin_allowed desc limit 10"}
{"label": "concentration among new skin billers", "rows": 1, "secs": 0.4, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), r as (select a, row_number() over (order by a desc) rn from skin)\nselect sum(iff(rn<=10,a,0)) top10, sum(iff(rn<=50,a,0)) top50, sum(a) total, count(*) npis,\n       sum(iff(a>=1000000,1,0)) over_1m\nfrom r"}
{"label": "dollars per beneficiary new vs veteran skin billers", "rows": 2, "secs": 0.2, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed,\n         sum(try_to_number(TOT_BENES,18,0)) skin_bene_lines\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), j as (\n  select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n         p.TOT_MDCR_ALOWD_AMT allowed, try_to_number(p.TOT_BENES,18,0) benes,\n         k.skin_allowed, k.skin_bene_lines\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\n  join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\n)\nselect grp, count(*) npis,\n       median(allowed/nullif(benes,0)) med_allowed_per_bene,\n       sum(allowed)/sum(benes) pooled_allowed_per_bene,\n       median(skin_allowed/nullif(skin_bene_lines,0)) med_skin_per_skin_bene,\n       sum(skin_allowed)/sum(skin_bene_lines) pooled_skin_per_skin_bene,\n       median(skin_allowed/allowed) med_skin_share,\n       sum(iff(skin_allowed/allowed > 0.5,1,0)) majority_skin,\n       sum(iff(allowed/nullif(benes,0) > 100000,1,0)) over_100k_per_bene\nfrom j group by 1 order by 1"}
{"label": "per-bene, NP/PA only", "rows": 2, "secs": 0.2, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), j as (\n  select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp, p.RNDRNG_PRVDR_TYPE ptype,\n         p.TOT_MDCR_ALOWD_AMT allowed, try_to_number(p.TOT_BENES,18,0) benes, k.skin_allowed\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\n  join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\n  where p.RNDRNG_PRVDR_TYPE in ('Nurse Practitioner','Physician Assistant')\n)\nselect grp, count(*) npis, median(allowed/nullif(benes,0)) med_allowed_per_bene,\n       sum(allowed)/sum(benes) pooled_allowed_per_bene, sum(skin_allowed) skin_allowed\nfrom j group by 1 order by 1"}
{"label": "provider type of new skin billers", "rows": 4, "secs": 0.3, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect p.RNDRNG_PRVDR_TYPE ptype, count(*) npis, sum(k.a) skin_allowed\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI group by 1 order by 3 desc limit 8"}
{"label": "NP/PA Part B billers new vs veteran (base rate)", "rows": 4, "secs": 0.8, "sql": "select p.RNDRNG_PRVDR_TYPE ptype, iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n       count(*) partb_billers, sum(p.TOT_MDCR_ALOWD_AMT) allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' and p.RNDRNG_PRVDR_TYPE in ('Nurse Practitioner','Physician Assistant')\ngroup by 1,2 order by 1,2"}
{"label": "all individual Part B billers new vs veteran (base rate)", "rows": 2, "secs": 0.5, "sql": "select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp, count(*) partb_billers, sum(p.TOT_MDCR_ALOWD_AMT) allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' group by 1 order by 1"}
{"label": "new skin billers sharing a practice address", "rows": 12, "secs": 2.3, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect upper(trim(p.RNDRNG_PRVDR_ST1)) st1, p.RNDRNG_PRVDR_CITY city, p.RNDRNG_PRVDR_STATE_ABRVTN st,\n       count(*) new_npis, sum(k.a) skin_allowed\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI\ngroup by 1,2,3 having count(*) > 1 order by 4 desc, 5 desc limit 15"}
{"label": "address sharing summary", "rows": 1, "secs": 1.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), a as (\n  select upper(trim(p.RNDRNG_PRVDR_ST1))||'|'||p.RNDRNG_PRVDR_CITY||'|'||p.RNDRNG_PRVDR_STATE_ABRVTN addr, count(*) n, sum(k.a) d\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI group by 1\n)\nselect count(*) addresses, sum(iff(n>1,n,0)) npis_at_shared_addr, sum(iff(n>1,d,0)) dollars_at_shared_addr, sum(d) total\nfrom a"}
{"label": "veteran skin billers at the new billers' addresses", "rows": 1, "secs": 2.3, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), newaddr as (\n  select distinct upper(trim(p.RNDRNG_PRVDR_ST1)) st1, p.RNDRNG_PRVDR_CITY city, p.RNDRNG_PRVDR_STATE_ABRVTN st\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI\n), vskin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect count(distinct p.RNDRNG_NPI) veteran_skin_npis_same_addr, sum(v.a) their_skin_dollars\nfrom vskin v join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = v.RNDRNG_NPI\njoin LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = v.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1' and n.PROVIDER_ENUMERATION_DATE < '2022-01-01'\njoin newaddr x on x.st1 = upper(trim(p.RNDRNG_PRVDR_ST1)) and x.city = p.RNDRNG_PRVDR_CITY and x.st = p.RNDRNG_PRVDR_STATE_ABRVTN"}
{"label": "ramp speed by enumeration half-year", "rows": 3, "secs": 0.8, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect iff(n.enum_dt >= '2023-07-01', 'enumerated Jul 2023 or later', iff(n.enum_dt >= '2023-01-01','enumerated H1 2023','enumerated 2022')) bucket,\n       count(*) npis, sum(k.a) skin_allowed, median(k.a) med_skin\nfrom skin k join newnpi n on n.NPI = k.RNDRNG_NPI group by 1 order by 1"}
{"label": "key checks", "rows": 3, "secs": 0.2, "sql": "select 'prov' as t, count(*) n, count(distinct RNDRNG_NPI) d, min(length(RNDRNG_NPI)) mn, max(length(RNDRNG_NPI)) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER\nunion all\nselect 'nppes', count(*), count(distinct NPI), min(length(NPI)), max(length(NPI)) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES\nunion all\nselect 'svc', count(*), count(distinct RNDRNG_NPI), min(length(RNDRNG_NPI)), max(length(RNDRNG_NPI)) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI"}
{"label": "nppes entity type + enumeration range", "rows": 3, "secs": 0.3, "sql": "select ENTITY_TYPE_CODE, count(*) n, min(PROVIDER_ENUMERATION_DATE) mn, max(PROVIDER_ENUMERATION_DATE) mx,\n       sum(iff(PROVIDER_ENUMERATION_DATE is null,1,0)) null_dt\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES group by 1 order by 1"}
{"label": "carbon date both files", "rows": 6, "secs": 0.2, "sql": "select 'prov' f, year(n.PROVIDER_ENUMERATION_DATE) y, count(distinct p.RNDRNG_NPI) npis\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI\nwhere year(n.PROVIDER_ENUMERATION_DATE) >= 2022 group by 1,2\nunion all\nselect 'svc', year(n.PROVIDER_ENUMERATION_DATE), count(distinct s.RNDRNG_NPI)\nfrom (select distinct RNDRNG_NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI) s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = s.RNDRNG_NPI\nwhere year(n.PROVIDER_ENUMERATION_DATE) >= 2022 group by 1,2\norder by 1,2"}
{"label": "top1% split new vs veteran (loose number)", "rows": 2, "secs": 0.3, "sql": "with ind as (\n  select RNDRNG_NPI, TOT_MDCR_ALOWD_AMT, try_to_number(TOT_BENES,18,0) benes, RNDRNG_PRVDR_TYPE, RNDRNG_PRVDR_STATE_ABRVTN st\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER where RNDRNG_PRVDR_ENT_CD = 'I'\n), ranked as (\n  select *, percent_rank() over (order by TOT_MDCR_ALOWD_AMT desc) pr from ind\n), top1 as (\n  select r.*, n.PROVIDER_ENUMERATION_DATE enum_dt,\n         iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp\n  from ranked r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = r.RNDRNG_NPI and n.ENTITY_TYPE_CODE = '1'\n  where r.pr < 0.01\n)\n\nselect grp, count(*) npis, sum(TOT_MDCR_ALOWD_AMT) allowed, min(TOT_MDCR_ALOWD_AMT) cut\nfrom top1 group by 1 order by 1"}
{"label": "top1% skin-substitute dollars (strict number, first-pass cohort)", "rows": 2, "secs": 0.7, "sql": "with ind as (\n  select RNDRNG_NPI, TOT_MDCR_ALOWD_AMT, try_to_number(TOT_BENES,18,0) benes, RNDRNG_PRVDR_TYPE, RNDRNG_PRVDR_STATE_ABRVTN st\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER where RNDRNG_PRVDR_ENT_CD = 'I'\n), ranked as (\n  select *, percent_rank() over (order by TOT_MDCR_ALOWD_AMT desc) pr from ind\n), top1 as (\n  select r.*, n.PROVIDER_ENUMERATION_DATE enum_dt,\n         iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp\n  from ranked r join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = r.RNDRNG_NPI and n.ENTITY_TYPE_CODE = '1'\n  where r.pr < 0.01\n)\n\nselect t.grp, count(distinct s.RNDRNG_NPI) npis_with_skin, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed\nfrom top1 t join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s on s.RNDRNG_NPI = t.RNDRNG_NPI\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1 order by 1"}
{"label": "ALL 2022+ NPIs: skin-substitute dollars", "rows": 1, "secs": 0.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\nselect count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed, sum(try_to_number(s.TOT_SRVCS,18,6)) sq_cm_units,\n       count(distinct s.HCPCS_CD) codes\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100)"}
{"label": "skin dollars new vs veteran, all individual billers", "rows": 2, "secs": 0.3, "sql": "select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n       count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = s.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1 order by 1"}
{"label": "Q4 below 4100 among new NPIs", "rows": 1, "secs": 0.4, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\nselect sum(iff((left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100),1,0)) hi_lines, sum(iff(left(s.HCPCS_CD,2)='Q4' and not (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100),1,0)) lo_lines,\n       sum(iff(left(s.HCPCS_CD,2)='Q4' and not (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100), try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT, 0)) lo_dollars\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI"}
{"label": "top skin codes among new NPIs", "rows": 15, "secs": 0.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\nselect s.HCPCS_CD, max(s.HCPCS_DESC) descr, count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1 order by 4 desc limit 15"}
{"label": "skin billing by enumeration year", "rows": 20, "secs": 0.2, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect year(n.PROVIDER_ENUMERATION_DATE) enum_year,\n       count(*) skin_billers, sum(k.skin_allowed) skin_allowed,\n       sum(p.TOT_MDCR_ALOWD_AMT) total_allowed\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\njoin LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\ngroup by 1 order by 1"}
{"label": "Part B individual billers by enumeration year", "rows": 20, "secs": 0.2, "sql": "select year(n.PROVIDER_ENUMERATION_DATE) enum_year, count(*) partb_billers\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' group by 1 order by 1"}
{"label": "skin dollars by state, new vs veteran", "rows": 69, "secs": 0.2, "sql": "select s.RNDRNG_PRVDR_STATE_ABRVTN st,\n       iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n       count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = s.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1,2"}
{"label": "top 10 new NPIs by skin dollars", "rows": 10, "secs": 0.3, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed, sum(try_to_number(s.TOT_SRVCS,18,6)) units,\n         count(distinct s.HCPCS_CD) codes\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect k.RNDRNG_NPI npi, p.RNDRNG_PRVDR_LAST_ORG_NAME last_name, p.RNDRNG_PRVDR_FIRST_NAME first_name,\n       p.RNDRNG_PRVDR_TYPE ptype, p.RNDRNG_PRVDR_STATE_ABRVTN st, p.RNDRNG_PRVDR_CITY city,\n       n.enum_dt, k.skin_allowed, p.TOT_MDCR_ALOWD_AMT total_allowed, p.TOT_MDCR_PYMT_AMT total_paid,\n       try_to_number(p.TOT_BENES,18,0) benes, k.units, k.codes\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI join newnpi n on n.NPI = k.RNDRNG_NPI\norder by k.skin_allowed desc limit 10"}
{"label": "concentration among new skin billers", "rows": 1, "secs": 0.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), r as (select a, row_number() over (order by a desc) rn from skin)\nselect sum(iff(rn<=10,a,0)) top10, sum(iff(rn<=50,a,0)) top50, sum(a) total, count(*) npis,\n       sum(iff(a>=1000000,1,0)) over_1m\nfrom r"}
{"label": "dollars per beneficiary new vs veteran skin billers", "rows": 2, "secs": 0.3, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed,\n         sum(try_to_number(TOT_BENES,18,0)) skin_bene_lines\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), j as (\n  select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n         p.TOT_MDCR_ALOWD_AMT allowed, try_to_number(p.TOT_BENES,18,0) benes,\n         k.skin_allowed, k.skin_bene_lines\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\n  join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\n)\nselect grp, count(*) npis,\n       median(allowed/nullif(benes,0)) med_allowed_per_bene,\n       sum(allowed)/sum(benes) pooled_allowed_per_bene,\n       median(skin_allowed/nullif(skin_bene_lines,0)) med_skin_per_skin_bene,\n       sum(skin_allowed)/sum(skin_bene_lines) pooled_skin_per_skin_bene,\n       median(skin_allowed/allowed) med_skin_share,\n       sum(iff(skin_allowed/allowed > 0.5,1,0)) majority_skin,\n       sum(iff(allowed/nullif(benes,0) > 100000,1,0)) over_100k_per_bene\nfrom j group by 1 order by 1"}
{"label": "per-bene, NP/PA only", "rows": 2, "secs": 0.3, "sql": "with skin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) skin_allowed from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), j as (\n  select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp, p.RNDRNG_PRVDR_TYPE ptype,\n         p.TOT_MDCR_ALOWD_AMT allowed, try_to_number(p.TOT_BENES,18,0) benes, k.skin_allowed\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI and p.RNDRNG_PRVDR_ENT_CD='I'\n  join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = k.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\n  where p.RNDRNG_PRVDR_TYPE in ('Nurse Practitioner','Physician Assistant')\n)\nselect grp, count(*) npis, median(allowed/nullif(benes,0)) med_allowed_per_bene,\n       sum(allowed)/sum(benes) pooled_allowed_per_bene, sum(skin_allowed) skin_allowed\nfrom j group by 1 order by 1"}
{"label": "provider type of new skin billers", "rows": 4, "secs": 0.6, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect p.RNDRNG_PRVDR_TYPE ptype, count(*) npis, sum(k.a) skin_allowed\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI group by 1 order by 3 desc limit 8"}
{"label": "NP/PA Part B billers new vs veteran (base rate)", "rows": 4, "secs": 0.7, "sql": "select p.RNDRNG_PRVDR_TYPE ptype, iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp,\n       count(*) partb_billers, sum(p.TOT_MDCR_ALOWD_AMT) allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' and p.RNDRNG_PRVDR_TYPE in ('Nurse Practitioner','Physician Assistant')\ngroup by 1,2 order by 1,2"}
{"label": "all individual Part B billers new vs veteran (base rate)", "rows": 2, "secs": 0.3, "sql": "select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp, count(*) partb_billers, sum(p.TOT_MDCR_ALOWD_AMT) allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' group by 1 order by 1"}
{"label": "new skin billers sharing a practice address", "rows": 12, "secs": 0.3, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect upper(trim(p.RNDRNG_PRVDR_ST1)) st1, p.RNDRNG_PRVDR_CITY city, p.RNDRNG_PRVDR_STATE_ABRVTN st,\n       count(*) new_npis, sum(k.a) skin_allowed\nfrom skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI\ngroup by 1,2,3 having count(*) > 1 order by 4 desc, 5 desc limit 15"}
{"label": "address sharing summary", "rows": 1, "secs": 0.2, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), a as (\n  select upper(trim(p.RNDRNG_PRVDR_ST1))||'|'||p.RNDRNG_PRVDR_CITY||'|'||p.RNDRNG_PRVDR_STATE_ABRVTN addr, count(*) n, sum(k.a) d\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI group by 1\n)\nselect count(*) addresses, sum(iff(n>1,n,0)) npis_at_shared_addr, sum(iff(n>1,d,0)) dollars_at_shared_addr, sum(d) total\nfrom a"}
{"label": "veteran skin billers at the new billers' addresses", "rows": 1, "secs": 0.4, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n), newaddr as (\n  select distinct upper(trim(p.RNDRNG_PRVDR_ST1)) st1, p.RNDRNG_PRVDR_CITY city, p.RNDRNG_PRVDR_STATE_ABRVTN st\n  from skin k join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = k.RNDRNG_NPI\n), vskin as (\n  select RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect count(distinct p.RNDRNG_NPI) veteran_skin_npis_same_addr, sum(v.a) their_skin_dollars\nfrom vskin v join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p on p.RNDRNG_NPI = v.RNDRNG_NPI\njoin LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = v.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1' and n.PROVIDER_ENUMERATION_DATE < '2022-01-01'\njoin newaddr x on x.st1 = upper(trim(p.RNDRNG_PRVDR_ST1)) and x.city = p.RNDRNG_PRVDR_CITY and x.st = p.RNDRNG_PRVDR_STATE_ABRVTN"}
{"label": "ramp speed by enumeration half-year", "rows": 3, "secs": 2.7, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\n, skin as (\n  select s.RNDRNG_NPI, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) a from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI where (left(HCPCS_CD,2)='Q4' and try_to_number(substr(HCPCS_CD,2),18,0) >= 4100) group by 1\n)\nselect iff(n.enum_dt >= '2023-07-01', 'enumerated Jul 2023 or later', iff(n.enum_dt >= '2023-01-01','enumerated H1 2023','enumerated 2022')) bucket,\n       count(*) npis, sum(k.a) skin_allowed, median(k.a) med_skin\nfrom skin k join newnpi n on n.NPI = k.RNDRNG_NPI group by 1 order by 1"}
{"label": "A2xxx skin substitutes among new NPIs (excluded from headline)", "rows": 1, "secs": 0.6, "sql": "with newnpi as (\n  select NPI, PROVIDER_ENUMERATION_DATE enum_dt, PROVIDER_CREDENTIAL_TEXT cred\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where ENTITY_TYPE_CODE = '1' and PROVIDER_ENUMERATION_DATE >= '2022-01-01'\n)\n\nselect count(*) lines, count(distinct s.RNDRNG_NPI) npis, sum(try_to_number(TOT_SRVCS,18,6) * AVG_MDCR_ALOWD_AMT) allowed\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER_AND_SERVI s join newnpi n on n.NPI = s.RNDRNG_NPI\nwhere s.HCPCS_CD between 'A2001' and 'A2999'"}
{"label": "per-bene, every NP/PA Part B biller", "rows": 2, "secs": 0.5, "sql": "select iff(n.PROVIDER_ENUMERATION_DATE >= '2022-01-01','new','veteran') grp, count(*) npis,\n       median(p.TOT_MDCR_ALOWD_AMT/nullif(try_to_number(p.TOT_BENES,18,0),0)) med_allowed_per_bene\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER p join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.NPI = p.RNDRNG_NPI and n.ENTITY_TYPE_CODE='1'\nwhere p.RNDRNG_PRVDR_ENT_CD='I' and p.RNDRNG_PRVDR_TYPE in ('Nurse Practitioner','Physician Assistant')\ngroup by 1 order by 1"}
