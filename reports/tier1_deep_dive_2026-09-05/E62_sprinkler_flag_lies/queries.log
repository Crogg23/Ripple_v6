{"label": "mart tables", "rows": 11, "secs": 1.4, "sql": "select table_schema, table_name, row_count from LIBRARY_MARTS.information_schema.tables\n where table_name ilike '%NURSING%' order by 1,2"}
{"label": "landing tables", "rows": 6, "secs": 1.0, "sql": "select table_name, row_count from LIBRARY_RAW.information_schema.tables\n where table_schema='LANDING' and table_name ilike '%NURSING%' order by 1"}
{"label": "sprinkler cols anywhere", "rows": 2, "secs": 5.8, "sql": "select table_schema, table_name, column_name from LIBRARY_RAW.information_schema.columns\n where column_name ilike '%SPRINKLER%' union all\n select table_schema, table_name, column_name from LIBRARY_MARTS.information_schema.columns\n where column_name ilike '%SPRINKLER%'"}
{"label": "cols HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES", "rows": 23, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES' order by ordinal_position"}
{"label": "cols HEALTH__FED_NURSINGHOME411", "rows": 71, "secs": 2.3, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_NURSINGHOME411' order by ordinal_position"}
{"label": "cols fire", "rows": 24, "secs": 1.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES' order by ordinal_position"}
{"label": "flag values", "rows": 3, "secs": 0.7, "sql": "select AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS f, count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) ccns, min(PROCESSING_DATE) mn, max(PROCESSING_DATE) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME group by 1 order by 2 desc"}
{"label": "home ccn key", "rows": 1, "secs": 0.4, "sql": "select count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) d, min(length(CMS_CERTIFICATION_NUMBER_CCN)) l1, max(length(CMS_CERTIFICATION_NUMBER_CCN)) l2 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME"}
{"label": "health prefix", "rows": 1, "secs": 0.4, "sql": "select DEFICIENCY_PREFIX, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES group by 1 order by 2 desc"}
{"label": "fire prefix", "rows": 2, "secs": 0.9, "sql": "select DEFICIENCY_PREFIX, count(*) n, min(SURVEY_DATE) mn, max(SURVEY_DATE) mx, min(PROCESSING_DATE) p1, max(PROCESSING_DATE) p2 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES group by 1 order by 2 desc"}
{"label": "sprinkler tags fire", "rows": 8, "secs": 1.3, "sql": "select DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION d, count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) homes from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_DESCRIPTION ilike '%sprinkler%' group by 1,2 order by 3 desc"}
{"label": "sprinkler tags health", "rows": 0, "secs": 0.6, "sql": "select DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION d, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES where DEFICIENCY_DESCRIPTION ilike '%sprinkler%' group by 1,2 order by 3 desc"}
{"label": "corrected values fire", "rows": 7, "secs": 0.5, "sql": "select DEFICIENCY_CORRECTED, count(*) n, sum(iff(CORRECTION_DATE is null,1,0)) nulldate from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES group by 1"}
{"label": "fire->home orphans", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) homes, sum(iff(h.CMS_CERTIFICATION_NUMBER_CCN is null,1,0)) orphans from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME h using (CMS_CERTIFICATION_NUMBER_CCN)"}
{"label": "landing snapshot date", "rows": 1, "secs": 0.3, "sql": "select PROCESSING_DATE, count(*) n from LIBRARY_RAW.LANDING.FED_CMS_NURSING_HOME group by 1"}
{"label": "mart processing null?", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(PROCESSING_DATE) p from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME"}
{"label": "rebuild: k0351 since 2024-06-01 at Yes homes", "rows": 1, "secs": 0.8, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(y.ccn is not null,1,0)) cites_yes, count(distinct iff(y.ccn is not null,k.ccn,null)) homes_yes from k left join y using(ccn) where tag='0351' and SURVEY_DATE>='2024-06-01'"}
{"label": "rebuild: open k0351 at Yes homes (any survey date)", "rows": 1, "secs": 0.7, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(open_at_snap,1,0)) open_cites, count(distinct iff(open_at_snap,k.ccn,null)) open_homes from k join y using(ccn) where tag='0351'"}
{"label": "open k0351 at Yes homes by status", "rows": 5, "secs": 0.8, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect status, count(*) cites, count(distinct k.ccn) homes, sum(iff(cd is null,1,0)) no_date, sum(iff(cd>'2026-05-01',1,0)) dated_after_snap, min(SURVEY_DATE) oldest, max(SURVEY_DATE) newest from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 2 desc"}
{"label": "all-status k0351 at Yes homes by status", "rows": 6, "secs": 0.8, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect status, count(*) cites, count(distinct k.ccn) homes, sum(iff(open_at_snap,1,0)) open_cites from k join y using(ccn) where tag='0351' group by 1 order by 2 desc"}
{"label": "open sprinkler-family at Yes homes by tag", "rows": 8, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect tag, count(*) cites, count(distinct k.ccn) homes, sum(iff(open_at_snap,1,0)) open_cites, count(distinct iff(open_at_snap,k.ccn,null)) open_homes from k join y using(ccn) group by 1 order by 2 desc"}
{"label": "open k0351 Yes homes by state", "rows": 23, "secs": 0.7, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect k.STATE, count(distinct k.ccn) open_homes, count(*) open_cites, sum(iff(cd is null,1,0)) no_date, sum(iff(status like 'Waiver%',1,0)) waiver_cites, round(avg(datediff(day,SURVEY_DATE,'2026-05-01'))) avg_days_open, max(datediff(day,SURVEY_DATE,'2026-05-01')) max_days_open, (select count(*) from y y2 where y2.STATE=k.STATE) yes_homes_in_state from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 2 desc, 1"}
{"label": "open k0351 Yes homes age buckets", "rows": 5, "secs": 0.7, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect case when datediff(day,SURVEY_DATE,'2026-05-01')<90 then 'a. under 90 days' when datediff(day,SURVEY_DATE,'2026-05-01')<365 then 'b. 90 days to 1 yr' when datediff(day,SURVEY_DATE,'2026-05-01')<730 then 'c. 1 to 2 yrs' when datediff(day,SURVEY_DATE,'2026-05-01')<1825 then 'd. 2 to 5 yrs' else 'e. over 5 yrs' end bucket, count(*) cites, count(distinct k.ccn) homes, sum(iff(status like 'Waiver%',1,0)) waiver, sum(iff(status like '%no plan%',1,0)) no_plan, sum(iff(status like '%has plan%',1,0)) has_plan, sum(iff(status like '%date of correction%',1,0)) has_date from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 1"}
{"label": "open k0351 Yes homes scope", "rows": 5, "secs": 0.5, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect ss, count(*) cites, count(distinct k.ccn) homes from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 1"}
{"label": "open k0351 Yes homes list", "rows": 71, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect k.ccn, k.PROVIDER_NAME, k.STATE, SURVEY_DATE, ss, status, cd, datediff(day,SURVEY_DATE,'2026-05-01') days_open from k join y using(ccn) where tag='0351' and open_at_snap order by days_open desc"}
{"label": "open k0351 at Partial/DNA homes", "rows": 1, "secs": 0.4, "sql": "select h.AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS f, count(*) cites, count(distinct f.CMS_CERTIFICATION_NUMBER_CCN) homes from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME h using(CMS_CERTIFICATION_NUMBER_CCN) where f.DEFICIENCY_TAG_NUMBER='0351' and (f.CORRECTION_DATE is null or f.CORRECTION_DATE>'2026-05-01') group by 1"}
{"label": "repeat k0351 same home 2+ surveys, Yes flag", "rows": 1, "secs": 0.5, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) homes, sum(iff(n>=3,1,0)) three_plus from (select k.ccn, count(distinct SURVEY_DATE) n from k join y using(ccn) where tag='0351' group by 1) where n>=2"}
{"label": "correction-date-after-snap: how far after", "rows": 25, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select f.CMS_CERTIFICATION_NUMBER_CCN ccn, f.PROVIDER_NAME, f.STATE, f.SURVEY_DATE, f.DEFICIENCY_TAG_NUMBER tag, f.SCOPE_SEVERITY_CODE ss, f.DEFICIENCY_CORRECTED status, f.CORRECTION_DATE cd,\n  (f.CORRECTION_DATE is null or f.CORRECTION_DATE > '2026-05-01') as open_at_snap\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f where f.DEFICIENCY_PREFIX='K' and f.DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect datediff(day,'2026-05-01',cd) d, count(*) n from k join y using(ccn) where tag='0351' and cd>'2026-05-01' group by 1 order by 1"}
{"label": "01 flag values (the column has no No)", "rows": 3, "secs": 0.3, "sql": "select AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS flag, count(*) homes from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME group by 1 order by 2 desc"}
{"label": "02 flag snapshot date", "rows": 1, "secs": 0.3, "sql": "select PROCESSING_DATE, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME group by 1"}
{"label": "03 home CCN is a key", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME"}
{"label": "04 fire table joins clean", "rows": 1, "secs": 0.4, "sql": "select count(*) n, count(distinct f.CMS_CERTIFICATION_NUMBER_CCN) homes, sum(iff(h.CMS_CERTIFICATION_NUMBER_CCN is null,1,0)) orphans, min(SURVEY_DATE) mn, max(SURVEY_DATE) mx, max(f.PROCESSING_DATE) fire_snapshot from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME h using(CMS_CERTIFICATION_NUMBER_CCN)"}
{"label": "05 sprinkler tag codes, exact", "rows": 8, "secs": 0.5, "sql": "select DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr, count(*) cites, count(distinct CMS_CERTIFICATION_NUMBER_CCN) homes from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_DESCRIPTION ilike '%sprinkler%' group by 1,2 order by 3 desc"}
{"label": "06 sprinkler in health (F) file", "rows": 1, "secs": 0.5, "sql": "select count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES where DEFICIENCY_DESCRIPTION ilike '%sprinkler%'"}
{"label": "07 status values in fire file", "rows": 7, "secs": 0.2, "sql": "select DEFICIENCY_CORRECTED status, count(*) n, sum(iff(CORRECTION_DATE is null,1,0)) no_date from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES group by 1 order by 2 desc"}
{"label": "08 rebuild first pass: K0351 since 2024-06-01, Yes homes", "rows": 1, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(y.ccn is not null,1,0)) cites_yes, count(distinct iff(y.ccn is not null,k.ccn,null)) homes_yes from k left join y using(ccn) where tag='0351' and SURVEY_DATE>='2024-06-01'"}
{"label": "09 rebuild first pass: open at snapshot, in window", "rows": 1, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(cd is null,1,0)) no_date from k join y using(ccn) where tag='0351' and SURVEY_DATE>='2024-06-01' and (cd is null or cd>'2026-05-01')"}
{"label": "10 open K0351 at Yes homes, all time, survey on/before snapshot", "rows": 1, "secs": 0.5, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(cd is null,1,0)) no_date from k join y using(ccn) where tag='0351' and open_at_snap"}
{"label": "11 open K0351 at Yes homes by status", "rows": 5, "secs": 0.5, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect status, count(*) cites, count(distinct k.ccn) homes, sum(iff(cd is null,1,0)) no_date, round(avg(days_open)) avg_days, max(days_open) max_days from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 2 desc"}
{"label": "12 K0351 lifetime at Yes homes by status", "rows": 6, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect status, count(*) cites, count(distinct k.ccn) homes, sum(iff(open_at_snap,1,0)) open_cites from k join y using(ccn) where tag='0351' group by 1 order by 2 desc"}
{"label": "13 open sprinkler family at Yes homes by tag", "rows": 8, "secs": 1.1, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect tag, min(descr) descr, count(*) cites, count(distinct k.ccn) homes, sum(iff(open_at_snap,1,0)) open_cites, count(distinct iff(open_at_snap,k.ccn,null)) open_homes from k join y using(ccn) group by 1 order by 3 desc"}
{"label": "14 open K0351 Yes homes by state", "rows": 23, "secs": 0.5, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect k.STATE state, count(distinct k.ccn) open_homes, count(*) open_cites, sum(iff(cd is null,1,0)) no_date, sum(iff(status like 'Waiver%',1,0)) waiver, sum(iff(status like '%no plan%',1,0)) no_plan, round(avg(days_open)) avg_days, max(days_open) max_days, (select count(*) from y y2 where y2.STATE=k.STATE) yes_homes from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 2 desc, 1"}
{"label": "15 open K0351 Yes homes age buckets", "rows": 5, "secs": 0.6, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect case when days_open<90 then 'a. under 90 days' when days_open<365 then 'b. 90 days to 1 yr' when days_open<730 then 'c. 1 to 2 yrs' when days_open<1825 then 'd. 2 to 5 yrs' else 'e. over 5 yrs' end bucket, count(*) cites, sum(iff(status like 'Waiver%',1,0)) waiver, sum(iff(status like '%no plan%',1,0)) no_plan, sum(iff(status like '%has plan%',1,0)) has_plan, sum(iff(status like '%date of correction%',1,0)) has_date, sum(iff(status like 'No revisit%',1,0)) no_revisit from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 1"}
{"label": "16 open K0351 Yes homes days-open stats", "rows": 1, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect median(days_open) med, round(avg(days_open)) avg, max(days_open) mx, sum(iff(days_open>=365,1,0)) over_1yr from k join y using(ccn) where tag='0351' and open_at_snap"}
{"label": "17 open K0351 Yes homes scope", "rows": 5, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect ss scope, count(*) cites from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 1"}
{"label": "18 open K0351 Yes homes full list", "rows": 68, "secs": 0.7, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect k.ccn, PROVIDER_NAME, k.STATE state, SURVEY_DATE, ss, status, cd, days_open from k join y using(ccn) where tag='0351' and open_at_snap order by days_open desc"}
{"label": "19 open K0351 at Partial / Data Not Available homes", "rows": 1, "secs": 0.4, "sql": "select h.AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS flag, count(*) cites from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME h using(CMS_CERTIFICATION_NUMBER_CCN) where f.DEFICIENCY_TAG_NUMBER='0351' and f.SURVEY_DATE<='2026-05-01' and (f.CORRECTION_DATE is null or f.CORRECTION_DATE>'2026-05-01') group by 1"}
{"label": "20 promised dates past the fire file's own date", "rows": 1, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) n from k join y using(ccn) where tag='0351' and open_at_snap and cd > '2026-06-01'"}
{"label": "21 repeat K0351 homes (2+ surveys), Yes flag", "rows": 1, "secs": 0.4, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) homes, sum(iff(n>=3,1,0)) three_plus from (select k.ccn, count(distinct SURVEY_DATE) n from k join y using(ccn) where tag='0351' group by 1) where n>=2"}
{"label": "22 base rate check: Yes share overall vs cited", "rows": 1, "secs": 0.7, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes')/ (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME) yes_share_all, count(distinct iff(y.ccn is not null,k.ccn,null))/count(distinct k.ccn) yes_share_cited from k left join y using(ccn) where tag='0351'"}
{"label": "01 flag values (the column has no No)", "rows": 3, "secs": 0.4, "sql": "select AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS flag, count(*) homes from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME group by 1 order by 2 desc"}
{"label": "02 flag snapshot date", "rows": 1, "secs": 0.3, "sql": "select PROCESSING_DATE, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME group by 1"}
{"label": "03 home CCN is a key", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME"}
{"label": "04 fire table joins clean", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct f.CMS_CERTIFICATION_NUMBER_CCN) homes, sum(iff(h.CMS_CERTIFICATION_NUMBER_CCN is null,1,0)) orphans, min(SURVEY_DATE) mn, max(SURVEY_DATE) mx, max(f.PROCESSING_DATE) fire_snapshot from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME h using(CMS_CERTIFICATION_NUMBER_CCN)"}
{"label": "05 sprinkler tag codes, exact", "rows": 8, "secs": 1.2, "sql": "select DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr, count(*) cites, count(distinct CMS_CERTIFICATION_NUMBER_CCN) homes from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_DESCRIPTION ilike '%sprinkler%' group by 1,2 order by 3 desc"}
{"label": "06 sprinkler in health (F) file", "rows": 1, "secs": 0.2, "sql": "select count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES where DEFICIENCY_DESCRIPTION ilike '%sprinkler%'"}
{"label": "07 status values in fire file", "rows": 7, "secs": 0.3, "sql": "select DEFICIENCY_CORRECTED status, count(*) n, sum(iff(CORRECTION_DATE is null,1,0)) no_date from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES group by 1 order by 2 desc"}
{"label": "08 rebuild first pass: K0351 since 2024-06-01, Yes homes", "rows": 1, "secs": 0.2, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(y.ccn is not null,1,0)) cites_yes, count(distinct iff(y.ccn is not null,k.ccn,null)) homes_yes from k left join y using(ccn) where tag='0351' and SURVEY_DATE>='2024-06-01'"}
{"label": "09 rebuild first pass: open at snapshot, in window", "rows": 1, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(cd is null,1,0)) no_date from k join y using(ccn) where tag='0351' and SURVEY_DATE>='2024-06-01' and (cd is null or cd>'2026-05-01')"}
{"label": "10 open K0351 at Yes homes, all time, survey on/before snapshot", "rows": 1, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) cites, count(distinct k.ccn) homes, sum(iff(cd is null,1,0)) no_date from k join y using(ccn) where tag='0351' and open_at_snap"}
{"label": "11 open K0351 at Yes homes by status", "rows": 5, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect status, count(*) cites, count(distinct k.ccn) homes, sum(iff(cd is null,1,0)) no_date, round(avg(days_open)) avg_days, max(days_open) max_days from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 2 desc"}
{"label": "12 K0351 lifetime at Yes homes by status", "rows": 6, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect status, count(*) cites, count(distinct k.ccn) homes, sum(iff(open_at_snap,1,0)) open_cites from k join y using(ccn) where tag='0351' group by 1 order by 2 desc"}
{"label": "13 open sprinkler family at Yes homes by tag", "rows": 8, "secs": 0.2, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect tag, min(descr) descr, count(*) cites, count(distinct k.ccn) homes, sum(iff(open_at_snap,1,0)) open_cites, count(distinct iff(open_at_snap,k.ccn,null)) open_homes from k join y using(ccn) group by 1 order by 3 desc"}
{"label": "14 open K0351 Yes homes by state", "rows": 23, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect k.STATE state, count(distinct k.ccn) open_homes, count(*) open_cites, sum(iff(cd is null,1,0)) no_date, sum(iff(status like 'Waiver%',1,0)) waiver, sum(iff(status like '%no plan%',1,0)) no_plan, round(avg(days_open)) avg_days, max(days_open) max_days, (select count(*) from y y2 where y2.STATE=k.STATE) yes_homes from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 2 desc, 1"}
{"label": "15 open K0351 Yes homes age buckets", "rows": 5, "secs": 0.2, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect case when days_open<90 then 'a. under 90 days' when days_open<365 then 'b. 90 days to 1 yr' when days_open<730 then 'c. 1 to 2 yrs' when days_open<1825 then 'd. 2 to 5 yrs' else 'e. over 5 yrs' end bucket, count(*) cites, sum(iff(status like 'Waiver%',1,0)) waiver, sum(iff(status like '%no plan%',1,0)) no_plan, sum(iff(status like '%has plan%',1,0)) has_plan, sum(iff(status like '%date of correction%',1,0)) has_date, sum(iff(status like 'No revisit%',1,0)) no_revisit from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 1"}
{"label": "16 open K0351 Yes homes days-open stats", "rows": 1, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect median(days_open) med, round(avg(days_open)) avg, max(days_open) mx, sum(iff(days_open>=365,1,0)) over_1yr from k join y using(ccn) where tag='0351' and open_at_snap"}
{"label": "17 open K0351 Yes homes scope", "rows": 5, "secs": 0.2, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect ss scope, count(*) cites from k join y using(ccn) where tag='0351' and open_at_snap group by 1 order by 1"}
{"label": "18 open K0351 Yes homes full list", "rows": 68, "secs": 0.2, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect k.ccn, PROVIDER_NAME, k.STATE state, SURVEY_DATE, ss, status, cd, days_open from k join y using(ccn) where tag='0351' and open_at_snap order by days_open desc"}
{"label": "19 open K0351 at Partial / Data Not Available homes", "rows": 1, "secs": 0.2, "sql": "select h.AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS flag, count(*) cites from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME h using(CMS_CERTIFICATION_NUMBER_CCN) where f.DEFICIENCY_TAG_NUMBER='0351' and f.SURVEY_DATE<='2026-05-01' and (f.CORRECTION_DATE is null or f.CORRECTION_DATE>'2026-05-01') group by 1"}
{"label": "20 promised dates past the fire file's own date", "rows": 1, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) n from k join y using(ccn) where tag='0351' and open_at_snap and cd > '2026-06-01'"}
{"label": "21 repeat K0351 homes (2+ surveys), Yes flag", "rows": 1, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect count(*) homes, sum(iff(n>=3,1,0)) three_plus from (select k.ccn, count(distinct SURVEY_DATE) n from k join y using(ccn) where tag='0351' group by 1) where n>=2"}
{"label": "22 base rate check: Yes share overall vs cited", "rows": 1, "secs": 0.3, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\nselect (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes')/ (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME) yes_share_all, count(distinct iff(y.ccn is not null,k.ccn,null))/count(distinct k.ccn) yes_share_cited from k left join y using(ccn) where tag='0351'"}
{"label": "23 durable 25: later survey check", "rows": 25, "secs": 0.5, "sql": "with y as (select CMS_CERTIFICATION_NUMBER_CCN ccn, STATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME where AUTOMATIC_SPRINKLER_SYSTEMS_IN_ALL_REQUIRED_AREAS='Yes'),\nk as (select CMS_CERTIFICATION_NUMBER_CCN ccn, PROVIDER_NAME, STATE, SURVEY_DATE, DEFICIENCY_TAG_NUMBER tag, DEFICIENCY_DESCRIPTION descr,\n  SCOPE_SEVERITY_CODE ss, DEFICIENCY_CORRECTED status, CORRECTION_DATE cd,\n  (SURVEY_DATE <= '2026-05-01' and (CORRECTION_DATE is null or CORRECTION_DATE > '2026-05-01')) as open_at_snap,\n  datediff(day, SURVEY_DATE, '2026-05-01') days_open\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES where DEFICIENCY_PREFIX='K' and DEFICIENCY_TAG_NUMBER in ('0351','0353','0354','0352','0342','0400','0112','0322'))\n\nselect k.ccn, k.PROVIDER_NAME, k.STATE state, k.SURVEY_DATE, k.status, k.days_open,\n  (select max(f2.SURVEY_DATE) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f2 where f2.CMS_CERTIFICATION_NUMBER_CCN=k.ccn and f2.DEFICIENCY_PREFIX='K'\n     and f2.SURVEY_DATE > k.SURVEY_DATE and f2.SURVEY_DATE <= '2026-05-01') later_k_survey,\n  (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_FIRE_DEFICIENCIES f3 where f3.CMS_CERTIFICATION_NUMBER_CCN=k.ccn and f3.DEFICIENCY_TAG_NUMBER='0351'\n     and f3.SURVEY_DATE > k.SURVEY_DATE and f3.SURVEY_DATE <= '2026-05-01') later_k0351\nfrom k join y using(ccn)\nwhere tag='0351' and open_at_snap and (status like 'Waiver%' or status like '%no plan%')\norder by status, days_open desc"}
