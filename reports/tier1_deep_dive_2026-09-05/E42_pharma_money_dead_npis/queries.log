{"label": "q14_second_npi_tight", "rows": 10, "secs": 0.3, "sql": "with t as (select '1104812593' dead_npi, 'SPETZLER' ln, 'ROBERT' fn, 'AZ' st union all select '1033558069' dead_npi, 'GELLER' ln, 'MATTHEW' fn, 'CA' st union all select '1700830361' dead_npi, 'FENLIN' ln, 'JOHN' fn, 'PA' st union all select '1962558551' dead_npi, 'MAST' ln, 'JEFFREY' fn, 'NV' st union all select '1003909649' dead_npi, 'MORRISON' ln, 'THOMAS' fn, 'GA' st union all select '1760509848' dead_npi, 'DURAN' ln, 'CARLOS' fn, 'MT' st union all select '1316965916' dead_npi, 'HILL' ln, 'CLINT' fn, 'MS' st union all select '1114987831' dead_npi, 'RUIZ' ln, 'RAMON' fn, 'FL' st union all select '1083806863' dead_npi, 'REDDY' ln, 'RAHUL' fn, 'AZ' st union all select '1447253562' dead_npi, 'GOLDSTEIN' ln, 'STEVEN' fn, 'NJ' st)\nselect t.dead_npi, t.ln, t.st, count(p.NPI) live_same_name_state, listagg(p.NPI||':'||p.HEALTHCARE_PROVIDER_TAXONOMY_CODE_1, ' ') hits\nfrom t left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES p on upper(p.PROVIDER_LAST_NAME_LEGAL_NAME)=t.ln and upper(p.PROVIDER_FIRST_NAME)=t.fn\n  and p.ENTITY_TYPE_CODE='1' and p.NPI_DEACTIVATION_DATE is null and p.PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME=t.st\ngroup by 1,2,3 order by 1"}
