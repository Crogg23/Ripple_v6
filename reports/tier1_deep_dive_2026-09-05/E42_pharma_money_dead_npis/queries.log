{"label": "cols HEALTH__FED_CMS_OPEN_PAYMENTS", "rows": 22, "secs": 1.4, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_OPEN_PAYMENTS' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_NPPES", "rows": 333, "secs": 1.2, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NPPES' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_OPEN_PAYMENTS_PROFILE_SUPPLEMENT", "rows": 35, "secs": 1.7, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_OPEN_PAYMENTS_PROFILE_SUPPLEMENT' order by ordinal_position"}
{"label": "op_sample", "rows": 5, "secs": 0.2, "sql": "select DATE_OF_PAYMENT, PROGRAM_YEAR, TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS, NPI from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS where NPI is not null limit 5"}
{"label": "nppes_cohort", "rows": 1, "secs": 1.4, "sql": "select count(*) n, count_if(NPI_DEACTIVATION_DATE is not null) deact, count_if(NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) deact_never_react,\n  count_if(NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is not null) deact_react,\n  count_if(NPI_DEACTIVATION_DATE is not null and nullif(trim(NPI_DEACTIVATION_REASON_CODE),'') is not null) reason_filled,\n  min(NPI_DEACTIVATION_DATE) mn, max(NPI_DEACTIVATION_DATE) mx, count(distinct NPI) dn from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES"}
{"label": "op_keys", "rows": 1, "secs": 1.6, "sql": "select count(*) n, count(distinct NPI) dn, count_if(NPI is null or trim(NPI)='') blank, count_if(try_to_date(DATE_OF_PAYMENT,'MM/DD/YYYY') is null) bad_date, min(PROGRAM_YEAR) py0, max(PROGRAM_YEAR) py1 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS"}
{"label": "q1_rebuild", "rows": 1, "secs": 2.1, "sql": "with byday as (select NPI, try_to_date(DATE_OF_PAYMENT,'MM/DD/YYYY') pd, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) amt, count(*) n\n               from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS where NPI is not null group by 1,2)\nselect count(distinct b.NPI) dead_npis_paid_2024,\n       count(distinct case when b.pd > n.d then b.NPI end) npis_paid_after,\n       sum(case when b.pd > n.d then b.amt end) dollars_after,\n       sum(case when b.pd > n.d then b.n end) payments_after,\n       sum(b.amt) dollars_all, sum(b.n) payments_all,\n       count(distinct case when b.pd > dateadd(day,90,n.d) then b.NPI end) npis_paid_90plus\nfrom byday b join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = b.NPI"}
{"label": "q2_top25", "rows": 25, "secs": 1.3, "sql": "with per as (select NPI, sum(amt) tot, count(*) n, min(pd) first_pd, max(pd) last_pd, min(d) d,\n                    count(distinct payer) payers, max(fn) fn, max(ln) ln, max(st) st, max(spec) spec, max(pid) pid\n             from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1)\nselect NPI, fn, ln, st, spec, pid, d deact, first_pd, last_pd, datediff(day, d, first_pd) days_to_first, datediff(day, d, last_pd) days_to_last,\n       n payments, payers, tot, round(100*tot/sum(tot) over (),2) pct, round(100*sum(tot) over (order by tot desc rows unbounded preceding)/sum(tot) over (),2) cum_pct,\n       row_number() over (order by tot desc) rk\nfrom per qualify rk <= 25 order by rk"}
{"label": "q3_dist", "rows": 6, "secs": 0.8, "sql": "with per as (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1)\nselect case when tot < 25 then 'a <$25' when tot < 100 then 'b $25-100' when tot < 1000 then 'c $100-1k'\n            when tot < 10000 then 'd $1k-10k' when tot < 100000 then 'e $10k-100k' else 'f $100k+' end bucket,\n       count(*) npis, sum(tot) dollars, median(tot) med\nfrom per group by 1 order by 1"}
{"label": "q4_nature", "rows": 17, "secs": 1.6, "sql": "select nature, case when NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10)) then 'top10' else 'rest' end grp,\n       count(distinct NPI) npis, count(*) payments, sum(amt) dollars\nfrom (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1,2 order by dollars desc"}
{"label": "q5_top_detail", "rows": 16, "secs": 1.5, "sql": "select NPI, ln, nature, payer, count(*) payments, sum(amt) dollars, min(pd) first_pd, max(pd) last_pd\nfrom (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) where NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10)) group by 1,2,3,4 order by NPI, dollars desc"}
{"label": "q6_nppes_top10", "rows": 10, "secs": 1.5, "sql": "select NPI, ENTITY_TYPE_CODE, PROVIDER_LAST_NAME_LEGAL_NAME, PROVIDER_ENUMERATION_DATE, LAST_UPDATE_DATE,\n       NPI_DEACTIVATION_REASON_CODE, NPI_DEACTIVATION_DATE, NPI_REACTIVATION_DATE, REPLACEMENT_NPI, CERTIFICATION_DATE,\n       HEALTHCARE_PROVIDER_TAXONOMY_CODE_1, PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10))"}
{"label": "q7_prior_years", "rows": 18, "secs": 0.7, "sql": "select NPI, 2023 py, count(*) payments, sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) dollars,\n       min(try_to_date(DATE_OF_PAYMENT,'MM/DD/YYYY')) first_pd, max(try_to_date(DATE_OF_PAYMENT,'MM/DD/YYYY')) last_pd\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2023 where NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10)) group by 1\nunion all\nselect NPI, 2022, count(*), sum(TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS),\n       min(try_to_date(DATE_OF_PAYMENT,'MM/DD/YYYY')), max(try_to_date(DATE_OF_PAYMENT,'MM/DD/YYYY'))\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_2022 where NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10)) group by 1 order by 1,2"}
{"label": "q8_second_npi_by_name", "rows": 61, "secs": 2.3, "sql": "with t as (select NPI dead_npi, max(fn) fn, max(ln) ln, max(st) st from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) where NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10)) group by 1)\nselect t.dead_npi, t.ln, t.fn, t.st, p.NPI live_npi, p.PROVIDER_ENUMERATION_DATE enum_dt, p.NPI_DEACTIVATION_DATE live_deact,\n       p.PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME live_st, p.HEALTHCARE_PROVIDER_TAXONOMY_CODE_1 tax\nfrom t left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES p on upper(p.PROVIDER_LAST_NAME_LEGAL_NAME) = upper(t.ln) and upper(p.PROVIDER_FIRST_NAME) = upper(t.fn)\n      and p.ENTITY_TYPE_CODE = '1'\norder by t.dead_npi"}
{"label": "q9_supplement_top10", "rows": 10, "secs": 1.5, "sql": "select PROFILE_ID, NPI, FIRST_NAME, LAST_NAME, STATE, PRIMARY_SPECIALTY, ASSOCIATED_PROFILE_ID_1, ASSOCIATED_PROFILE_ID_2, LICENSE_STATE_CODE_1\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS_PROFILE_SUPPLEMENT where NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10))"}
{"label": "q10_reactivated_window", "rows": 1, "secs": 0.9, "sql": "with r as (select NPI, NPI_DEACTIVATION_DATE d, NPI_REACTIVATION_DATE rd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES\n           where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is not null)\nselect count(distinct o.NPI) npis_in_window, count(*) payments, sum(o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) dollars,\n       max(o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS) biggest, median(datediff(day, r.d, r.rd)) med_gap_days\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join r on r.NPI = o.NPI\nwhere try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > r.d and try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') < r.rd"}
{"label": "q11_gap_years", "rows": 11, "secs": 0.6, "sql": "with per as (select NPI, min(d) d, min(pd) first_pd, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1)\nselect least(floor(datediff(day, d, first_pd)/365.25), 10) yrs, count(*) npis, sum(tot) dollars\nfrom per group by 1 order by 1"}
{"label": "q12_top10_monthly", "rows": 41, "secs": 1.4, "sql": "select NPI, ln, date_trunc(month, pd) m, sum(amt) dollars, count(*) n\nfrom (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) where NPI in (select NPI from (select NPI, sum(amt) tot from (select o.NPI, try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') pd, n.d,\n        o.TOTAL_AMOUNT_OF_PAYMENT_USDOLLARS amt, o.NATURE_OF_PAYMENT_OR_TRANSFER_OF_VALUE nature,\n        o.APPLICABLE_MANUFACTURER_OR_APPLICABLE_GPO_MAKING_PAYMENT_NAME payer,\n        o.COVERED_RECIPIENT_FIRST_NAME fn, o.COVERED_RECIPIENT_LAST_NAME ln, o.RECIPIENT_STATE st,\n        o.COVERED_RECIPIENT_SPECIALTY_1 spec, o.COVERED_RECIPIENT_PROFILE_ID pid\n        from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_OPEN_PAYMENTS o join (select NPI, NPI_DEACTIVATION_DATE d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES where NPI_DEACTIVATION_DATE is not null and NPI_REACTIVATION_DATE is null) n on n.NPI = o.NPI\n        where try_to_date(o.DATE_OF_PAYMENT,'MM/DD/YYYY') > n.d) group by 1 order by tot desc limit 10)) group by 1,2,3 order by 1,3"}
{"label": "q13_find_tables", "rows": 6, "secs": 1.7, "sql": "select table_schema, table_name, row_count from LIBRARY_MARTS.information_schema.tables\n  where table_name ilike '%LEIE%' or table_name ilike '%PHYSICIAN_OTHER_PRACTITIONERS_BY_PROVIDER%' or table_name ilike '%SAM_EXCLUSIONS%'"}
{"label": "q14_second_npi_tight", "rows": 10, "secs": 1.8, "sql": "with t as (select '1104812593' dead_npi, 'SPETZLER' ln, 'ROBERT' fn, 'AZ' st union all select '1033558069' dead_npi, 'GELLER' ln, 'MATTHEW' fn, 'CA' st union all select '1700830361' dead_npi, 'FENLIN' ln, 'JOHN' fn, 'PA' st union all select '1962558551' dead_npi, 'MAST' ln, 'JEFFREY' fn, 'NV' st union all select '1003909649' dead_npi, 'MORRISON' ln, 'THOMAS' fn, 'GA' st union all select '1760509848' dead_npi, 'DURAN' ln, 'CARLOS' fn, 'MT' st union all select '1316965916' dead_npi, 'HILL' ln, 'CLINT' fn, 'MS' st union all select '1114987831' dead_npi, 'RUIZ' ln, 'RAMON' fn, 'FL' st union all select '1083806863' dead_npi, 'REDDY' ln, 'RAHUL' fn, 'AZ' st union all select '1447253562' dead_npi, 'GOLDSTEIN' ln, 'STEVEN' fn, 'NJ' st)\nselect t.dead_npi, t.ln, t.st, count(p.NPI) live_same_name_state, listagg(p.NPI||':'||p.HEALTHCARE_PROVIDER_TAXONOMY_CODE_1, ' ') hits\nfrom t left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES p on upper(p.PROVIDER_LAST_NAME_LEGAL_NAME)=t.ln and upper(p.PROVIDER_FIRST_NAME)=t.fn\n  and p.ENTITY_TYPE_CODE='1' and p.NPI_DEACTIVATION_DATE is null and p.PROVIDER_BUSINESS_PRACTICE_LOCATION_ADDRESS_STATE_NAME=t.st\ngroup by 1,2,3 order by 1"}
