d(100*median(m_cost),1) p50, round(100*percentile_cont(0.75) within group (order by m_cost),1) p75, round(100*percentile_cont(0.90) within group (order by m_cost),1) p90 from b where grp='term_2024_26' group by 1 order by 1"}
{"label": "D_threshold_by_bin", "rows": 9, "secs": 0.5, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect case when m_cost < -0.30 then 'a <-30%' when m_cost < -0.20 then 'b -30..-20' when m_cost < -0.10 then 'c -20..-10' when m_cost < -0.05 then 'd -10..-5' when m_cost < 0 then 'e -5..0' when m_cost < 0.05 then 'f 0..5' when m_cost < 0.10 then 'g 5..10' when m_cost < 0.20 then 'h 10..20' else 'i >20%' end bin, count(*) n, sum(iff(grp='term_2024_26',1,0)) term, sum(iff(grp='term_2024_26' and tcd<>'07',1,0)) closure, round(100*term/n,2) pct_term, round(100*closure/n,2) pct_closure from b where grp in ('active','term_2024_26') group by 1 order by 1"}
{"label": "D_threshold_cum", "rows": 5, "secs": 1.2, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect t.thr, count(*) n, sum(iff(grp='term_2024_26',1,0)) term, sum(iff(grp='term_2024_26' and tcd<>'07',1,0)) closure, round(100*term/n,2) pct_term, round(100*closure/n,2) pct_closure from b, (select $1 thr from values (0),(-0.05),(-0.10),(-0.20),(-0.30)) t where grp in ('active','term_2024_26') and m_cost < t.thr group by 1 order by 1 desc"}
{"label": "D_stacked_signals", "rows": 5, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect (iff(ni<0,1,0)+iff(opi<0,1,0)+iff(fb<0,1,0)+iff(cr<1,1,0)) signals, count(*) n, sum(iff(grp='term_2024_26',1,0)) term, sum(iff(grp='term_2024_26' and tcd<>'07',1,0)) closure, round(100*term/n,2) pct_term, round(100*closure/n,2) pct_closure\n from b where grp in ('active','term_2024_26') and opi is not null and fb is not null and cr is not null group by 1 order by 1"}
{"label": "D_signal_fill", "rows": 2, "secs": 0.5, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect grp, count(*) n, count(opi) opi, count(fb) fb, count(cr) cr, sum(iff(fb<0,1,0)) neg_equity, sum(iff(opi<0,1,0)) op_loss, sum(iff(cr<1,1,0)) cr_lt1 from b where grp in ('active','term_2024_26') group by 1"}
{"label": "D_lag_buckets", "rows": 4, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect case when lag_days<=90 then 'a 0-90d' when lag_days<=365 then 'b 91-365d' when lag_days<=730 then 'c 366-730d' else 'd >730d' end lag, count(*) n, sum(iff(ni<0,1,0)) neg, round(100*neg/n,1) pct_neg from b where grp='term_2024_26' group by 1 order by 1"}
{"label": "D_worst_closures", "rows": 12, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect CCN, nm, st, ftype, tcd, tdt, fye, round(100*m_cost,1) m_cost, round(100*m_npr,1) m_npr, round(ni) ni, round(npr) npr, round(fb) fund_bal from b where grp='term_2024_26' and npr is not null and npr>0 order by m_cost limit 12"}
{"label": "D_term_no_report", "rows": 5, "secs": 0.3, "sql": "select PGM_TRMNTN_CD, count(*) n, sum(iff(h.PROVIDER_CCN is null,1,0)) no_report_at_all, sum(iff(h.PROVIDER_CCN is not null and h.full12=0,1,0)) short_report_only\n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER p left join (select PROVIDER_CCN, max(iff(FISCAL_YEAR_LENGTH_DAYS between 350 and 380,1,0)) full12 from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1) h on h.PROVIDER_CCN=p.CCN\n where p.PRVDR_CTGRY_CD='01' and p.TRMNTN_EXPRTN_DT>='2024-01-01' group by 1 order by 1"}
{"label": "D_by_ftype", "rows": 8, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect ftype, sum(iff(grp='active',1,0)) active, sum(iff(grp='active' and ni<0,1,0)) active_neg, sum(iff(grp='term_2024_26',1,0)) term, sum(iff(grp='term_2024_26' and ni<0,1,0)) term_neg from b where grp in ('active','term_2024_26') group by 1 order by 2 desc"}
{"label": "A_pos_latest_term_cat01", "rows": 1, "secs": 0.3, "sql": "select max(TRMNTN_EXPRTN_DT) latest_term from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'"}
