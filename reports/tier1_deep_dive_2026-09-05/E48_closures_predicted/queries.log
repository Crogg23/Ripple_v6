{"label": "A_ingest_dates", "rows": 1, "secs": 0.2, "sql": "select min(_INGESTED_AT) mn, max(_INGESTED_AT) mx, min(FISCAL_YEAR_END_DATE) fye_min, max(FISCAL_YEAR_END_DATE) fye_max from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "A_pos_latest_term", "rows": 1, "secs": 0.2, "sql": "select max(TRMNTN_EXPRTN_DT) latest_term, max(CHOW_DT) latest_chow from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER"}
{"label": "A_nan_rows", "rows": 1, "secs": 0.2, "sql": "select sum(iff(NET_INCOME='NaN'::float,1,0)) ni_nan, sum(iff(TOTAL_COSTS='NaN'::float,1,0)) tc_nan, sum(iff(NET_PATIENT_REVENUE='NaN'::float,1,0)) npr_nan, sum(iff(TOTAL_FUND_BALANCES='NaN'::float,1,0)) fb_nan, sum(iff(NET_MARGIN_RATIO='NaN'::float,1,0)) nmr_nan from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "A_nmr_definition", "rows": 1, "secs": 0.2, "sql": "select count(*) n, sum(iff(abs(NET_MARGIN_RATIO - NET_INCOME/nullif(TOTAL_INCOME,0))<0.001,1,0)) eq_ti, sum(iff(abs(NET_MARGIN_RATIO - NET_INCOME/nullif(NET_PATIENT_REVENUE,0))<0.001,1,0)) eq_npr, sum(iff(abs(NET_MARGIN_RATIO - NET_INCOME/nullif(TOTAL_COSTS,0))<0.001,1,0)) eq_tc, sum(iff(abs(NET_MARGIN_RATIO - NET_INCOME/nullif(TOTAL_PATIENT_REVENUE,0))<0.001,1,0)) eq_tpr from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS where NET_MARGIN_RATIO<>'NaN'::float and NET_INCOME<>'NaN'::float"}
{"label": "A_reports_per_ccn", "rows": 2, "secs": 0.3, "sql": "select cnt, count(*) hospitals from (select PROVIDER_CCN, sum(iff(FISCAL_YEAR_LENGTH_DAYS between 350 and 380,1,0)) cnt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1) group by 1 order by 1"}
{"label": "B_rebuild_68", "rows": 3, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect grp, count(*) n, sum(iff(ni<0,1,0)) neg, round(100*neg/n,1) pct_neg, round(100*median(m_cost),2) med_m_cost, round(100*median(m_npr),2) med_m_npr from b group by 1 order by 1"}
{"label": "B_by_term_code", "rows": 4, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect tgrp, count(*) n, sum(iff(ni<0,1,0)) neg, round(100*neg/n,1) pct_neg, round(100*median(m_cost),2) med_m_cost, sum(iff(xref is not null,1,0)) has_successor_ccn, sum(iff(fb<0,1,0)) neg_equity, round(100*neg_equity/n,1) pct_neg_equity from b where grp in ('active','term_2024_26') group by 1 order by 1"}
{"label": "B_by_successor", "rows": 5, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect iff(xref is null,'no successor CCN','successor CCN listed') succ, tgrp, count(*) n, sum(iff(ni<0,1,0)) neg, round(100*neg/n,1) pct_neg, round(100*median(m_cost),2) med_m_cost from b where grp='term_2024_26' group by 1,2 order by 1,2"}
{"label": "B_pos_all_term24", "rows": 5, "secs": 0.2, "sql": "select PGM_TRMNTN_CD, count(*) n, sum(iff(nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') is not null,1,0)) xref from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01' and TRMNTN_EXPRTN_DT>='2024-01-01' group by 1 order by 1"}
{"label": "C_margin_bins", "rows": 9, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect case when m_cost < -0.30 then 'a <-30%' when m_cost < -0.20 then 'b -30..-20' when m_cost < -0.10 then 'c -20..-10' when m_cost < -0.05 then 'd -10..-5' when m_cost < 0 then 'e -5..0' when m_cost < 0.05 then 'f 0..5' when m_cost < 0.10 then 'g 5..10' when m_cost < 0.20 then 'h 10..20' else 'i >20%' end bin, sum(iff(grp='active',1,0)) active, sum(iff(grp='term_2024_26',1,0)) term, sum(iff(grp='term_2024_26' and tcd<>'07',1,0)) term_closure, sum(iff(grp='term_2024_26' and tcd='07',1,0)) term_status from b where grp in ('active','term_2024_26') group by 1 order by 1"}
{"label": "C_percentiles", "rows": 2, "secs": 0.4, "sql": "with pos as (\n  select CCN, PGM_TRMNTN_CD tcd, TRMNTN_EXPRTN_DT tdt, CHOW_DT, CHOW_CNT, nullif(trim(CROSS_REF_PROVIDER_NUMBER),'') xref, PRVDR_CTGRY_SBTYP_CD sub\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='01'),\nh as (\n  select PROVIDER_CCN hccn, HOSPITAL_NAME nm, STATE_CODE st, CCN_FACILITY_TYPE ftype, FISCAL_YEAR_END_DATE fye, FISCAL_YEAR_LENGTH_DAYS fylen,\n         iff(NET_INCOME = 'NaN'::float, null, NET_INCOME) ni, iff(TOTAL_COSTS = 'NaN'::float, null, TOTAL_COSTS) tc, iff(NET_PATIENT_REVENUE = 'NaN'::float, null, NET_PATIENT_REVENUE) npr, iff(NET_INCOME_FROM_SERVICE_TO_PATIENTS = 'NaN'::float, null, NET_INCOME_FROM_SERVICE_TO_PATIENTS) opi,\n         iff(TOTAL_FUND_BALANCES = 'NaN'::float, null, TOTAL_FUND_BALANCES) fb, iff(CURRENT_RATIO = 'NaN'::float, null, CURRENT_RATIO) cr, iff(NET_MARGIN_RATIO = 'NaN'::float, null, NET_MARGIN_RATIO) nmr, iff(TOTAL_INCOME = 'NaN'::float, null, TOTAL_INCOME) ti\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS),\nj as (\n  select p.*, h.*, \n    case when p.tcd='00' then 'active'\n         when p.tdt >= '2024-01-01' then 'term_2024_26'\n         when p.tdt >= '2023-01-01' then 'term_2023' else 'term_pre2023' end grp,\n    case when p.tcd='00' then 'active' when p.tcd='07' then '07 status change' when p.tcd='01' then '01 voluntary merger/closure'\n         when p.tcd='05' then '05 involuntary' else 'other ('||p.tcd||')' end tgrp,\n    row_number() over (partition by p.CCN order by h.fye desc) rn\n  from pos p join h on h.hccn=p.CCN\n  where h.fylen between 350 and 380 and h.ni is not null and h.tc > 0\n    and (p.tcd='00' or h.fye <= p.tdt)),\nb as (select *, ni/tc m_cost, ni/nullif(npr,0) m_npr, datediff(day, fye, tdt) lag_days from j where rn=1)\nselect grp, count(*) n, round(100*percentile_cont(0.10) within group (order by m_cost),1) p10, round(100*percentile_cont(0.25) within group (order by m_cost),1) p25, round(100*median(m_cost),1) p50, round(100*percentile_cont(0.75) within group (order by m_cost),1) p75, round(100*percentile_cont(0.90) within group (order by m_cost),1) p90 from b where grp in ('active','term_2024_26') group by 1 order by 1"}
