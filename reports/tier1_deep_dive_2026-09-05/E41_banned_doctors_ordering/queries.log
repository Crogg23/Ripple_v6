{"label": "leie mart profile", "rows": 1, "secs": 0.4, "sql": "select count(*) n, count(distinct npi) distinct_npi,\n       sum(iff(npi = '0000000000', 1, 0)) sentinel_rows,\n       sum(iff(nullif(trim(npi), '') is null, 1, 0)) blank_rows,\n       sum(iff(npi_is_real, 1, 0)) npi_is_real_rows,\n       min(exclusion_date) min_excl, max(exclusion_date) max_excl,\n       count(distinct _source_run_id) runs\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE"}
{"label": "leie landing profile (INGESTED_AT is epoch micros)", "rows": 1, "secs": 0.9, "sql": "select count(*) n, sum(iff(npi = '0000000000', 1, 0)) sentinel_rows,\n       min(ingested_at) ingest_epoch_micros, max(excldate) max_excl,\n       count(distinct source_run_id) runs\nfrom LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE"}
{"label": "leie REINDATE values", "rows": 1, "secs": 0.3, "sql": "select reindate, count(*) n from LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE group by 1 order by 2 desc limit 5"}
{"label": "leie waiver values", "rows": 5, "secs": 0.3, "sql": "select nullif(trim(waiverdate), '') waiverdate, nullif(trim(wvrstate), '') wvrstate, count(*) n\nfrom LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE group by 1, 2 order by 3 desc limit 6"}
{"label": "ordering mart profile", "rows": 1, "secs": 0.5, "sql": "select count(*) n, count(distinct npi) distinct_npi,\n       sum(iff(nullif(trim(npi), '') is null, 1, 0)) blank,\n       min(length(npi)) len_min, max(length(npi)) len_max\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING"}
{"label": "ordering landing ingest", "rows": 1, "secs": 0.6, "sql": "select min(_ingested_at) ingest_min, max(_ingested_at) ingest_max, count(distinct _source_run_id) runs\nfrom LIBRARY_RAW.LANDING.FED_CMS_ORDER_AND_REFERRING"}
{"label": "ordering file category totals", "rows": 1, "secs": 0.4, "sql": "select sum(iff(partb = 'Y', 1, 0)) partb, sum(iff(dme = 'Y', 1, 0)) dme, sum(iff(hha = 'Y', 1, 0)) hha,\n       sum(iff(pmd = 'Y', 1, 0)) pmd, sum(iff(hospice = 'Y', 1, 0)) hospice, count(*) n\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING"}
{"label": "join on marts", "rows": 1, "secs": 0.4, "sql": "select count(*) rows_, count(distinct l.npi) leie_npis, count(distinct o.npi) order_npis\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = l.npi where l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null"}
{"label": "join on landing (second way)", "rows": 1, "secs": 0.6, "sql": "select count(*) rows_, count(distinct l.npi) leie_npis\nfrom LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE l where l.npi <> '0000000000' and exists (select 1 from LIBRARY_RAW.LANDING.FED_CMS_ORDER_AND_REFERRING o where o.npi = l.npi)"}
{"label": "matches by date bucket vs load date", "rows": 3, "secs": 0.5, "sql": "select case when l.exclusion_date < '2025-01-01' then 'a. excluded before 2025'\n            when l.exclusion_date < '2026-08-05' then 'b. excluded 2025-01-01 to 2026-08-04'\n            else 'c. excluded on/after load 2026-08-05' end bucket,\n       count(*) n, min(l.exclusion_date) min_excl, max(l.exclusion_date) max_excl\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = l.npi where l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null group by 1 order by 1"}
{"label": "7 and 26 rebuilt on landing text dates", "rows": 1, "secs": 0.4, "sql": "select sum(iff(l.excldate < '20250101', 1, 0)) before_2025,\n       sum(iff(l.excldate < '20260805', 1, 0)) before_load, count(*) total\nfrom LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE l where l.npi <> '0000000000' and exists (select 1 from LIBRARY_RAW.LANDING.FED_CMS_ORDER_AND_REFERRING o where o.npi = l.npi)"}
{"label": "the 38 with waiver, NPPES identity, categories", "rows": 38, "secs": 1.0, "sql": "select l.npi, l.last_name, l.first_name, l.general_category, l.specialty, l.exclusion_type, l.exclusion_date,\n       l.state leie_state, ll.waiverdate, nullif(trim(ll.wvrstate), '') wvrstate, ll.reindate,\n       o.last_name order_last_name, o.partb, o.dme, o.hha, o.pmd, o.hospice,\n       n.provider_last_name_legal_name nppes_last_name, n.provider_credential_text credential,\n       n.provider_business_practice_location_address_state_name nppes_state,\n       n.npi_deactivation_date deact_date, n.npi_reactivation_date react_date, n.last_update_date nppes_updated\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l\njoin LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = l.npi\nleft join LIBRARY_RAW.LANDING.FED_HHS_OIG_LEIE ll on ll.npi = l.npi and ll.excldate = to_char(l.exclusion_date, 'YYYYMMDD')\nleft join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.npi = l.npi\nwhere l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null order by l.exclusion_date, l.last_name"}
{"label": "match rate by first exclusion year", "rows": 17, "secs": 0.8, "sql": "with x as (select npi, min(exclusion_date) first_excl from LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l where l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null group by 1)\nselect year(x.first_excl) y, count(*) excluded_npis,\n       sum(iff(n.npi is not null, 1, 0)) in_nppes,\n       sum(iff(n.npi is not null and nullif(trim(n.npi_deactivation_date), '') is null, 1, 0)) nppes_active,\n       sum(iff(o.npi is not null, 1, 0)) in_ordering\nfrom x left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = x.npi left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NPPES n on n.npi = x.npi\nwhere year(x.first_excl) >= 2010 group by 1 order by 1"}
{"label": "2025-07 onward by exclusion date", "rows": 34, "secs": 0.6, "sql": "select l.exclusion_date, count(distinct l.npi) excluded_npis, count(distinct o.npi) in_ordering\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = l.npi\nwhere l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null and l.exclusion_date >= '2025-07-01' group by 1 order by 1"}
{"label": "exclusion type: list vs matches", "rows": 20, "secs": 1.6, "sql": "select l.exclusion_type, count(distinct l.npi) all_real_npis, count(distinct o.npi) in_ordering\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = l.npi where l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null group by 1 order by 2 desc"}
{"label": "state: list vs matches", "rows": 22, "secs": 0.4, "sql": "select l.state, count(distinct l.npi) all_real_npis, count(distinct o.npi) in_ordering\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = l.npi where l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null group by 1 having count(distinct o.npi) > 0 order by 3 desc, 2 desc"}
{"label": "the 38 as paid DME referrers", "rows": 9, "secs": 0.6, "sql": "select l.npi, l.last_name, l.exclusion_date, d.rfrg_prvdr_state_abrvtn dme_state,\n       d.tot_suplr_srvcs srvcs, d.suplr_mdcr_pymt_amt paid\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_HHS_OIG_LEIE l join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_ORDER_AND_REFERRING o on o.npi = l.npi join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_REFER d on d.rfrg_npi = l.npi\nwhere l.npi <> '0000000000' and nullif(trim(l.npi), '') is not null order by l.exclusion_date"}
{"label": "DME referrer file size", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct rfrg_npi) d from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_MEDICARE_DURABLE_MEDICAL_EQUIPMENT_DEVICES_SUPPLIES_BY_REFER"}
