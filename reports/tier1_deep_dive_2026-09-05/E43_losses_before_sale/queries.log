{"label": "pos_shape", "rows": 1, "secs": 0.2, "sql": "select count(*) n, count(distinct ccn) ccns, count(chow_dt) chow_dt_n, count(chow_prior_dt) prior_n, min(chow_dt) mn, max(chow_dt) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER"}
{"label": "pos_cat", "rows": 5, "secs": 0.2, "sql": "select prvdr_ctgry_cd, count(*) n, count(chow_dt) chow_n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER group by 1 order by 2 desc"}
{"label": "pos_chow_sw", "rows": 1, "secs": 0.3, "sql": "select chow_sw, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER group by 1"}
{"label": "pos_chow_cnt", "rows": 12, "secs": 0.2, "sql": "select chow_cnt, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER group by 1 order by 1"}
{"label": "hcris_shape", "rows": 1, "secs": 0.2, "sql": "select count(*) n, count(distinct provider_ccn) ccns, count(net_income) ni_n, count(net_margin_ratio) nm_n, min(fiscal_year_end_date) mn, max(fiscal_year_end_date) mx, min(fiscal_year_begin_date) mnb, max(fiscal_year_begin_date) mxb from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "hcris_years", "rows": 3, "secs": 0.7, "sql": "select year(fiscal_year_end_date) fy, count(*) n, count(distinct provider_ccn) ccns from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "hcris_dupes", "rows": 3, "secs": 0.2, "sql": "select cnt, count(*) ccns from (select provider_ccn, count(*) cnt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1) group by 1 order by 1"}
{"label": "chow_dom", "rows": 31, "secs": 1.1, "sql": "select day(chow_dt) d, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where chow_dt>='2015-01-01' group by 1 order by 2 desc"}
{"label": "chow_dow", "rows": 7, "secs": 0.2, "sql": "select dayname(chow_dt) dow, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where chow_dt>='2015-01-01' group by 1 order by 2 desc"}
{"label": "chow_years_hosp", "rows": 12, "secs": 0.3, "sql": "select year(chow_dt) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt>='2015-01-01' group by 1 order by 1"}
{"label": "sold_n", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct ccn) ccns from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'"}
{"label": "sold_ctrl", "rows": 8, "secs": 0.3, "sql": "select gnrl_cntl_type_cd, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31' group by 1 order by 2 desc"}
{"label": "repro_naive", "rows": 1, "secs": 0.3, "sql": "select count(*) rows_, count(distinct s.ccn) hospitals, sum(iff(h.net_income<0,1,0)) losing_rows,\n  round(100*sum(iff(h.net_income<0,1,0))/count(*),1) pct\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn\n  where s.prvdr_ctgry_cd='01' and s.chow_dt between '2022-01-01' and '2024-12-31'"}
{"label": "repro_timing", "rows": 3, "secs": 0.3, "sql": "with s as (select ccn, chow_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31')\n  select case when h.provider_ccn is null then 'no HCRIS' when h.fiscal_year_end_date < s.chow_dt then 'ends before sale' else 'ends after sale' end timing,\n  count(*) rows_, sum(iff(h.net_income<0,1,0)) losing, round(100*sum(iff(h.net_income<0,1,0))/nullif(count(h.net_income),0),1) pct\n  from s left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn group by 1 order by 1"}
{"label": "before_cohort", "rows": 1, "secs": 0.2, "sql": "select count(*) hospitals, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct_losing,\n  sum(iff(op_income<0,1,0)) op_losing, round(100*sum(iff(op_income<0,1,0))/count(*),1) pct_op_losing,\n  median(net_margin_ratio) med_margin, round(avg(datediff('month', fye, chow_dt)),1) avg_gap_months, median(datediff('month', fye, chow_dt)) med_gap_months\n  from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1)"}
{"label": "before_by_saleyear", "rows": 3, "secs": 0.2, "sql": "select year(chow_dt) sale_year, count(*) hospitals, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct\n  from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) group by 1 order by 1"}
{"label": "before_gap", "rows": 14, "secs": 0.4, "sql": "select datediff('month', fye, chow_dt) gap_months, count(*) n from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) group by 1 order by 1"}
{"label": "before_by_type", "rows": 5, "secs": 0.3, "sql": "select ftype, count(*) n, sum(iff(net_income<0,1,0)) losing from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) group by 1 order by 2 desc"}
{"label": "before_by_ctrl", "rows": 11, "secs": 0.4, "sql": "select type_of_control, count(*) n, sum(iff(net_income<0,1,0)) losing from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) group by 1 order by 2 desc"}
{"label": "before_list", "rows": 88, "secs": 0.4, "sql": "select ccn, fac_name, chow_dt, fye, round(net_income) net_income, net_margin_ratio, ftype, type_of_control, round(net_patient_revenue) npr\n  from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) order by net_margin_ratio limit 400"}
{"label": "after_only", "rows": 1, "secs": 0.4, "sql": "with s as (select ccn, chow_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  b as (select distinct s.ccn from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select count(distinct s.ccn) hospitals, count(distinct h.provider_ccn) with_after_report,\n   sum(iff(h.net_income<0,1,0)) losing_after from s left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn where s.ccn not in (select ccn from b)"}
{"label": "base_all", "rows": 1, "secs": 0.2, "sql": "select count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct, sum(iff(net_income_from_service_to_patients<0,1,0)) op_losing, median(net_margin_ratio) med_margin from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS"}
{"label": "base_fy", "rows": 3, "secs": 0.2, "sql": "select year(fiscal_year_end_date) fy, count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct, median(net_margin_ratio) med_margin from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "base_type", "rows": 9, "secs": 0.2, "sql": "select ccn_facility_type ftype, count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct, median(net_margin_ratio) med_margin from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 2 desc"}
{"label": "base_ctrl", "rows": 13, "secs": 0.2, "sql": "select type_of_control, count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 2 desc"}
{"label": "base_notsold", "rows": 1, "secs": 0.2, "sql": "select count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct, median(net_margin_ratio) med_margin\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS where provider_ccn not in (select ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where chow_dt between '2022-01-01' and '2024-12-31')"}
{"label": "margin_buckets", "rows": 12, "secs": 0.2, "sql": "with b as (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1),\n  x as (select 'sold, year before' grp, net_margin_ratio m from b\n        union all select 'all other hospitals', net_margin_ratio from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS where provider_ccn not in (select ccn from b)),\n  bk as (select grp, case when m < -0.20 then 'a. below -20%' when m < -0.10 then 'b. -20 to -10%' when m < 0 then 'c. -10 to 0%'\n                when m < 0.05 then 'd. 0 to 5%' when m < 0.10 then 'e. 5 to 10%' else 'f. above 10%' end bucket from x where m is not null)\n  select grp, bucket, count(*) n from bk group by 1,2 order by 1,2"}
{"label": "before_len", "rows": 3, "secs": 0.3, "sql": "select case when fy_len>=300 then 'full year (300+ days)' when fy_len>=180 then 'half year (180-299)' else 'stub (<180 days)' end period,\n  count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct, median(net_margin_ratio) med_margin,\n  sum(iff(datediff('day', fye, chow_dt)<=1,1,0)) ends_day_before_sale\n  from (select b.*, h.fiscal_year_length_days fy_len from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) b join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=b.ccn and h.fiscal_year_end_date=b.fye) group by 1 order by 1"}
{"label": "before_len_hist", "rows": 88, "secs": 0.2, "sql": "select h.fiscal_year_length_days fy_len, datediff('day', b.fye, b.chow_dt) days_to_sale, b.net_margin_ratio, b.fac_name\n  from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) b join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=b.ccn and h.fiscal_year_end_date=b.fye order by 1"}
{"label": "base_len", "rows": 3, "secs": 0.2, "sql": "select case when fiscal_year_length_days>=300 then 'full year (300+ days)' when fiscal_year_length_days>=180 then 'half year (180-299)' else 'stub (<180 days)' end period,\n  count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct, median(net_margin_ratio) med_margin from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 order by 1"}
{"label": "dupes_vs_sold", "rows": 1, "secs": 0.2, "sql": "with d as (select provider_ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 having count(*)>1)\n  select count(*) dupe_ccns, sum(iff(p.chow_dt is not null,1,0)) ever_sold, sum(iff(p.chow_dt between '2022-01-01' and '2024-12-31',1,0)) sold_2022_24,\n  sum(iff(p.chow_dt between '2022-10-01' and '2024-09-30',1,0)) sold_in_hcris_window\n  from d left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER p on p.ccn=d.provider_ccn"}
{"label": "fair_full_year", "rows": 2, "secs": 0.3, "sql": "with b as (select b.*, h.fiscal_year_length_days fy_len from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) b join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=b.ccn and h.fiscal_year_end_date=b.fye)\n  select 'sold, full-year report before sale' grp, count(*) n, sum(iff(net_income<0,1,0)) losing, round(100*sum(iff(net_income<0,1,0))/count(*),1) pct, median(net_margin_ratio) med_margin from b where fy_len>=300\n  union all\n  select 'not sold, full-year report', count(*), sum(iff(net_income<0,1,0)), round(100*sum(iff(net_income<0,1,0))/count(*),1), median(net_margin_ratio)\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS where fiscal_year_length_days>=300 and provider_ccn not in (select ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where chow_dt between '2022-01-01' and '2024-12-31')"}
{"label": "stub_pairs", "rows": 31, "secs": 0.4, "sql": "select h.provider_ccn ccn, h.hospital_name, h.fiscal_year_begin_date fyb, h.fiscal_year_end_date fye, h.fiscal_year_length_days fy_len, h.net_margin_ratio, p.chow_dt\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER p on p.ccn=h.provider_ccn where p.chow_dt between '2022-01-01' and '2024-12-31' and p.prvdr_ctgry_cd='01'\n  and h.provider_ccn in (select provider_ccn from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS group by 1 having count(*)>1) order by 1, 3 limit 60"}
{"label": "name_change", "rows": 3, "secs": 0.4, "sql": "select case when upper(regexp_replace(h.hospital_name,'[^A-Z]',''))=upper(regexp_replace(b.fac_name,'[^A-Z]','')) then 'same name'\n   when left(upper(regexp_replace(h.hospital_name,'[^A-Z]','')),8)=left(upper(regexp_replace(b.fac_name,'[^A-Z]','')),8) then 'same first 8 letters' else 'different name' end name_status,\n   count(*) n, sum(iff(b.net_income<0,1,0)) losing\n   from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) b join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=b.ccn and h.fiscal_year_end_date=b.fye group by 1 order by 2 desc"}
{"label": "name_change_list", "rows": 53, "secs": 0.7, "sql": "select b.ccn, h.hospital_name before_name, b.fac_name today_name, b.net_margin_ratio from (with s as (select ccn, fac_name, chow_dt, gnrl_cntl_type_cd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where prvdr_ctgry_cd='01' and chow_dt between '2022-01-01' and '2024-12-31'),\n  j as (select s.ccn, s.fac_name, s.chow_dt, s.gnrl_cntl_type_cd, h.fiscal_year_end_date fye, h.net_income, h.net_margin_ratio, h.net_income_from_service_to_patients op_income,\n           h.ccn_facility_type ftype, h.type_of_control, h.net_patient_revenue,\n           row_number() over (partition by s.ccn order by h.fiscal_year_end_date desc) rn\n        from s join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=s.ccn and h.fiscal_year_end_date < s.chow_dt)\n  select * from j where rn=1) b join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_HCRIS h on h.provider_ccn=b.ccn and h.fiscal_year_end_date=b.fye\n   where left(upper(regexp_replace(h.hospital_name,'[^A-Z]','')),8)<>left(upper(regexp_replace(b.fac_name,'[^A-Z]','')),8) order by 1"}
