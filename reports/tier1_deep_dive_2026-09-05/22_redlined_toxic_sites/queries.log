{"label": "mart_area_by_grade", "rows": 7, "secs": 0.2, "sql": "with polys as (select HOLC_NEIGHBORHOOD_KEY k, CITY, STATE, trim(HOLC_GRADE) g, try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_MARTS.HOUSING.HOUSING__FED_MAPPING_INEQUALITY) select g, count(*) polys, round(sum(km2),1) km2 from polys group by 1 order by 1"}
{"label": "landing_area_by_grade", "rows": 7, "secs": 0.4, "sql": "with polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY) select g, count(*) polys, round(sum(km2),1) km2, round(median(km2),2) med_km2 from polys group by 1 order by 1"}
{"label": "landing_join_by_grade", "rows": 6, "secs": 0.3, "sql": "with pts as (select C_2_TRIFD id, any_value(C_12_LATITUDE) lat, any_value(C_13_LONGITUDE) lon,\n  sum(iff(C_50_UNIT_OF_MEASURE='Grams', C_107_TOTAL_RELEASES/453.592, C_107_TOTAL_RELEASES)) lbs,\n  max(iff(C_46_CARCINOGEN='YES',1,0)) carc from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_BASIC_2023 group by 1), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY)\nselect g, count(distinct p.id) sites, count(*) pairs, count(distinct y.k) polys_hit, round(sum(p.lbs)) lbs,\n  round(median(p.lbs)) med_lbs_per_site, sum(p.carc) carc_sites, sum(iff(p.lbs>0,1,0)) sites_nonzero\nfrom pts p join polys y on st_contains(y.geo, st_makepoint(p.lon, p.lat)) group by 1 order by 1"}
{"label": "landing_join_500m", "rows": 7, "secs": 0.6, "sql": "with pts as (select C_2_TRIFD id, any_value(C_12_LATITUDE) lat, any_value(C_13_LONGITUDE) lon,\n  sum(iff(C_50_UNIT_OF_MEASURE='Grams', C_107_TOTAL_RELEASES/453.592, C_107_TOTAL_RELEASES)) lbs,\n  max(iff(C_46_CARCINOGEN='YES',1,0)) carc from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_BASIC_2023 group by 1), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY)\nselect g, count(distinct p.id) sites from pts p join polys y on st_dwithin(y.geo, st_makepoint(p.lon, p.lat), 500) group by 1 order by 1"}
{"label": "landing_polys_with_site", "rows": 7, "secs": 0.9, "sql": "with pts as (select C_2_TRIFD id, any_value(C_12_LATITUDE) lat, any_value(C_13_LONGITUDE) lon,\n  sum(iff(C_50_UNIT_OF_MEASURE='Grams', C_107_TOTAL_RELEASES/453.592, C_107_TOTAL_RELEASES)) lbs,\n  max(iff(C_46_CARCINOGEN='YES',1,0)) carc from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_BASIC_2023 group by 1), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY),\nhit as (select distinct y.k from pts p join polys y on st_contains(y.geo, st_makepoint(p.lon, p.lat)))\nselect y.g, count(*) polys, count(h.k) polys_with_site, round(100*count(h.k)/count(*),1) pct from polys y left join hit h on h.k=y.k group by 1 order by 1"}
{"label": "landing_join_facility_table", "rows": 6, "secs": 0.3, "sql": "with fac as (select TRI_FACILITY_ID id, FAC_CLOSED_IND closed,\n  floor(FAC_LATITUDE/10000)+floor(mod(FAC_LATITUDE,10000)/100)/60+mod(FAC_LATITUDE,100)/3600 la,\n  -(floor(FAC_LONGITUDE/10000)+floor(mod(FAC_LONGITUDE,10000)/100)/60+mod(FAC_LONGITUDE,100)/3600) lo\n  from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_FACILITY where FAC_LATITUDE>0 and FAC_LONGITUDE>0),\nfpts as (select * from (select id, closed, iff(la>72 and -lo<72, -lo, la) lat, iff(la>72 and -lo<72, -la, lo) lon from fac)\n  where lat between 18 and 72 and lon between -180 and -65), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY)\nselect g, count(distinct f.id) sites, sum(iff(f.closed='0',1,0)) open_sites from fpts f join polys y on st_contains(y.geo, st_makepoint(f.lon, f.lat)) group by 1 order by 1"}
{"label": "facility_pts_kept", "rows": 1, "secs": 0.3, "sql": "with fac as (select TRI_FACILITY_ID id, FAC_CLOSED_IND closed,\n  floor(FAC_LATITUDE/10000)+floor(mod(FAC_LATITUDE,10000)/100)/60+mod(FAC_LATITUDE,100)/3600 la,\n  -(floor(FAC_LONGITUDE/10000)+floor(mod(FAC_LONGITUDE,10000)/100)/60+mod(FAC_LONGITUDE,100)/3600) lo\n  from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_FACILITY where FAC_LATITUDE>0 and FAC_LONGITUDE>0),\nfpts as (select * from (select id, closed, iff(la>72 and -lo<72, -lo, la) lat, iff(la>72 and -lo<72, -la, lo) lon from fac)\n  where lat between 18 and 72 and lon between -180 and -65) select count(*) kept from fpts"}
{"label": "landing_city_grade", "rows": 644, "secs": 0.3, "sql": "with pts as (select C_2_TRIFD id, any_value(C_12_LATITUDE) lat, any_value(C_13_LONGITUDE) lon,\n  sum(iff(C_50_UNIT_OF_MEASURE='Grams', C_107_TOTAL_RELEASES/453.592, C_107_TOTAL_RELEASES)) lbs,\n  max(iff(C_46_CARCINOGEN='YES',1,0)) carc from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_BASIC_2023 group by 1), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY),\nhits as (select p.id, p.lbs, y.CITY, y.STATE, y.g from pts p join polys y on st_contains(y.geo, st_makepoint(p.lon, p.lat))),\narea as (select CITY, STATE, g, count(*) polys, sum(km2) km2 from polys group by 1,2,3),\ntot as (select CITY, STATE, count(distinct id) total_sites from hits where g in ('A','B','C','D') group by 1,2)\nselect a.CITY, a.STATE, a.g, a.polys, round(a.km2,2) km2, count(distinct h.id) sites, round(coalesce(sum(h.lbs),0)) lbs, t.total_sites\nfrom area a join tot t on t.CITY=a.CITY and t.STATE=a.STATE\nleft join hits h on h.CITY=a.CITY and h.STATE=a.STATE and h.g=a.g\nwhere a.g in ('A','B','C','D') group by 1,2,3,4,5,8 order by t.total_sites desc, a.CITY, a.g"}
{"label": "landing_top_sites", "rows": 10, "secs": 0.3, "sql": "with pts as (select C_2_TRIFD id, any_value(C_12_LATITUDE) lat, any_value(C_13_LONGITUDE) lon,\n  sum(iff(C_50_UNIT_OF_MEASURE='Grams', C_107_TOTAL_RELEASES/453.592, C_107_TOTAL_RELEASES)) lbs,\n  max(iff(C_46_CARCINOGEN='YES',1,0)) carc from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_BASIC_2023 group by 1), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY)\nselect p.id, y.CITY, y.STATE, y.g, round(p.lbs) lbs from pts p join polys y on st_contains(y.geo, st_makepoint(p.lon, p.lat))\nwhere y.g in ('A','B','C','D') qualify row_number() over (order by p.lbs desc) <= 10"}
{"label": "landing_lbs_excl_top1_per_grade", "rows": 4, "secs": 0.3, "sql": "with pts as (select C_2_TRIFD id, any_value(C_12_LATITUDE) lat, any_value(C_13_LONGITUDE) lon,\n  sum(iff(C_50_UNIT_OF_MEASURE='Grams', C_107_TOTAL_RELEASES/453.592, C_107_TOTAL_RELEASES)) lbs,\n  max(iff(C_46_CARCINOGEN='YES',1,0)) carc from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_BASIC_2023 group by 1), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY),\nh as (select distinct p.id, p.lbs, y.g from pts p join polys y on st_contains(y.geo, st_makepoint(p.lon, p.lat)) where y.g in ('A','B','C','D'))\nselect g, round(sum(lbs)) lbs, round(sum(lbs)-max(lbs)) lbs_minus_biggest, round(percentile_cont(0.75) within group (order by lbs)) p75 from h group by 1 order by 1"}
{"label": "landing_join_500m_lbs", "rows": 7, "secs": 2.0, "sql": "with pts as (select C_2_TRIFD id, any_value(C_12_LATITUDE) lat, any_value(C_13_LONGITUDE) lon,\n  sum(iff(C_50_UNIT_OF_MEASURE='Grams', C_107_TOTAL_RELEASES/453.592, C_107_TOTAL_RELEASES)) lbs,\n  max(iff(C_46_CARCINOGEN='YES',1,0)) carc from LIBRARY_MARTS.ENVIRONMENT.ENVIRONMENT__FED_EPA_TRI_BASIC_2023 group by 1), polys as (select HOLC_ID||'|'||CITY||'|'||STATE||'|'||row_number() over (order by GEOMETRY) k, CITY, STATE, trim(HOLC_GRADE) g,\n  try_to_geography(GEOMETRY) geo, st_area(try_to_geography(GEOMETRY))/1e6 km2 from LIBRARY_RAW.LANDING.FED_MAPPING_INEQUALITY),\nh as (select p.id, p.lbs, y.g from pts p join polys y on st_dwithin(y.geo, st_makepoint(p.lon, p.lat), 500)),\nd as (select distinct id, lbs, g from h)\nselect g, count(*) sites, round(sum(lbs)) lbs from d group by 1 order by 1"}
