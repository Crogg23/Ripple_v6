{"label": "cols HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS", "rows": 23, "secs": 1.3, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_NURSING_HOME_PENALTIES", "rows": 14, "secs": 1.9, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NURSING_HOME_PENALTIES' order by ordinal_position"}
{"label": "mart tables like snf/chow/owner", "rows": 6, "secs": 1.8, "sql": "select table_schema, table_name, row_count from LIBRARY_MARTS.information_schema.tables where table_name ilike '%SKILLED_NURSING%' or table_name ilike '%NURSING_HOME_PENALT%' or table_name ilike '%SNF%' or table_name ilike '%CHOW%' or table_name ilike '%OWNER%'"}
{"label": "raw tables like snf/chow/owner", "rows": 4, "secs": 1.8, "sql": "select table_schema, table_name, row_count from LIBRARY_RAW.information_schema.tables where table_name ilike '%SKILLED_NURSING%' or table_name ilike '%NURSING_HOME_PENALT%' or table_name ilike '%SNF%' or table_name ilike '%CHOW%' or table_name ilike '%OWNER%'"}
{"label": "ownership-ish cols in HEALTH", "rows": 48, "secs": 1.6, "sql": "select table_name, column_name, data_type from LIBRARY_MARTS.information_schema.columns\n where table_schema='HEALTH' and (column_name ilike '%OWNER%' or column_name ilike '%CHOW%' or column_name ilike '%CHANGE%' or column_name ilike '%INCORPORAT%' or column_name ilike '%FIRST_APPROVED%' or column_name ilike '%CERTIFICATION_DATE%')\n order by 1,2"}
{"label": "enroll key check", "rows": 1, "secs": 0.8, "sql": "select count(*) n, count(distinct CCN) d_ccn, count(distinct ENROLLMENT_ID) d_enr, count(distinct NPI) d_npi, count(distinct ASSOCIATE_ID) d_assoc, sum(iff(CCN is null or trim(CCN)='',1,0)) blank_ccn, min(length(CCN)) minlen, max(length(CCN)) maxlen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "enroll sample", "rows": 5, "secs": 0.4, "sql": "select CCN, ENROLLMENT_ID, NPI, ASSOCIATE_ID, ORGANIZATION_NAME, INCORPORATION_DATE, ORGANIZATION_TYPE_STRUCTURE, PROPRIETARY_NONPROFIT from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS limit 5"}
{"label": "penalty key check", "rows": 1, "secs": 0.4, "sql": "select count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) d_ccn, min(PENALTY_DATE) mn, max(PENALTY_DATE) mx, min(length(CMS_CERTIFICATION_NUMBER_CCN)) minlen, max(length(CMS_CERTIFICATION_NUMBER_CCN)) maxlen, count(distinct FINE_ID) d_fine, min(PROCESSING_DATE) mnp, max(PROCESSING_DATE) mxp from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES"}
{"label": "penalty types", "rows": 2, "secs": 0.3, "sql": "select PENALTY_TYPE, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1"}
{"label": "incorp profile", "rows": 1, "secs": 0.8, "sql": "select count(*) n, count(INCORPORATION_DATE) filled, min(INCORPORATION_DATE) mn, max(INCORPORATION_DATE) mx, sum(iff(INCORPORATION_DATE>='2023-06-17',1,0)) since_pen_start, sum(iff(INCORPORATION_DATE>=current_date,1,0)) future from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "incorp by year 2015+", "rows": 10, "secs": 0.4, "sql": "select year(INCORPORATION_DATE) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS where INCORPORATION_DATE>='2015-01-01' group by 1 order by 1"}
{"label": "reproduce first pass", "rows": 1, "secs": 0.7, "sql": "with pen as (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1),\n e as (select CCN, INCORPORATION_DATE from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS)\n select count(distinct pen.ccn) penalized_homes, count(distinct iff(e.CCN is not null, pen.ccn, null)) matched,\n count(distinct iff(e.INCORPORATION_DATE is not null, pen.ccn, null)) with_incorp,\n count(distinct iff(e.INCORPORATION_DATE > pen.first_pen, pen.ccn, null)) incorp_after_first_pen,\n count(distinct iff(e.INCORPORATION_DATE >= '2023-06-17', pen.ccn, null)) incorp_since_202306\n from pen left join e on e.CCN=pen.ccn"}
{"label": "landing enroll cols", "rows": 25, "secs": 1.3, "sql": "select column_name, data_type from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS' order by ordinal_position"}
{"label": "enrollment_id format", "rows": 1, "secs": 0.3, "sql": "select count(*) n, sum(iff(regexp_like(ENROLLMENT_ID,'^O[0-9]{14}$'),1,0)) fmt_ok,\n count(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) parsed, min(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) mn, max(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) mx,\n sum(iff(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')>='2023-06-17',1,0)) since_pen_start from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "enrollment_id by year", "rows": 25, "secs": 0.4, "sql": "select year(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS group by 1 order by 1"}
{"label": "latest enrollment ids", "rows": 8, "secs": 0.5, "sql": "select ENROLLMENT_ID, INCORPORATION_DATE, ORGANIZATION_NAME from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS order by ENROLLMENT_ID desc limit 8"}
{"label": "incorp sentinels & incorp after enroll", "rows": 1, "secs": 0.2, "sql": "select sum(iff(INCORPORATION_DATE<'1900-01-01',1,0)) pre1900, sum(iff(INCORPORATION_DATE<'1950-01-01',1,0)) pre1950, sum(iff(INCORPORATION_DATE > try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD'),1,0)) incorp_after_enroll from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "pos_other cols", "rows": 7, "secs": 1.2, "sql": "select column_name from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_POS_OTHER' and (column_name ilike '%CTGRY%' or column_name ilike '%PRVDR_NUM%' or column_name ilike '%CHOW%' or column_name ilike '%SUBTYP%') order by 1"}
{"label": "pos_other by category", "rows": 5, "secs": 0.4, "sql": "select PRVDR_CTGRY_CD, count(*) n, count(CHOW_DT) chow_dated, sum(iff(CHOW_CNT>0,1,0)) chow_cnt_pos, max(CHOW_DT) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER group by 1 order by 2 desc"}
{"label": "nursing_home chow flag", "rows": 1, "secs": 0.3, "sql": "select PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS f, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME group by 1"}
{"label": "nh411 chow flag", "rows": 2, "secs": 0.3, "sql": "select PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS f, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 group by 1"}
{"label": "the 39", "rows": 39, "secs": 0.5, "sql": "with pen as (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen, sum(FINE_AMOUNT) fines from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1)\n select e.CCN, e.ORGANIZATION_NAME, e.ORGANIZATION_TYPE_STRUCTURE, e.PROPRIETARY_NONPROFIT, e.STATE, e.INCORPORATION_DATE, try_to_date(substr(e.ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt, pen.first_pen, pen.last_pen, datediff(day,pen.first_pen,e.INCORPORATION_DATE) gap_days, pen.n_pen, pen.fines,\n (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p2 where p2.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p2.PENALTY_DATE>e.INCORPORATION_DATE) pen_after_incorp\n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS e join pen on pen.ccn=e.CCN where e.INCORPORATION_DATE>pen.first_pen order by gap_days"}
{"label": "gap buckets incorp", "rows": 4, "secs": 1.1, "sql": "with pen as (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1)\n select case when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 0 and 90 then 'a 0-90' when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 91 and 180 then 'b 91-180'\n  when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 181 and 365 then 'c 181-365' else 'd 366+' end bucket, count(*) n\n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS e join pen on pen.ccn=e.CCN where e.INCORPORATION_DATE>pen.first_pen group by 1 order by 1"}
{"label": "pos cat 21 subtypes", "rows": 3, "secs": 0.3, "sql": "select PRVDR_CTGRY_CD, PRVDR_CTGRY_SBTYP_CD, count(*) n, count(CHOW_DT) chow_dated from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD in ('21','19','06') group by 1,2 order by 1,2"}
{"label": "pos21 vs enroll/pen", "rows": 1, "secs": 0.7, "sql": "select count(*) pos21, count(distinct MEDICARE_MEDICAID_PRVDR_NUMBER) d_num, count(distinct e.CCN) in_enroll, count(distinct pen.ccn) in_pen, count(distinct iff(p.CHOW_DT is not null, pen.ccn, null)) pen_chow_dated, count(distinct iff(p.CHOW_DT>pen.first_pen, pen.ccn, null)) chow_after_first_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER p left join (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e on e.CCN=p.MEDICARE_MEDICAID_PRVDR_NUMBER left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=p.MEDICARE_MEDICAID_PRVDR_NUMBER where p.PRVDR_CTGRY_CD='21'"}
{"label": "pos21 chow by year", "rows": 8, "secs": 0.4, "sql": "select year(CHOW_DT) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER where PRVDR_CTGRY_CD='21' and CHOW_DT is not null group by 1 order by 1 desc limit 8"}
{"label": "nh411 flag Y cross", "rows": 1, "secs": 0.6, "sql": "select count(*) n, count(pen.ccn) penalized, count(e.CCN) in_enroll, sum(iff(e.enroll_dt>='2023-06-17',1,0)) enroll_recent, sum(iff(e.INCORPORATION_DATE>='2023-06-17',1,0)) incorp_recent, sum(iff(e.enroll_dt>pen.first_pen,1,0)) enroll_after_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 n left join (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e on e.CCN=n.CMS_CERTIFICATION_NUMBER_CCN left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=n.CMS_CERTIFICATION_NUMBER_CCN where n.PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS='Y'"}
{"label": "rebuild B enroll_dt", "rows": 1, "secs": 0.3, "sql": "select count(*) penalized_matched, sum(iff(e.enroll_dt>pen.first_pen,1,0)) enroll_after_first_pen,\n sum(iff(e.enroll_dt>pen.first_pen and datediff(day,pen.first_pen,e.enroll_dt)<=365,1,0)) within_365,\n sum(iff(e.enroll_dt>pen.first_pen and datediff(day,pen.first_pen,e.enroll_dt)<=180,1,0)) within_180,\n sum(iff(e.enroll_dt>pen.first_pen and e.INCORPORATION_DATE>pen.first_pen,1,0)) both_after,\n sum(iff(e.INCORPORATION_DATE>pen.first_pen,1,0)) incorp_after,\n sum(iff(e.enroll_dt>pen.first_pen and pen.last_pen>e.enroll_dt,1,0)) penalized_again_after_new_enroll\n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN"}
{"label": "gap buckets enroll_dt", "rows": 5, "secs": 0.4, "sql": "select case when datediff(day,pen.first_pen,e.enroll_dt) between 0 and 90 then 'a 0-90' when datediff(day,pen.first_pen,e.enroll_dt) between 91 and 180 then 'b 91-180'\n  when datediff(day,pen.first_pen,e.enroll_dt) between 181 and 365 then 'c 181-365' when datediff(day,pen.first_pen,e.enroll_dt) between 366 and 730 then 'd 366-730' else 'e 731+' end bucket, count(*) n\n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.enroll_dt>pen.first_pen group by 1 order by 1"}
{"label": "base rate penalized vs not", "rows": 2, "secs": 0.5, "sql": "with h as (\n select e.CCN, e.enroll_dt, e.INCORPORATION_DATE, pen.first_pen, iff(pen.ccn is null,'no penalty','penalized') grp,\n  iff(pen.ccn is null, to_date('2023-06-17'), pen.first_pen) t0\n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN)\n select grp, count(*) homes, sum(datediff(day,t0,'2026-02-12'))/365.25 home_years,\n  sum(iff(enroll_dt>t0,1,0)) new_enroll, round(1000*sum(iff(enroll_dt>t0,1,0))/(sum(datediff(day,t0,'2026-02-12'))/365.25),1) new_enroll_per_1000hy,\n  sum(iff(enroll_dt>t0 and datediff(day,t0,enroll_dt)<=365,1,0)) new_enroll_365, round(100*sum(iff(enroll_dt>t0 and datediff(day,t0,enroll_dt)<=365,1,0))/count(*),2) pct_within_365,\n  sum(iff(INCORPORATION_DATE>t0,1,0)) new_incorp, count(INCORPORATION_DATE) incorp_filled,\n  round(1000*sum(iff(INCORPORATION_DATE>t0,1,0))/(sum(iff(INCORPORATION_DATE is not null, least(datediff(day,t0,'2024-09-17'),9999),0))/365.25),1) new_incorp_per_1000hy_to_202409\n from h group by 1"}
{"label": "pos_other id-ish cols", "rows": 18, "secs": 1.3, "sql": "select column_name from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_POS_OTHER' and (column_name ilike '%NUM%' or column_name ilike '%CCN%' or column_name ilike '%PRVDR_ID%') order by 1"}
{"label": "pos_other id-ish cols", "rows": 18, "secs": 1.4, "sql": "select column_name from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_POS_OTHER' and (column_name ilike '%NUM%' or column_name ilike '%CCN%' or column_name ilike '%PRVDR_ID%') order by 1"}
{"label": "pos CCN distinct by cat", "rows": 5, "secs": 0.3, "sql": "select PRVDR_CTGRY_CD, count(distinct CCN) d_prvdr_num, min(CCN) mn, max(CCN) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER group by 1 order by 1"}
{"label": "pos21 via CCN", "rows": 1, "secs": 0.4, "sql": "select count(*) pos21, count(distinct p.CCN) d, count(distinct e.CCN) in_enroll, count(distinct pen.ccn) in_pen, count(distinct iff(p.CHOW_DT>pen.first_pen,pen.ccn,null)) chow_after_first_pen, count(distinct iff(p.CHOW_DT>='2023-06-17',p.CCN,null)) chow_since from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER p left join (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e on e.CCN=p.CCN left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=p.CCN where p.PRVDR_CTGRY_CD='21'"}
{"label": "first_pen distribution", "rows": 1, "secs": 0.3, "sql": "select median(datediff(day,'2023-06-17',first_pen)) med_days_from_start, count(*) homes, sum(iff(first_pen<='2023-12-31',1,0)) first_pen_2023h2, sum(iff(first_pen between '2024-01-01' and '2024-12-31',1,0)) first_pen_2024 from (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1)"}
{"label": "prospective cohort 2023H2: penalty -> new enrollment next year", "rows": 3, "secs": 0.9, "sql": "with h as (\n      select e.CCN, e.enroll_dt, e.INCORPORATION_DATE,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE < '2023-06-17') n_pen_before\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt < '2024-01-01')\n     select '2023H2' cohort, case when n_pen_y=0 then '0 no penalty' when n_pen_y=1 then '1 one penalty' else '2 two or more' end grp,\n       count(*) homes, sum(iff(enroll_dt between '2024-01-01' and '2024-12-31',1,0)) new_enroll_next_year,\n       round(100*sum(iff(enroll_dt between '2024-01-01' and '2024-12-31',1,0))/count(*),2) pct\n     from h group by 1,2 order by 2"}
{"label": "prospective cohort 2023H2: fine band -> new enrollment next year", "rows": 4, "secs": 0.4, "sql": "with h as (\n      select e.CCN, e.enroll_dt,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt < '2024-01-01')\n     select '2023H2' cohort, case when n_pen_y=0 then 'a none' when fines_y<25000 then 'b under $25k' when fines_y<100000 then 'c $25k-100k' else 'd $100k+' end fine_band,\n       count(*) homes, sum(iff(enroll_dt between '2024-01-01' and '2024-12-31',1,0)) new_enroll_next_year,\n       round(100*sum(iff(enroll_dt between '2024-01-01' and '2024-12-31',1,0))/count(*),2) pct\n     from h group by 1,2 order by 2"}
{"label": "prospective cohort 2024: penalty -> new enrollment next year", "rows": 3, "secs": 0.8, "sql": "with h as (\n      select e.CCN, e.enroll_dt, e.INCORPORATION_DATE,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE < '2024-01-01') n_pen_before\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt < '2025-01-01')\n     select '2024' cohort, case when n_pen_y=0 then '0 no penalty' when n_pen_y=1 then '1 one penalty' else '2 two or more' end grp,\n       count(*) homes, sum(iff(enroll_dt between '2025-01-01' and '2025-12-31',1,0)) new_enroll_next_year,\n       round(100*sum(iff(enroll_dt between '2025-01-01' and '2025-12-31',1,0))/count(*),2) pct\n     from h group by 1,2 order by 2"}
{"label": "prospective cohort 2024: fine band -> new enrollment next year", "rows": 4, "secs": 0.8, "sql": "with h as (\n      select e.CCN, e.enroll_dt,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt < '2025-01-01')\n     select '2024' cohort, case when n_pen_y=0 then 'a none' when fines_y<25000 then 'b under $25k' when fines_y<100000 then 'c $25k-100k' else 'd $100k+' end fine_band,\n       count(*) homes, sum(iff(enroll_dt between '2025-01-01' and '2025-12-31',1,0)) new_enroll_next_year,\n       round(100*sum(iff(enroll_dt between '2025-01-01' and '2025-12-31',1,0))/count(*),2) pct\n     from h group by 1,2 order by 2"}
{"label": "penalties 365d before vs after new enrollment", "rows": 1, "secs": 0.4, "sql": "select count(distinct e.CCN) homes_new_enroll_in_window,\n sum(iff(p.PENALTY_DATE between dateadd(day,-365,e.enroll_dt) and dateadd(day,-1,e.enroll_dt),1,0)) pen_365_before,\n sum(iff(p.PENALTY_DATE between e.enroll_dt and dateadd(day,365,e.enroll_dt),1,0)) pen_365_after,\n count(distinct iff(p.PENALTY_DATE between dateadd(day,-365,e.enroll_dt) and dateadd(day,-1,e.enroll_dt),e.CCN,null)) homes_pen_before,\n count(distinct iff(p.PENALTY_DATE between e.enroll_dt and dateadd(day,365,e.enroll_dt),e.CCN,null)) homes_pen_after\n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p on p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN\n where e.enroll_dt between '2024-06-17' and '2025-05-13'"}
{"label": "penalties by month relative to new enrollment", "rows": 24, "secs": 0.4, "sql": "select floor(datediff(day,e.enroll_dt,p.PENALTY_DATE)/30.44) rel_month, count(*) n_pen, count(distinct e.CCN) homes\n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p on p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN\n where e.enroll_dt between '2024-06-17' and '2025-05-13' and abs(datediff(day,e.enroll_dt,p.PENALTY_DATE))<=365 group by 1 order by 1"}
{"label": "the 39 grouped by incorp date+state", "rows": 4, "secs": 0.4, "sql": "select e.INCORPORATION_DATE, e.STATE, count(*) n, listagg(e.ORGANIZATION_NAME, ' | ') names from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.INCORPORATION_DATE>pen.first_pen group by 1,2 having count(*)>1 order by 3 desc"}
{"label": "enroll-after set: same-day clusters", "rows": 12, "secs": 0.4, "sql": "select e.enroll_dt, e.STATE, count(*) n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.enroll_dt>pen.first_pen group by 1,2 having count(*)>=3 order by 3 desc limit 12"}
{"label": "enroll-after set: distinct associate ids", "rows": 1, "secs": 0.4, "sql": "select count(distinct e.ASSOCIATE_ID) d_assoc, count(*) homes, sum(iff(e.ORGANIZATION_NAME ilike '%OPCO%' or e.ORGANIZATION_NAME ilike '%OPERAT%' or e.ORGANIZATION_NAME ilike '%SNF%',1,0)) opco_named from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.enroll_dt>pen.first_pen"}
{"label": "cohort 2023H2: homes dropped (current enrollment after window)", "rows": 1, "secs": 0.2, "sql": "select count(*) dropped_enrolled_after_window from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) where enroll_dt > '2024-12-31'"}
{"label": "prospective cohort 2023H2: penalty count -> new enrollment next year", "rows": 3, "secs": 0.3, "sql": "select '2023H2' cohort, case when n_pen_y=0 then '0 no penalty' when n_pen_y=1 then '1 one penalty' else '2 two or more' end grp,\n       count(*) homes, sum(iff(enroll_dt >= '2024-01-01',1,0)) new_enroll_next_year, round(100*sum(iff(enroll_dt >= '2024-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2024-12-31') h group by 1,2 order by 2"}
{"label": "prospective cohort 2023H2: fine band -> new enrollment next year", "rows": 4, "secs": 0.4, "sql": "select '2023H2' cohort, case when n_pen_y=0 then 'a none' when fines_y<25000 then 'b under $25k' when fines_y<100000 then 'c $25k-100k' else 'd $100k+' end fine_band,\n       count(*) homes, sum(iff(enroll_dt >= '2024-01-01',1,0)) new_enroll_next_year, round(100*sum(iff(enroll_dt >= '2024-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2024-12-31') h group by 1,2 order by 2"}
{"label": "prospective cohort 2023H2: by for-profit flag", "rows": 6, "secs": 0.3, "sql": "select '2023H2' cohort, PROPRIETARY_NONPROFIT, iff(n_pen_y>0,'penalized','no penalty') grp,\n       count(*) homes, sum(iff(enroll_dt >= '2024-01-01',1,0)) new_enroll_next_year, round(100*sum(iff(enroll_dt >= '2024-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2024-12-31') h group by 1,2,3 order by 2,3"}
{"label": "cohort 2024: homes dropped (current enrollment after window)", "rows": 1, "secs": 0.3, "sql": "select count(*) dropped_enrolled_after_window from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) where enroll_dt > '2025-12-31'"}
{"label": "prospective cohort 2024: penalty count -> new enrollment next year", "rows": 3, "secs": 0.4, "sql": "select '2024' cohort, case when n_pen_y=0 then '0 no penalty' when n_pen_y=1 then '1 one penalty' else '2 two or more' end grp,\n       count(*) homes, sum(iff(enroll_dt >= '2025-01-01',1,0)) new_enroll_next_year, round(100*sum(iff(enroll_dt >= '2025-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2025-12-31') h group by 1,2 order by 2"}
{"label": "prospective cohort 2024: fine band -> new enrollment next year", "rows": 4, "secs": 0.4, "sql": "select '2024' cohort, case when n_pen_y=0 then 'a none' when fines_y<25000 then 'b under $25k' when fines_y<100000 then 'c $25k-100k' else 'd $100k+' end fine_band,\n       count(*) homes, sum(iff(enroll_dt >= '2025-01-01',1,0)) new_enroll_next_year, round(100*sum(iff(enroll_dt >= '2025-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2025-12-31') h group by 1,2 order by 2"}
{"label": "prospective cohort 2024: by for-profit flag", "rows": 6, "secs": 0.7, "sql": "select '2024' cohort, PROPRIETARY_NONPROFIT, iff(n_pen_y>0,'penalized','no penalty') grp,\n       count(*) homes, sum(iff(enroll_dt >= '2025-01-01',1,0)) new_enroll_next_year, round(100*sum(iff(enroll_dt >= '2025-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2025-12-31') h group by 1,2,3 order by 2,3"}
{"label": "incorp-date version of the cohort test", "rows": 2, "secs": 0.4, "sql": "with h as (select e.CCN, e.INCORPORATION_DATE, (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y\n  from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.INCORPORATION_DATE is not null and e.INCORPORATION_DATE<='2024-09-17')\n select iff(n_pen_y>0,'penalized 2023H2','no penalty 2023H2') grp, count(*) homes_with_incorp_date, sum(iff(INCORPORATION_DATE>='2024-01-01',1,0)) incorp_2024_to_sep, round(100*sum(iff(INCORPORATION_DATE>='2024-01-01',1,0))/count(*),2) pct from h group by 1"}
{"label": "enroll-after set by state", "rows": 8, "secs": 0.4, "sql": "select e.STATE, count(*) n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.enroll_dt>pen.first_pen group by 1 order by 2 desc limit 8"}
{"label": "keys enroll", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct CCN) d_ccn, count(distinct ENROLLMENT_ID) d_enr, sum(iff(regexp_like(ENROLLMENT_ID,'^O[0-9]{14}$'),1,0)) enr_fmt_ok from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "keys penalties", "rows": 1, "secs": 0.2, "sql": "select count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) d_ccn, min(PENALTY_DATE) mn, max(PENALTY_DATE) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES"}
{"label": "two clocks", "rows": 1, "secs": 0.4, "sql": "select count(*) homes, count(INCORPORATION_DATE) incorp_filled, min(INCORPORATION_DATE) incorp_min, max(INCORPORATION_DATE) incorp_max,\n  sum(iff(INCORPORATION_DATE<'1900-01-01',1,0)) incorp_pre1900, sum(iff(INCORPORATION_DATE>=current_date,1,0)) incorp_future,\n  count(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) enroll_parsed, min(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) enroll_min, max(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) enroll_max,\n  sum(iff(INCORPORATION_DATE > try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD'),1,0)) incorp_after_enroll from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "incorp by year", "rows": 10, "secs": 0.3, "sql": "select year(INCORPORATION_DATE) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS where INCORPORATION_DATE>='2015-01-01' group by 1 order by 1"}
{"label": "enroll by year", "rows": 12, "secs": 0.3, "sql": "select year(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS where try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')>='2015-01-01' group by 1 order by 1"}
{"label": "first pass reproduced", "rows": 1, "secs": 0.3, "sql": "select count(*) penalized_homes, count(e.CCN) matched, count(e.INCORPORATION_DATE) with_incorp,\n  sum(iff(e.INCORPORATION_DATE>pen.first_pen,1,0)) incorp_after_first_pen, sum(iff(e.INCORPORATION_DATE>='2023-06-17',1,0)) incorp_since_202306\n  from (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen left join (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e on e.CCN=pen.ccn"}
{"label": "the 39", "rows": 39, "secs": 0.6, "sql": "select e.CCN, e.ORGANIZATION_NAME, e.STATE, e.INCORPORATION_DATE, e.enroll_dt, pen.first_pen, datediff(day,pen.first_pen,e.INCORPORATION_DATE) gap_days, pen.n_pen,\n  (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p2 where p2.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p2.PENALTY_DATE>e.INCORPORATION_DATE) pen_after_incorp\n  from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.INCORPORATION_DATE>pen.first_pen order by gap_days"}
{"label": "the 39 clustered by incorp date+state", "rows": 4, "secs": 0.3, "sql": "select e.INCORPORATION_DATE, e.STATE, count(*) n, listagg(e.ORGANIZATION_NAME, ' | ') names from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN\n  where e.INCORPORATION_DATE>pen.first_pen group by 1,2 having count(*)>1 order by 3 desc"}
{"label": "rebuild via enrollment date", "rows": 1, "secs": 0.4, "sql": "select count(*) penalized_matched, sum(iff(e.enroll_dt>pen.first_pen,1,0)) enroll_after_first_pen,\n  sum(iff(e.enroll_dt>pen.first_pen and datediff(day,pen.first_pen,e.enroll_dt)<=365,1,0)) within_365,\n  sum(iff(e.enroll_dt>pen.first_pen and datediff(day,pen.first_pen,e.enroll_dt)<=180,1,0)) within_180,\n  sum(iff(e.enroll_dt>pen.first_pen and e.INCORPORATION_DATE>pen.first_pen,1,0)) both_clocks_after,\n  sum(iff(e.enroll_dt>pen.first_pen and pen.last_pen>e.enroll_dt,1,0)) penalized_again_after_new_record,\n  count(distinct iff(e.enroll_dt>pen.first_pen, e.ASSOCIATE_ID, null)) distinct_owners_in_set\n  from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN"}
{"label": "gap buckets enrollment date", "rows": 5, "secs": 0.5, "sql": "select case when datediff(day,pen.first_pen,e.enroll_dt) between 0 and 90 then '0-90 days' when datediff(day,pen.first_pen,e.enroll_dt) between 91 and 180 then '91-180'\n  when datediff(day,pen.first_pen,e.enroll_dt) between 181 and 365 then '181-365' when datediff(day,pen.first_pen,e.enroll_dt) between 366 and 730 then '366-730' else '731+' end bucket,\n  min(datediff(day,pen.first_pen,e.enroll_dt)) o, count(*) n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.enroll_dt>pen.first_pen group by 1 order by o"}
{"label": "gap buckets incorporation date", "rows": 4, "secs": 0.6, "sql": "select case when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 0 and 90 then '0-90 days' when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 91 and 180 then '91-180'\n  when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 181 and 365 then '181-365' when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 366 and 730 then '366-730' else '731+' end bucket,\n  min(datediff(day,pen.first_pen,e.INCORPORATION_DATE)) o, count(*) n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.INCORPORATION_DATE>pen.first_pen group by 1 order by o"}
{"label": "nh411 flag values", "rows": 2, "secs": 0.3, "sql": "select PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS f, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 group by 1 order by 1"}
{"label": "nh411 flag Y vs the two clocks", "rows": 1, "secs": 0.6, "sql": "select count(*) flagged_y, count(e.CCN) in_enroll, sum(iff(e.enroll_dt>='2023-06-17',1,0)) enroll_record_since_202306,\n  sum(iff(e.enroll_dt>='2024-12-01',1,0)) enroll_record_in_12mo_before_snapshot, sum(iff(e.INCORPORATION_DATE>='2023-06-17',1,0)) incorp_since_202306, count(pen.ccn) penalized\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 n left join (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e on e.CCN=n.CMS_CERTIFICATION_NUMBER_CCN left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=n.CMS_CERTIFICATION_NUMBER_CCN\n  where n.PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS='Y'"}
{"label": "cohort 2023 H2: penalty count -> new record next year", "rows": 3, "secs": 0.5, "sql": "select '2023 H2' cohort, 'penalty count' cut, case when n_pen_y=0 then 'no penalty' when n_pen_y=1 then 'one penalty' else 'two or more' end grp, 1 o,\n       count(*) homes, sum(iff(enroll_dt >= '2024-01-01',1,0)) new_record_next_year, round(100*sum(iff(enroll_dt >= '2024-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2024-12-31') h group by 1,2,3 order by 3"}
{"label": "cohort 2023 H2: fine band -> new record next year", "rows": 4, "secs": 0.4, "sql": "select '2023 H2' cohort, 'fine band' cut, case when n_pen_y=0 then 'no penalty' when fines_y<25000 then 'under $25k' when fines_y<100000 then '$25k-100k' else '$100k+' end grp,\n       case when n_pen_y=0 then 0 when fines_y<25000 then 1 when fines_y<100000 then 2 else 3 end o,\n       count(*) homes, sum(iff(enroll_dt >= '2024-01-01',1,0)) new_record_next_year, round(100*sum(iff(enroll_dt >= '2024-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2024-12-31') h group by 1,2,3,4 order by 4"}
{"label": "cohort 2023 H2: for-profit split", "rows": 4, "secs": 0.4, "sql": "select '2023 H2' cohort, 'ownership' cut, PROPRIETARY_NONPROFIT || ' / ' || iff(n_pen_y>0,'penalized','no penalty') grp, 0 o,\n       count(*) homes, sum(iff(enroll_dt >= '2024-01-01',1,0)) new_record_next_year, round(100*sum(iff(enroll_dt >= '2024-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2023-06-17' and '2023-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2024-12-31') h where PROPRIETARY_NONPROFIT in ('P','N') group by 1,2,3 order by 3"}
{"label": "cohort 2024: penalty count -> new record next year", "rows": 3, "secs": 0.4, "sql": "select '2024' cohort, 'penalty count' cut, case when n_pen_y=0 then 'no penalty' when n_pen_y=1 then 'one penalty' else 'two or more' end grp, 1 o,\n       count(*) homes, sum(iff(enroll_dt >= '2025-01-01',1,0)) new_record_next_year, round(100*sum(iff(enroll_dt >= '2025-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2025-12-31') h group by 1,2,3 order by 3"}
{"label": "cohort 2024: fine band -> new record next year", "rows": 4, "secs": 0.4, "sql": "select '2024' cohort, 'fine band' cut, case when n_pen_y=0 then 'no penalty' when fines_y<25000 then 'under $25k' when fines_y<100000 then '$25k-100k' else '$100k+' end grp,\n       case when n_pen_y=0 then 0 when fines_y<25000 then 1 when fines_y<100000 then 2 else 3 end o,\n       count(*) homes, sum(iff(enroll_dt >= '2025-01-01',1,0)) new_record_next_year, round(100*sum(iff(enroll_dt >= '2025-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2025-12-31') h group by 1,2,3,4 order by 4"}
{"label": "cohort 2024: for-profit split", "rows": 4, "secs": 0.4, "sql": "select '2024' cohort, 'ownership' cut, PROPRIETARY_NONPROFIT || ' / ' || iff(n_pen_y>0,'penalized','no penalty') grp, 0 o,\n       count(*) homes, sum(iff(enroll_dt >= '2025-01-01',1,0)) new_record_next_year, round(100*sum(iff(enroll_dt >= '2025-01-01',1,0))/count(*),2) pct\n     from (select e.CCN, e.enroll_dt, e.PROPRIETARY_NONPROFIT,\n        (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') n_pen_y,\n        (select coalesce(sum(FINE_AMOUNT),0) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p.PENALTY_DATE between '2024-01-01' and '2024-12-31') fines_y\n      from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e where e.enroll_dt <= '2025-12-31') h where PROPRIETARY_NONPROFIT in ('P','N') group by 1,2,3 order by 3"}
{"label": "cohort homes dropped (record dated after the window)", "rows": 1, "secs": 0.2, "sql": "select sum(iff(enroll_dt>'2024-12-31',1,0)) dropped_2023h2, sum(iff(enroll_dt>'2025-12-31',1,0)) dropped_2024 from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS)"}
{"label": "penalties by month relative to new record", "rows": 24, "secs": 0.3, "sql": "select floor(datediff(day,e.enroll_dt,p.PENALTY_DATE)/30.44) rel_month, count(*) n_pen, count(distinct e.CCN) homes\n  from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p on p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN\n  where e.enroll_dt between '2024-06-17' and '2025-05-13' and abs(datediff(day,e.enroll_dt,p.PENALTY_DATE))<=365 group by 1 order by 1"}
{"label": "penalties 365d before vs after new record", "rows": 1, "secs": 0.4, "sql": "select count(distinct e.CCN) homes_new_record,\n  sum(iff(p.PENALTY_DATE between dateadd(day,-365,e.enroll_dt) and dateadd(day,-1,e.enroll_dt),1,0)) pen_365_before,\n  sum(iff(p.PENALTY_DATE between e.enroll_dt and dateadd(day,365,e.enroll_dt),1,0)) pen_365_after\n  from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e left join LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p on p.CMS_CERTIFICATION_NUMBER_CCN=e.CCN where e.enroll_dt between '2024-06-17' and '2025-05-13'"}
{"label": "pos_other: any nursing homes?", "rows": 5, "secs": 0.3, "sql": "select p.PRVDR_CTGRY_CD cat, count(*) n, count(CHOW_DT) chow_dated, count(distinct pen.ccn) penalty_ccn_hits\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_POS_OTHER p left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=p.CCN group by 1 order by 2 desc"}
{"label": "keys enroll", "rows": 1, "secs": 0.2, "sql": "select count(*) n, count(distinct CCN) d_ccn, count(distinct ENROLLMENT_ID) d_enr, sum(iff(regexp_like(ENROLLMENT_ID,'^O[0-9]{14}$'),1,0)) enr_fmt_ok from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "keys penalties", "rows": 1, "secs": 0.3, "sql": "select count(*) n, count(distinct CMS_CERTIFICATION_NUMBER_CCN) d_ccn, min(PENALTY_DATE) mn, max(PENALTY_DATE) mx from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES"}
{"label": "two clocks", "rows": 1, "secs": 0.3, "sql": "select count(*) homes, count(INCORPORATION_DATE) incorp_filled, min(INCORPORATION_DATE) incorp_min, max(INCORPORATION_DATE) incorp_max,\n  sum(iff(INCORPORATION_DATE<'1900-01-01',1,0)) incorp_pre1900, sum(iff(INCORPORATION_DATE>=current_date,1,0)) incorp_future,\n  count(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) enroll_parsed, min(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) enroll_min, max(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) enroll_max,\n  sum(iff(INCORPORATION_DATE > try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD'),1,0)) incorp_after_enroll from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS"}
{"label": "incorp by year", "rows": 10, "secs": 0.2, "sql": "select year(INCORPORATION_DATE) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS where INCORPORATION_DATE>='2015-01-01' group by 1 order by 1"}
{"label": "enroll by year", "rows": 12, "secs": 0.9, "sql": "select year(try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS where try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD')>='2015-01-01' group by 1 order by 1"}
{"label": "first pass reproduced", "rows": 1, "secs": 0.3, "sql": "select count(*) penalized_homes, count(e.CCN) matched, count(e.INCORPORATION_DATE) with_incorp,\n  sum(iff(e.INCORPORATION_DATE>pen.first_pen,1,0)) incorp_after_first_pen, sum(iff(e.INCORPORATION_DATE>='2023-06-17',1,0)) incorp_since_202306\n  from (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen left join (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e on e.CCN=pen.ccn"}
{"label": "the 39", "rows": 39, "secs": 0.2, "sql": "select e.CCN, e.ORGANIZATION_NAME, e.STATE, e.INCORPORATION_DATE, e.enroll_dt, pen.first_pen, datediff(day,pen.first_pen,e.INCORPORATION_DATE) gap_days, pen.n_pen,\n  (select count(*) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p2 where p2.CMS_CERTIFICATION_NUMBER_CCN=e.CCN and p2.PENALTY_DATE>e.INCORPORATION_DATE) pen_after_incorp\n  from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.INCORPORATION_DATE>pen.first_pen order by gap_days"}
{"label": "the 39 clustered by incorp date+state", "rows": 4, "secs": 0.2, "sql": "select e.INCORPORATION_DATE, e.STATE, count(*) n, listagg(e.ORGANIZATION_NAME, ' | ') names from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN\n  where e.INCORPORATION_DATE>pen.first_pen group by 1,2 having count(*)>1 order by 3 desc"}
{"label": "rebuild via enrollment date", "rows": 1, "secs": 0.3, "sql": "select count(*) penalized_matched, sum(iff(e.enroll_dt>pen.first_pen,1,0)) enroll_after_first_pen,\n  sum(iff(e.enroll_dt>pen.first_pen and datediff(day,pen.first_pen,e.enroll_dt)<=365,1,0)) within_365,\n  sum(iff(e.enroll_dt>pen.first_pen and datediff(day,pen.first_pen,e.enroll_dt)<=180,1,0)) within_180,\n  sum(iff(e.enroll_dt>pen.first_pen and e.INCORPORATION_DATE>pen.first_pen,1,0)) both_clocks_after,\n  sum(iff(e.enroll_dt>pen.first_pen and pen.last_pen>e.enroll_dt,1,0)) penalized_again_after_new_record,\n  count(distinct iff(e.enroll_dt>pen.first_pen, e.ASSOCIATE_ID, null)) distinct_owners_in_set\n  from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN"}
{"label": "gap buckets enrollment date", "rows": 5, "secs": 0.6, "sql": "select case when datediff(day,pen.first_pen,e.enroll_dt) between 0 and 90 then '0-90 days' when datediff(day,pen.first_pen,e.enroll_dt) between 91 and 180 then '91-180'\n  when datediff(day,pen.first_pen,e.enroll_dt) between 181 and 365 then '181-365' when datediff(day,pen.first_pen,e.enroll_dt) between 366 and 730 then '366-730' else '731+' end bucket,\n  min(datediff(day,pen.first_pen,e.enroll_dt)) o, count(*) n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.enroll_dt>pen.first_pen group by 1 order by o"}
{"label": "gap buckets incorporation date", "rows": 4, "secs": 0.2, "sql": "select case when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 0 and 90 then '0-90 days' when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 91 and 180 then '91-180'\n  when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 181 and 365 then '181-365' when datediff(day,pen.first_pen,e.INCORPORATION_DATE) between 366 and 730 then '366-730' else '731+' end bucket,\n  min(datediff(day,pen.first_pen,e.INCORPORATION_DATE)) o, count(*) n from (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=e.CCN where e.INCORPORATION_DATE>pen.first_pen group by 1 order by o"}
{"label": "nh411 flag values", "rows": 2, "secs": 0.3, "sql": "select PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS f, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 group by 1 order by 1"}
{"label": "nh411 flag Y vs the two clocks", "rows": 1, "secs": 0.3, "sql": "select count(*) flagged_y, count(e.CCN) in_enroll, sum(iff(e.enroll_dt>='2023-06-17',1,0)) enroll_record_since_202306,\n  sum(iff(e.enroll_dt>='2024-12-01',1,0)) enroll_record_in_12mo_before_snapshot, sum(iff(e.INCORPORATION_DATE>='2023-06-17',1,0)) incorp_since_202306, count(pen.ccn) penalized\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 n left join (select CCN, ASSOCIATE_ID, ORGANIZATION_NAME, STATE, PROPRIETARY_NONPROFIT, INCORPORATION_DATE, try_to_date(substr(ENROLLMENT_ID,2,8),'YYYYMMDD') enroll_dt from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_SKILLED_NURSING_FACILITY_ENROLLMENTS) e on e.CCN=n.CMS_CERTIFICATION_NUMBER_CCN left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=n.CMS_CERTIFICATION_NUMBER_CCN\n  where n.PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS='Y'"}
{"label": "clock-free: flagged changes vs penalized base", "rows": 1, "secs": 0.3, "sql": "select sum(iff(n.PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS='Y',1,0)) flagged, sum(iff(n.PROVIDER_CHANGED_OWNERSHIP_IN_LAST_12_MONTHS='Y' and pen.ccn is not null,1,0)) flagged_penalized,\n  count(*) all_homes, count(pen.ccn) all_penalized from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 n left join (select CMS_CERTIFICATION_NUMBER_CCN ccn, min(PENALTY_DATE) first_pen, max(PENALTY_DATE) last_pen, count(*) n_pen from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1) pen on pen.ccn=n.CMS_CERTIFICATION_NUMBER_CCN"}
