{"label": "chain rollup all", "rows": 618, "secs": 0.6, "sql": "with homes as (\n  select CMS_CERTIFICATION_NUMBER_CCN ccn, nullif(trim(CHAIN_ID),'') chain_id, nullif(trim(CHAIN_NAME),'') chain_name,\n         NUMBER_OF_CERTIFIED_BEDS beds, NUMBER_OF_FINES cms_fines, TOTAL_AMOUNT_OF_FINES_IN_DOLLARS cms_fine_dollars, NUMBER_OF_PAYMENT_DENIALS cms_denials\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411),\nfines as (\n  select CMS_CERTIFICATION_NUMBER_CCN ccn, count(distinct FINE_ID) fines, sum(FINE_AMOUNT) dollars\n  from (select distinct CMS_CERTIFICATION_NUMBER_CCN, FINE_ID, FINE_AMOUNT from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine' and PENALTY_DATE>='2023-06-17')\n  group by 1),\ndenials as (\n  select CMS_CERTIFICATION_NUMBER_CCN ccn, count(*) denials from (select distinct CMS_CERTIFICATION_NUMBER_CCN, PAYMENT_DENIAL_START_DATE, PAYMENT_DENIAL_LENGTH_IN_DAYS from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Payment Denial') group by 1)\nselect coalesce(h.chain_id,'(none)') chain_id, coalesce(h.chain_name,'(no chain)') chain_name,\n  count(*) homes, sum(h.beds) beds,\n  sum(coalesce(f.fines,0)) fines, sum(coalesce(f.dollars,0)) dollars,\n  sum(iff(f.fines>0,1,0)) homes_fined,\n  sum(coalesce(d.denials,0)) denials,\n  sum(coalesce(h.cms_fines,0)) cms_fines, sum(coalesce(h.cms_fine_dollars,0)) cms_dollars, sum(coalesce(h.cms_denials,0)) cms_denials,\n  round(sum(coalesce(f.fines,0))/count(*),2) fines_per_home,\n  round(sum(coalesce(f.dollars,0))/count(*)) dollars_per_home,\n  round(100*sum(coalesce(f.fines,0))/nullif(sum(h.beds),0),2) fines_per_100_beds,\n  round(sum(coalesce(f.dollars,0))/nullif(sum(h.beds),0)) dollars_per_bed\nfrom homes h left join fines f on f.ccn=h.ccn left join denials d on d.ccn=h.ccn\ngroup by 1,2 order by fines_per_home desc"}
{"label": "fine totals distinct id", "rows": 1, "secs": 0.4, "sql": "select count(distinct FINE_ID) fines, sum(FINE_AMOUNT) dollars from (select distinct FINE_ID, FINE_AMOUNT from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine')"}
{"label": "fine id dupes", "rows": 1, "secs": 0.2, "sql": "select count(*) ids_with_2plus_rows, sum(c) rows_ from (select FINE_ID, count(*) c from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine' group by 1 having c>1)"}
{"label": "fine id amount/ccn conflict", "rows": 1, "secs": 0.3, "sql": "select count(*) n from (select FINE_ID from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine' group by 1 having count(distinct FINE_AMOUNT)>1 or count(distinct CMS_CERTIFICATION_NUMBER_CCN)>1)"}
{"label": "denial dupes", "rows": 1, "secs": 0.8, "sql": "select count(*) rows_, count(distinct CMS_CERTIFICATION_NUMBER_CCN||'|'||PAYMENT_DENIAL_START_DATE||'|'||PAYMENT_DENIAL_LENGTH_IN_DAYS) distinct_ from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Payment Denial'"}
{"label": "repeat tag by chain", "rows": 618, "secs": 0.3, "sql": "with d as (select CMS_CERTIFICATION_NUMBER_CCN ccn, DEFICIENCY_TAG_NUMBER tag, SURVEY_DATE sd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES where SURVEY_DATE is not null),\npairs as (select ccn, tag, count(distinct sd) n_dates, count(distinct iff(sd>='2023-06-17',sd,null)) n_dates_pw from d group by 1,2),\nhomes as (select CMS_CERTIFICATION_NUMBER_CCN ccn, coalesce(nullif(trim(CHAIN_ID),''),'(none)') chain_id, coalesce(nullif(trim(CHAIN_NAME),''),'(no chain)') chain_name from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411)\nselect h.chain_id, h.chain_name, count(distinct h.ccn) homes,\n  count(p.tag) pairs, sum(iff(p.n_dates>=2,1,0)) repeat_pairs, round(100*sum(iff(p.n_dates>=2,1,0))/nullif(count(p.tag),0),1) repeat_pct,\n  sum(p.n_dates) citations,\n  sum(iff(p.n_dates_pw>=1,1,0)) pairs_pw, sum(iff(p.n_dates_pw>=2,1,0)) repeat_pairs_pw,\n  round(100*sum(iff(p.n_dates_pw>=2,1,0))/nullif(sum(iff(p.n_dates_pw>=1,1,0)),0),1) repeat_pct_pw\nfrom homes h left join pairs p on p.ccn=h.ccn group by 1,2"}
{"label": "repeat tag overall", "rows": 1, "secs": 0.2, "sql": "with d as (select CMS_CERTIFICATION_NUMBER_CCN ccn, DEFICIENCY_TAG_NUMBER tag, SURVEY_DATE sd from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES),\npairs as (select ccn, tag, count(distinct sd) n_dates from d group by 1,2)\nselect count(*) pairs, sum(iff(n_dates>=2,1,0)) repeat_pairs, round(100*sum(iff(n_dates>=2,1,0))/count(*),1) repeat_pct, max(n_dates) max_dates from pairs"}
{"label": "deficiency type by year", "rows": 10, "secs": 0.3, "sql": "select year(SURVEY_DATE) y, sum(iff(STANDARD_DEFICIENCY='Y',1,0)) standard, sum(iff(COMPLAINT_DEFICIENCY='Y',1,0)) complaint, count(distinct CMS_CERTIFICATION_NUMBER_CCN) ccns, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES group by 1 order by 1"}
{"label": "bria homes", "rows": 15, "secs": 0.4, "sql": "select h.CMS_CERTIFICATION_NUMBER_CCN ccn, h.PROVIDER_NAME, h.STATE, h.NUMBER_OF_CERTIFIED_BEDS beds, h.OVERALL_RATING, h.SPECIAL_FOCUS_STATUS, h.ABUSE_ICON,\n  h.NUMBER_OF_FINES cms_fines, h.TOTAL_AMOUNT_OF_FINES_IN_DOLLARS cms_dollars,\n  (select count(distinct FINE_ID) from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p where p.CMS_CERTIFICATION_NUMBER_CCN=h.CMS_CERTIFICATION_NUMBER_CCN and PENALTY_TYPE='Fine') fines,\n  (select sum(FINE_AMOUNT) from (select distinct FINE_ID, FINE_AMOUNT, CMS_CERTIFICATION_NUMBER_CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine') p where p.CMS_CERTIFICATION_NUMBER_CCN=h.CMS_CERTIFICATION_NUMBER_CCN) dollars\nfrom LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 h where CHAIN_NAME='BRIA HEALTH SERVICES' order by dollars desc nulls last"}
{"label": "penalty dupe kind", "rows": 1, "secs": 0.2, "sql": "select PENALTY_TYPE, count(*) groups_, sum(c-1) extra, count(distinct ids) distinct_id_groups from (select CMS_CERTIFICATION_NUMBER_CCN, PENALTY_DATE, PENALTY_TYPE, FINE_AMOUNT, count(*) c, count(distinct FINE_ID) ids from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1,2,3,4 having c>1) group by 1"}
{"label": "bria repeat tags", "rows": 12, "secs": 0.2, "sql": "with d as (select CMS_CERTIFICATION_NUMBER_CCN ccn, DEFICIENCY_TAG_NUMBER tag, max(DEFICIENCY_DESCRIPTION) descr, count(distinct SURVEY_DATE) n_dates\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES where SURVEY_DATE>='2023-06-17' and CMS_CERTIFICATION_NUMBER_CCN in (select CMS_CERTIFICATION_NUMBER_CCN from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME='BRIA HEALTH SERVICES') group by 1,2)\nselect tag, min(descr) descr, count(*) homes_cited, sum(iff(n_dates>=2,1,0)) homes_repeat, sum(n_dates) citations from d group by 1 order by homes_repeat desc, citations desc limit 12"}
{"label": "cohort by chain size", "rows": 3, "secs": 0.3, "sql": "with homes as (select CMS_CERTIFICATION_NUMBER_CCN ccn, nullif(trim(CHAIN_ID),'') chain_id, NUMBER_OF_CERTIFIED_BEDS beds from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411),\nfines as (select CMS_CERTIFICATION_NUMBER_CCN ccn, count(distinct FINE_ID) fines, sum(FINE_AMOUNT) dollars from (select distinct CMS_CERTIFICATION_NUMBER_CCN, FINE_ID, FINE_AMOUNT from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine') group by 1),\nsz as (select chain_id, count(*) n from homes where chain_id is not null group by 1)\nselect case when h.chain_id is null then 'no chain' when s.n>=10 then 'chain 10+ homes' else 'chain under 10' end grp,\n  count(distinct h.chain_id) chains, count(*) homes, sum(h.beds) beds, sum(coalesce(f.fines,0)) fines, sum(coalesce(f.dollars,0)) dollars,\n  round(sum(coalesce(f.fines,0))/count(*),2) fines_per_home, round(100*sum(coalesce(f.fines,0))/sum(h.beds),2) fines_per_100_beds, round(sum(coalesce(f.dollars,0))/sum(h.beds)) dollars_per_bed\nfrom homes h left join fines f on f.ccn=h.ccn left join sz s on s.chain_id=h.chain_id group by 1 order by 1"}
{"label": "cols HEALTH__FED_NURSINGHOME411", "rows": 71, "secs": 1.1, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_NURSINGHOME411' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES", "rows": 23, "secs": 1.2, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES' order by ordinal_position"}
{"label": "cols HEALTH__FED_CMS_NURSING_HOME_PENALTIES", "rows": 14, "secs": 1.3, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='HEALTH' and table_name='HEALTH__FED_CMS_NURSING_HOME_PENALTIES' order by ordinal_position"}
{"label": "nh shape", "rows": 1, "secs": 0.3, "sql": "select count(*) rows_, count(distinct CMS_CERTIFICATION_NUMBER_CCN) ccns,\n count(distinct CHAIN_ID) chain_ids, count(distinct CHAIN_NAME) chain_names,\n sum(iff(CHAIN_ID is null or trim(CHAIN_ID)='',1,0)) no_chain_id, sum(iff(CHAIN_NAME is null or trim(CHAIN_NAME)='',1,0)) no_chain_name,\n count(distinct PROCESSING_DATE) proc_dates, min(PROCESSING_DATE) pd_min, max(PROCESSING_DATE) pd_max from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411"}
{"label": "chain id sample", "rows": 15, "secs": 0.2, "sql": "select CHAIN_ID, CHAIN_NAME, NUMBER_OF_FACILITIES_IN_CHAIN, count(*) homes_here from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411\n where CHAIN_ID is not null group by 1,2,3 order by homes_here desc limit 15"}
{"label": "id/name crosswalk", "rows": 1, "secs": 0.7, "sql": "select\n (select count(*) from (select CHAIN_ID from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_ID is not null group by 1 having count(distinct CHAIN_NAME)>1)) ids_with_many_names,\n (select count(*) from (select CHAIN_NAME from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_NAME is not null group by 1 having count(distinct CHAIN_ID)>1)) names_with_many_ids,\n (select count(*) from (select CHAIN_ID from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_ID is not null group by 1 having count(distinct NUMBER_OF_FACILITIES_IN_CHAIN)>1)) ids_with_many_facility_counts,\n (select count(*) from (select CHAIN_ID, max(NUMBER_OF_FACILITIES_IN_CHAIN) n, count(*) c from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_ID is not null group by 1 having n<>c)) ids_where_count_disagrees"}
{"label": "chain id format", "rows": 4, "secs": 0.2, "sql": "select length(CHAIN_ID) len, regexp_like(CHAIN_ID,'^[0-9]+$') numeric, count(*) n, min(CHAIN_ID) lo, max(CHAIN_ID) hi from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 where CHAIN_ID is not null group by 1,2 order by n desc"}
{"label": "penalties shape", "rows": 1, "secs": 1.1, "sql": "select count(*) rows_, count(distinct FINE_ID) fine_ids, count(distinct CMS_CERTIFICATION_NUMBER_CCN) ccns,\n min(PENALTY_DATE) d_min, max(PENALTY_DATE) d_max, sum(iff(PENALTY_DATE<'2023-06-17',1,0)) before_window,\n count(distinct PROCESSING_DATE) proc_dates from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES"}
{"label": "penalty types", "rows": 2, "secs": 0.2, "sql": "select PENALTY_TYPE, count(*) n, count(distinct FINE_ID) fine_ids, sum(FINE_AMOUNT) dollars, sum(iff(FINE_ID is null or trim(FINE_ID)='',1,0)) blank_id from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1 order by n desc"}
{"label": "penalty dupes", "rows": 1, "secs": 0.2, "sql": "select count(*) dupe_groups, sum(c-1) extra_rows from (select CMS_CERTIFICATION_NUMBER_CCN, PENALTY_DATE, PENALTY_TYPE, FINE_AMOUNT, count(*) c from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1,2,3,4 having c>1)"}
{"label": "penalty ccn coverage", "rows": 1, "secs": 0.2, "sql": "select count(distinct p.CMS_CERTIFICATION_NUMBER_CCN) pen_ccns, count(distinct n.CMS_CERTIFICATION_NUMBER_CCN) matched from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES p left join LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411 n on n.CMS_CERTIFICATION_NUMBER_CCN=p.CMS_CERTIFICATION_NUMBER_CCN"}
{"label": "deficiency shape", "rows": 1, "secs": 0.3, "sql": "select count(*) rows_, count(distinct CMS_CERTIFICATION_NUMBER_CCN) ccns, min(SURVEY_DATE) d_min, max(SURVEY_DATE) d_max,\n count(distinct DEFICIENCY_TAG_NUMBER) tags, count(distinct PROCESSING_DATE) proc_dates from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES"}
{"label": "deficiencies by year", "rows": 10, "secs": 0.2, "sql": "select year(SURVEY_DATE) y, count(*) n from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_DEFICIENCIES group by 1 order by 1"}
{"label": "penalties by month", "rows": 36, "secs": 0.8, "sql": "select date_trunc('month',PENALTY_DATE) m, count(*) n, sum(iff(PENALTY_TYPE ilike 'fine%',FINE_AMOUNT,0)) dollars from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES group by 1 order by 1"}
{"label": "chain rollup all", "rows": 618, "secs": 0.9, "sql": "with homes as (\n  select CMS_CERTIFICATION_NUMBER_CCN ccn, nullif(trim(CHAIN_ID),'') chain_id, nullif(trim(CHAIN_NAME),'') chain_name,\n         NUMBER_OF_CERTIFIED_BEDS beds, NUMBER_OF_FINES cms_fines, TOTAL_AMOUNT_OF_FINES_IN_DOLLARS cms_fine_dollars, NUMBER_OF_PAYMENT_DENIALS cms_denials\n  from LIBRARY_MARTS.HEALTH.HEALTH__FED_NURSINGHOME411),\nfines as (\n  select CMS_CERTIFICATION_NUMBER_CCN ccn, count(distinct FINE_ID) fines, sum(FINE_AMOUNT) dollars\n  from (select distinct CMS_CERTIFICATION_NUMBER_CCN, FINE_ID, FINE_AMOUNT from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine' and PENALTY_DATE>='2023-06-17')\n  group by 1),\ndenials as (\n  select CMS_CERTIFICATION_NUMBER_CCN ccn, count(*) denials from (select distinct CMS_CERTIFICATION_NUMBER_CCN, PAYMENT_DENIAL_START_DATE, PAYMENT_DENIAL_LENGTH_IN_DAYS from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Payment Denial') group by 1)\nselect coalesce(h.chain_id,'(none)') chain_id, coalesce(h.chain_name,'(no chain)') chain_name,\n  count(*) homes, sum(h.beds) beds,\n  sum(coalesce(f.fines,0)) fines, sum(coalesce(f.dollars,0)) dollars,\n  sum(iff(f.fines>0,1,0)) homes_fined,\n  sum(coalesce(d.denials,0)) denials,\n  sum(coalesce(h.cms_fines,0)) cms_fines, sum(coalesce(h.cms_fine_dollars,0)) cms_dollars, sum(coalesce(h.cms_denials,0)) cms_denials,\n  round(sum(coalesce(f.fines,0))/count(*),2) fines_per_home,\n  round(sum(coalesce(f.dollars,0))/count(*)) dollars_per_home,\n  round(100*sum(coalesce(f.fines,0))/nullif(sum(h.beds),0),2) fines_per_100_beds,\n  round(sum(coalesce(f.dollars,0))/nullif(sum(h.beds),0)) dollars_per_bed\nfrom homes h left join fines f on f.ccn=h.ccn left join denials d on d.ccn=h.ccn\ngroup by 1,2 order by fines_per_home desc"}
{"label": "fine totals distinct id", "rows": 1, "secs": 0.3, "sql": "select count(distinct FINE_ID) fines, sum(FINE_AMOUNT) dollars from (select distinct FINE_ID, FINE_AMOUNT from LIBRARY_MARTS.HEALTH.HEALTH__FED_CMS_NURSING_HOME_PENALTIES where PENALTY_TYPE='Fine')"}
