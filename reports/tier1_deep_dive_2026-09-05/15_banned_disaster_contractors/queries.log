{"label": "cols r2", "rows": 39, "secs": 1.3, "sql": "select column_name, data_type from LIBRARY_RAW.information_schema.columns where table_schema='LANDING' and table_name='FED_USASPENDING_CONTRACTS_FULL_R2' order by ordinal_position"}
{"label": "cols excl", "rows": 22, "secs": 2.0, "sql": "select column_name, data_type from LIBRARY_MARTS.information_schema.columns where table_schema='PROCUREMENT' and table_name='PROCUREMENT__FED_SAM_EXCLUSIONS' order by ordinal_position"}
{"label": "excl profile", "rows": 1, "secs": 0.4, "sql": "select count(*) n, count(distinct UEI) uei, count(distinct nullif(trim(CAGE_CODE),'')) cage,\n        sum(iff(IS_ENTITY_NOT_INDIVIDUAL,1,0)) ents, sum(iff(IS_CURRENTLY_EXCLUDED,1,0)) cur,\n        min(ACTIVATION_DATE) mn, max(ACTIVATION_DATE) mx, count(TERMINATION_DATE) term from LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS"}
{"label": "excl class", "rows": 4, "secs": 1.0, "sql": "select RECORD_STATUS, CLASSIFICATION, count(*) n from LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS group by 1,2 order by 3 desc"}
{"label": "excl type", "rows": 5, "secs": 0.4, "sql": "select EXCLUSION_TYPE, count(*) n from LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS group by 1 order by 2 desc"}
{"label": "excl term raw", "rows": 1, "secs": 0.2, "sql": "select TERMINATION_DATE_RAW, count(*) n from LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS where TERMINATION_DATE is null group by 1 order by 2 desc limit 5"}
{"label": "excl activation years", "rows": 53, "secs": 0.5, "sql": "select year(ACTIVATION_DATE) y, count(*) n from LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS group by 1 order by 1"}
{"label": "slice by sub-agency", "rows": 40, "secs": 9.3, "sql": "select AWARDING_SUB_AGENCY_NAME sub, count(*) n,\n        sum(try_to_number(FEDERAL_ACTION_OBLIGATION,18,2)) oblig,\n        min(try_to_date(ACTION_DATE)) mn, max(try_to_date(ACTION_DATE)) mx\n        from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2 where (AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%'\n   or regexp_like(upper(coalesce(TRANSACTION_DESCRIPTION,'')), '.*(HURRICANE|DISASTER|FEMA|WILDFIRE|FLOOD|TORNADO|EARTHQUAKE|EMERGENCY RESPONSE|DEBRIS REMOVAL|BLUE ROOF|EMERGENCY MANAGEMENT).*')) group by 1 order by 2 desc limit 40"}
{"label": "slice by year", "rows": 42, "secs": 6.1, "sql": "select year(try_to_date(ACTION_DATE)) y,\n        iff(AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%','FEMA','keyword') how,\n        count(*) n, sum(try_to_number(FEDERAL_ACTION_OBLIGATION,18,2)) oblig from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2 where (AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%'\n   or regexp_like(upper(coalesce(TRANSACTION_DESCRIPTION,'')), '.*(HURRICANE|DISASTER|FEMA|WILDFIRE|FLOOD|TORNADO|EARTHQUAKE|EMERGENCY RESPONSE|DEBRIS REMOVAL|BLUE ROOF|EMERGENCY MANAGEMENT).*')) group by 1,2 order by 1,2"}
{"label": "r2 profile", "rows": 1, "secs": 9.4, "sql": "select count(*) n, count(distinct RECIPIENT_UEI) uei, count(distinct nullif(trim(CAGE_CODE),'')) cage,\n        min(try_to_date(ACTION_DATE)) mn, max(try_to_date(ACTION_DATE)) mx,\n        count(distinct CONTRACT_AWARD_UNIQUE_KEY) awards from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2"}
{"label": "disaster x exclusions", "rows": 420, "secs": 14.0, "sql": "with d as (\n        select CONTRACT_AWARD_UNIQUE_KEY awk, AWARD_ID_PIID piid, try_to_date(ACTION_DATE) act, try_to_date(PERIOD_OF_PERFORMANCE_START_DATE) pstart,\n               try_to_number(FEDERAL_ACTION_OBLIGATION,18,2) oblig, try_to_number(CURRENT_TOTAL_VALUE_OF_AWARD,18,2) ctv,\n               AWARDING_SUB_AGENCY_NAME sub, RECIPIENT_UEI uei, nullif(trim(CAGE_CODE),'') cage, RECIPIENT_NAME rname,\n               upper(trim(RECIPIENT_NAME)) rn, left(TRANSACTION_DESCRIPTION, 120) descr, AWARD_TYPE atype, USASPENDING_PERMALINK link\n        from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2 where (AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%'\n   or regexp_like(upper(coalesce(TRANSACTION_DESCRIPTION,'')), '.*(HURRICANE|DISASTER|FEMA|WILDFIRE|FLOOD|TORNADO|EARTHQUAKE|EMERGENCY RESPONSE|DEBRIS REMOVAL|BLUE ROOF|EMERGENCY MANAGEMENT).*')))\n      select 'UEI' how, d.*, e.SAM_NUMBER sam, e.ENTITY_NAME ename, e.CLASSIFICATION cls, e.EXCLUSION_TYPE etype, e.EXCLUDING_AGENCY eagency,\n             e.ACTIVATION_DATE act_on, e.TERMINATION_DATE term_on, e.TERMINATION_DATE_RAW term_raw\n      from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI = d.uei and e.IS_ENTITY_NOT_INDIVIDUAL\n      union all\n      select 'CAGE', d.*, e.SAM_NUMBER, e.ENTITY_NAME, e.CLASSIFICATION, e.EXCLUSION_TYPE, e.EXCLUDING_AGENCY, e.ACTIVATION_DATE, e.TERMINATION_DATE, e.TERMINATION_DATE_RAW\n      from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.CAGE_CODE = d.cage and e.IS_ENTITY_NOT_INDIVIDUAL and (e.UEI is null or e.UEI <> d.uei)\n      union all\n      select 'NAME', d.*, e.SAM_NUMBER, e.ENTITY_NAME, e.CLASSIFICATION, e.EXCLUSION_TYPE, e.EXCLUDING_AGENCY, e.ACTIVATION_DATE, e.TERMINATION_DATE, e.TERMINATION_DATE_RAW\n      from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on upper(trim(e.ENTITY_NAME)) = d.rn and e.IS_ENTITY_NOT_INDIVIDUAL and (e.UEI is null or e.UEI <> d.uei)\n           and (e.CAGE_CODE is null or e.CAGE_CODE <> coalesce(d.cage,''))\n      order by 1, act"}
{"label": "window summary", "rows": 8, "secs": 18.5, "sql": "with d as (\n        select CONTRACT_AWARD_UNIQUE_KEY awk, AWARD_ID_PIID piid, try_to_date(ACTION_DATE) act,\n               try_to_number(FEDERAL_ACTION_OBLIGATION,18,2) oblig, try_to_number(CURRENT_TOTAL_VALUE_OF_AWARD,18,2) ctv,\n               AWARDING_SUB_AGENCY_NAME sub, RECIPIENT_UEI uei, nullif(trim(CAGE_CODE),'') cage, upper(trim(RECIPIENT_NAME)) rn,\n               left(TRANSACTION_DESCRIPTION,120) descr, USASPENDING_PERMALINK link, hash(*) rowkey\n        from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2 where (AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%'\n   or regexp_like(upper(coalesce(TRANSACTION_DESCRIPTION,'')), '.*(HURRICANE|DISASTER|FEMA|WILDFIRE|FLOOD|TORNADO|EARTHQUAKE|EMERGENCY RESPONSE|DEBRIS REMOVAL|BLUE ROOF|EMERGENCY MANAGEMENT).*'))),\n      m as (\n        select d.*, e.SAM_NUMBER sam, e.ENTITY_NAME ename, e.EXCLUSION_TYPE etype, e.EXCLUDING_AGENCY eagency, e.ACTIVATION_DATE act_on,\n               coalesce(e.TERMINATION_DATE, '2099-12-31'::date) term_on,\n               case when e.UEI = d.uei then 'UEI' when e.CAGE_CODE = d.cage then 'CAGE' else 'NAME' end how\n        from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.IS_ENTITY_NOT_INDIVIDUAL and (e.UEI = d.uei or e.CAGE_CODE = d.cage or upper(trim(e.ENTITY_NAME)) = d.rn)),\n      one as (\n        select rowkey, awk, piid, act, oblig, ctv, sub, uei, rn, descr, link,\n               min(how) how, min(act_on) first_act_on, max(act_on) last_act_on,\n               max(iff(act between act_on and term_on, 1, 0)) in_window,\n               max(iff(act >= act_on, 1, 0)) after_ban_start,\n               min(iff(act >= act_on, etype, null)) etype_hit, min(iff(act >= act_on, eagency, null)) eagency_hit,\n               min(iff(act >= act_on, act_on, null)) act_on_hit, max(iff(act >= act_on, term_on, null)) term_on_hit,\n               count(*) excl_records\n        from m group by all)\n      select how, in_window, after_ban_start, iff(sub ilike '%Emergency Management%','FEMA','other') fema,\n             count(*) n, count(distinct uei) recips, count(distinct awk) awards,\n             sum(oblig) oblig, sum(greatest(oblig,0)) oblig_pos\n      from one group by all order by 1,2,3,4"}
{"label": "window by year", "rows": 29, "secs": 10.8, "sql": "with d as (\n        select CONTRACT_AWARD_UNIQUE_KEY awk, AWARD_ID_PIID piid, try_to_date(ACTION_DATE) act,\n               try_to_number(FEDERAL_ACTION_OBLIGATION,18,2) oblig, try_to_number(CURRENT_TOTAL_VALUE_OF_AWARD,18,2) ctv,\n               AWARDING_SUB_AGENCY_NAME sub, RECIPIENT_UEI uei, nullif(trim(CAGE_CODE),'') cage, upper(trim(RECIPIENT_NAME)) rn,\n               left(TRANSACTION_DESCRIPTION,120) descr, USASPENDING_PERMALINK link, hash(*) rowkey\n        from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2 where (AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%'\n   or regexp_like(upper(coalesce(TRANSACTION_DESCRIPTION,'')), '.*(HURRICANE|DISASTER|FEMA|WILDFIRE|FLOOD|TORNADO|EARTHQUAKE|EMERGENCY RESPONSE|DEBRIS REMOVAL|BLUE ROOF|EMERGENCY MANAGEMENT).*'))),\n      m as (\n        select d.*, e.SAM_NUMBER sam, e.ENTITY_NAME ename, e.EXCLUSION_TYPE etype, e.EXCLUDING_AGENCY eagency, e.ACTIVATION_DATE act_on,\n               coalesce(e.TERMINATION_DATE, '2099-12-31'::date) term_on,\n               case when e.UEI = d.uei then 'UEI' when e.CAGE_CODE = d.cage then 'CAGE' else 'NAME' end how\n        from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.IS_ENTITY_NOT_INDIVIDUAL and (e.UEI = d.uei or e.CAGE_CODE = d.cage or upper(trim(e.ENTITY_NAME)) = d.rn)),\n      one as (\n        select rowkey, awk, piid, act, oblig, ctv, sub, uei, rn, descr, link,\n               min(how) how, min(act_on) first_act_on, max(act_on) last_act_on,\n               max(iff(act between act_on and term_on, 1, 0)) in_window,\n               max(iff(act >= act_on, 1, 0)) after_ban_start,\n               min(iff(act >= act_on, etype, null)) etype_hit, min(iff(act >= act_on, eagency, null)) eagency_hit,\n               min(iff(act >= act_on, act_on, null)) act_on_hit, max(iff(act >= act_on, term_on, null)) term_on_hit,\n               count(*) excl_records\n        from m group by all)\n      select year(act) y, in_window, count(*) n, count(distinct uei) recips, sum(oblig) oblig\n      from one group by all order by 1,2"}
{"label": "repro first pass", "rows": 9, "secs": 10.3, "sql": "with d as (\n        select CONTRACT_AWARD_UNIQUE_KEY awk, try_to_number(FEDERAL_ACTION_OBLIGATION,18,2) oblig,\n               try_to_number(CURRENT_TOTAL_VALUE_OF_AWARD,18,2) ctv, try_to_number(TOTAL_DOLLARS_OBLIGATED,18,2) tdo,\n               AWARDING_SUB_AGENCY_NAME sub, RECIPIENT_UEI uei, upper(trim(RECIPIENT_NAME)) rn\n        from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2 where (AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%'\n   or regexp_like(upper(coalesce(TRANSACTION_DESCRIPTION,'')), '.*(HURRICANE|DISASTER|FEMA|WILDFIRE|FLOOD|TORNADO|EARTHQUAKE|EMERGENCY RESPONSE|DEBRIS REMOVAL|BLUE ROOF|EMERGENCY MANAGEMENT).*')))\n      select 'A uei, entities, all disaster, sum oblig' v, count(distinct d.uei) cos, sum(oblig) dollars from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei and e.IS_ENTITY_NOT_INDIVIDUAL\n      union all select 'B uei, entities, FEMA only, sum oblig', count(distinct d.uei), sum(oblig) from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei and e.IS_ENTITY_NOT_INDIVIDUAL where sub ilike '%Emergency Management%'\n      union all select 'C uei, entities, all disaster, sum ctv (per transaction)', count(distinct d.uei), sum(ctv) from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei and e.IS_ENTITY_NOT_INDIVIDUAL\n      union all select 'D uei, entities, all disaster, ctv once per award', count(distinct uei), sum(ctv) from (select d.uei, d.awk, max(ctv) ctv from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei and e.IS_ENTITY_NOT_INDIVIDUAL group by 1,2)\n      union all select 'E uei, entities, all disaster, tdo once per award', count(distinct uei), sum(tdo) from (select d.uei, d.awk, max(tdo) tdo from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei and e.IS_ENTITY_NOT_INDIVIDUAL group by 1,2)\n      union all select 'F uei, ALL excl rows incl individuals, all disaster, sum oblig', count(distinct d.uei), sum(oblig) from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei\n      union all select 'G uei, entities, FEMA only, ctv once per award', count(distinct uei), sum(ctv) from (select d.uei, d.awk, max(ctv) ctv from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei and e.IS_ENTITY_NOT_INDIVIDUAL where sub ilike '%Emergency Management%' group by 1,2)\n      union all select 'H name, entities, all disaster, sum oblig', count(distinct d.rn), sum(oblig) from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on upper(trim(e.ENTITY_NAME))=d.rn and e.IS_ENTITY_NOT_INDIVIDUAL\n      union all select 'I uei, entities, FEMA only, tdo once per award', count(distinct uei), sum(tdo) from (select d.uei, d.awk, max(tdo) tdo from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.UEI=d.uei and e.IS_ENTITY_NOT_INDIVIDUAL where sub ilike '%Emergency Management%' group by 1,2)"}
{"label": "excl records per uei", "rows": 7, "secs": 0.3, "sql": "select cnt, count(*) ueis from (select UEI, count(*) cnt from LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS where UEI is not null group by 1) group by 1 order by 1 limit 10"}
{"label": "window summary", "rows": 8, "secs": 0.2, "sql": "with d as (\n        select CONTRACT_AWARD_UNIQUE_KEY awk, AWARD_ID_PIID piid, try_to_date(ACTION_DATE) act,\n               try_to_number(FEDERAL_ACTION_OBLIGATION,18,2) oblig, try_to_number(CURRENT_TOTAL_VALUE_OF_AWARD,18,2) ctv,\n               AWARDING_SUB_AGENCY_NAME sub, RECIPIENT_UEI uei, nullif(trim(CAGE_CODE),'') cage, upper(trim(RECIPIENT_NAME)) rn,\n               left(TRANSACTION_DESCRIPTION,120) descr, USASPENDING_PERMALINK link, hash(*) rowkey\n        from LIBRARY_RAW.LANDING.FED_USASPENDING_CONTRACTS_FULL_R2 where (AWARDING_SUB_AGENCY_NAME ilike '%Emergency Management%'\n   or regexp_like(upper(coalesce(TRANSACTION_DESCRIPTION,'')), '.*(HURRICANE|DISASTER|FEMA|WILDFIRE|FLOOD|TORNADO|EARTHQUAKE|EMERGENCY RESPONSE|DEBRIS REMOVAL|BLUE ROOF|EMERGENCY MANAGEMENT).*'))),\n      m as (\n        select d.*, e.SAM_NUMBER sam, e.ENTITY_NAME ename, e.EXCLUSION_TYPE etype, e.EXCLUDING_AGENCY eagency, e.ACTIVATION_DATE act_on,\n               coalesce(e.TERMINATION_DATE, '2099-12-31'::date) term_on,\n               case when e.UEI = d.uei then 'UEI' when e.CAGE_CODE = d.cage then 'CAGE' else 'NAME' end how\n        from d join LIBRARY_MARTS.PROCUREMENT.PROCUREMENT__FED_SAM_EXCLUSIONS e on e.IS_ENTITY_NOT_INDIVIDUAL and (e.UEI = d.uei or e.CAGE_CODE = d.cage or upper(trim(e.ENTITY_NAME)) = d.rn)),\n      one as (\n        select rowkey, awk, piid, act, oblig, ctv, sub, uei, rn, descr, link,\n               min(how) how, min(act_on) first_act_on, max(act_on) last_act_on,\n               max(iff(act between act_on and term_on, 1, 0)) in_window,\n               max(iff(act >= act_on, 1, 0)) after_ban_start,\n               min(iff(act >= act_on, etype, null)) etype_hit, min(iff(act >= act_on, eagency, null)) eagency_hit,\n               min(iff(act >= act_on, act_on, null)) act_on_hit, max(iff(act >= act_on, term_on, null)) term_on_hit,\n               count(*) excl_records\n        from m group by all)\n      select how, in_window, after_ban_start, iff(sub ilike '%Emergency Management%','FEMA','other') fema,\n             count(*) n, count(distinct uei) recips, count(distinct awk) awards,\n             sum(oblig) oblig, sum(greatest(oblig,0)) oblig_pos\n      from one group by all order by 1,2,3,4"}
