  "d1a_lifecycle_vs_rows": {
    "sql": "\n        WITH t AS (SELECT TABLE_NAME, ROW_COUNT FROM LIBRARY_RAW.INFORMATION_SCHEMA.TABLES\n                   WHERE TABLE_SCHEMA='LANDING')\n        SELECT COUNT(*) AS landed_total,\n               SUM(IFF(t.TABLE_NAME IS NULL,1,0)) AS no_physical_table,\n               SUM(IFF(t.ROW_COUNT=0,1,0)) AS zero_rows,\n               SUM(IFF(t.ROW_COUNT BETWEEN 1 AND 3,1,0)) AS rows_1_to_3\n        FROM LIBRARY_META.REGISTRY.CATALOG c\n        LEFT JOIN t ON t.TABLE_NAME = UPPER(c.SOURCE_ID)\n        WHERE c.LIFECYCLE IN ('landed','modeled')",
    "columns": [
      "LANDED_TOTAL",
      "NO_PHYSICAL_TABLE",
      "ZERO_ROWS",
      "ROWS_1_TO_3"
    ],
    "rows": [
      [
        "199",
        "0",
        "0",
        "8"
      ]
    ]
  },
