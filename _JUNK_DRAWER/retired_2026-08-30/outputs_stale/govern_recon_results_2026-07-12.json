  "d4_connect_views": {
    "sql": "SHOW VIEWS IN SCHEMA LIBRARY_META.\"CONNECT\"",
    "columns": [
      "created_on",
      "name",
      "reserved",
      "database_name",
      "schema_name",
      "owner",
      "comment",
      "text",
      "is_secure",
      "is_materialized",
      "owner_role_type",
      "change_tracking"
    ],
    "rows": [
      [
        "2026-07-06 17:23:05.512000-07:00",
        "V_CONNECTIONS",
        "",
        "LIBRARY_META",
        "CONNECT",
        "ACCOUNTADMIN",
        "One row per connection-graph edge, human-readable. table_a.col_a = table_b.col_b\nis a runnable join. tier STEEL/STRONG = hard identifier; GEO/CORROBORATED/PROBABILISTIC\nare softer. Built over CONNECT_EDGES; regenerable.",
        "CREATE OR REPLACE VIEW LIBRARY_META.\"CONNECT\".V_CONNECTIONS COPY GRANTS\ncomment = 'One row per connection-graph edge, human-readable. table_a.col_a = table_b.col_b\\nis a runnable join. tier STEEL/STRONG = hard identifier; GEO/CORROBORATED/PROBABILISTIC\\nare softer. Built over CONNECT_EDGES; regenerable.' AS\nSELECT\n    e.A                         AS table_a,\n    e.A_COL                     AS col_a,\n    e.B                         AS table_b,\n    e.B_COL                     AS col_b,\n    e.KEY                       AS join_key,\n    e.TIER                      AS tier,\n    e.CONFIDENCE                AS confidence,\n    e.MATCHED                   AS matched_values,\n    e.MATCH_RATE                AS match_rate_pct,\n    e.A_DISTINCT                AS a_distinct,\n    e.B_DISTINCT                AS b_distinct,\n    ca.DOMAIN_PRIMARY           AS domain_a,\n    cb.DOMAIN_PRIMARY           AS domain_b,\n    CASE WHEN e.A_COL IS NOT NULL AND e.B_COL IS NOT NULL THEN\n        'SELECT a.*, b.* FROM LIBRARY_RAW.LANDING.' || e.A || ' a '\n        || 'JOIN LIBRARY_RAW.LANDING.' || e.B || ' b '\n        || 'ON a.' || e.A_COL || ' = b.' || e.B_COL\n    END                         AS join_hint,\n    e.\"SAMPLE\"                  AS sample_values,\n    e.BUILT_AT                  AS built_at\nFROM LIBRARY_META.\"CONNECT\".CONNECT_EDGES e\nLEFT JOIN LIBRARY_META.REGISTRY.CATALOG ca ON UPPER(ca.SOURCE_ID) = e.A\nLEFT JOIN LIBRARY_META.REGISTRY.CATALOG cb ON UPPER(cb.SOURCE_ID) = e.B",
        "false",
        "false",
        "ROLE",
        "OFF"
      ],
      [
        "2026-07-06 17:23:07.076000-07:00",
        "V_CONNECTION_SUMMARY",
        "",
        "LIBRARY_META",
        "CONNECT",
        "ACCOUNTADMIN",
        "Browse menu for the connection graph: edge counts and best overlap per\n(domain_a, domain_b, tier). Which domains connect, and how strongly.",
        "CREATE OR REPLACE VIEW LIBRARY_META.\"CONNECT\".V_CONNECTION_SUMMARY COPY GRANTS\ncomment = 'Browse menu for the connection graph: edge counts and best overlap per\\n(domain_a, domain_b, tier). Which domains connect, and how strongly.' AS\nSELECT\n    domain_a,\n    domain_b,\n    tier,\n    COUNT(*)                    AS edges,\n    COUNT(DISTINCT table_a)     AS distinct_a_tables,\n    COUNT(DISTINCT table_b)     AS distinct_b_tables,\n    MAX(matched_values)         AS max_overlap,\n    ROUND(AVG(confidence), 3)   AS avg_confidence\nFROM LIBRARY_META.\"CONNECT\".V_CONNECTIONS\nGROUP BY 1, 2, 3",
        "false",
        "false",
        "ROLE",
        "OFF"
      ],
      [
        "2026-07-03 13:27:24.637000-07:00",
        "V_LEADS_PUBLISHED",
        "",
        "LIBRARY_META",
        "CONNECT",
        "ACCOUNTADMIN",
        "The SAFE way to read leads in SQL: published()-semantics as a view. Drops leads whose latest human verdict is rejected/retracted/stale, drops leads absent from the latest run (STATUS<>active), and stamps every survivor with REVIEW_STATE + PUBLISHED so an unreviewed lead can never read as fact. Built by the Investigator Instrument 2026-07-03; mirrors connect/leads.py published(). Regenerable.",
        "CREATE OR REPLACE VIEW LIBRARY_META.\"CONNECT\".V_LEADS_PUBLISHED\ncomment = 'The SAFE way to read leads in SQL: published()-semantics as a view. Drops leads whose latest human verdict is rejected/retracted/stale, drops leads absent from the latest run (STATUS<>active), and stamps every survivor with REVIEW_STATE + PUBLISHED so an unreviewed lead can never read as fact. Built by the Investigator Instrument 2026-07-03; mirrors connect/leads.py published(). Regenerable.' \nAS\nWITH latest_verdict AS (\n    SELECT TARGET_ID, DECISION\n    FROM LIBRARY_META.\"CONNECT\".DECISIONS\n    WHERE TARGET_KIND = 'lead'\n    QUALIFY ROW_NUMBER() OVER (PARTITION BY TARGET_ID ORDER BY DECIDED_AT DESC) = 1\n)\nSELECT\n    l.*,\n    COALESCE(v.DECISION, 'pending')                    AS REVIEW_STATE,\n    COALESCE(v.DECISION, 'pending') = 'confirmed'      AS PUBLISHED\nFROM LIBRARY_META.\"CONNECT\".LEADS l\nLEFT JOIN latest_verdict v ON v.TARGET_ID = l.LEAD_ID\nWHERE COALESCE(l.STATUS, 'active') = 'active'\n  AND COALESCE(v.DECISION, 'pending') NOT IN ('rejected', 'retracted', 'stale')",
        "false",
        "false",
        "ROLE",
        "OFF"
      ]
    ]
  },
